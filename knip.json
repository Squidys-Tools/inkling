{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "src/**/*.test.ts",
        "benchmarks/**/*.smoke.ts",
        "electron/model-manifest.json",
        "electron/**/*.d.mts",
        "electron/**/*.test.ts",
        "electron/preload.cjs"
      ],
      "project": ["src/**/*", "benchmarks/harness/**/*", "electron/**/*"],
      "ignore": ["src/bun-test.d.ts"],
      "ignoreDependencies": ["@fontsource/.+"]
    },
    "extension": {
      "entry": ["src/options.ts", "src/background.ts", "src/**/*.test.ts"]
    },
    "packages/*": {}
  }
}
