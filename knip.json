{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "src/**/*.test.ts",
        "benchmarks/**/*.smoke.ts",
        "electron/main.ts",
        "electron/preload.ts",
        "electron/sqlite-snapshot-worker.ts",
        "electron/search-worker.ts",
        "electron/**/*.test.ts"
      ],
      "project": ["src/**/*", "benchmarks/harness/**/*", "electron/**/*"],
      "ignore": ["src/bun-test.d.ts", "src/components/GradualBlur/**"],
      "ignoreDependencies": ["@img/sharp-wasm32"],
      "ignoreBinaries": ["dpkg-deb"]
    },
    "extension": {
      "entry": ["src/options.ts", "src/background.ts", "src/**/*.test.ts"]
    },
    "packages/*": {}
  }
}
