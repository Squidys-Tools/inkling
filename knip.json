{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "tools/**/*.{ts,mjs}",
        "benchmarks/fetch-macrumors.ts",
        "benchmarks/harness/index.ts"
      ],
      "ignoreDependencies": ["@img/sharp-wasm32"],
      "ignoreBinaries": ["dpkg-deb"],
      "ignore": [".agents/**", ".claude/**"]
    },
    "apps/desktop": {
      "entry": ["src/main.ts", "src/preload.ts", "build.ts", "after-pack.cjs"],
      "ignoreBinaries": ["mkfifo"]
    },
    "apps/renderer": {
      "entry": ["index.html"]
    },
    "apps/site": {
      "entry": ["src/routes/**/*.tsx"],
      "ignore": ["public/demo/**"]
    },
    "packages/library": {
      "entry": ["src/storage/sqlite-snapshot-worker.ts"]
    },
    "packages/*": {},
    "tools/*": {
      "entry": ["*.{ts,mjs}"]
    },
    "extension": {
      "entry": ["src/options.ts", "src/background.ts", "src/popup/main.tsx"]
    }
  }
}
