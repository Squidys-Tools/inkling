{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["src/**/*.test.ts", "benchmarks/**/*.smoke.ts"],
      "project": ["src/**/*", "benchmarks/harness/**/*"],
      "ignore": ["src/bun-test.d.ts"]
    },
    "extension": {
      "entry": ["content.js", "options.js", "src/background.ts", "src/popup.ts", "src/**/*.test.ts"]
    },
    "packages/*": {}
  }
}
