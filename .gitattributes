# Preserve PDF bytes exactly; line endings inside xref tables are significant to some parsers.
benchmarks/corpus/pdfs/*.pdf binary

# Keep Biome-formatted files identical across Windows and Linux checkouts.
*.cjs text eol=lf
*.css text eol=lf
*.html text eol=lf
*.js text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
