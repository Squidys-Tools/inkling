{
  "manifest_version": 3,
  "name": "inkling — save to your library",
  "version": "0.1.0",
  "description": "Save the current page to your local inkling library.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Save to inkling",
    "default_icon": {
      "16": "icons/inkling.svg",
      "48": "icons/inkling.svg",
      "128": "icons/inkling.svg"
    }
  },
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "options_page": "options.html",
  "permissions": ["storage", "activeTab", "contextMenus"],
  "host_permissions": ["http://127.0.0.1/*"],
  "icons": {
    "16": "icons/inkling.svg",
    "48": "icons/inkling.svg",
    "128": "icons/inkling.svg"
  }
}
