    onPointerUp={endDrag}\n        onPointerCancel={endDrag}\n      >\n        <img\n          src={displayedSrc}\n          alt={alt}\n          className=\"item-stage-image\"\n          draggable={!isZoomed}\n          onLoad={(event) => {\n            const { naturalWidth, naturalHeight } = event.currentTarget;\n            // Only the first load sets the layout; the original leaves it alone.\n            if (naturalWidth > 0 && naturalHeight > 0) {\n              setNatural((previous) => previous ?? { width: naturalWidth, height: naturalHeight });\n            }\n          }}\n          style={{\n            width: base?.width,\n            height: base?.height,\n            transform: isZoomed\n              ? `translate(${offset.x}px, ${offset.y}px) scale(${zoom / fit})`\n              : undefined,\n            imageRendering: showPixels ? \"pixelated\" : undefined,\n          }}\n        />\n        {showPixels && shown && (\n          <div\n            className=\"item-stage-grid\"\n            style={{\n              width: shown.width,\n              height: shown.height,\n              translate: `calc(-50% + ${offset.x}px) calc(-50% + ${offset.y}px)`,\n              backgroundSize: `${zoom / sourceScale}px ${zoom / sourceScale}px`,\n            }}\n          />\n        )}\n      </div>\n      {ready && (\n        <div className=\"item-zoom-pill glass\">\n          <button\n            type=\"button\"\n            className=\"item-zoom-button\"\n            aria-label=\"Zoom out\"\n            title=\"Zoom out\"\n            disabled={!isZoomed}\n            onClick={() => zoomBy(1 / BUTTON_ZOOM_FACTOR)}\n          >\n            <svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n              <path\n                d=\"M5 12h14\"\n                fill=\"none\"\n                stroke=\"currentColor\"\n                strokeWidth=\"2.2\"\n                strokeLinecap=\"round\"\n              />\n            </svg>\n          </button>\n          <span className=\"item-zoom-label\">{Math.round(zoom * 100)}%</span>\n          <button\n            type=\"button\"\n            className=\"item-zoom-button\"\n            aria-label=\"Zoom in\"\n            title=\"Zoom in\"\n            disabled={!canZoomIn}\n            onClick={() => zoomBy(BUTTON_ZOOM_FACTOR)}\n          >\n            <svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n              <path\n                d=\"M12 5v14M5 12h14\"\n                fill=\"none\"\n                stroke=\"currentColor\"\n                strokeWidth=\"2.2\"\n                strokeLinecap=\"round\"\n              />\n            </svg>\n          </button>\n        </div>\n      )}\n    </>\n  );\n}\n\nfunction OverlayMedia({ item }: { item: LibraryItem }) {\n  if (item.kind === \"Note\" && !item.image) {\n    return (\n      <div className=\"item-stage-art note-detail-media\">\n        <NoteArtwork item={item} />\n      </div>\n    );\n  }\n\n  if (item.social?.provider === \"x\") {\n    return (\n      <div className=\"item-stage-art detail-x-post\">\n        <XPostEmbed\n          key={item.social.postUrl}\n          social={item.social}\n          fallback={\n            item.post ? (\n              <PostArtwork post={item.post} />\n            ) : (\n              <div className=\"detail-art ink\">Post preview unavailable.</div>\n            )\n          }\n        />\n      </div>\n    );\n  }\n\n  if (item.kind === \"Video\") {\n    return (\n      <div className=\"item-stage-art\">\n        <DetailVideoMedia item={item} />\n      </div>\n    );","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"sourceToolAssistantUUID":"f1e9d721-2aa9-484f-9b8d-248147071a35","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"sdk-ts","cwd":"C:\\Users\\chris\\.t3\\worktrees\\inkling\\t3-47ff5304","sessionId":"fad76192-bf94-45bb-9f1a-d29cda113db