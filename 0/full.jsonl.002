{"parentUuid":"c146b01c-07a8-4967-8448-ef8e5dc06eac","isSidechain":false,"attachment":{"type":"file","filename":"C:\\Users\\chris\\.t3\\worktrees\\inkling\\t3-47ff5304\\src\\components\\imageZoom.test.ts","content":{"type":"text","file":{"filePath":"C:\\Users\\chris\\.t3\\worktrees\\inkling\\t3-47ff5304\\src\\components\\imageZoom.test.ts","content":"import { expect, test } from \"bun:test\";\nimport { clampPan, clampZoom, MAX_ZOOM, panAround, wheelZoomFactor } from \"./imageZoom\";\n\ntest(\"zoom stays between the fitted size and the maximum\", () => {\n  expect(clampZoom(0.05, 0.14)).toBe(0.14);\n  expect(clampZoom(100, 0.14)).toBe(MAX_ZOOM);\n  expect(clampZoom(0.5, 0.14)).toBe(0.5);\n});\n\ntest(\"an image that fits above the maximum never zooms below fit\", () => {\n  expect(clampZoom(10, 40)).toBe(40);\n});\n\ntest(\"zooming around a point keeps that point under the cursor\", () => {\n  const anchor = { x: 120, y: -40 };\n  const pan = { x: 10, y: 5 };\n  const next = panAround(pan, anchor, 0.5, 2);\n  // The image point under the anchor, in image pixels, is the same before and after.\n  expect((anchor.x - pan.x) / 0.5).toBeCloseTo((anchor.x - next.x) / 2);\n  expect((anchor.y - pan.y) / 0.5).toBeCloseTo((anchor.y - next.y) / 2);\n});\n\ntest(\"zooming around the centre scales the pan\", () => {\n  expect(panAround({ x: 10, y: -4 }, { x: 0, y: 0 }, 1, 2)).toEqual({ x: 20, y: -8 });\n});\n\ntest(\"wheel down zooms out and wheel up zooms in\", () => {\n  expect(wheelZoomFactor(100)).toBeLessThan(1);\n  expect(wheelZoomFactor(-100)).toBeGreaterThan(1);\n  expect(wheelZoomFactor(100) * wheelZoomFactor(-100)).toBeCloseTo(1);\n});\n\ntest(\"pan stops where the image edge meets the frame\", () => {\n  const shown = { width: 400, height: 100 };\n  const frame = { width: 200, height: 200 };\n  expect(clampPan({ x: 500, y: 50 }, shown, frame)).toEqual({ x: 100, y: 0 });\n});\n","numLines":38,"startLine":1,"totalLines":38}},"displayPath":"src\\components\\imageZoom.test.ts"},"type":"attachment","uuid":"c0f0fcae-3e32-4e28-a111-2c5fad5364e9","timestamp":"2026-10-21T03:40:46.433Z","rendered":[{"content":"<system-reminder>\nCalled the Read tool with the following input: {\"file_path\":\"C:\\\\Users\\\\chris\\\\.t3\\\\worktrees\\\\inkling\\\\t3-47ff5304\\\\src\\\\components\\\\imageZoom.test.ts\"}\n</system-reminder>"},{"content":"<system-reminder>\nResult of calling the Read tool:\n1\timport { expect, test } from \"bun:test\";\n2\timport { clampPan, clampZoom, MAX_ZOOM, panAround, wheelZoomFactor } from \"./imageZoom\";\n3\t\n4\ttest(\"zoom stays between the fitted size and the maximum\", () => {\n5\t  expect(clampZoom(0.05, 0.14)).toBe(0.14);\n6\t  expect(clampZoom(100, 0.14)).toBe(MAX_ZOOM);\n7\t  expect(clampZoom(0.5, 0.14)).toBe(0.5);\n8\t});\n9\t\n10\ttest(\"an image that fits above the maximum never zooms below fit\", () => {\n11\t  expect(clampZoom(10, 40)).toBe(40);\n12\t});\n13\t\n14\ttest(\"zooming around a point keeps that point under the cursor\", () => {\n15\t  const anchor = { x: 120, y: -40 };\n16\t  const pan = { x: 10, y: 5 };\n17\t  const next = panAround(pan, anchor, 0.5, 2);\n18\t  // The image point under the anchor, in image pixels, is the same before and after.\n19\t  expect((anchor.x - pan.x) / 0.5).toBeCloseTo((anchor.x - next.x) / 2);\n20\t  expect((anchor.y - pan.y) / 0.5).toBeCloseTo((anchor.y - next.y) / 2);\n21\t});\n22\t\n23\ttest(\"zooming around the centre scales the pan\", () => {\n24\t  expect(panAround({ x: 10, y: -4 }, { x: 0, y: 0 }, 1, 2)).toEqual({ x: 20, y: -8 });\n25\t});\n26\t\n27\ttest(\"wheel down zooms out and wheel up zooms in\", () => {\n28\t  expect(wheelZoomFactor(100)).toBeLessThan(1);\n29\t  expect(wheelZoomFactor(-100)).toBeGreaterThan(1);\n30\t  expect(wheelZoomFactor(100) * wheelZoomFactor(-100)).toBeCloseTo(1);\n31\t});\n32\t\n33\ttest(\"pan stops where the image edge meets the frame\", () => {\n34\t  const shown = { width: 400, height: 100 };\n35\t  const frame = { width: 200, height: 200 };\n36\t  expect(clampPan({ x: 500, y: 50 }, shown, frame)).toEqual({ x: 100, y: 0 });\n37\t});\n38\t\n</system-reminder>"}],"renderedRole":"system","userType":"external","entrypoint":"sdk-ts","cwd":"C:\\Users\\chris\\.t3\\worktrees\\inkling\\t3-47ff5304","sessionId":"fad76192-bf94-45bb-9f1a-d29cda113db7","version":"2.1.305","gitBranch":"feat/glass-surface","slug":"purrfect-munching-gadget"}
{"parentUuid":"c0f0fcae-3e32-4e28-a111-2c5fad5364e9","isSidechain":false,"attachment":{"type":"file","filename":"C:\\Users\\chris\\.t3\\worktrees\\inkling\\t3-47ff5304\\src\\components\\imageZoom.ts","content":{"type":"text","file":{"filePath":"C:\\Users\\chris\\.t3\\worktrees\\inkling\\t3-47ff5304\\src\\components\\imageZoom.ts","content":"// Zoom is screen pixels per image pixel. It runs continuously from the fitted\n// size up to MAX_ZOOM (3200%).\nexport const MAX_ZOOM = 32;\n// From this zoom on, an image pixel is large enough to read as a square, so the\n// image renders pixelated and the grid appears.\nexport const PIXEL_ZOOM = 8;\n// One button press scales by this much, so each step feels the same size at 20%\n// as at 2000%.\nexport const BUTTON_ZOOM_FACTOR = 1.25;\n// Ctrl+wheel: a typical 100px notch scales by about 1.22.\nconst WHEEL_ZOOM_RATE = 0.002;\n\nexport type Size = { width: number; height: number };\nexport type Offset = { x: number; y: number };\n\nexport function clampZoom(zoom: number, fit: number): number {\n  return Math.min(Math.max(fit, MAX_ZOOM), Math.max(fit, zoom));\n}\n\nexport function wheelZoomFactor(deltaY: number): number {\n  return Math.exp(-deltaY * WHEEL_ZOOM_RATE);\n}\n\n// Pan moves the image only as far as it overhangs the frame, so the frame stays\n// covered. An image smaller than the frame in one axis stays centred on it.\nexport function clampPan(pan: Offset, shown: Size, frame: Size): Offset {\n  const maxX = Math.max(0, (shown.width - frame.width) / 2);\n  const maxY = Math.max(0, (shown.height - frame.height) / 2);\n  return {\n    x: Math.min(maxX, Math.max(-maxX, pan.x)),\n    y: Math.min(maxY, Math.max(-maxY, pan.y)),\n  };\n}\n\n// The pan that keeps the image point under `anchor` (frame-centre coordinates)\n// in place while the zoom changes from `from` to `to`.\nexport function panAround(pan: Offset, anchor: Offset, from: number, to: number): Offset {\n  const ratio = to / from;\n  return {\n    x: anchor.x - (anchor.x - pan.x) * ratio,\n    y: anchor.y - (anchor.y - pan.y) * ratio,\n  };\n}\n","numLines":44,"startLine":1,"totalLines":44}},"displayPath":"src\\components\\imageZoom.ts"},"type":"attachment","uuid":"2c8950ea-b137-4c31-afef-b754357490ee","timestamp":"2026-10-21T03:40:46.433Z","rendered":[{"content":"<system-reminder>\nCalled the Read tool with the following input: {\"file_path\":\"C:\\\\Users\\\\chris\\\\.t3\\\\worktrees\\\\inkling\\\\t3-47ff5304\\\\src\\\\components\\\\imageZoom.ts\"}\n</system-reminder>"},{"content":"<system-reminder>\nResult of calling the Read tool:\n1\t// Zoom is screen pixels per image pixel. It runs continuously from the fitted\n2\t// size up to MAX_ZOOM (3200%).\n3\texport const MAX_ZOOM = 32;\n4\t// From this zoom on, an image pixel is large enough to read as a square, so the\n5\t// image renders pixelated and the grid appears.\n6\texport const PIXEL_ZOOM = 8;\n7\t// One button press scales by this much, so each step feels the same size at 20%\n8\t// as at 2000%.\n9\texport const BUTTON_ZOOM_FACTOR = 1.25;\n10\t// Ctrl+wheel: a typical 100px notch scales by about 1.22.\n11\tconst WHEEL_ZOOM_RATE = 0.002;\n12\t\n13\texport type Size = { width: number; height: number };\n14\texport type Offset = { x: number; y: number };\n15\t\n16\texport function clampZoom(zoom: number, fit: number): number {\n17\t  return Math.min(Math.max(fit, MAX_ZOOM), Math.max(fit, zoom));\n18\t}\n19\t\n20\texport function wheelZoomFactor(deltaY: number): number {\n21\t  return Math.exp(-deltaY * WHEEL_ZOOM_RATE);\n22\t}\n23\t\n24\t// Pan moves the image only as far as it overhangs the frame, so the frame stays\n25\t// covered. An image smaller than the frame in one axis stays centred on it.\n26\texport function clampPan(pan: Offset, shown: Size, frame: Size): Offset {\n27\t  const maxX = Math.max(0, (shown.width - frame.width) / 2);\n28\t  const maxY = Math.max(0, (shown.height - frame.height) / 2);\n29\t  return {\n30\t    x: Math.min(maxX, Math.max(-maxX, pan.x)),\n31\t    y: Math.min(maxY, Math.max(-maxY, pan.y)),\n32\t  };\n33\t}\n34\t\n35\t// The pan that keeps the image point under `anchor` (frame-centre coordinates)\n36\t// in place while the zoom changes from `from` to `to`.\n37\texport function panAround(pan: Offset, anchor: Offset, from: number, to: number): Offset {\n38\t  const ratio = to / from;\n39\t  return {\n40\t    x: anchor.x - (anchor.x - pan.x) * ratio,\n41\t    y: anchor.y - (anchor.y - pan.y) * ratio,\n42\t  };\n43\t}\n44\t\n</system-reminder>"}],"renderedRole":"system","userType":"external","entrypoint":"sdk-ts","cwd":"C:\\Users\\chris\\.t3\\worktrees\\inkling\\t3-47ff5304","sessionId":"fad76192-bf94-45bb-9f1a-d29cda113db7","version":"2.1.305","gitBranch":"feat/glass-surface","slug":"purrfect-munching-gadget"}
