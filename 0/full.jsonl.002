:"bypassPermissions","origin":{"kind":"task-notification","producer":"session-task","runId":"0mvh50tjn-8096323e"},"promptSource":"system","turnOrigin":"task_notification","turnPosition":{"promptIndex":0,"turnIndex":113},"queueSkipAttachments":true,"userType":"external","entrypoint":"sdk-ts","cwd":"C:\\Users\\chris\\.t3\\worktrees\\inkling\\t3-47ff5304","sessionId":"fad76192-bf94-45bb-9f1a-d29cda113db7","version":"2.1.304","gitBranch":"feat/glass-surface","slug":"purrfect-munching-gadget"}
