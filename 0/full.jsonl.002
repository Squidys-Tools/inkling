elled) removeListener();","stderr":"\nShell cwd was reset to C:\\Users\\chris\\.t3\\worktrees\\inkling\\t3-47ff5304","interrupted":false,"isImage":false,"noOutputExpected":false},"sourceToolAssistantUUID":"b07be943-924e-46b2-8826-c75e089dd48f","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"sdk-ts","cwd":"C:\\Users\\chris\\.t3\\worktrees\\inkling\\t3-47ff5304","sessionId":"fad76192-bf94-45bb-9f1a-d29cda113db7","version":"2.1.304","gitBranch":"feat/glass-surface","slug":"purrfect-munching-gadget"}
