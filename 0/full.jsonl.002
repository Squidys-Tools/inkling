n-height: 0;\n  overflow: hidden;\n  position: relative;\n  scrollbar-width: none;\n  -ms-overflow-style: none;\n  margin-top: -52px;\n}\n/* Paper 1.3: the 44px filter row and the grid's 4px top padding put the first\n   card 100px below the toolbar's top. The -52px pull-up above cancels the\n   52px toolbar, so the pinned offset is 100 - 52. */\n.library-scroll.has-pinned-query {\n  margin-top: 48px;\n}\n/* At rest the first row sits just below the toolbar; scrolled cards still pass\n   under the glass. The pinned band already clears the toolbar. */\n.library-scroll:not(.has-pinned-query) .library-grid {\n  padding-top: 52px;\n}\n.history-nav,\n.view-controls {\n  position: relative;\n  display: flex;\n  flex: 0 0 auto;\n  align-items: center;\n  gap: 2px;\n  height: 34px;\n  min-width: 0;\n  margin: 0;\n  padding: 3px;\n  border-radius: 999px;\n}\n.history-button,\n.view-button {\n  display: grid;\n  place-items: center;\n  width: 26px;\n  height: 26px;\n  padding: 0;\n  border: 0;\n  border-radius: 999px;\n  background: transparent;\n  cursor: pointer;\n}\n.history-button {\n  color: var(--library-text-soft);\n  transition: color 0.18s ease;\n}\n.history-button:hover:not(:disabled) {\n  color: var(--ink);\n}\n.history-button:disabled {\n  opacity: 0.35;\n  cursor: default;\n}\n.view-button {\n  position: relative;\n  z-index: 1;\n  color: var(--library-muted);\n  transition:\n    color 0.15s cubic-bezier(0.23, 1, 0.32, 1),\n    transform 0.15s cubic-bezier(0.23, 1, 0.32, 1);\n}\n.view-button.selected {\n  color: var(--library-text);\n}\n.view-button:active {\n  transform: scale(0.96);\n}\n.view-selection {\n  position: absolute;\n  top: 3px;\n  left: 3px;\n  z-index: 0;\n  width: 26px;\n  height: 26px;\n  border-radius: 999px;\n  background: var(--glass-active);\n  pointer-events: none;\n}\n\n.search-field {\n  position: relative;\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  min-width: 0;\n  height: 50px;\n  padding: 0 15px;\n  border-radius: var(--