e={`settings-tab ${settingsTab === \"archive\" ? \"active\" : \"\"}`}\n                      aria-current={settingsTab === \"archive\" ? \"page\" : undefined}\n                      onClick={() => setSettingsTab(\"archive\")}\n                    >\n                      <HugeiconsIcon icon={Archive01Icon} size={16} />\n                      <span>Archive</span>\n                      <span className=\"settings-tab-count\">{archivedItems.length}</span>\n                    </button>\n                    <button\n                      type=\"button\"\n>>>>>>> origin/main\n                      className={`settings-tab ${settingsTab === \"data\" ? \"active\" : \"\"}`}\n                      aria-current={settingsTab === \"data\" ? \"page\" : undefined}\n                      onClick={() => setSettingsTab(\"data\")}\n                    >\n                      <HugeiconsIcon icon={Database02Icon} size={15} />\n                      <span>Library</span>\n                    </button>\n                    <button\n                      type=\"button\"\n                      className={`settings-tab ${settingsTab === \"archive\" ? \"active\" : \"\"}`}\n                      aria-current={settingsTab === \"archive\" ? \"page\" : undefined}\n                      onClick={() => setSettingsTab(\"archive\")}\n                    >\n                      <HugeiconsIcon icon={Archive01Icon} size={15} />\n                      <span>Archive</span>\n                      <span className=\"settings-tab-count\">{archivedItems.length}</span>\n                    </button>\n                    <button\n                      type=\"button\"\n                      className={`settings-tab ${settingsTab === \"extension\" ? \"active\" : \"\"}`}\n                      aria-current={settingsTab === \"extension\" ? \"page\" : undefined}\n                      onClick={() => setSettingsTab(\"extension\")}\n                    >\n                      <HugeiconsIcon icon={Link01Icon} size={15} />\n                      <span>Browser extension</span>\n                    </button>\n                  </div>\n                  <div className=\"settings-sidebar-footer\">\n                    <p>Everything stays on this machine.</p>","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"sourceToolAssistantUUID":"cc6657fe-50aa-4a43-941d-7eefcb853b79","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"sdk-ts","cwd":"C:\\Users\\chris\\.t3\\worktrees\\inkling\\t3-47ff5304","sessionId":"fad76192-bf94-45bb-9f1a-d29cda113db7","version":"2.1.304","gitBranch":"feat/glass-surface","slug":"purrfect-munching-gadget"}
