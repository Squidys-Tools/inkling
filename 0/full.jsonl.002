sor(job, this.storage, this.workerId);\n          this.queue.complete(job.id, this.workerId);\n        } catch (error) {\n          this.queue.fail(\n            job.id,\n            this.workerId,\n            error instanceof Error ? error.message : String(error),\n          );\n        } finally {\n          clearInterval(heartbeat);\n        }\n        if (this.stopped) break;\n        job = claim();\n      }\n    } finally {\n      this.running = false;\n      for (const resolve of this.stopWaiters.splice(0)) resolve();\n    }\n  }\n}\n\nexport function openLibraryStorage(databasePath, options = {}) {\n  const database = resolve(databasePath);\n  mkdirSync(dirname(database), { recursive: true });\n  const { db, fts5Enabled } = openDatabase(database);\n  db.function(\"inkling_unicode_lower\", { deterministic: true }, (value) =>\n    String(value ?? \"\").toLowerCase(),\n  );\n  const jobQueue = new JobQueue(db, options.jobQueue);\n  const library = new LibraryStorage(database, db, fts5Enabled, jobQueue, options);\n  return library;\n}\n\nclass LibraryStorage {\n  constructor(\n    databasePath,\n    db,\n    fts5Enabled,\n    jobs,\n    { createThumbnail, inspectImage, createSnapshot } = {},\n847:  claimNext(workerId, kinds = null) {\n1077:        const claimed = this.queue.claimNext(this.workerId, kinds);\n1080:        return this.queue.claimNext(this.workerId, kinds);\n1082:      let job = claim();\n1103:        job = claim();\nShell cwd was reset to C:\\Users\\chris\\.t3\\worktrees\\inkling\\t3-47ff5304","is_error":false}]},"uuid":"f1e38d24-f7b2-42f7-9240-dbd5daffea60","timestamp":"2026-10-20T21:47:31.493Z","toolUseResult":{"stdout":"      throw error;\n    }\n    for (const row of rows) this.announce(row);\n    return rows.length;\n  }\n}\n\nexport class JobWorker {\n  constructor(\n    storage,\n    { processors = {}, pollInterval = 5000, workerId = randomUUID(), onIdle } = {},\n  ) {\n    this.storage = storage;\n    this.onIdle = onIdle;\n    this.queue =