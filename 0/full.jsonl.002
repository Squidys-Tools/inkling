ce card and dissolves into it, or —\n    // when the source card is no longer mounted — fades out in place.\n    const timeline = gsap.timeline({''','''    if (flight.archive && flight.to) {\n      const timeline = gsap.timeline({\n        onComplete: () => {\n          void Promise.resolve(actionsRef.current.onForget(flight.fromItem)).then(() => {\n            // Still mounted means archiving failed: bring the view back.\n            const current = dialogRef.current;\n            if (!current) return;\n            gsap.set(current, { ...flight.from, opacity: 1, borderRadius: FRAME_RADIUS });\n            setFlight(null);\n          });\n        },\n      });\n      timeline\n        .fromTo(\n          dialog,\n          { ...flight.from },\n          {\n            ...flight.to,\n            borderRadius: cardCorners,\n            duration,\n            ease: OVERLAY_EASE,\n            autoRound: false,\n          },\n          0,\n        )\n        .to(dialog, { opacity: 0, duration: duration * 0.7, ease: \"power1.in\" }, duration * 0.3);\n      return () => {\n        timeline.kill();\n      };\n    }\n\n    // Closing: the view returns to its source card and dissolves into it, or —\n    // when the source card is no longer mounted — fades out in place.\n    const timeline = gsap.timeline({''')\nrep('''                onClick={() => void actions.onForget(shownItem)}''','''                onClick={archiveFromView}''')\nopen(p,'w',encoding='utf-8',newline='').write(s)\nEOF\ngrep -n \"prefersReducedMotion\\|^import.*overlayMotion\" src/components/ExpandedItemOverlay.tsx | head -3","description":"Add archive fade-out flight"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1758,"cache_read_input_tokens":223036,"output_tokens":1723,"output_tokens_details":{"thinking_tokens":356},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"s