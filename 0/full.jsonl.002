%;\n}\n.item-stage-zoom.is-zoomed {\n  cursor: grab;\n  touch-action: none;\n}\n.item-stage-zoom.is-zoomed.is-dragging {\n  cursor: grabbing;\n}\n/* A drop shadow would be recomputed over the whole scaled image on every pan. */\n.item-stage-zoom.is-zoomed .item-stage-image {\n  box-shadow: none;\n}\n.item-stage-grid {\n  position: absolute;\n  top: 50%;\n  left: 50%;\n  pointer-events: none;\n  background-image:\n    linear-gradient(to right, rgba(255, 255, 255, 0.08) 1px, transparent 1px),\n    linear-gradient(to bottom, rgba(255, 255, 255, 0.08) 1px, transparent 1px);\n}\n.item-zoom-pill {\n  position: absolute;\n  bottom: 16px;\n  left: 50%;\n  z-index: 1;\n377:.detail-space-blob.orange {\n378-  color: var(--orange);\n379-}\n380-.space-dot-mark.green,\n381:.detail-space-blob.green {\n382-  color: #7f9a8c;\n383-}\n384-.space-dot-mark.blue,\n385:.detail-space-blob.blue {\n386-  color: #8e9bbf;\n387-}\n388-.space-dot-mark.pink,\n389:.detail-space-blob.pink {\n390-  color: #c98b8b;\n391-}\n392-.space-dot-mark.purple,\n393:.detail-space-blob.purple {\n394-  color: #a88ab5;\n395-}\n396-.space-dot-mark.yellow,\n397:.detail-space-blob.yellow {\n398-  color: #c9b27a;\n399-}\n400-.space-actions {\n401-  width: 0;\n402-  overflow: hidden;\n403-  opacity: 0;\n404-  display: flex;\n405-  flex: 0 0 auto;\n406-  transition: opacity 0.15s ease;\n407-}\n408-.space-item:hover .space-actions,\n409-.space-item:focus-within .space-actions {\n410-  width: 72px;\n411-  margin-left: 10px;\n--\n2092:.detail-space {\n2093-  display: inline-flex;\n2094-  align-items: center;\n2095-  gap: 5px;\n2096-  min-height: 24px;\n2097-  max-width: 100%;\n2098-  min-width: 0;\n2099-  padding: 3px 9px;\n2100-  border: 1px solid #3a3833;\n2101-  border-radius: 999px;\n2102-  background: transparent;\n2103-  color: var(--library-muted);\n2104-  cursor: pointer;\n2105-  font: 10px var(--font-ui);\n2106-  transition:\n--\n2111:.detail-space:hover {\n2112-  color: var(--ink);\n2113-  border-color: #5a5750;\