tyCandidates = useMemo(\nsrc/App.tsx:3521:      isSerendipityView\nsrc/App.tsx:3522:        ? serendipityItems(items, { excludedIds: serendipityKeptIds, limit: items.length })\nsrc/App.tsx:3524:    [isSerendipityView, items, serendipityKeptIds],\nsrc/App.tsx:3526:  const serendipityBatch = useMemo(\nsrc/App.tsx:3527:    () => serendipityCandidates.slice(0, SERENDIPITY_BATCH_SIZE),\nsrc/App.tsx:3528:    [serendipityCandidates],\nsrc/App.tsx:3530:  const serendipityItem = serendipityBatch[0] ?? null;\nsrc/App.tsx:3531:  const serendipityRemainingCount = serendipityCandidates.length;\nsrc/App.tsx:3534:    if (isSerendipityView) return serendipityBatch;\nsrc/App.tsx:3547:        (activeView === \"Top of mind\" && matchesPinsView(item)) ||\nsrc/App.tsx:3562:    isSerendipityView,\nsrc/App.tsx:3566:    serendipityBatch,\nsrc/App.tsx:3570:  const showLibraryEdges = !isSerendipityView && filteredItems.length > 0;\nsrc/App.tsx:3573:  const showFilterRow = !isSerendipityView && !isSearchFocused && query.trim() !== \"\";\nsrc/App.tsx:3577:  // Serendipity is its own walk, and an empty Space has nothing to search or\nsrc/App.tsx:3580:  const showBrowseControls = !isSerendipityView && !isEmptySpace;\nsrc/App.tsx:4348:              className={`nav-item ${activeView === \"Top of mind\" && !activeSpaceId ? \"active\" : \"\"}`}\nsrc/App.tsx:4351:                setActiveView(\"Top of mind\");\nsrc/App.tsx:4359:              <span className=\"nav-label\">Top of mind</span>\nsrc/App.tsx:4364:              className={`nav-item ${activeView === \"Serendipity\" && !activeSpaceId ? \"active\" : \"\"}`}\nsrc/App.tsx:4365:              onClick={selectSerendipityView}\nsrc/App.tsx:4370:              <span className=\"nav-label\">Serendipity</span>\nsrc/App.tsx:4788:              {isSerendipityView ? (\nsrc/App.tsx:4790:                  className=\"serendipity-stage\"\nsrc/App.tsx:4791:                  aria-labelledby=\"serendipity-title\"\nsrc/App.tsx:4792:                  data-testid=\"serendipity-view\"\nsrc/App.tsx:4794:                  <div className=\"serendipity-intro\">\nsrc/App.tsx:4795:                    <div className=\"serendipity-intro-copy\">\nsrc/App.tsx:4796:                      <p className=\"serendipity-eyebrow\">A slower look through your library</p>\nsrc/App.tsx:4797:                      <h1 id=\"serendipity-title\">Something worth finding again?</h1>\nsrc/App.tsx:4800:                    <p className=\"serendipity-progress\" role=\"status\" aria-live=\"polite\">\nsrc/App.tsx:4801:                      {serendipityRemainingCount === 1\nsrc/App.tsx:4803:                        : `${serendipityRemainingCount} older items left`}\nsrc/App.tsx:4807:                  {serendipityItem ? (\nsrc/App.tsx:4808:                    <div className=\"serendipity-browse\">\nsrc/App.tsx:4809:                      <div className=\"serendipity-art\" data-testid=\"serendipity-item\">\nsrc/App.tsx:4812:                            key={String(serendipityItem.id)}\nsrc/App.tsx:4819:                              data={serendipityItem}\nsrc/App.tsx:4826:                      <div className=\"serendipity-copy\">\nsrc/App.tsx:4827:                        <div className=\"serendipity-kicker\">\nsrc/App.tsx:4829:                            <KindIcon kind={serendipityItem.kind} />\nsrc/App.tsx:4830:                            {serendipityItem.kind}\nsrc/App.tsx:4832:                          <span>{serendipityItem.date}</span>\nsrc/App.tsx:4834:                        <h2>{serendipityItem.title}</h2>\nsrc/App.tsx:4835:                        {serendipityItem.description && (\nsrc/App.tsx:4836:                          <p className=\"serendipity-description\">{serendipityItem.description}</p>\nsrc/App.tsx:4838:                        {serendipityItem.tags.length > 0 && (\nsrc/App.tsx:4839:                          <ul className=\"serendipity-tags\" aria-label=\"Tags\">\nsrc/App.tsx:4840:                            {serendipityItem.tags.slice(0, 5).map((tag)