ures from Add, paste, deep links, and the browser extension now appear immediately and enrich the same item through the retryable local job queue."]}]},{"filePath":"C:\\Users\\chris\\.t3\\worktrees\\inkling\\t3-47ff5304\\src\\App.tsx","hunks":[{"oldStart":4644,"oldLines":7,"newStart":4644,"newLines":10,"lines":["         </aside>","         {/* A closed sidebar's tab would sit over an open item's stage. */}","         {(isSidebarOpen || !selectedItem) && (","-          <SidebarEdgeTab isOpen={isSidebarOpen} onToggle={() => setIsSidebarOpen((open) => !open)} />","+          <SidebarEdgeTab","+            isOpen={isSidebarOpen}","+            onToggle={() => setIsSidebarOpen((open) => !open)}","+          />","         )}"," ","         {/* An open item replaces the library, which stays mounted underneath so"]}]}],"moreFiles":0,"changedFiles":["C:\\Users\\chris\\.t3\\worktrees\\inkling\\t3-47ff5304\\docs\\changelog.md","C:\\Users\\chris\\.t3\\worktrees\\inkling\\t3-47ff5304\\src\\App.tsx"]}},"sourceToolAssistantUUID":"e2d60a80-404e-4ff8-a545-de8b3514b310","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"sdk-ts","cwd":"C:\\Users\\chris\\.t3\\worktrees\\inkling\\t3-47ff5304","sessionId":"fad76192-bf94-45bb-9f1a-d29cda113db7","version":"2.1.306","gitBranch":"feat/glass-surface","slug":"purrfect-munching-gadget"}
