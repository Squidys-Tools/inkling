: 0;\n    border-radius: 20px 0 0 20px / 23px 0 0 23px;''')\nrep('''    border-left: 0;\n    border-radius: 0 14px 14px 0;''','''    border-left: 0;\n    border-radius: 0 20px 20px 0 / 0 23px 23px 0;''')\nrep('''  margin: 0 0 0 22px;\n  padding: 0;\n  border-radius: 999px;''','''  margin: 0 0 0 28px;\n  padding: 0;\n  border-radius: 999px;''')\n# resting scroll offset\nrep('''.library-scroll .library-grid {\n  padding-top: calc(var(--scroll-reach-top) + 52px);''','''.library-scroll .library-grid {\n  padding-top: calc(var(--scroll-reach-top) + var(--library-rest-gap));''')\nrep('''.library-scroll {\n  --scroll-reach-top: 12px;''','''.library-scroll {\n  --scroll-reach-top: 12px;\n  /* The gap between the toolbar and the first row. Each result set opens\n     scrolled past it, so rows start at the frame's top edge; scrolling up\n     brings them down to rest below the toolbar. */\n  --library-rest-gap: 52px;''')\nrep('''.library-scroll.has-pinned-query .library-grid {''','''/* Columns stretch so a short result set can still scroll past the gap. */\n.library-scroll .library-grid > * {\n  min-height: calc(100% + var(--library-rest-gap));\n}\n.library-scroll.has-pinned-query .library-grid {''')\nio.open(p,'w',encoding='utf8',newline='').write(s)\nEOF\npython /tmp/edit.py && sed -i 's/  hoverIntensity: 0,\\n//' src/components/LibraryEdgeFade.tsx && grep -n \"libraryScrollRef = \\|ref={libraryScrollRef}\" src/App.tsx"},"caller":{"type":"direct"}}]}}
