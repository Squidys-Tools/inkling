adow: 0 16px 40px rgba(0, 0, 0, 0.5);\n  animation: license-filter-in 0.12s cubic-bezier(0.23, 1, 0.32, 1);\n  transform-origin: top right;\n}\n@keyframes license-filter-in {\n  from {\n    opacity: 0;\n    transform: scale(0.97);\n  }\n}\n.license-filter-options {\n  max-height: 300px;\n  overflow-y: auto;\n  scrollbar-width: thin;\n  scrollbar-color: #4a4842 transparent;\n}\n.license-filter-option,\n.license-filter-clear {\n  width: 100%;\n  height: 32px;\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 0 10px 0 8px;\n  border: 0;\n  border-radius: 8px;\n  background: transparent;\n  color: var(--library-text-soft);\n  cursor: pointer;\n  font: 13px var(--font-ui);\n  text-align: left;\n}\n.license-filter-option:is(:hover, :focus),\n.license-filter-clear:is(:hover, :focus) {\n  outline: 0;\n  background: var(--glass-active);\n  color: var(--library-text);\n}\n.license-filter-check {\n  flex: 0 0 auto;\n  width: 15px;\n  height: 15px;\n  display: grid;\n  place-items: center;\n  border: 1px solid #4a443d;\n  border-radius: 4px;\n  color: var(--library-frame);\n}\n.license-filter-option[aria-checked=\"true\"] .license-filter-check {\n  border-color: var(--library-text);\n  background: var(--library-text);\n}\n.license-filter-label {\n  min-width: 0;\n  flex: 1 1 auto;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.license-filter-count {\n  flex: 0 0 auto;\n  color: var(--library-muted);\n  font: 400 11px / 16px var(--font-mono);\n}\n.license-filter-clear {\n  justify-content: center;\n  margin-top: 5px;\n  box-shadow: 0 -1px 0 var(--library-border);\n  border-radius: 0 0 8px 8px;\n}\n@media (prefers-reduced-motion: reduce) {\n  .license-filter-menu {\n    animation: none;\n  }\n}\n'''\ns=s.replace(anchor,css+anchor,1)\nio.open(p,'w',encoding='utf-8',newline='').write(s)\nEOF\nbunx biome check --write src/components/OpenSourceLicenses src/components/ContextMenu src/components/Tooltip src/App.tsx src/App.css src/Reader