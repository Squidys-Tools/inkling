starter-kit\": \"3.31.4\",\n    \"@virtuoso.dev/masonry\": \"^1.4.3\",\n    \"defuddle\": \"^0.19.5\",\n    \"electron-updater\": \"6.8.9\",\n    \"gsap\": \"^3.15.0\",\n    \"linkedom\": \"^0.18.13\",\n    \"motion\": \"^14.1.0\",\n    \"onnxruntime-node\": \"1.30.0\",\n    \"pdfjs-dist\": \"^6.4.299\",\n    \"react\": \"^19.3.0\",\n    \"react-dom\": \"^19.3.0\",\n    \"sharp\": \"^0.35.5\",\n    \"sonner\": \"^2.0.8\",\n    \"tesseract.js\": \"7.0.0\"\n  },\nAGENTS.md\nCLAUDE.md\nCONTRIBUTING.md\nLICENSE\nREADME.md\nbenchmarks\nbiome.jsonc\nbuild\nbun.lock\ndist\ndocs\nelectron\nextension\nindex.html\nknip.json\nnode_modules\npackage.json\npackages\npatches\npublic\nscripts\nsrc\nt3.json\ntsconfig.json\ntsconfig.node.json\nvercel.json\nvite.config.ts\nLICENSE\nsrc/components/GradualBlur/LICENSE.md\nsrc/components/SegmentedControl/LICENSE.md\nimport { rmSync } from \"node:fs\";\nimport { defineConfig } from \"vite\";\nimport react from \"@vitejs/plugin-react\";\n\n// Vite copies public/ verbatim and offers no exclude list, so the demo seed\n// folder is removed from the output after the copy. Everything else in\n// public/ is still shipped.\nfunction excludeSeedFromAppBuild() {\n  return {\n    name: \"inkling-exclude-demo-seed\",\n    apply: \"build\" as const,\n    closeBundle() {\n      rmSync(new URL(\"./dist/seed-demo\", import.meta.url), {\n        recursive: true,\n        force: true,\n      });\n    },\n  };\n}\n\n// The committed demo seed (public/seed-demo/ + src/seedPersonal.ts) is the\n// default for preview and UI work, and is excluded from the shipped app build.\n// Both halves have to go at build time: a runtime `if` is too late, because\n// Vite has already copied public/ and bundled the seed module by the time any\n// gate runs.\n//\n// Gated on `--mode app` rather than an environment variable, because a\n// `VAR=x` prefix in a package script is not cross-platform on Windows `cmd`.\n// `bun run build:app` is the only thing that passes this mode.\n//\n// https://vite.dev/config/\nexport default defineConfig(async ({ mode }) => {\n  // `app` is the shipped Electron build. Every other mode — dev, and the default\n  // production build used by `vite preview` and the web preview deploy — keeps\n  // the seed.\n  const includeSeed = mode !== \"app\";\n\n  return {\n    plugins: includeSeed ? [react()] : [react(), excludeSeedFromAppBuild()],\n\n    // Read by the seed glob in src/App.tsx. A `define` rather than a runtime\n    // check, so the false branch is dropped and the seed module is never\n    // bundled into a shipped build.\n    define: includeSeed ? {} : { \"import.meta.env.VITE_INKLING_SEED\": JSON.stringify(\"0\") },\n\n    build: {\n      // Electron ships an evergreen Chromium webview, so build for\n      // modern syntax: smaller output, no transpilation helpers, no\n      // modulepreload polyfill. No visual or behavioral effect.\n      target: \"chrome120\",\n      modulePreload: { polyfill: false },\n    },\n  };\n});","is_error":false}]},"uuid":"cd95cce2-f06a-4c07-a63a-1b2de2cb955f","timestamp":"2026-10-21T17:01:52.377Z","toolUseResult":{"stdout":"  \"dependencies\": {\n    \"@fontsource-variable/dm-sans\": \"^5.3.0\",\n    \"@fontsource/arimo\": \"^5.3.0\",\n    \"@fontsource/bitter\": \"^5.3.0\",\n    \"@fontsource/cormorant-garamond\": \"^5.3.0\",\n    \"@fontsource/crimson-pro\": \"^5.3.0\",\n    \"@fontsource/dm-mono\": \"^5.3.0\",\n    \"@fontsource/eb-garamond\": \"^5.3.0\",\n    \"@fontsource/fraunces\": \"^5.3.0\",\n    \"@fontsource/gelasio\": \"^5.3.0\",\n    \"@fontsource/ibm-plex-serif\": \"^5.3.0\",\n    \"@fontsource/inter\": \"^5.3.0\",\n    \"@fontsource/libre-baskerville\": \"^5.3.0\",\n    \"@fontsource/literata\": \"^5.3.0\",\n    \"@fontsource/lora\": \"^5.3.0\",\n    \"@fontsource/newsreader\": \"^5.3.0\",\n    \"@fontsource/noto-sans\": \"^5.3.0\",\n    \"@fontsource/nunito-sans\": \"^5.3.0\",\n    \"@fontsource/playfair-display\": \"^5.3.0\",\n    \"@fontsource/pt-sans\": 