src/App.css:4930:  padding-top: calc(var(--scroll-reach-top) + 100px);\nsrc/App.css:4934:.has-open-item .library-scroll {\nsrc/App.css:4935:  clip-path: inset(var(--scroll-reach-top) 0 var(--scroll-reach-bottom));\nsrc/App.css:4937:.has-open-item .library-edge-blur {\nsrc/App.tsx:4714:          className={`main-content${selectedItem ? \" has-open-item\" : \"\"}`}\n6::root {\n58:  --titlebar-height: 32px;\n5313:.item-stage {\n5322:  --item-stage-surface:\n5324:  background: var(--item-stage-surface);\n5330:.expanded-overlay.is-flying .item-stage {\n5336:.item-stage-image {\n5347:.expanded-overlay.is-flying .item-stage-image {\n5350:.item-stage-art {\n5356:.item-stage-art > *,\n5357:.item-stage-art .detail-art,\n5358:.item-stage-art .post-art {\n5364:.expanded-overlay.is-flying .item-stage-art {\n5369:.item-inspector {\n5383:.expanded-overlay.is-flying .item-inspector {\n5805:.item-stage-zoom {\n5810:.item-stage-zoom.is-zoomed {\n5814:.item-stage-zoom.is-zoomed.is-dragging {\n5818:.item-stage-zoom.is-zoomed .item-stage-image {\n5821:.item-stage-grid {\n5862:  background: var(--item-stage-surface);\n5869:.item-stage-zoom.is-zoomed + .item-zoom-pill .item-zoom-lens-image {","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"sourceToolAssistantUUID":"d68a1645-9f75-4685-9411-8899bee4636e","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"sdk-ts","cwd":"C:\\Users\\chris\\.t3\\worktrees\\inkling\\t3-47ff5304","sessionId":"fad76192-bf94-45bb-9f1a-d29cda113db7","version":"2.1.306","gitBranch":"feat/glass-surface","slug":"purrfect-munching-gadget"}
