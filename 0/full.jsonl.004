{"parentUuid":"bccc3e10-fd5e-418e-9c98-7f509b979560","isSidechain":false,"promptId":"761638c0-aa7a-4fa6-accf-c8ca2c05ada7","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013g2GM21Qns7qkxbDJA6JdF","type":"tool_result","content":"  color: var(--library-muted);\n  font: 400 12px / 16px var(--font-ui);\n}\n.settings-sidebar-footer .settings-sidebar-version {\n  color: #5e5850;\n  font: 400 11px / 14px var(--font-mono);\n}\n.settings-panel {\n  min-width: 0;\n  min-height: 0;\n  display: flex;\n  flex: 1 1 auto;\n  flex-direction: column;\n  gap: 28px;\n  padding: 28px 40px 32px 48px;\n  border: 1px solid var(--library-border);\n  border-right: 0;\n  border-radius: var(--frame-radius) 0 0 var(--frame-radius);\n  background: var(--library-frame);\n}\n.settings-panel-header {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: 24px;\n}\n.settings-panel-header-content {\n  min-width: 0;\n  display: flex;\n  flex: 1 1 auto;\n  flex-direction: column;\n  gap: 8px;\n}\n.settings-panel-header h2 {\n  margin: 0;\n  color: var(--library-text);\n  font: 600 28px / 34px var(--font-sans);\n  letter-spacing: -0.02em;\n}\n.settings-panel-note {\n  max-width: 460px;\n  margin: 0;\n  color: var(--library-muted);\n  font: 400 14px / 21px var(--font-ui);\n}\n.settings-panel-tools {\n  display: flex;\n  flex: 0 0 auto;\n  align-items: center;\n  gap: 8px;\n}\n.settings-close {\n  flex: 0 0 auto;\n  width: 34px;\n  height: 34px;\n  border-color: var(--library-border);\n  border-radius: 999px;\n  color: var(--library-text-soft);\n}\n.settings-archive-actions {\n  min-width: 0;\n  margin: 0;\n  padding: 0;\n  border: 0;\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n.settings-selected-count {\n  color: var(--library-muted);\n  font: 400 12px / 16px var(--font-mono);\n  white-space: nowrap;\n}\n.settings-batch-button,\n.settings-select-button,\n.settings-data-button {\n  height: 34px;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  padding: 0 16px;\n  border: 1px solid #2e2a26;\n  border-radius: 999px;\n  background: transparent;\n  color: var(--library-text);\n  cursor: pointer;\n  font: 400 13px / 16px var(--font-ui);\n  white-space: nowrap;\n  transition:\n    transform 0.18s ease,\n    background 0.18s ease,\n    opacity 0.18s ease;\n}\n.settings-batch-button:hover:not(:disabled),\n.settings-select-button:hover:not(.is-active),\n.settings-data-button:hover:not(:disabled):not(.is-primary) {\n  background: var(--glass-active);\n}\n.settings-batch-button:active:not(:disabled),\n.settings-select-button:active,\n.settings-data-button:active:not(:disabled) {\n  transform: scale(0.96);\n}\n.settings-batch-button:disabled,\n.settings-data-button:disabled {\n  cursor: not-allowed;\n  opacity: 0.42;\n}\n.settings-batch-delete {\n  color: var(--orange);\n}\n.settings-batch-delete:hover:not(:disabled) {\n  border-color: var(--orange);\n}\n.settings-select-button.is-active,\n.settings-data-button.is-primary {\n  border-color: var(--library-text);\n  background: var(--library-text);\n  color: var(--library-surface);\n}\n.settings-data-button.is-primary {\n  font-weight: 600;\n}\n.settings-data-button.is-busy svg {\n  animation: spin 1.2s linear infinite;\n}\n.settings-scroll {\n  min-height: 0;\n  flex: 1 1 auto;\n  display: flex;\n  flex-direction: column;\n  overflow-y: auto;\n  padding-right: 3px;\n  scrollbar-width: thin;\n  scrollbar-color: #4a4842 transparent;\n}\n.settings-scroll > * {\n  flex-shrink: 0;\n}\n.settings-makeup {\n  display: flex;\n  flex-direction: column;\n  gap: 14px;\n  margin-bottom: 28px;\n  padding: 20px 22px;\n  border: 1px solid #221f1c;\n  border-radius: 16px;\n  background: #171513;\n}\n.settings-makeup-head {\n  display: flex;\n  align-items: baseline;\n  justify-content: space-between;\n  gap: 12px;\n}\n.settings-makeup-figures {\n  min-width: 0;\n  display: flex;\n  flex-wrap: wrap;\n  align-items: baseline;\n  g