ses fetches this file beside\r","-// index.html, so the notices stay out of the app bundle until someone looks.\r","-function thirdPartyLicenses(): Plugin {\r","-  const collect = () => collectThirdPartyLicenses(fileURLToPath(new URL(\".\", import.meta.url)));\r","-  return {\r","-    name: \"inkling-third-party-licenses\",\r","-    configureServer(server) {\r","-      server.middlewares.use(`/${LICENSES_FILE}`, (_request, response) => {\r","-        response.setHeader(\"Content-Type\", \"application/json\");\r","-        response.end(JSON.stringify(collect().entries));\r","-      });\r","-    },\r","-    generateBundle() {\r","-      const { entries, warnings } = collect();\r","-      for (const warning of warnings) this.warn(warning);\r","-      this.emitFile({ type: \"asset\", fileName: LICENSES_FILE, source: JSON.stringify(entries) });\r","-    },\r","-  };\r","-}\r","-\r","-// Vite copies public/ verbatim and offers no exclude list, so the demo seed\r","-// folder is removed from the output after the copy. Everything else in\r","-// public/ is still shipped.\r","-function excludeSeedFromAppBuild() {\r","-  return {\r","-    name: \"inkling-exclude-demo-seed\",\r","-    apply: \"build\" as const,\r","-    closeBundle() {\r","-      rmSync(new URL(\"./dist/seed-demo\", import.meta.url), {\r","-        recursive: true,\r","-        force: true,\r","-      });\r","-    },\r","-  };\r","-}\r","-\r","-// The committed demo seed (public/seed-demo/ + src/seedPersonal.ts) is the\r","-// default for preview and UI work, and is excluded from the shipped app build.\r","-// Both halves have to go at build time: a runtime `if` is too late, because\r","-// Vite has already copied public/ and bundled the seed module by the time any\r","-// gate runs.\r","-//\r","-// Gated on `--mode app` rather than an environment variable, because a\r","-// `VAR=x` prefix in a package script is not cross-platform on Windows `cmd`.\r","-// `bun run build:app` is the only thing that passes this mode.\r","-//\r","-// https://vite.dev/config/\r","-export default defineConfig(async ({ mode }) => {\r","-  // `app` is the shipped Electron build. Every other mode — dev, and the default\r","-  // production build used by `vite preview` and the web preview deploy — keeps\r","-  // the seed.\r","-  const includeSeed = mode !== \"app\";\r","-\r","-  return {\r","-    plugins: includeSeed\r","-      ? [react(), thirdPartyLicenses()]\r","-      : [react(), thirdPartyLicenses(), excludeSeedFromAppBuild()],\r","-\r","-    // Read by the seed glob in src/App.tsx. A `define` rather than a runtime\r","-    // check, so the false branch is dropped and the seed module is never\r","-    // bundled into a shipped build.\r","-    define: includeSeed ? {} : { \"import.meta.env.VITE_INKLING_SEED\": JSON.stringify(\"0\") },\r","-\r","-    build: {\r","-      // Electron ships an evergreen Chromium webview, so build for\r","-      // modern syntax: smaller output, no transpilation helpers, no\r","-      // modulepreload polyfill. No visual or behavioral effect.\r","-      target: \"chrome120\",\r","-      modulePreload: { polyfill: false },\r","-    },\r","-  };\r","-});\r","+import { rmSync } from \"node:fs\";","+import { fileURLToPath } from \"node:url\";","+import { defineConfig, type Plugin } from \"vite\";","+import react from \"@vitejs/plugin-react\";","+import { collectThirdPartyLicenses } from \"./scripts/third-party-licenses/collect.mjs\";","+","+const LICENSES_FILE = \"third-party-licenses.json\";","+","+// Settings → General → Open source licenses fetches this file beside","+// index.html, so the notices stay out of the app bundle until someone looks.","+function thirdPartyLicenses(): Plugin {","+  const collect = () => collectThirdPartyLicenses(fileURLToPath(new URL(\".\", import.meta.url)));","+  return {","+    name: \"inkling-third-party-licenses\",","+    configureServer(server) {","+      server.middlewares.use(`/${LICENSES_FILE}`, (_request, response) => {","+        response.setHeader(\"Content-Type\", \"application/json\");","+        response.end(JSON.stringify(collect().entries));","+      });","+    },","+    generateBundle() {","+      const { entries, warnings } = collect();","+      for (const warning of warnings) this.warn(warning);","+      this.emitFile({ type: \"asset\", fileName: LICENSES_FILE, source: JSON.stringify(entries) });","+    },","+  };","+}","+","+// Vite copies public/ verbatim and offers no exclude list, so the demo seed","+// folder is removed from the output after the copy. Everything else in","+// public/ is still shipped.","+function excludeSeedFromAppBuild() {","+  return {","+    name: \"inkling-exclude-demo-seed\",","+    apply: \"build\" as const,","+    closeBundle() {","+      rmSync(new URL(\"./dist/seed-demo\", import.meta.url), {","+        recursive: true,","+        force: true,","+      });","+    },","+  };","+}","+","+// The committed demo seed (public/seed-demo/ + src/seedPersonal.ts) is the","+// default for preview and UI work, and is excluded from the shipped app build.","+// Both halves have to go at build time: a runtime `if` is too late, because","+// Vite has already copied public/ and bundled the seed module by the time any","+// gate runs.","+//","+// Gated on `--mode app` rather than an environment variable, because a","+// `VAR=x` prefix in a package script is not cross-platform on Windows `cmd`.","+// `bun run build:app` is the only thing that passes this mode.","+//","+// https://vite.dev/config/","+export default defineConfig(async ({ mode }) => {","+  // `app` is the shipped Electron build. Every other mode — dev, and the default","+  // production build used by `vite preview` and the web preview deploy — keeps","+  // the seed.","+  const includeSeed = mode !== \"app\";","+","+  return {","+    plugins: includeSeed","+      ? [react(), thirdPartyLicenses()]","+      : [react(), thirdPartyLicenses(), excludeSeedFromAppBuild()],","+","+    // Read by the seed glob in src/App.tsx. A `define` rather than a runtime","+    // check, so the false branch is dropped and the seed module is never","+    // bundled into a shipped build.","+    define: includeSeed ? {} : { \"import.meta.env.VITE_INKLING_SEED\": JSON.stringify(\"0\") },","+","+    build: {","+      // Electron ships an evergreen Chromium webview, so build for","+      // modern syntax: smaller output, no transpilation helpers, no","+      // modulepreload polyfill. No visual or behavioral effect.","+      target: \"chrome120\",","+      modulePreload: { polyfill: false },","+    },","+  };","+});"]}]}],"moreFiles":1,"changedFiles":["C:\\Users\\chris\\.t3\\worktrees\\inkling\\t3-47ff5304\\scripts\\third-party-licenses\\collect.mjs","C:\\Users\\chris\\.t3\\worktrees\\inkling\\t3-47ff5304\\src\\App.tsx","C:\\Users\\chris\\.t3\\worktrees\\inkling\\t3-47ff5304\\src\\components\\OpenSourceLicenses\\OpenSourceLicenses.tsx","C:\\Users\\chris\\.t3\\worktrees\\inkling\\t3-47ff5304\\tsconfig.node.tsbuildinfo","C:\\Users\\chris\\.t3\\worktrees\\inkling\\t3-47ff5304\\vite.config.ts"]}},"sourceToolAssistantUUID":"e6ac4b3f-47b4-42ea-bc0b-5bb2fe6df65b","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"sdk-ts","cwd":"C:\\Users\\chris\\.t3\\worktrees\\inkling\\t3-47ff5304","sessionId":"fad76192-bf94-45bb-9f1a-d29cda113db7","version":"2.1.306","gitBranch":"feat/glass-surface","slug":"purrfect-munching-gadget"}
