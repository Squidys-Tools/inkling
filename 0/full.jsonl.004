if (!isAdding) return;\n    const previouslyFocused = captureReturnFocusRef.current;\n    const dialog = captureModalRef.current;\n    const onKeyDown = (event: KeyboardEvent) => {\n      if (dialog) keepTabFocusInside(event, dialog);\n    };\n    document.addEventListener(\"keydown\", onKeyDown);\n    return () => {\n      document.removeEventListener(\"keydown\", onKeyDown);\n      previouslyFocused?.focus();\n    };\n  }, [isAdding]);\n\n  useEffect(() => {\n    if (!isAdding) return;\n    const selector =\n      captureMode === \"file\" ? \".file-picker\" : captureMode ? \"[autofocus]\" : \".capture-option\";\n    captureModalRef.current?.querySelector<HTMLElement>(selector)?.focus();\n  }, [captureMode, isAdding]);\n\n''','')\nr('''      await persistFile(file, captureSource);\n      setSelectedFile(null);\n      setIsAdding(false);''','''      await persistFile(file, captureSource);\n      setIsAdding(false);''')\nr('''      await persistArticle(sourceUrl, captureSource, extensionTitle);\n      setCaptureUrl(\"\");\n      setIsAdding(false);''','''      await persistArticle(sourceUrl, captureSource, extensionTitle);\n      setIsAdding(false);''')\n# saveCapture .. openCaptureModal block\ni=s.index('  async function saveCapture(event: React.FormEvent) {')\nj=s.index('  function closeCaptureModal() {')\ns=s[:i]+'''  // Saves from the Add menu. The card appears at once; the menu closes on\n  // success and keeps the draft when the save fails.\n  async function saveFromAddMenu(save: () => Promise<unknown>) {\n    setCaptureError(null);\n    try {\n      await save();\n      setIsAdding(false);\n      setCaptureMode(null);\n      return true;\n    } catch (error) {\n      setCaptureError(error instanceof Error ? error.message : String(error));\n      return false;\n    }\n  }\n\n  // Add lives in the sidebar, so opening it brings the sidebar out.\n  function openCapture(mode: AddMode | null = null) {\n    setCaptureError(null);\n    setCaptureMode(mode);\n    setIsAdding(true);\n    setIsSidebarOpen(true);\n  }\n\n'''+s[j:]\nr('''    setIsAdding(false);\n    setCaptureMode(null);\n    setSelectedFile(null);\n  }''','''    setIsAdding(false);\n    setCaptureMode(null);\n  }''')\n# sidebar add button\ni=s.index('''            <button\n              type=\"button\"\n              className=\"add-button\"\n              onClick={openCaptureModal}''')\nj=s.index('</button>',i)+len('</button>')\ns=s[:i]+'''            <AddMenu\n              open={isAdding}\n              mode={captureMode}\n              saving={isCapturing}\n              error={isAdding ? captureError : null}\n              onOpen={() => openCapture()}\n              onClose={closeCaptureModal}\n              onModeChange={(mode) => {\n                setCaptureMode(mode);\n                setCaptureError(null);\n              }}\n              onSaveNote={(text) => saveFromAddMenu(() => persistText(text, \"quick note\"))}\n              onSaveLink={(url) => saveFromAddMenu(() => persistArticle(url, \"quick link\"))}\n              onSaveQuote={(text, attribution, sourceUrl) =>\n                saveFromAddMenu(() => persistQuote(text, attribution, sourceUrl, \"quick quote\"))\n              }\n              onPickFile={(file) => void captureFile(file, \"file picker\")}\n              onScreenshot={startScreenshotCapture}\n            />'''+s[j:]\n# compact add\ni=s.index('''            {!isSidebarOpen && (\n              <button\n                type=\"button\"\n                className=\"add-button is-compact\"''')\nj=s.index('            )}\\n',i)+len('            )}\\n')\ns=s[:i]+s[j:]\n# modal\ni=s.index('''        <AnimatePresence>\n          {isAdding && (\n            <motion.div\n              key=\"capture-modal\"''')\nj=s.index('        </AnimatePresence>\\n',i)+len('        </AnimatePresence>\\n')\ns=s[:i]+s[j:].lstrip('\\n')\ns=s.replace('import { TooltipLayer } from \"./components/Tooltip/TooltipLayer\";','import { TooltipLayer } from \"./component