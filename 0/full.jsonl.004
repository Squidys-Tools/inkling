px 2px 10px;\n72\t  border: 0;\n73\t  border-radius: 12px;\n74\t  background: transparent;\n75\t  color: var(--library-muted);\n76\t  cursor: pointer;\n77\t  transition:\n78\t    background 0.18s ease,\n79\t    color 0.18s ease;\n80\t}\n81\t.add-menu-tile span {\n82\t  max-width: 100%;\n83\t  overflow: hidden;\n84\t  color: var(--library-text-soft);\n85\t  font: 500 12px / 15px var(--font-ui);\n86\t  text-overflow: ellipsis;\n87\t  white-space: nowrap;\n88\t}\n89\t.add-menu-tile:hover:not(:disabled),\n90\t.add-menu-tile:focus-visible {\n91\t  outline: 0;\n92\t  background: var(--glass-active);\n93\t  color: var(--library-text);\n94\t}\n95\t.add-menu-tile:disabled {\n96\t  cursor: wait;\n97\t  opacity: 0.5;\n98\t}\n99\t.add-menu-form {\n100\t  display: grid;\n101\t  gap: 6px;\n102\t}\n103\t.add-menu-form input,\n104\t.add-menu-form textarea {\n105\t  width: 100%;\n106\t  min-width: 0;\n107\t  padding: 9px 10px;\n108\t  border: 1px solid var(--library-border);\n109\t  border-radius: 9px;\n110\t  outline: 0;\n111\t  background: var(--library-surface);\n112\t  color: var(--library-text);\n113\t  font: 13px / 18px var(--font-ui);\n114\t  transition: border-color 0.18s ease;\n115\t}\n116\t.add-menu-form textarea {\n117\t  min-height: 72px;\n118\t  max-height: 160px;\n119\t  resize: vertical;\n120\t}\n121\t.add-menu-form :is(input, textarea):focus {\n122\t  border-color: #4a443d;\n123\t}\n124\t.add-menu-form :is(input, textarea)::placeholder {\n125\t  color: #5e5850;\n126\t}\n127\t.add-menu-save {\n128\t  height: 34px;\n129\t  margin-top: 2px;\n130\t  border: 0;\n131\t  border-radius: 9px;\n132\t  background: var(--library-text);\n133\t  color: var(--library-canvas);\n134\t  cursor: pointer;\n135\t  font: 600 13px / 16px var(--font-ui);\n136\t  transition: background 0.18s ease;\n137\t}\n138\t.add-menu-save:hover:not(:disabled) {\n139\t  background: #f2ece1;\n140\t}\n141\t.add-menu-save:disabled {\n142\t  cursor: wait;\n143\t  opacity: 0.65;\n144\t}\n145\t.add-menu-error {\n146\t  margin: 6px 4px 2px;\n147\t  color: #e08a6a;\n148\t  font: 12px / 16px var(--font-ui);\n149\t}\n150\t\n</system-reminder>"}],"renderedRole":"system","userType":"external","entrypoint":"sdk-ts","cwd":"C:\\Users\\chris\\.t3\\worktrees\\inkling\\t3-47ff5304","sessionId":"fad76192-bf94-45bb-9f1a-d29cda113db7","version":"2.1.306","gitBranch":"feat/glass-surface","slug":"purrfect-munching-gadget"}
