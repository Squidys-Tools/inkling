  align-items: center;\n  gap: 18px;\n  padding: 20px 2px;\n}\n.settings-data-row:not(:last-of-type) {\n  border-bottom: 1px solid #1e1b19;\n}\n.settings-data-icon {\n  display: grid;\n  flex: 0 0 auto;\n  place-items: center;\n  width: 36px;\n  height: 36px;\n  border-radius: 11px;\n  background: var(--library-surface-raised);\n  color: var(--library-text);\n}\n.settings-data-text {\n  display: flex;\n  flex: 1 1 auto;\n  flex-direction: column;\n  gap: 4px;\n  min-width: 0;\n}\n.settings-data-text h3 {\n  margin: 0;\n  color: var(--library-text);\n  font: 600 15px / 20px var(--font-ui);\n}\n.settings-data-text p {\n  margin: 0;\n  color: var(--library-muted);\n  font: 400 13px / 19px var(--font-ui);\n}\n.settings-data-text .settings-data-copy {\n  color: #6f685f;\n  font: 400 11px / 14px var(--font-mono);\n}\n.settings-data-text .settings-data-hint {\n  color: var(--library-muted);\n  font: 400 12px / 16px var(--font-ui);\n}\n.settings-data-result {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n  padding: 12px 14px;\n  border: 1px solid #221f1c;\n  border-radius: 10px;\n}\n.settings-data-summary {\n  color: var(--library-text-soft);\n  font: 500 12px / 16px var(--font-ui);\n}\n.settings-data-path {\n  color: var(--library-muted);\n  font: 400 11px / 14px var(--font-mono);\n  overflow-wrap: anywhere;\n}\n.settings-pairing {\n  display: flex;\n  flex-direction: column;\n  gap: 16px;\n  max-width: 560px;\n}\n.settings-pairing-row {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 10px;\n}\n.settings-pairing-status {\n  color: var(--library-muted);\n  font: 400 12px / 16px var(--font-ui);\n}\n.settings-token {\n  flex: 1 1 220px;\n  min-width: 0;\n  padding: 9px 12px;\n  border: 1px solid #221f1c;\n  border-radius: 10px;\n  background: var(--library-surface);\n  color: var(--library-text-soft);\n  font: 400 12px / 16px var(--font-mono);\n  letter-spacing: 0.02em;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;