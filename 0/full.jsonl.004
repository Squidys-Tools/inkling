es-row-head {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n.licenses-row-toggle {\n  min-width: 0;\n  flex: 1 1 auto;\n  display: flex;\n  align-items: baseline;\n  gap: 10px;\n  padding: 13px 2px;\n  border: 0;\n  background: transparent;\n  color: var(--library-text);\n  cursor: pointer;\n  text-align: left;\n}\n.licenses-chevron {\n  flex: 0 0 auto;\n  align-self: center;\n  color: var(--library-muted);\n  transition: rotate 0.18s ease;\n}\n.licenses-row[data-open] .licenses-chevron {\n  rotate: 90deg;\n}\n.licenses-name {\n  min-width: 0;\n  overflow: hidden;\n  font: 500 14px / 18px var(--font-ui);\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.licenses-version {\n  flex: 0 0 auto;\n  color: var(--library-muted);\n  font: 400 12px / 16px var(--font-mono);\n}\n.licenses-id {\n  min-width: 0;\n  margin-left: auto;\n  overflow: hidden;\n  color: var(--library-text-soft);\n  font: 400 11px / 16px var(--font-mono);\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.licenses-source {\n  flex: 0 0 auto;\n  width: 28px;\n  height: 28px;\n  border-radius: 999px;\n}\n.licenses-source:hover {\n  border-color: transparent;\n  background: var(--glass-active);\n  color: var(--library-text);\n}\n.licenses-body {\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n  padding: 0 2px 16px 25px;\n}\n.licenses-body p {\n  margin: 0;\n  color: var(--library-muted);\n  font: 400 13px / 19px var(--font-ui);\n}\n.licenses-body pre {\n  max-height: 320px;\n  margin: 0;\n  padding: 14px 16px;\n  overflow: auto;\n  border: 1px solid #221f1c;\n  border-radius: 10px;\n  background: var(--library-surface);\n  color: var(--library-text-soft);\n  font: 400 11px / 17px var(--font-mono);\n  white-space: pre-wrap;\n  overflow-wrap: anywhere;\n  scrollbar-width: thin;\n  scrollbar-color: #4a4842 transparent;\n}\n.licenses-empty {\n  margin: 0;\n  padding: 20px 2px;\n  color: var(--library-muted);\n  font: 400 13px / 19px var(--font-ui);\n}\n"},"caller":{"type"