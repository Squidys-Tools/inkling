241c16;\n  --color-green: #7fa08d;\n  --color-green-soft: #26332c;\n  --color-blue-soft: #243136;\n  --color-yellow-soft: #3a3524;\n  --color-glass-fill: rgba(12, 11, 10, 0.62);\n  --color-glass-active: rgba(255, 255, 255, 0.08);\n  --color-space-orange: var(--color-accent);\n  --color-space-green: #7f9a8c;\n  --color-space-blue: #8e9bbf;\n  --color-space-pink: #c98b8b;\n  --color-space-purple: #a88ab5;\n  --color-space-yellow: #c9b27a;\n\n  --radius-button: 9px;\n  --radius-row: 9px;\n  --radius-toggle: 12px;\n  --radius-tile: 12px;\n  --radius-sidebar: 14px;\n  --radius-frame: 16px;\n  --radius-card: 20px;\n  --radius-search: 20px;\n  --radius-overlay: 24px;\n\n  --font-sans: \"DM Sans Variable\", \"DM Sans\", system-ui, sans-serif;\n  --font-mono: \"DM Mono\", ui-monospace, monospace;\n  --font-body: system-ui, -apple-system, \"Segoe UI\", sans-serif;\n  --font-quote: \"Libre Baskerville\", Georgia, serif;\n\n  --spacing-component: 16px;\n  --spacing-sidebar: 232px;\n  --spacing-titlebar: 32px;\n  --spacing-topbar: 56px;\n\n  --breakpoint-wide: 781px;\n\n  --animate-mascot-bob: mascot-bob 0.9s ease-in-out infinite;\n  @keyframes mascot-bob {\n    0%,\n    100% {\n      transform: translateY(0);\n    }\n    50% {\n      transform: translateY(-1.5px);\n    }\n  }\n}\n\n:root {\n  --glass-filter: blur(18px) saturate(140%) brightness(0.7);\n}\n\n@layer base {\n  :root {\n    interpolate-size: allow-keywords;\n    font-family: var(--font-body);\n    color: var(--color-ink);\n    background: var(--color-canvas);\n    color-scheme: dark;\n    font-synthesis: none;\n    text-rendering: optimizeLegibility;\n    -webkit-font-smoothing: antialiased;\n  }\n  * {\n    box-sizing: border-box;\n  }\n  html,\n  body,\n  #root {\n    height: 100%;\n  }\n  body {\n    margin: 0;\n    min-width: 320px;\n    min-height: 100vh;\n    overflow: hidden;\n  }\n  button,\n  input {\n    font: inherit;\n  }\n  button {\n    color: inherit;\n    padding: 0;\n  }\n  /* Under the utilities la