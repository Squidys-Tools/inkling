{"type":"ai-title","aiTitle":"Inkling redesign inspired by resurf.so","sessionId":"fad76192-bf94-45bb-9f1a-d29cda113db7"}
{"type":"mode","mode":"normal","sessionId":"fad76192-bf94-45bb-9f1a-d29cda113db7"}
