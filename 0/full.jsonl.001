 Where the toolbar row starts; the library scroller starts here too. */\n67\t  --library-top: var(--main-pad-top);\n68\t  --stage-background: var(--color-canvas);\n69\t  width: auto;\n70\t  height: 100vh;\n71\t  min-width: 0;\n72\t  min-height: 0;\n73\t  flex: 1 1 auto;\n74\t  display: flex;\n75\t  flex-direction: column;\n76\t  padding: var(--main-pad-top) var(--main-pad-x) var(--main-pad-bottom);\n77\t  position: relative;\n78\t  overflow: hidden;\n79\t  transition: padding 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n80\t}\n81\t@media (min-width: 781px) {\n82\t  /* The sidebar holds still underneath and the library frame slides over it, so\n83\t     only the frame's left edge moves. */\n84\t  .main-content {\n85\t    margin-left: var(--spacing-sidebar);\n86\t    transition:\n87\t      margin-left 0.3s cubic-bezier(0.4, 0, 0.2, 1),\n88\t      padding 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n89\t  }\n90\t  .main-content.is-sidebar-closed {\n91\t    margin-left: 0;\n92\t  }\n93\t  .main-content {\n94\t    --stage-background: var(--color-frame);\n95\t    border: 1px solid var(--color-border);\n96\t    border-right: 0;\n97\t    border-radius: var(--radius-frame) 0 0 var(--radius-frame);\n98\t    background: var(--color-frame);\n99\t  }\n100\t}\n101\t\n102\t.paper-blue {\n103\t  background: var(--color-blue-soft);\n104\t}\n105\t.paper-green {\n106\t  background: var(--color-green-soft);\n107\t}\n108\t.paper-yellow {\n109\t  background: var(--color-yellow-soft);\n110\t}\n111\t.text-button {\n112\t  border: 0;\n113\t  background: none;\n114\t  color: var(--color-accent);\n115\t  cursor: pointer;\n116\t  font-size: 13px;\n117\t  text-decoration: underline;\n118\t  text-underline-offset: 3px;\n119\t}\n120\t.library-header {\n121\t  padding: 0;\n122\t  flex: 0 0 auto;\n123\t}\n124\t@media (max-width: 1120px) {\n125\t  :root {\n126\t    --spacing-sidebar: 220px;\n127\t  }\n128\t  .main-content {\n129\t    width: calc(100vw - var(--spacing-sidebar));\n130\t  }\n131\t}\n132\t@media (max-width: 780px) {\n133\t  .main-content {\n134\t    --main-pad-top: 12px;\n135\t    --main-pad-x: 18px;\n136\t    --main-pad-bottom: 24px;\n137\t    /* Below the 30px library-header padding. */\n138\t    --library-top: 42px;\n139\t    width: 100%;\n140\t    transition: none;\n141\t  }\n142\t  .library-header {\n143\t    display: block;\n144\t    padding-top: 30px;\n145\t  }\n146\t}\n147\t\n148\t.visually-hidden {\n149\t  position: absolute;\n150\t  width: 1px;\n151\t  height: 1px;\n152\t  overflow: hidden;\n153\t  clip: rect(0 0 0 0);\n154\t  white-space: nowrap;\n155\t  clip-path: inset(50%);\n156\t}\n157\t@keyframes spin {\n158\t  to {\n159\t    transform: rotate(360deg);\n160\t  }\n161\t}\n162\t@media (prefers-reduced-motion: reduce) {\n163\t  *,\n164\t  *::before,\n165\t  *::after {\n166\t    animation-duration: 0.01ms !important;\n167\t    transition-duration: 0.01ms !important;\n168\t  }\n169\t}\n170\t\n171\t[data-sonner-toast][data-styled=\"true\"] [data-close-button] {\n172\t  left: auto;\n173\t  right: 0;\n174\t  width: 22px;\n175\t  height: 22px;\n176\t  transform: translate(35%, -35%);\n177\t}\n178\t[data-sonner-toast] [data-icon]:empty {\n179\t  display: none !important;\n180\t}\n181\t[data-sonner-toaster][data-sonner-theme=\"dark\"] [data-sonner-toast][data-styled=\"true\"] {\n182\t  background: var(--color-surface-raised) !important;\n183\t  color: var(--color-ink);\n184\t}\n185\t[data-sonner-toaster][data-sonner-theme=\"dark\"]\n186\t  [data-sonner-toast][data-styled=\"true\"]\n187\t  [data-close-button] {\n188\t  background: var(--color-surface-raised) !important;\n189\t  border: 1px solid var(--color-border) !important;\n190\t}\n191\t\n192\t/* Drawer label — action toasts (Undo, persistent choices). Slim catalog slip. */\n193\t.library-toast[data-sonner-toast] {\n194\t  width: min(420px, calc(100vw - 32px));\n195\t  padding: 12px 14px;\n196\t  border: 0;\n197\t  border-radius: var(--radius-toggle);\n198\t  background: var(--color-surface-raised);\n199\t 