ation-duration: 0.01ms !important;\n    transition-duration: 0.01ms !important;\n  }\n}\n'''\nopen(p,'w',encoding='utf-8',newline='\\n').write(s)\np='src/ui/Surface.css'\ns=open(p,encoding='utf-8').read()\ns=s.replace('/* Unlayered like App.css, so the glass still beats the remaining legacy rules. */','/* Unlayered, so it beats utilities on the same element; override with `!`. */')\nopen(p,'w',encoding='utf-8',newline='\\n').write(s)\nEOF\ngit diff --stat; file src/index.css src/main.tsx","description":"Move globals and fonts out of App.css"},"caller":{"type":"direct"}}]}}
