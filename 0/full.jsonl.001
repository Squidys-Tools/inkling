": 340,\n      \"worldX\": 4560,\n      \"worldY\": 1460\n    }\n  ],\n  \"pages\": [\n    {\n      \"type\": \"page\",\n      \"id\": \"p-3-0\",\n      \"name\": \"screens\",\n      \"icon\": null,\n      \"isActive\": false\n    },\n    {\n      \"type\": \"page\",\n      \"id\": \"p-6-0\",\n      \"name\": \"resurf redesign\",\n      \"icon\": \"design\",\n      \"isActive\": true\n    },\n    {\n      \"type\": \"page\",\n      \"id\": \"p-5-1\",\n      \"name\": \"references\",\n      \"icon\": null,\n      \"isActive\": false\n    },\n    {\n      \"type\": \"page\",\n      \"id\": \"p-4-1\",\n      \"name\": \"extension\",\n      \"icon\": null,\n      \"isActive\": false\n    },\n    {\n      \"type\": \"page\",\n      \"id\": \"p-1-0\",\n      \"name\": \"tokens\",\n      \"icon\": null,\n      \"isActive\": false\n    }\n  ],\n  \"fontFamilies\": [\n    \"DM Sans\",\n    \"DM Mono\",\n    \"Georgia\",\n    \"Gloria Hallelujah\",\n    \"System Sans-Serif\",\n    \"Libre Baskerville\"\n  ],\n  \"tokens\": {\n    \"items\": [\n      {\n        \"name\": \"--library-accent\",\n        \"value\": \"#B0714F\"\n      },\n      {\n        \"name\": \"--library-border\",\n        \"value\": \"#262221\"\n      },\n      {\n        \"name\": \"--library-canvas\",\n        \"value\": \"#0C0C0B\"\n      },\n      {\n        \"name\": \"--library-muted\",\n        \"value\": \"#8D867C\"\n      },\n      {\n        \"name\": \"--library-surface\",\n        \"value\": \"#161412\"\n      },\n      {\n        \"name\": \"--library-surface-raised\",\n        \"value\": \"#1B1917\"\n      },\n      {\n        \"name\": \"--library-text\",\n        \"value\": \"#E5DDD2\"\n      },\n      {\n        \"name\": \"--app-background\",\n        \"value\": \"#0A0A09\"\n      },\n      {\n        \"name\": \"--library-frame\",\n        \"value\": \"#0D0C0B\"\n      },\n      {\n        \"name\": \"--library-text-soft\",\n        \"value\": \"#C9C1B6\"\n      },\n      {\n        \"nam