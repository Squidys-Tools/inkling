scape\");\nawait settle();\nawait c.ev(`document.querySelector('button[aria-label=\"Close details\"]')?.focus(); true`);\nawait c.key(\"Escape\");\nawait c.until(`!document.querySelector(\".expanded-overlay\")`, 8000).catch(() => (log.viewStillOpen = true));\nawait settle();\n\n// Shortcuts dialog: focus moves in, Escape returns it.\nawait c.ev(`document.querySelector('button[aria-label=\"Settings\"]').focus(); true`);\nawait c.key(\"?\");\nawait c.until(`document.querySelector('[role=dialog]')`, 5000);\nawait settle();\nawait c.shot(\"shortcuts.png\");\nlog.shortcutsFocus = await active();\nawait c.key(\"Escape\");\nawait c.until(`!document.querySelector('[role=dialog]')`, 5000);\nlog.shortcutsReturn = await active();\n\n// Settings tabs by keyboard, then Escape back to the Settings button.\nawait c.ev(`document.querySelector('button[aria-label=\"Settings\"]').click(); true`);\nawait c.until(`document.querySelector('[role=tab]')`, 8000);\nawait settle();\nawait c.ev(`document.querySelector('[role=tab][aria-selected=true]').focus(); true`);\nawait c.key(\"ArrowDown\");\nawait c.key(\"ArrowRight\");\nawait settle();\nlog.settingsTab = await c.ev(`document.querySelector('[role=tab][aria-selected=true]')?.textContent`);\nawait c.shot(\"settings.png\");\nawait c.key(\"Escape\");\nawait c.until(`!document.querySelector('[role=tab]')`, 5000);\nlog.settingsReturn = await active();\n\n// Archive the note from its menu: the undo toast.\nawait openMenu(\"squ132 note\");\nawait c.until(`document.querySelector('[role=menu]')`, 5000);\nawait clickText(\"[role=menuitem]\", \"Archive\");\nawait c.until(`document.querySelector('[data-sonner-toast]')`, 5000);\nawait settle();\nawait c.shot(\"toast.png\");\nlog.toast = await style(\"[data-sonner-toast]\", [\"background-color\", \"border-radius\", \"width\", \"color\"]);\nlog.toastText = await c.ev(`document.querySelector(\"[data-sonner-toast]\").textContent`);\nawait c.ev(`[...document.querySelectorAll(\"[data-sonner-toast] button\")