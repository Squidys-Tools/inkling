{"parentUuid":"21441afc-9dbe-4777-bd5e-7a93aa68e48b","isSidechain":false,"promptId":"cda62929-1bba-4a09-ba3d-cc680eb61184","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DSHidZicr81XA4cpV7gvVp","type":"tool_result","content":"  useEffect(() => {\n    const onPaste = (event: ClipboardEvent) => {\n      const target = event.target;\n      if (\n        target instanceof HTMLInputElement ||\n        target instanceof HTMLTextAreaElement ||\n        (target instanceof HTMLElement && target.isContentEditable)\n      ) {\n        return;\n      }\n\n      const file = Array.from(event.clipboardData?.files ?? [])[0];\n      if (file) {\n        event.preventDefault();\n        void captureFileRef.current(file, \"clipboard\");\n        return;\n      }\n\n      const text = event.clipboardData?.getData(\"text/plain\").trim();\n      if (text) {\n        event.preventDefault();\n        void captureTextRef.current(text, \"clipboard\");\n      }\n    };\n\n    window.addEventListener(\"paste\", onPaste);\n    return () => window.removeEventListener(\"paste\", onPaste);\n  }, []);\n\n  const handleDeepLinkPayloadRef = useRef(handleDeepLinkPayload);\n  handleDeepLinkPayloadRef.current = handleDeepLinkPayload;\n  useEffect(() => {\n    if (shouldUseSeedLibrary()) return;\n    let cancelled = false;\n    const unlisten: Array<() => void> = [];\n  }\n\n  function handleDragLeave(event: React.DragEvent<HTMLElement>) {\n    if (event.currentTarget === event.target) setIsDragActive(false);\n  }\n\n  function handleDrop(event: React.DragEvent<HTMLElement>) {\n    event.preventDefault();\n    setIsDragActive(false);\n    const file = Array.from(event.dataTransfer.files)[0];\n    if (file) {\n      void captureFile(file, \"drag and drop\");\n      return;\n    }\n\n    const droppedText = (\n      event.dataTransfer.getData(\"text/uri-list\") || event.dataTransfer.getData(\"text/plain\")\n    )\n      .split(/\\r?\\n/u)\n      .map((value) => value.trim())\n  