ections","mcp__claude_ai_Unsplash__get_related_collections","mcp__claude_ai_Unsplash__get_user_collections","mcp__claude_ai_Unsplash__search_by_image","mcp__claude_ai_Unsplash__search_collections","mcp__claude_ai_Unsplash__search_illustrations","mcp__claude_ai_Unsplash__search_photos","mcp__claude_ai_Unsplash__search_related","mcp__claude_ai_Unsplash__search_users","mcp__claude_ai_Unsplash__update_collection","mcp__claude_ai_Unsplash__upload_image_for_search","mcp__col__get_component","mcp__col__get_library","mcp__col__render_component","mcp__col__search_components","mcp__col__search_libraries"],"wireHiddenNames":[],"readdedNames":[],"pendingMcpServers":["claude.ai Claude Docs","claude.ai Linear","claude.ai Unsplash","col","onesamosa"],"needsAuthMcpServers":[],"failedMcpServers":[],"removedByBlock":["mcp__claude_ai_Claude_Docs__batch","mcp__claude_ai_Claude_Docs__guide","mcp__claude_ai_Claude_Docs__update"]},"type":"attachment","uuid":"5dd401bd-4f34-4272-b34c-fe521485c74e","timestamp":"2026-10-19T16:40:04.687Z","rendered":[{"content":"<system-reminder>\nThe following tools are no longer available. Do not call them:\nmcp__claude_ai_Claude_Docs__batch\nmcp__claude_ai_Claude_Docs__guide\nmcp__claude_ai_Claude_Docs__update\n\n102 deferred tools are no longer available (MCP server disconnected): mcp__claude_ai_Claude_Docs__* (5), mcp__claude_ai_Linear__* (68), mcp__claude_ai_Unsplash__* (24), mcp__col__* (5). Do not search for them — ToolSearch will return no match.\n\nThe following deferred tools are no longer available in this session. Do not search for them — ToolSearch will return no match:\nListMcpResourcesTool\nReadMcpResourceDirTool\nReadMcpResourceTool\n\nThis is ambient context — do not narrate it to the user unless they ask or it is directly relevant to their request.\n\nThe following MCP servers are still connecting — their tools (typically named mcp__<server>__*) are not yet available but will appear shortly:\nclaude.ai Claude Docs\nclaude.ai Linear\nclaude.ai Unsplash\ncol\nonesamosa\n\nIf the user's request might be served by one of these servers (even if they didn't name it explicitly), call ToolSearch with a relevant keyword — ToolSearch will wait for connecting servers and search their tools once available. Do not report a capability as unavailable without first searching.\n</system-reminder>"}],"renderedRole":"system","userType":"external","entrypoint":"sdk-ts","cwd":"C:\\Users\\chris\\.t3\\worktrees\\inkling\\t3-47ff5304","sessionId":"fad76192-bf94-45bb-9f1a-d29cda113db7","version":"2.1.303","gitBranch":"feat/glass-surface","slug":"purrfect-munching-gadget"}
