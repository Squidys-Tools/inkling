n the\n533\t  // shown item changes, not on every edit to its record.\n534\t  // biome-ignore lint/correctness/useExhaustiveDependencies: Keyed on the item ID; the lookup reads the item it was started for.\n535\t  useEffect(() => {\n536\t    if (inspectorTab !== \"similar\") return;\n537\t    const itemId = String(shownItem.id);\n538\t    let cancelled = false;\n539\t    actionsRef.current.onLoadSimilar(shownItem).then(\n540\t      (items) => {\n541\t        if (!cancelled)\n542\t          setSimilar({\n543\t            itemId,\n544\t            items: items.filter((candidate) => String(candidate.id) !== itemId),\n545\t          });\n546\t      },\n547\t      () => {\n548\t        if (!cancelled) setSimilar({ itemId, items: [] });\n549\t      },\n550\t    );\n551\t    return () => {\n552\t      cancelled = true;\n553\t    };\n554\t  }, [inspectorTab, shownItem.id]);\n555\t\n556\t  const isFlying = flight !== null;\n557\t  const placedStyle: CSSProperties | undefined =\n558\t    destination && !isFlying\n559\t      ? {\n560\t          left: destination.left,\n561\t          top: destination.top,"}]},"uuid":"44b519a7-9fd5-40bc-b90d-3841962d44aa","timestamp":"2026-10-26T08:01:23.657Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\chris\\.t3\\worktrees\\inkling\\t3-a1f541e8\\src\\features\\item-view\\ItemView.tsx","content":"  };\n\n  useEffect(() => {\n    const onKeyDown = (event: KeyboardEvent) => {\n      if (event.key !== \"Escape\") return;\n      // A field inside the view owns its own Escape: the new-tag input and\n      // the editor's link URL field each cancel just themselves. This listener\n      // runs in the capture phase, before their handlers get a chance to.\n      if (event.target instanceof HTMLInputElement) return;\n      event.stopPropagation();\n      if (isFocusModeRef.current) {\n        setIsFocusMode(false);\n        return;\n      }\n      if (isEditingNoteRef.current) {\n        setIsEditingNote(false);\n        return;\n      }\n      requestClose();\n    };\n    window.addEventListener(\"keydown\", onKeyDown, true);\n    return () => window.removeEventListener(\"keydown\", onKeyDown, true);\n  }, [requestClose]);\n\n  const [isAddingTag, setIsAddingTag] = useState(false);\n  const [tagDraft, setTagDraft] = useState(\"\");\n  useLayoutEffect(() => {\n    if (isAddingTag) tagInputRef.current?.focus();\n  }, [isAddingTag]);\n\n  // Selection changes reset this local editor state even though the selected ID\n  // is only a trigger and is not read by the reset itself.\n  // biome-ignore lint/correctness/useExhaustiveDependencies: The shown item ID intentionally triggers a reset.\n  useEffect(() => {\n    setIsAddingTag(false);\n    setTagDraft(\"\");\n    setIsSpaceMenuOpen(false);\n    setInspectorTab(\"info\");\n  }, [shownItem.id]);\n\n  // Looks up similar items when the Similar tab is open. Reloads only when the\n  // shown item changes, not on every edit to its record.\n  // biome-ignore lint/correctness/useExhaustiveDependencies: Keyed on the item ID; the lookup reads the item it was started for.\n  useEffect(() => {\n    if (inspectorTab !== \"similar\") return;\n    const itemId = String(shownItem.id);\n    let cancelled = false;\n    actionsRef.current.onLoadSimilar(shownItem).then(\n      (items) => {\n        if (!cancelled)\n          setSimilar({\n            itemId,\n            items: items.filter((candidate) => String(candidate.id) !== itemId),\n          });\n      },\n      () => {\n        if (!cancelled) setSimilar({ itemId, items: [] });\n      },\n    );\n    return () => {\n      cancelled = true;\n    };\n  }, [inspectorTab, shownItem.id]);\n\n  const isFlying = flight !== null;\n  const placedStyle: CSSProperties | undefined =\n    destination && !isFlying\n      ? {\n          left: destination.left,\n          top: destination.top,","numLines":70,"startLine":492,"totalLines":733}},"sourceToolAssistantUUID":"28a5ee05-afb7-482c-997c-526303f19f11","permissionDecisi