IsFocusMode}\n                />\n              </Suspense>\n            </div>\n          ) : (\n            <>\n              <Tabs.Panel value=\"info\" tabIndex={-1} className={INSPECTOR_BODY}>\n                <InfoPanel\n                  item={shownItem}\n                  actions={actions}\n                  memberSpaces={memberSpaces}\n                  onEditNote={() => {\n                    setIsFocusMode(false);\n                    setIsEditingNote(true);\n                  }}\n                />\n              </Tabs.Panel>\n              <Tabs.Panel value=\"similar\" tabIndex={-1} className={INSPECTOR_BODY}>\n                <SimilarPanel item={shownItem} similar={similarItems} onOpen={actions.onOpenItem} />\n              </Tabs.Panel>\n            </>\n          )}\n\n          {!isEditingNoteView && (\n            <ItemActionBar\n              item={shownItem}\n              actions={actions}\n              spaces={spaces}\n              onArchive={archiveFromView}\n            />\n          )}\n        </Tabs.Root>\n      </section>\n    </div>\n  );\n}\n"}},"apiBlockIndex":1,"requestId":"req_011CgQVkLNxctt4r8NsEECoy","requestRef":"74adc41d-ee4a-49c9-b616-216c3cdd3fd0","requestedModel":"claude-opus-5-5","type":"assistant","uuid":"dcb3200c-a8dc-4816-afb4-669da71dd2e5","timestamp":"2026-10-26T08:00:56.664Z","advisorModel":"claude-opus-5-5","effort":"high","perTurnEffort":"high","userType":"external","entrypoint":"sdk-ts","cwd":"C:\\Users\\chris\\.t3\\worktrees\\inkling\\t3-a1f541e8","sessionId":"bf5ac5c7-e575-44db-b623-8a1386058030","version":"2.1.310","gitBranch":"squidlee/squ-131-stack-67-item-view-overlay","slug":"starry-painting-spark"}
