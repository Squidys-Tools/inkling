-\nsrc/App.css-16-.brand-mark {\nsrc/App.css-17-  width: 44px;\n--\nsrc/App.css:567:.pdf-viewer-page input:focus-visible {\nsrc/App.css-568-  outline-offset: 0;\nsrc/App.css-569-}\nsrc/App.css-570-.pdf-viewer-group .text-button {\nsrc/App.css-571-  margin-left: 2px;\nsrc/App.css-572-  font-size: 11px;\nsrc/App.css-573-}\n--\nsrc/App.css:1432:.first-run-quiet:focus-visible {\nsrc/App.css-1433-  color: var(--color-ink);\nsrc/App.css-1434-}\nsrc/App.css-1435-.first-run-mascot {\nsrc/App.css-1436-  position: absolute;\nsrc/App.css-1437-  line-height: 0;\nsrc/App.css-1438-  pointer-events: none;\n--\nsrc/App.css:2619:.item-space-option:focus-visible {\nsrc/App.css-2620-  background: var(--color-glass-active);\nsrc/App.css-2621-  color: var(--color-ink);\nsrc/App.css-2622-}\nsrc/App.css-2623-.item-space-option[aria-pressed=\"true\"] {\nsrc/App.css-2624-  color: var(--color-ink);\nsrc/App.css-2625-}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"sandboxed":false,"sourceToolAssistantUUID":"01ce5a22-c068-44ec-8869-d4cc1321df75","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"sdk-ts","cwd":"C:\\Users\\chris\\.t3\\worktrees\\inkling\\t3-a1f541e8","sessionId":"bf5ac5c7-e575-44db-b623-8a1386058030","version":"2.1.310","gitBranch":"squidlee/squ-131-stack-67-item-view-overlay","slug":"starry-painting-spark"}
