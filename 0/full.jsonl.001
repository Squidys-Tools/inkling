n: 0;\n120\t  padding: 0;\n121\t  color: var(--library-muted);\n122\t  font-size: 12px;\n123\t  list-style: none;\n124\t}\n125\t.settings-makeup-legend li {\n126\t  display: inline-flex;\n127\t  align-items: center;\n128\t  gap: 6px;\n129\t}\n130\t.settings-makeup-legend li span {\n131\t  width: 7px;\n132\t  height: 7px;\n133\t  border-radius: 50%;\n134\t}\n135\t.settings-data-row {\n136\t  display: flex;\n137\t  align-items: center;\n138\t  gap: 18px;\n139\t  padding: 20px 0;\n140\t}\n141\t.settings-data-row:not(:last-of-type) {\n142\t  border-bottom: 1px solid var(--library-border);\n143\t}\n144\t.settings-data-icon {\n145\t  display: grid;\n146\t  flex: 0 0 auto;\n147\t  place-items: center;\n148\t  width: 36px;\n149\t  height: 36px;\n150\t  border-radius: 10px;\n151\t  background: var(--library-surface-raised);\n152\t  color: var(--library-text);\n153\t}\n154\t.settings-data-text {\n155\t  display: flex;\n156\t  flex: 1 1 auto;\n157\t  flex-direction: column;\n158\t  gap: 4px;\n159\t  min-width: 0;\n160\t}\n161\t.settings-data-text h3 {\n162\t  margin: 0;\n163\t  color: var(--library-text);\n164\t  font-size: 15px;\n165\t  font-weight: 600;\n166\t}\n167\t.settings-data-text p {\n168\t  margin: 0;\n169\t  color: var(--library-muted);\n170\t  font-size: 13px;\n171\t  line-height: 1.5;\n172\t}\n173\t.settings-data-button {\n174\t  flex: 0 0 auto;\n175\t  align-self: center;\n176\t  padding: 0 18px;\n177\t  border-color: var(--library-border);\n178\t  border-radius: 999px;\n179\t  background: transparent;\n180\t  color: var(--library-text);\n181\t  font-size: 13px;\n182\t}\n183\t.settings-data-button.is-primary {\n184\t  border-color: #e8e0d4;\n185\t  background: #e8e0d4;\n186\t  color: #141210;\n187\t}\n188\t.settings-data-link {\n189\t  margin-top: 20px;\n190\t}\n191\t\n</system-reminder>"}],"renderedRole":"system","userType":"external","entrypoint":"sdk-ts","cwd":"C:\\Users\\chris\\.t3\\worktrees\\inkling\\t3-47ff5304","sessionId":"fad76192-bf94-45bb-9f1a-d29cda1