{"parentUuid":"ebfb6aa2-2c60-436e-87cf-c7267c13126b","isSidechain":false,"promptId":"6f28c0dc-c66c-4abb-8f60-5b5bebef6251","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VUgZ3M1CSV1HDFf57SKNvw","type":"tool_result","content":".expanded-overlay-layer {\n  position: fixed;\n  inset: 0;\n  z-index: 6;\n  display: grid;\n  place-items: center;\n  padding: clamp(var(--small-component), 4vh, 40px) clamp(var(--small-component), 3vw, 48px);\n  pointer-events: none;\n}\n.app-shell.settings-open .expanded-overlay-layer {\n  z-index: 130;\n}\n.expanded-overlay {\n  position: relative;\n  pointer-events: auto;\n  display: flex;\n  flex-direction: column;\n  width: min(680px, 100%);\n  max-height: 100%;\n  border: 1px solid #4a4842;\n  border-radius: var(--library-radius-overlay);\n  overflow: hidden;\n  background: var(--library-surface);\n  box-shadow: 0 30px 80px rgba(0, 0, 0, 0.55);\n}\n.expanded-overlay.is-placed {\n  position: absolute;\n  z-index: 1;\n  width: auto;\n  height: auto;\n}\n.expanded-overlay.is-flying {\n  will-change: left, top, width, height, opacity;\n}\n.overlay-flight-frame {\n  position: absolute;\n  z-index: 2;\n  overflow: hidden;\n  background: var(--library-surface);\n  border: 1px solid #4a4842;\n  pointer-events: none;\n  will-change: left, top, width, height;\n}\n.overlay-flight-media {\n  position: absolute;\n  overflow: hidden;\n  background: #101010;\n  will-change: top, left, width, height;\n}\n.overlay-flight-img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  display: block;\n}\n.overlay-flight-art {\n  position: absolute;\n  inset: 0;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 10px;\n  color: var(--green);\n  font: 11px var(--font-ui);\n  text-transform: uppercase;\n}\n.overlay-flight-art .post-art {\n  width: 100%;\n  height: 100%;\n  min-height: 0;\n  box-sizing: border-box;\n}\n.expanded-overlay-close {\n  position: absolute;\n  top: 14px;\n  right: 14px;\n  z-ind