ictures\";\nimport { SplitText } from \"./onboarding/SplitText\";\nimport \"./onboarding/onboarding.css\";\n\n/**\n * Every screen is drawn on a 960x540 stage that keeps a fixed share of the\n * window: 1:1 at 1280x720 (or 1280x800), smaller below that, larger above it\n * up to a cap (about 1080p), past which more window only adds margin.\n */\nconst STAGE_FIT_WIDTH = 1280;\nconst STAGE_FIT_HEIGHT = 720;\nconst MAX_STAGE_SCALE = 1.35;","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"sandboxed":false,"sourceToolAssistantUUID":"f6439ad5-331b-44af-8376-90eb5fc029aa","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"sdk-ts","cwd":"C:\\Users\\chris\\.t3\\worktrees\\inkling\\t3-a1f541e8","sessionId":"bf5ac5c7-e575-44db-b623-8a1386058030","version":"2.1.310","gitBranch":"squidlee/squ-132-stack-77-onboarding-reader-cleanup-delete-appcss","slug":"starry-painting-spark"}
