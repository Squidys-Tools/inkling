{"parentUuid":"ebb9a05a-8fff-49c3-96a2-9e222785811d","isSidechain":false,"promptId":"cda62929-1bba-4a09-ba3d-cc680eb61184","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Qp2LiKWTqZUd3aU9w1M44B","type":"tool_result","content":"electron/ai-jobs-lazy.test.ts:8:test(\"the system-font scan waits for PDF jobs, including after BMP thumbnailing\", () => {\nelectron/ai-jobs.test.ts:87:test(\"Electron jobs OCR captured files, index their text, and persist matching model vectors\", async () => {\nelectron/ai-jobs.test.ts:193:test(\"embedding text keeps the shared document inputs and markdown projection\", () => {\nelectron/ai-jobs.test.ts:225:test(\"URL enrichment updates the captured item before its text is embedded\", async () => {\nelectron/ai-jobs.test.ts:293:test(\"failed URL enrichment retries while keeping the fallback item available\", async () => {\nelectron/ai-jobs.test.ts:341:test(\"PDF capture stays instant and the OCR job publishes the page-one thumbnail\", async () => {\nelectron/ai-jobs.test.ts:396:test(\"image capture stays instant and the thumbnail job publishes the card image\", async () => {\nelectron/ai-jobs.test.ts:432:test(\"the image palette job waits for the thumbnail job, then persists five dominant colors\", async () => {\nelectron/ai-jobs.test.ts:451:test(\"a failed thumbnail keeps the item and the OCR and embedding work, with nothing to retry on screen\", async () => {\nelectron/ai-jobs.test.ts:483:test(\"the thumbnail lane finishes while the main worker is held inside a long job\", async () => {\nelectron/ai-jobs.test.ts:515:test(\"a pending thumbnail job survives closing and reopening the library\", async () => {\nelectron/ai-jobs.test.ts:533:test(\"a thumbnail job whose worker died resumes after its lease expires\", async () => {\nelectron/ai-jobs.test.ts:555:test(\"backfill drains one missing PDF thumbnail at a time, hides the work, and skips a broken PDF\", async () => {\nelectron/ai-jobs.test.ts:618:test(\"a thumbnail job whose lease expired resumes on restart without duplicating work\", async () => {\nelectron/ai-jobs.test.ts:654:test(\"backfill stops scanning once exhausted and resumes only when PDF OCR leaves a page without a thumbnail\", async () => {\nelectron/ai-jobs.test.ts:706:test(\"backfill retries the same candidate after queue admission fails\", async () => {\nelectron/asset-response.test.ts:42:test(\"a full GET streams the file with its headers\", async () => {\nelectron/asset-response.test.ts:56:test(\"a large file arrives in chunks instead of one read\", async () => {\nelectron/asset-response.test.ts:67:test(\"HEAD answers with the headers and no body\", async () => {\nelectron/asset-response.test.ts:75:test(\"a byte range answers 206 with just those bytes\", async () => {\nelectron/asset-response.test.ts:83:test(\"open-ended, suffix and overlong ranges are clamped to the file\", async () => {\nelectron/asset-response.test.ts:103:test(\"HEAD with a range reports the slice without a body\", async () => {\nelectron/asset-response.test.ts:111:test(\"a range past the end answers 416 with the file size\", async () => {\nelectron/asset-response.test.ts:123:test(\"a malformed or unsupported range is ignored and the whole file is sent\", async () => {\nelectron/asset-response.test.ts:132:test(\"an empty file is a 200 with no body\", async () => {\nelectron/asset-response.test.ts:140:test(\"If-Range only honors the range while the file is unchanged\", async () => {\nelectron/asset-response.test.ts:149:test(\"unknown extensions fall back to a binary content type\", async () => {\nelectron/asset-response.test.ts:154:test(\"only GET and HEAD are served\", async () => {\nelectron/asset-response.test.ts:160:test(\"paths that leave the assets directory are rejected\", async () => {\nelectron/asset-response.test.ts:165:test(\"a link that resolves outside the assets directory is rejected\", async () => {\nelectron/asset-response.test.ts:171:test(\"directories and missing files are not served\", async () => {\nelectron/capture-server.test.ts:24:describe(\"capture server parity\", () => {\nelectron/capture-server.test.ts:25:  test(\"bearer tokens require the exact value\", () => {\nelectron/capture-server.test.ts:34:  test(\"only extension, null, and Electron origins pass\", () => {\nelectron/capture-server.test.ts:63:  test(\"capture URLs match storage's HTTP guards and allow explicit loopback saves\", () => {\nelectron/capture-server.test.ts:81:  test(\"v1 payload normalization and Rust scrubber vectors stay in parity\", () => {\nelectron/capture-server.test.ts:151:  test(\"scrubber removes the executable subset and preserves safe article markup\", () => {\nelectron/capture-server.test.ts:190:  test(\"token generation, rate limiting, and payload cap match the Rust receiver\", () => {\nelectron/capture-server.test.ts:208:test(\"loopback capture uses a persisted bearer token and creates a pending storage item\", async () => {\nelectron/capture-server.test.ts:320:test(\"closing the receiver waits for an in-flight capture to finish\", async () => {\nelectron/embeddings.test.ts:15:test(\"Nomic document normalization produces a unit vector and little-endian storage bytes\", () => {\nelectron/embeddings.test.ts:26:test(\"tokenizer truncation preserves the final special token at the Rust document limit\", () => {\nelectron/embeddings.test.ts:43:test(\"Nomic text validation accepts Unicode letters and numbers\", () => {\nelectron/embeddings.test.ts:49:test(\"text-query embeddings do not download model assets during search\", async () => {\nelectron/library-size.test.ts:24:test(\"library size answers from the last walk until a refresh is asked for\", async () => {\nelectron/library-size.test.ts:34:test(\"library size keeps answering from cache while a refresh walks\", async () => {\nelectron/library-size.test.ts:44:test(\"library size shares one walk between overlapping first calls\", async () => {\nelectron/library-size.test.ts:52:test(\"library siz