{"parentUuid":"95ede672-2fa0-4ce8-81fa-f87752a25a23","isSidechain":false,"message":{"model":"claude-opus-5-5","id":"msg_011CgBwf4LQc37937BJaXvSk","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"Rather than patching pieces, it's cleanest to rewrite the entire file from scratch, including the OverlayMedia function and fileTypeFor helper, using the Write tool directly.\n\n","signature":""}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3880,"cache_read_input_tokens":145801,"output_tokens":12748,"output_tokens_details":{"thinking_tokens":77},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":3880,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":12748,"cache_read_input_tokens":145801,"cache_creation_input_tokens":3880,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3880},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"thinkingDurationMs":2421,"thinkingDisplay":"summarized","apiBlockIndex":0,"requestId":"req_011CgBwf3vbEkuBTLqKSoh1f","requestRef":"ad4ffb52-cd60-4c9b-87ca-cbc6dc1d17d5","requestedModel":"claude-opus-5-5","type":"assistant","uuid":"d092e2b2-e1d6-44da-addd-ce4a4d0bf761","timestamp":"2026-10-19T16:52:37.131Z","advisorModel":"claude-opus-5-5","effort":"low","perTurnEffort":"low","userType":"external","entrypoint":"sdk-ts","cwd":"C:\\Users\\chris\\.t3\\worktrees\\inkling\\t3-47ff5304","sessionId":"fad76192-bf94-45bb-9f1a-d29cda113db7","version":"2.1.303","gitBranch":"feat/glass-surface","slug":"purrfect-munching-gadget"}
{"parentUuid":"d092e2b2-e1d6-44da-addd-ce4a4d0bf761","isSidechain":false,"message":{"model":"claude-opus-5-5","id":"msg_011CgBwf4LQc37937BJaXvSk","type":"message","role":"assistant","content":[{"type":"text","text":"I'll write the whole file directly; that's cleaner than patching."}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3880,"cache_read_input_tokens":145801,"output_tokens":12748,"output_tokens_details":{"thinking_tokens":77},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":3880,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":12748,"cache_read_input_tokens":145801,"cache_creation_input_tokens":3880,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3880},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"apiBlockIndex":1,"requestId":"req_011CgBwf3vbEkuBTLqKSoh1f","requestRef":"ad4ffb52-cd60-4c9b-87ca-cbc6dc1d17d5","requestedModel":"claude-opus-5-5","type":"assistant","uuid":"13599bc9-29fc-4f91-9269-6355262675b7","timestamp":"2026-10-19T16:52:37.137Z","advisorModel":"claude-opus-5-5","effort":"low","perTurnEffort":"low","userType":"external","entrypoint":"sdk-ts","cwd":"C:\\Users\\chris\\.t3\\worktrees\\inkling\\t3-47ff5304","sessionId":"fad76192-bf94-45bb-9f1a-d29cda113db7","version":"2.1.303","gitBranch":"feat/glass-surface","slug":"purrfect-munching-gadget"}
{"parentUuid":"13599bc9-29fc-4f91-9269-6355262675b7","isSidechain":false,"message":{"model":"claude-opus-5-5","id":"msg_011CgBwf4LQc37937BJaXvSk","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01KMhroKxLx6i2KeRqqWH1D2","name":"Write","input":{"file_path":"C:\\Users\\chris\\.t3\\worktrees\\inkling\\t3-47ff5304\\src\\components\\ExpandedItemOverlay.tsx","content":"import {\n  lazy,\n  Suspense,\n  useCallback,\n  useEffect,\n  useLayoutEffect,\n  useRef,\n  useState,\n  type CSSProperties,\n  type ReactNode,\n  type RefObject,\n} from \"react\";\nimport { gsap } from \"gsap\";\nimport { HugeiconsIcon } from \"@hugeicons/react\";\nimport {\n  AlertCircleIcon,\n  Archive01Icon,\n  ArrowUpRight01Icon,\n  BookOpen01Icon,\n  FileTextIcon,\n  FolderAddIcon,\n  Loading01Icon,\n  PlusSignIcon,\n  RotateCwIcon,\n  SparklesIcon,\n  StarIcon,\n} from \"@hugeicons/core-free-icons\";\nimport type { LibraryItem } from \"../lib/types\";\nimport { isElectronRuntime } from \"../lib/libraryApi\";\nimport type { ReaderOrigin } from \"../ReaderView\";\nimport {\n  KindIcon,\n  NoteArtwork,\n  PdfArtwork,\n  PostArtwork,\n  XPostEmbed,\n  DetailVideoMedia,\n  pdfPreviewTitle,\n} from \"./ItemMedia\";\nimport {\n  OVERLAY_EASE,\n  OVERLAY_FLIGHT_MS,\n  prefersReducedMotion,\n  queryCardRects,\n  rectFrom,\n  type FlightRect,\n  type SourceRects,\n} from \"./overlayMotion\";\n\nconst RichNoteEditor = lazy(() =>\n  import(\"./RichNoteEditor\").then((module) => ({ default: module.RichNoteEditor })),\n);\n\nexport type ExpandedOverlayActions = {\n  onClose: () => void;\n  onOpenPdf: (item: LibraryItem) => void;\n  onOpenReader: (item: LibraryItem, origin: ReaderOrigin) => void;\n  onFindSimilar: (item: LibraryItem) => void;\n  onForget: (item: LibraryItem) => void | Promise<void>;\n  onTogglePin: (item: LibraryItem) => void | Promise<void>;\n  onRetryJob: (jobId: string) => void | Promise<void>;\n  onAddTag?: (item: LibraryItem, tag: string) => void | Promise<void>;\n  onUpdateNote: (item: LibraryItem, body: string) => void | Promise<void>;\n  onToggleSpace?: (item: LibraryItem, spaceId: string) => void | Promise<void>;\n  isFindingSimilar: boolean;\n};\n\n/** A Regular Space chip: filing an item in and taking it back out happen in the\n *  same place, so one toggle carries both directions. */\nexport type OverlaySpaceChip = {\n  id: string;\n  name: string;\n  color: string;\n  member: boolean;\n};\n\ntype OverlayAction = {\n  key: string;\n  label: string;\n  icon: ReactNode;\n  onClick: (event: React.MouseEvent<HTMLButtonElement>) => void;\n  disabled?: boolean;\n  title?: string;\n};\n\ntype Flight =\n  | { kind: \"open\"; id: number; from: FlightRect; to: FlightRect }\n  | {\n      kind: \"close\";\n      id: number;\n      fromItem: LibraryItem;\n      from: FlightRect;\n      to: FlightRect | null;\n      thenOpen: boolean;\n    };\n\n// The settled view's corners match the library frame it covers.\nconst FRAME_RADIUS = \"16px 0px 0px 16px\";\n\nfunction clickOrigin(event: React.MouseEvent<HTMLElement>): ReaderOrigin {\n  const rect = event.currentTarget.getBoundingClientRect();\n  return { x: rect.left + rect.width / 2, y: rect.top + rect.height / 2 };\n}\n\nfunction hostnameForUrl(url: string | undefined): string | null {\n  if (!url) return null;\n  try {\n    return new URL(url).hostname.replace(/^www\\./u, \"\");\n  } catch {\n    return null;\n  }\n}\n\nfunction fileTypeFor(item: LibraryItem): string {\n  if (item.kind === \"Image\") {\n    const match = item.image?.split(\"?\")[0].match(/\\.([a-z0-9]{2,5})$/iu);\n    if (match) {\n      const extension = match[1].toLowerCase();\n      return extension === \"jpeg\" ? \"JPG\" : extension.toUpperCase();\n    }\n    return \"JPG\";\n  }\n  switch (item.kind) {\n    case \"PDF\":\n      return \"PDF\";\n    case \"Video\":\n      return \"Video\";\n    case \"Article\":\n      return \"Link\";\n    case \"Post\":\n      return \"Post\";\n    case \"Note\":\n      return \"Note\";\n    case \"Quote\":\n      return \"Quote\";\n    default:\n      return \"File\";\n  }\n}\n\n// Content actions sit under the details: read, open the PDF, find similar.\n// Item housekeeping (star, Spaces, open original, archive) lives in the\n// action bar at the bottom of the inspector instead.\nfunction contentActions(item: LibraryItem, actions: ExpandedOverlayActions): OverlayAction[] {\n  const list: OverlayAction[] = [];\n  const hasReaderContent = Boolean(item.articleHtml || item.hasArticleContent);\n  if (item.kind === \"PDF\" && item.fileUrl) {\n    list.push({\n      key: \"open-pdf\",\n      label: \"Open PDF\",\n      icon: <HugeiconsIcon icon={FileTextIcon} size={14} />,\n      onClick: () => actions.onOpenPdf(item),\n    });\n  }\n  if (item.kind === \"Article\" && hasReaderContent) {\n    list.push({\n      key: \"read\",\n      label: \"Read\",\n      icon: <HugeiconsIcon icon={BookOpen01Icon} size={14} />,\n      onClick: (event) => actions.onOpenReader(item, clickOrigin(event)),\n    });\n  }\n  if (isElectronRuntime() && [\"Image\", \"Article\", \"Note\", \"Quote\"].includes(item.kind)) {\n    list.push({\n      key: \"find-similar\",\n      label: actions.isFindingSimilar ? \"Finding similar…\" : \"Find similar\",\n      icon: <HugeiconsIcon icon={SparklesIcon} size={14} />,\n      onClick: () => actions.onFindSimilar(item),\n      disabled: actions.isFindingSimilar,\n    });\n  }\n  return list;\n}\n\nfunction OverlayMedia({ item }: { item: LibraryItem }) {\n  if (item.kind === \"Note\" && !item.image) {\n    return (\n      <div className=\"item-stage-art note-detail-media\">\n        <NoteArtwork item={item} />\n      </div>\n    );\n  }\n\n  if (item.social?.provider === \"x\") {\n    return (\n      <div className=\"item-stage-art detail-x-post\">\n        <XPostEmbed\n          key={item.social.postUrl}\n          social={item.social}\n          fallback={\n            item.post ? (\n              <PostArtwork post={item.post} />\n            ) : (\n              <div className=\"detail-art ink\">Post preview unavailable.</div>\n            )\n          }\n        />\n      </div>\n    );\n  }\n\n  if (item.kind === \"Video\") {\n    return (\n      <div className=\"item-stage-art\">\n        <DetailVideoMedia item={item} />\n      </div>\n    );\n  }\n\n  if (item.kind === \"PDF\") {\n    return (\n      <div className=\"item-stage-art\">\n        <PdfArtwork item={item} />\n      </div>\n    );\n  }\n\n  if (item.image) {\n    return <img src={item.image} alt={item.imageAlt ?? item.title} className=\"item-stage-image\" />;\n  }\n\n  if (item.kind === \"Quote\") {\n    return (\n      <div className=\"item-stage-art\">\n        <div className=\"detail-art detail-quote-art paper-yellow\">\n          <span className=\"detail-quote-mark\">“</span>\n          <span>{item.kind}</span>\n        </div>\n      </div>\n    );\n  }\n\n  if (item.kind === \"Post\" && item.post) {\n    return (\n      <div className=\"item-stage-art\">\n        <PostArtwork post={item.post} />\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"item-stage-art\">\n      <div className={`detail-art ${item.accent ?? \"ink\"}`}>\n        <KindIcon kind={item.kind} />\n        <span>{item.kind}</span>\n      </div>\n    </div>\n  );\n}\n\nfunction detailTitleFor(item: LibraryItem): string {\n  return item.kind === \"PDF\" ? pdfPreviewTitle(item.title) || item.title : item.title;\n}\n\ntype ExpandedItemOverlayProps = {\n  item: LibraryItem;\n  actions: ExpandedOverlayActions;\n  /** Regular Spaces available to file this item in. Empty hides the Space control. */\n  spaces?: OverlaySpaceChip[];\n  originRectsRef: RefObject<SourceRects | null>;\n  /** The library frame the item view covers once it settles. */\n  frameRef: RefObject<HTMLElement | null>;\n};\n\nexport function ExpandedItemOverlay({\n  item,\n  actions,\n  spaces,\n  originRectsRef,\n  frameRef,\n}: ExpandedItemOverlayProps) {\n  const layerRef = useRef<HTMLDivElement>(null);\n  const dialogRef = useRef<HTMLElement>(null);\n  const closeButtonRef = useRef<HTMLButtonElement>(null);\n  const tagInputRef = useRef<HTMLInputElement>(null);\n  const itemIdRef = useRef(item.id);\n  const itemRef = useRef(item);\n  const previousItemRef = useRef(item);\n  const flightIdRef = useRef(0);\n  const flightRef = useRef<Flight | null>(null);\n  const cancelPendingOpenRef = useRef(false);\n  const hasSettledOnceRef = useRef(false);\n  const actionsRef = useRef(actions);\n  const [destination, setDestination] = useState<FlightRect | null>(null);\n  const [flight, setFlight] = useState<Flight | null>(null);\n  const [pendingOpen, setPendingOpen] = useState(false);\n  const [isEditingNote, setIsEditingNote] = useState(false);\n  const [isFocusMode, setIsFocusMode] = useState(false);\n  const [isSpaceMenuOpen, setIsSpaceMenuOpen] = useState(false);\n  const isEditingNoteRef = useRef(false);\n  const isFocusModeRef = useRef(false);\n\n  // Mirror props into refs inside an effect, never during render, so a\n  // concurrent render cannot publish a half-updated set. This runs before\n  // the flight effects below, which read these refs.\n  useLayoutEffect(() => {\n    itemIdRef.current = item.id;\n    itemRef.current = item;\n    flightRef.current = flight;\n  }, [item, flight]);\n\n  useLayoutEffect(() => {\n    isEditingNoteRef.current = isEditingNote;\n    isFocusModeRef.current = isFocusMode;\n  }, [isEditingNote, isFocusMode]);\n\n  // The item whose content the view shows. During a closing flight that was\n  // triggered by switching items, the view flies back displaying the item it\n  // was showing, while React's item prop already points at the next one.\n  const shownItem = flight?.kind === \"close\" ? flight.fromItem : item;\n\n  const frameRect = useCallback((): FlightRect => {\n    const rect = frameRef.current?.getBoundingClientRect();\n    if (rect) return rectFrom(rect);\n    return { left: 0, top: 0, width: window.innerWidth, height: window.innerHeight };\n  }, [frameRef]);\n\n  // Grows the view from a card-sized rectangle into the library frame.\n  const beginOpenFlight = useCallback(\n    (from: FlightRect) => {\n      const to = frameRect();\n      setDestination(to);\n      flightIdRef.current += 1;\n      setFlight({ kind: \"open\", id: flightIdRef.current, from, to });\n    },\n    [frameRect],\n  );\n\n  const beginCloseFlight = useCallback(\n    (closingItem: LibraryItem, to: FlightRect | null, thenOpen: boolean) => {\n      const dialog = dialogRef.current;\n      if (!dialog) {\n        actionsRef.current.onClose();\n        return;\n      }\n      flightIdRef.current += 1;\n      setFlight({\n        kind: \"close\",\n        id: flightIdRef.current,\n        fromItem: closingItem,\n        from: rectFrom(dialog.getBoundingClientRect()),\n        to,\n        thenOpen,\n      });\n    },\n    [],\n  );\n\n  const requestClose = useCallback(() => {\n    const activeFlight = flightRef.current;\n    if (activeFlight?.kind === \"close\") {\n      if (activeFlight.thenOpen) cancelPendingOpenRef.current = true;\n      return;\n    }\n    const rects = queryCardRects(itemIdRef.current);\n    if (prefersReducedMotion() || !rects || !dialogRef.current) {\n      if (flightRef.current) setFlight(null);\n      gsap.to(layerRef.current, {\n        opacity: 0,\n        duration: 0.15,\n        onComplete: actionsRef.current.onClose,\n      });\n      return;\n    }\n    cancelPendingOpenRef.current = false;\n    beginCloseFlight(itemRef.current, rects.card, false);\n  }, [beginCloseFlight]);\n\n  // The origin rectangle is a one-time snapshot supplied through a mutable ref.\n  // Reading it again after opening would retarget the flight to a stale card.\n  // biome-ignore lint/correctness/useExhaustiveDependencies: This effect consumes the source-rectangle snapshot once on mount.\n  useLayoutEffect(() => {\n    const originRects = originRectsRef.current;\n    if (!originRects || prefersReducedMotion()) {\n      setDestination(frameRect());\n      gsap.fromTo(\n        layerRef.current,\n        { opacity: 0 },\n        { opacity: 1, duration: 0.18, ease: \"power1.out\" },\n      );\n      return;\n    }\n    beginOpenFlight(originRects.card);\n  }, [beginOpenFlight]);\n\n  // Runs every flight. GSAP owns only the view's outer rectangle. While it\n  // flies, the stage fills the whole rectangle and the inspector is hidden, so\n  // the card reads as its own image growing into the frame; the inspector and\n  // the stage's margins ease in by CSS once it lands.\n  useLayoutEffect(() => {\n    if (!flight) return;\n    const dialog = dialogRef.current;\n    if (!dialog) {\n      if (flight.kind === \"close\") actionsRef.current.onClose();\n      return;\n    }\n    const cardRadius = `${getComputedStyle(dialog).getPropertyValue(\"--sidebar-radius\").trim() || \"14px\"}`;\n    const cardCorners = `${cardRadius} ${cardRadius} ${cardRadius} ${cardRadius}`;\n    const duration = OVERLAY_FLIGHT_MS / 1000;\n\n    if (flight.kind === \"open\") {\n      const timeline = gsap.timeline({\n        onComplete: () => {\n          setFlight(null);\n          closeButtonRef.current?.focus({ preventScroll: true });\n        },\n      });\n      timeline\n        .fromTo(\n          dialog,\n          { ...flight.from, borderRadius: cardCorners },\n          { ...flight.to, borderRadius: FRAME_RADIUS, duration, ease: OVERLAY_EASE, autoRound: false },\n          0,\n        )\n        .fromTo(dialog, { opacity: 0 }, { opacity: 1, duration: 0.12, ease: \"power1.out\" }, 0);\n      return () => {\n        timeline.kill();\n      };\n    }\n\n    // Closing: the view returns to its source card and dissolves into it, or —\n    // when the source card is no longer mounted — fades out in place.\n    const timeline = gsap.timeline({\n      onComplete: () => {\n        if (flight.thenOpen && !cancelPendingOpenRef.current) {\n          setFlight(null);\n          setPendingOpen(true);\n        } else {\n          actionsRef.current.onClose();\n        }\n      },\n    });\n    if (flight.to) {\n      timeline\n        .fromTo(\n          dialog,\n          { ...flight.from },\n          { ...flight.to, borderRadius: cardCorners, duration, ease: OVERLAY_EASE, autoRound: false },\n          0,\n        )\n        .to(dialog, { opacity: 0, duration: 0.18, ease: \"power1.in\" }, duration - 0.18);\n    } else {\n      timeline.to(dialog, { opacity: 0, duration: 0.25, ease: \"power1.in\" });\n    }\n    return () => {\n      timeline.kill();\n    };\n  }, [flight]);\n\n  // Follows the frame when the window resizes or the sidebar opens or closes.\n  useEffect(() => {\n    const frame = frameRef.current;\n    if (!frame) return;\n    const observer = new ResizeObserver(() => {\n      if (flightRef.current) return;\n      setDestination(frameRect());\n    });\n    observer.observe(frame);\n    return () => observer.disconnect();\n  }, [frameRef, frameRect]);\n\n  // Switching items while the view is open runs sequentially: the open view\n  // first flies back into the card it was showing, and only after it lands\n  // does the newly selected item open from its own card. Rapid selections\n  // during the closing leg are absorbed — the flight completes once and then\n  // opens the most recently selected item.\n  useLayoutEffect(() => {\n    const previous = previousItemRef.current;\n    if (previous.id === item.id) return;\n    previousItemRef.current = item;\n    if (isEditingNoteRef.current) {\n      // Leave the editor rather than carry the draft onto another item.\n      setIsEditingNote(false);\n      setIsFocusMode(false);\n    }\n\n    const activeFlight = flightRef.current;\n    if (activeFlight?.kind === \"close\") return;\n    if (activeFlight?.kind === \"open\") {\n      // Retarget the in-progress open from its current visual state.\n      const dialog = dialogRef.current;\n      if (!dialog) return;\n      cancelPendingOpenRef.current = false;\n      beginOpenFlight(rectFrom(dialog.getBoundingClientRect()));\n      return;\n    }\n\n    // Settled: close into the old card, then open the new selection.\n    cancelPendingOpenRef.current = false;\n    beginCloseFlight(previous, queryCardRects(previous.id)?.card ?? null, /* thenOpen */ true);\n  }, [item, beginOpenFlight, beginCloseFlight]);\n\n  // When a sequential switch's closing leg lands, open the newly selected\n  // item from its own card.\n  useLayoutEffect(() => {\n    if (!pendingOpen || flight) return;\n    setPendingOpen(false);\n    if (cancelPendingOpenRef.current) {\n      cancelPendingOpenRef.current = false;\n      actionsRef.current.onClose();\n      return;\n    }\n    const rects = queryCardRects(itemRef.current.id);\n    if (!rects) {\n      actionsRef.current.onClose();\n      return;\n    }\n    beginOpenFlight(rects.card);\n  }, [pendingOpen, flight, beginOpenFlight]);\n\n  // On close, hand focus back to the source card while it is still mounted.\n  // Skipping the restore when focus already moved elsewhere (nav, search)\n  // avoids yanking it back out of whatever the user clicked.\n  useEffect(\n    () => () => {\n      const focusOwner = document.activeElement;\n      const overlayHasFocus =\n        focusOwner instanceof HTMLElement && (dialogRef.current?.contains(focusOwner) ?? false);\n      if (!overlayHasFocus && focusOwner !== document.body) return;\n      const card = document.querySelector<HTMLElement>(\n        `.library-card[data-library-item-id=\"${CSS.escape(String(itemIdRef.current))}\"]`,\n      );\n      card?.focus({ preventScroll: true });\n    },\n    [],\n  );\n\n  // Move focus to the close control when the view finishes opening.\n  useLayoutEffect(() => {\n    if (flight || !destination || hasSettledOnceRef.current) return;\n    hasSettledOnceRef.current = true;\n    closeButtonRef.current?.focus({ preventScroll: true });\n  }, [flight, destination]);\n\n  actionsRef.current = actions;\n\n  const handleOverlayClose = () => {\n    if (isFocusModeRef.current) {\n      setIsFocusMode(false);\n      return;\n    }\n    if (isEditingNoteRef.current) {\n      setIsEditingNote(false);\n      return;\n    }\n    requestClose();\n  };\n\n  useEffect(() => {\n    const onKeyDown = (event: KeyboardEvent) => {\n      if (event.key !== \"Escape\") return;\n      // A field inside the view owns its own Escape: the new-tag input and\n      // the editor's link URL field each cancel just themselves. This listener\n      // runs in the capture phase, before their handlers get a chance to.\n      if (event.target instanceof HTMLInputElement) return;\n      event.stopPropagation();\n      if (isFocusModeRef.current) {\n        setIsFocusMode(false);\n        return;\n      }\n      if (isEditingNoteRef.current) {\n        setIsEditingNote(false);\n        return;\n      }\n      requestClose();\n    };\n    window.addEventListener(\"keydown\", onKeyDown, true);\n    return () => window.removeEventListener(\"keydown\", onKeyDown, true);\n  }, [requestClose]);\n\n  // Presses outside the view (the sidebar, the search bar) close it, except\n  // the edge tab, which only folds the sidebar away. While a note is being\n  // written every outside press is absorbed instead, so it cannot silently\n  // throw away what was just typed. The close button, Escape and Save are the\n  // ways out.\n  useEffect(() => {\n    const isOutside = (target: EventTarget | null) => {\n      if (!(target instanceof Node)) return false;\n      if (dialogRef.current?.contains(target)) return false;\n      return !(target instanceof Element && target.closest(\".edge-tab\"));\n    };\n\n    const onPointerDown = (event: PointerEvent) => {\n      if (!isOutside(event.target)) return;\n      if (!isEditingNoteRef.current) {\n        requestClose();\n        return;\n      }\n      event.preventDefault();\n      event.stopPropagation();\n    };\n\n    // A control behind the view can answer the press, the release, or the\n    // click, and those are separate events, so the press alone is not enough to\n    // absorb the interaction.\n    const absorbHandledPress = (event: Event) => {\n      if (!isEditingNoteRef.current || !isOutside(event.target)) return;\n      event.preventDefault();\n      event.stopPropagation();\n    };\n\n    document.addEventListener(\"pointerdown\", onPointerDown, true);\n    document.addEventListener(\"mousedown\", absorbHandledPress, true);\n    document.addEventListener(\"pointerup\", absorbHandledPress, true);\n    document.addEventListener(\"mouseup\", absorbHandledPress, true);\n    document.addEventListener(\"click\", absorbHandledPress, true);\n    return () => {\n      document.removeEventListener(\"pointerdown\", onPointerDown, true);\n      document.removeEventListener(\"mousedown\", absorbHandledPress, true);\n      document.removeEventListener(\"pointerup\", absorbHandledPress, true);\n      document.removeEventListener(\"mouseup\", absorbHandledPress, true);\n      document.removeEventListener(\"click\", absorbHandledPress, true);\n    };\n  }, [requestClose]);\n\n  const [isAddingTag, setIsAddingTag] = useState(false);\n  const [tagDraft, setTagDraft] = useState(\"\");\n  useLayoutEffect(() => {\n    if (isAddingTag) tagInputRef.current?.focus();\n  }, [isAddingTag]);\n\n  // Selection changes reset this local editor state even though the selected ID\n  // is only a trigger and is not read by the reset itself.\n  // biome-ignore lint/correctness/useExhaustiveDependencies: The shown item ID intentionally triggers a reset.\n  useEffect(() => {\n    setIsAddingTag(false);\n    setTagDraft(\"\");\n    setIsSpaceMenuOpen(false);\n  }, [shownItem.id]);\n\n  const allTags = shownItem.tags;\n\n  function submitTag() {\n    const clean = tagDraft.trim().replace(/^#+/u, \"\").toLowerCase();\n    if (clean && !allTags.some((tag) => tag.toLowerCase() === clean)) {\n      void actions.onAddTag?.(shownItem, clean);\n    }\n    setTagDraft(\"\");\n    setIsAddingTag(false);\n  }\n\n  const isFlying = flight !== null;\n  const placedStyle: CSSProperties | undefined =\n    destination && !isFlying\n      ? {\n          left: destination.left,\n          top: destination.top,\n          width: destination.width,\n          height: destination.height,\n        }\n      : undefined;\n\n  const isEditingNoteView = isEditingNote && shownItem.kind === \"Note\";\n  const isFocusModeView = isFocusMode && isEditingNoteView;\n  const isPinned = shownItem.favorite === true;\n  const sourceHost = hostnameForUrl(shownItem.sourceUrl);\n  const memberSpaces = spaces?.filter((space) => space.member) ?? [];\n  const content = contentActions(shownItem, actions);\n  const savedDate = shownItem.date.replace(/^saved\\s+/iu, \"\");\n  const size =\n    shownItem.mediaWidth && shownItem.mediaHeight\n      ? `${shownItem.mediaWidth} × ${shownItem.mediaHeight}`\n      : null;\n\n  return (\n    <div\n      className={`expanded-overlay-layer ${isFocusModeView ? \"is-focus-mode\" : \"\"}`}\n      ref={layerRef}\n    >\n      <section\n        ref={dialogRef}\n        className={`expanded-overlay ${destination ? \"is-placed\" : \"\"} ${isFlying ? \"is-flying\" : \"\"} ${isEditingNoteView ? \"is-editing-note\" : \"\"} ${isFocusModeView ? \"is-focus-mode\" : \"\"}`}\n        role=\"dialog\"\n        aria-modal={false}\n        aria-label={detailTitleFor(shownItem)}\n        style={isFocusModeView ? undefined : placedStyle}\n      >\n        <div className=\"item-stage\">\n          <div className=\"item-stage-title glass\">{detailTitleFor(shownItem)}</div>\n          <OverlayMedia item={shownItem} />\n        </div>\n\n        <aside className=\"item-inspector\">\n          <header className=\"item-inspector-header\">\n            <button\n              type=\"button\"\n              ref={closeButtonRef}\n              className=\"item-close\"\n              onClick={handleOverlayClose}\n              aria-label={\n                isFocusModeView\n                  ? \"Exit focus mode\"\n                  : isEditingNoteView\n                    ? \"Close editor\"\n                    : \"Close details\"\n              }\n            >\n              {isFocusModeView ? \"Exit focus\" : \"Close\"}\n              <kbd>esc</kbd>\n            </button>\n          </header>\n\n          <div className=\"item-inspector-body\">\n            {isEditingNoteView ? (\n              <Suspense\n                fallback={\n                  <p className=\"item-note\" role=\"status\">\n                    Loading editor…\n                  </p>\n                }\n              >\n                <RichNoteEditor\n                  key={`edit-${shownItem.id}`}\n                  embedded\n                  body={shownItem.noteBody}\n                  title={shownItem.title}\n                  onSave={(body) => actions.onUpdateNote(shownItem, body)}\n                  onEditingChange={(editing) => {\n                    setIsEditingNote(editing);\n                    if (!editing) setIsFocusMode(false);\n                  }}\n                  focusMode={isFocusModeView}\n                  onFocusModeChange={setIsFocusMode}\n                />\n              </Suspense>\n            ) : (\n              <>\n                {shownItem.kind === \"Quote\" ? (\n                  <>\n                    <blockquote className=\"detail-quote\">“{shownItem.title}”</blockquote>\n                    {shownItem.description && (\n                      <p className=\"detail-attribution\">\n                        — {shownItem.description.replace(/^—\\s*/u, \"\")}\n                      </p>\n                    )}\n                  </>\n                ) : (\n                  <>\n                    <h2 className=\"item-title\">{detailTitleFor(shownItem)}</h2>\n                    {shownItem.kind !== \"Note\" && shownItem.description && (\n                      <p className=\"item-note\">{shownItem.description}</p>\n                    )}\n                  </>\n                )}\n\n                {shownItem.processing?.active && (\n                  <div className=\"detail-processing\" role=\"status\">\n                    <HugeiconsIcon icon={Loading01Icon} size={14} />\n                    <span>{shownItem.processing.message ?? \"Processing\"}</span>\n                    {shownItem.processing.progressTotal != null && (\n                      <span>\n                        {shownItem.processing.progressCurrent}/{shownItem.processing.progressTotal}\n                      </span>\n                    )}\n                  </div>\n                )}\n                {shownItem.processing?.failedJob && (\n                  <div className=\"detail-processing failed\" role=\"alert\">\n                    <HugeiconsIcon icon={AlertCircleIcon} size={14} />\n                    <span>\n                      {shownItem.processing.failedJob.errorMessage ?? \"Processing failed\"}\n                    </span>\n                    <button\n                      type=\"button\"\n                      className=\"retry-button\"\n                      onClick={() =>\n                        void actions.onRetryJob(shownItem.processing?.failedJob?.id ?? \"\")\n                      }\n                    >\n                      <HugeiconsIcon icon={RotateCwIcon} size={12} /> Try again\n                    </button>\n                  </div>\n                )}\n\n                <div className=\"item-tags\">\n                  {memberSpaces.map((space) => (\n                    <span key={space.id} className=\"item-space-chip\">\n                      <span className={`detail-space-dot ${space.color}`} aria-hidden=\"true\" />\n                      {space.name}\n                    </span>\n                  ))}\n                  {allTags.map((tag) => (\n                    <span key={tag} className=\"item-tag\">\n                      #{tag}\n                    </span>\n                  ))}\n                  {isAddingTag ? (\n                    <input\n                      ref={tagInputRef}\n                      className=\"detail-tag-input\"\n                      value={tagDraft}\n                      placeholder=\"tag name\"\n                      aria-label=\"New tag name\"\n                      onChange={(event) => setTagDraft(event.target.value)}\n                      onKeyDown={(event) => {\n                        if (event.key === \"Enter\") {\n                          event.preventDefault();\n                          submitTag();\n                        } else if (event.key === \"Escape\") {\n                          setTagDraft(\"\");\n                          setIsAddingTag(false);\n                        }\n                      }}\n                      onBlur={submitTag}\n                    />\n                  ) : (\n                    <button\n                      type=\"button\"\n                      className=\"item-tag-add\"\n                      onClick={() => setIsAddingTag(true)}\n                      aria-label=\"Add a tag\"\n                    >\n                      <HugeiconsIcon icon={PlusSignIcon} size={11} />\n                    </button>\n                  )}\n                </div>\n\n                <dl className=\"item-details\">\n                  <dt className=\"item-details-label\">Details</dt>\n                  <div>\n                    <dt>Saved</dt>\n                    <dd>{savedDate}</dd>\n                  </div>\n                  {(sourceHost || shownItem.source) && (\n                    <div>\n                      <dt>From</dt>\n                      <dd>{sourceHost ?? shownItem.source}</dd>\n                    </div>\n                  )}\n                  <div>\n                    <dt>Type</dt>\n                    <dd>{fileTypeFor(shownItem)}</dd>\n                  </div>\n                  {size && (\n                    <div>\n                      <dt>Size</dt>\n                      <dd className=\"is-mono\">{size}</dd>\n                    </div>\n                  )}\n                </dl>\n\n                {(content.length > 0 || shownItem.kind === \"Note\") && (\n                  <div className=\"item-actions\">\n                    {shownItem.kind === \"Note\" && (\n                      <button\n                        type=\"button\"\n                        onClick={() => {\n                          setIsFocusMode(false);\n                          setIsEditingNote(true);\n                        }}\n                      >\n                        Edit note\n                      </button>\n                    )}\n                    {content.map((action) => (\n                      <button\n                        type=\"button\"\n                        key={action.key}\n                        onClick={action.onClick}\n                        disabled={action.disabled}\n                        title={action.title}\n                      >\n                        {action.icon} {action.label}\n                      </button>\n                    ))}\n                  </div>\n                )}\n              </>\n            )}\n          </div>\n\n          {!isEditingNoteView && (\n            <footer className=\"item-action-bar\">\n              {isSpaceMenuOpen && spaces && spaces.length > 0 && (\n                <fieldset className=\"item-space-menu\">\n                  <legend className=\"visually-hidden\">Regular Spaces</legend>\n                  {spaces.map((space) => (\n                    <button\n                      key={space.id}\n                      type=\"button\"\n                      className={`detail-space ${space.member ? \"is-member\" : \"\"}`}\n                      aria-pressed={space.member}\n                      title={space.member ? `Remove from ${space.name}` : `Add to ${space.name}`}\n                      onClick={() => void actions.onToggleSpace?.(shownItem, space.id)}\n                    >\n                      <span className={`detail-space-dot ${space.color}`} aria-hidden=\"true\" />\n                      <span className=\"detail-space-name\">{space.name}</span>\n                    </button>\n                  ))}\n                </fieldset>\n              )}\n              <button\n                type=\"button\"\n                className=\"item-bar-button\"\n                onClick={() => void actions.onTogglePin(shownItem)}\n                aria-label={isPinned ? \"Unstar\" : \"Star to Top of mind\"}\n                aria-pressed={isPinned}\n                title={isPinned ? \"Unstar\" : \"Star to Top of mind\"}\n              >\n                <HugeiconsIcon icon={StarIcon} size={15} />\n              </button>\n              {spaces && spaces.length > 0 && (\n                <button\n                  type=\"button\"\n                  className=\"item-bar-button\"\n                  onClick={() => setIsSpaceMenuOpen((open) => !open)}\n                  aria-label=\"Move to Space\"\n                  aria-expanded={isSpaceMenuOpen}\n                  title=\"Move to Space\"\n                >\n                  <HugeiconsIcon icon={FolderAddIcon} size={15} />\n                </button>\n              )}\n              {shownItem.sourceUrl && (\n                <button\n                  type=\"button\"\n                  className=\"item-bar-button\"\n                  onClick={() =>\n                    window.open(shownItem.sourceUrl, \"_blank\", \"noopener,noreferrer\")\n                  }\n                  aria-label={`Open ${sourceHost ?? \"original\"}`}\n                  title={`Open ${sourceHost ?? \"original\"}`}\n                >\n                  <HugeiconsIcon icon={ArrowUpRight01Icon} size={15} />\n                </button>\n              )}\n              <button\n                type=\"button\"\n                className=\"item-bar-button\"\n                onClick={() => void actions.onForget(shownItem)}\n                aria-label=\"Archive\"\n                title=\"Archive\"\n              >\n                <HugeiconsIcon icon={Archive01Icon} size={15} />\n              </button>\n            </footer>\n          )}\n        </aside>\n      </section>\n    </div>\n  );\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3880,"cache_read_input_tokens":145801,"output_tokens":12748,"output_tokens_details":{"thinking_tokens":77},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":3880,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":12748,"cache_read_input_tokens":145801,"cache_creation_input_tokens":3880,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3880},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01KMhroKxLx6i2KeRqqWH1D2":{"file_path":"C:\\Users\\chris\\.t3\\worktrees\\inkling\\t3-47ff5304\\src\\components\\ExpandedItemOverlay.tsx","content":"import {\n  lazy,\n  Suspense,\n  useCallback,\n  useEffect,\n  useLayoutEffect,\n  useRef,\n  useState,\n  type CSSProperties,\n  type ReactNode,\n  type RefObject,\n} from \"react\";\nimport { gsap } from \"gsap\";\nimport { HugeiconsIcon } from \"@hugeicons/react\";\nimport {\n  AlertCircleIcon,\n  Archive01Icon,\n  ArrowUpRight01Icon,\n  BookOpen01Icon,\n  FileTextIcon,\n  FolderAddIcon,\n  Loading01Icon,\n  PlusSignIcon,\n  RotateCwIcon,\n  SparklesIcon,\n  StarIcon,\n} from \"@hugeicons/core-free-icons\";\nimport type { LibraryItem } from \"../lib/types\";\nimport { isElectronRuntime } from \"../lib/libraryApi\";\nimport type { ReaderOrigin } from \"../ReaderView\";\nimport {\n  KindIcon,\n  NoteArtwork,\n  PdfArtwork,\n  PostArtwork,\n  XPostEmbed,\n  DetailVideoMedia,\n  pdfPreviewTitle,\n} from \"./ItemMedia\";\nimport {\n  OVERLAY_EASE,\n  OVERLAY_FLIGHT_MS,\n  prefersReducedMotion,\n  queryCardRects,\n  rectFrom,\n  type FlightRect,\n  type SourceRects,\n} from \"./overlayMotion\";\n\nconst RichNoteEditor = lazy(() =>\n  import(\"./RichNoteEditor\").then((module) => ({ default: module.RichNoteEditor })),\n);\n\nexport type ExpandedOverlayActions = {\n  onClose: () => void;\n  onOpenPdf: (item: LibraryItem) => void;\n  onOpenReader: (item: LibraryItem, origin: ReaderOrigin) => void;\n  onFindSimilar: (item: LibraryItem) => void;\n  onForget: (item: LibraryItem) => void | Promise<void>;\n  onTogglePin: (item: LibraryItem) => void | Promise<void>;\n  onRetryJob: (jobId: string) => void | Promise<void>;\n  onAddTag?: (item: LibraryItem, tag: string) => void | Promise<void>;\n  onUpdateNote: (item: LibraryItem, body: string) => void | Promise<void>;\n  onToggleSpace?: (item: LibraryItem, spaceId: string) => void | Promise<void>;\n  isFindingSimilar: boolean;\n};\n\n/** A Regular Space chip: filing an item in and taking it back out happen in the\n *  same place, so one toggle carries both directions. */\nexport type OverlaySpaceChip = {\n  id: string;\n  name: string;\n  color: string;\n  member: boolean;\n};\n\ntype OverlayAction = {\n  key: string;\n  label: string;\n  icon: ReactNode;\n  onClick: (event: React.MouseEvent<HTMLButtonElement>) => void;\n  disabled?: boolean;\n  title?: string;\n};\n\ntype Flight =\n  | { kind: \"open\"; id: number; from: FlightRect; to: FlightRect }\n  | {\n      kind: \"close\";\n      id: number;\n      fromItem: LibraryItem;\n      from: FlightRect;\n      to: FlightRect | null;\n      thenOpen: boolean;\n    };\n\n// The settled view's corners match the library frame it covers.\nconst FRAME_RADIUS = \"16px 0px 0px 16px\";\n\nfunction clickOrigin(event: React.MouseEvent<HTMLElement>): ReaderOrigin {\n  const rect = event.currentTarget.getBoundingClientRect();\n  return { x: rect.left + rect.width / 2, y: rect.top + rect.height / 2 };\n}\n\nfunction hostnameForUrl(url: string | undefined): string | null {\n  if (!url) return null;\n  try {\n    return new URL(url).hostname.replace(/^www\\./u, \"\");\n  } catch {\n    return null;\n  }\n}\n\nfunction fileTypeFor(item: LibraryItem): string {\n  if (item.kind === \"Image\") {\n    const match = item.image?.split(\"?\")[0].match(/\\.([a-z0-9]{2,5})$/iu);\n    if (match) {\n      const extension = match[1].toLowerCase();\n      return extension === \"jpeg\" ? \"JPG\" : extension.toUpperCase();\n    }\n    return \"JPG\";\n  }\n  switch (item.kind) {\n    case \"PDF\":\n      return \"PDF\";\n    case \"Video\":\n      return \"Video\";\n    case \"Article\":\n      return \"Link\";\n    case \"Post\":\n      return \"Post\";\n    case \"Note\":\n      return \"Note\";\n    case \"Quote\":\n      return \"Quote\";\n    default:\n      return \"File\";\n  }\n}\n\n// Content actions sit under the details: read, open the PDF, find similar.\n// Item housekeeping (star, Spaces, open original, archive) lives in the\n// action bar at the bottom of the inspector instead.\nfunction contentActions(item: LibraryItem, actions: ExpandedOverlayActions): OverlayAction[] {\n  const list: OverlayAction[] = [];\n  const hasReaderContent = Boolean(item.articleHtml || item.hasArticleContent);\n  if (item.kind === \"PDF\" && item.fileUrl) {\n    list.push({\n      key: \"open-pdf\",\n      label: \"Open PDF\",\n      icon: <HugeiconsIcon icon={FileTextIcon} size={14} />,\n      onClick: () => actions.onOpenPdf(item),\n    });\n  }\n  if (item.kind === \"Article\" && hasReaderContent) {\n    list.push({\n      key: \"read\",\n      label: \"Read\",\n      icon: <HugeiconsIcon icon={BookOpen01Icon} size={14} />,\n      onClick: (event) => actions.onOpenReader(item, clickOrigin(event)),\n    });\n  }\n  if (isElectronRuntime() && [\"Image\", \"Article\", \"Note\", \"Quote\"].includes(item.kind)) {\n    list.push({\n      key: \"find-similar\",\n      label: actions.isFindingSimilar ? \"Finding similar…\" : \"Find similar\",\n      icon: <HugeiconsIcon icon={SparklesIcon} size={14} />,\n      onClick: () => actions.onFindSimilar(item),\n      disabled: actions.isFindingSimilar,\n    });\n  }\n  return list;\n}\n\nfunction OverlayMedia({ item }: { item: LibraryItem }) {\n  if (item.kind === \"Note\" && !item.image) {\n    return (\n      <div className=\"item-stage-art note-detail-media\">\n        <NoteArtwork item={item} />\n      </div>\n    );\n  }\n\n  if (item.social?.provider === \"x\") {\n    return (\n      <div className=\"item-stage-art detail-x-post\">\n        <XPostEmbed\n          key={item.social.postUrl}\n          social={item.social}\n          fallback={\n            item.post ? (\n              <PostArtwork post={item.post} />\n            ) : (\n              <div className=\"detail-art ink\">Post preview unavailable.</div>\n            )\n          }\n        />\n      </div>\n    );\n  }\n\n  if (item.kind === \"Video\") {\n    return (\n      <div className=\"item-stage-art\">\n        <DetailVideoMedia item={item} />\n      </div>\n    );\n  }\n\n  if (item.kind === \"PDF\") {\n    return (\n      <div className=\"item-stage-art\">\n        <PdfArtwork item={item} />\n      </div>\n    );\n  }\n\n  if (item.image) {\n    return <img src={item.image} alt={item.imageAlt ?? item.title} className=\"item-stage-image\" />;\n  }\n\n  if (item.kind === \"Quote\") {\n    return (\n      <div className=\"item-stage-art\">\n        <div className=\"detail-art detail-quote-art paper-yellow\">\n          <span className=\"detail-quote-mark\">“</span>\n          <span>{item.kind}</span>\n        </div>\n      </div>\n    );\n  }\n\n  if (item.kind === \"Post\" && item.post) {\n    return (\n      <div className=\"item-stage-art\">\n        <PostArtwork post={item.post} />\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"item-stage-art\">\n      <div className={`detail-art ${item.accent ?? \"ink\"}`}>\n        <KindIcon kind={item.kind} />\n        <span>{item.kind}</span>\n      </div>\n    </div>\n  );\n}\n\nfunction detailTitleFor(item: LibraryItem): string {\n  return item.kind === \"PDF\" ? pdfPreviewTitle(item.title) || item.title : item.title;\n}\n\ntype ExpandedItemOverlayProps = {\n  item: LibraryItem;\n  actions: ExpandedOverlayActions;\n  /** Regular Spaces available to file this item in. Empty hides the Space control. */\n  spaces?: OverlaySpaceChip[];\n  originRectsRef: RefObject<SourceRects | null>;\n  /** The library frame the item view covers once it settles. */\n  frameRef: RefObject<HTMLElement | null>;\n};\n\nexport function ExpandedItemOverlay({\n  item,\n  actions,\n  spaces,\n  originRectsRef,\n  frameRef,\n}: ExpandedItemOverlayProps) {\n  const layerRef = useRef<HTMLDivElement>(null);\n  const dialogRef = useRef<HTMLElement>(null);\n  const closeButtonRef = useRef<HTMLButtonElement>(null);\n  const tagInputRef = useRef<HTMLInputElement>(null);\n  const itemIdRef = useRef(item.id);\n  const itemRef = useRef(item);\n  const previousItemRef = useRef(item);\n  const flightIdRef = useRef(0);\n  const flightRef = useRef<Flight | null>(null);\n  const cancelPendingOpenRef = useRef(false);\n  const hasSettledOnceRef = useRef(false);\n  const actionsRef = useRef(actions);\n  const [destination, setDestination] = useState<FlightRect | null>(null);\n  const [flight, setFlight] = useState<Flight | null>(null);\n  const [pendingOpen, setPendingOpen] = useState(false);\n  const [isEditingNote, setIsEditingNote] = useState(false);\n  const [isFocusMode, setIsFocusMode] = useState(false);\n  const [isSpaceMenuOpen, setIsSpaceMenuOpen] = useState(false);\n  const isEditingNoteRef = useRef(false);\n  const isFocusModeRef = useRef(false);\n\n  // Mirror props into refs inside an effect, never during render, so a\n  // concurrent render cannot publish a half-updated set. This runs before\n  // the flight effects below, which read these refs.\n  useLayoutEffect(() => {\n    itemIdRef.current = item.id;\n    itemRef.current = item;\n    flightRef.current = flight;\n  }, [item, flight]);\n\n  useLayoutEffect(() => {\n    isEditingNoteRef.current = isEditingNote;\n    isFocusModeRef.current = isFocusMode;\n  }, [isEditingNote, isFocusMode]);\n\n  // The item whose content the view shows. During a closing flight that was\n  // triggered by switching items, the view flies back displaying the item it\n  // was showing, while React's item prop already points at the next one.\n  const shownItem = flight?.kind === \"close\" ? flight.fromItem : item;\n\n  const frameRect = useCallback((): FlightRect => {\n    const rect = frameRef.current?.getBoundingClientRect();\n    if (rect) return rectFrom(rect);\n    return { left: 0, top: 0, width: window.innerWidth, height: window.innerHeight };\n  }, [frameRef]);\n\n  // Grows the view from a card-sized rectangle into the library frame.\n  const beginOpenFlight = useCallback(\n    (from: FlightRect) => {\n      const to = frameRect();\n      setDestination(to);\n      flightIdRef.current += 1;\n      setFlight({ kind: \"open\", id: flightIdRef.current, from, to });\n    },\n    [frameRect],\n  );\n\n  const beginCloseFlight = useCallback(\n    (closingItem: LibraryItem, to: FlightRect | null, thenOpen: boolean) => {\n      const dialog = dialogRef.current;\n      if (!dialog) {\n        actionsRef.current.onClose();\n        return;\n      }\n      flightIdRef.current += 1;\n      setFlight({\n        kind: \"close\",\n        id: flightIdRef.current,\n        fromItem: closingItem,\n        from: rectFrom(dialog.getBoundingClientRect()),\n        to,\n        thenOpen,\n      });\n    },\n    [],\n  );\n\n  const requestClose = useCallback(() => {\n    const activeFlight = flightRef.current;\n    if (activeFlight?.kind === \"close\") {\n      if (activeFlight.thenOpen) cancelPendingOpenRef.current = true;\n      return;\n    }\n    const rects = queryCardRects(itemIdRef.current);\n    if (prefersReducedMotion() || !rects || !dialogRef.current) {\n      if (flightRef.current) setFlight(null);\n      gsap.to(layerRef.current, {\n        opacity: 0,\n        duration: 0.15,\n        onComplete: actionsRef.current.onClose,\n      });\n      return;\n    }\n    cancelPendingOpenRef.current = false;\n    beginCloseFlight(itemRef.current, rects.card, false);\n  }, [beginCloseFlight]);\n\n  // The origin rectangle is a one-time snapshot supplied through a mutable ref.\n  // Reading it again after opening would retarget the flight to a stale card.\n  // biome-ignore lint/correctness/useExhaustiveDependencies: This effect consumes the source-rectangle snapshot once on mount.\n  useLayoutEffect(() => {\n    const originRects = originRectsRef.current;\n    if (!originRects || prefersReducedMotion()) {\n      setDestination(frameRect());\n      gsap.fromTo(\n        layerRef.current,\n        { opacity: 0 },\n        { opacity: 1, duration: 0.18, ease: \"power1.out\" },\n      );\n      return;\n    }\n    beginOpenFlight(originRects.card);\n  }, [beginOpenFlight]);\n\n  // Runs every flight. GSAP owns only the view's outer rectangle. While it\n  // flies, the stage fills the whole rectangle and the inspector is hidden, so\n  // the card reads as its own image growing into the frame; the inspector and\n  // the stage's margins ease in by CSS once it lands.\n  useLayoutEffect(() => {\n    if (!flight) return;\n    const dialog = dialogRef.current;\n    if (!dialog) {\n      if (flight.kind === \"close\") actionsRef.current.onClose();\n      return;\n    }\n    const cardRadius = `${getComputedStyle(dialog).getPropertyValue(\"--sidebar-radius\").trim() || \"14px\"}`;\n    const cardCorners = `${cardRadius} ${cardRadius} ${cardRadius} ${cardRadius}`;\n    const duration = OVERLAY_FLIGHT_MS / 1000;\n\n    if (flight.kind === \"open\") {\n      const timeline = gsap.timeline({\n        onComplete: () => {\n          setFlight(null);\n          closeButtonRef.current?.focus({ preventScroll: true });\n        },\n      });\n      timeline\n        .fromTo(\n          dialog,\n          { ...flight.from, borderRadius: cardCorners },\n          { ...flight.to, borderRadius: FRAME_RADIUS, duration, ease: OVERLAY_EASE, autoRound: false },\n          0,\n        )\n        .fromTo(dialog, { opacity: 0 }, { opacity: 1, duration: 0.12, ease: \"power1.out\" }, 0);\n      return () => {\n        timeline.kill();\n      };\n    }\n\n    // Closing: the view returns to its source card and dissolves into it, or —\n    // when the source card is no longer mounted — fades out in place.\n    const timeline = gsap.timeline({\n      onComplete: () => {\n        if (flight.thenOpen && !cancelPendingOpenRef.current) {\n          setFlight(null);\n          setPendingOpen(true);\n        } else {\n          actionsRef.current.onClose();\n        }\n      },\n    });\n    if (flight.to) {\n      timeline\n        .fromTo(\n          dialog,\n          { ...flight.from },\n          { ...flight.to, borderRadius: cardCorners, duration, ease: OVERLAY_EASE, autoRound: false },\n          0,\n        )\n        .to(dialog, { opacity: 0, duration: 0.18, ease: \"power1.in\" }, duration - 0.18);\n    } else {\n      timeline.to(dialog, { opacity: 0, duration: 0.25, ease: \"power1.in\" });\n    }\n    return () => {\n      timeline.kill();\n    };\n  }, [flight]);\n\n  // Follows the frame when the window resizes or the sidebar opens or closes.\n  useEffect(() => {\n    const frame = frameRef.current;\n    if (!frame) return;\n    const observer = new ResizeObserver(() => {\n      if (flightRef.current) return;\n      setDestination(frameRect());\n    });\n    observer.observe(frame);\n    return () => observer.disconnect();\n  }, [frameRef, frameRect]);\n\n  // Switching items while the view is open runs sequentially: the open view\n  // first flies back into the card it was showing, and only after it lands\n  // does the newly selected item open from its own card. Rapid selections\n  // during the closing leg are absorbed — the flight completes once and then\n  // opens the most recently selected item.\n  useLayoutEffect(() => {\n    const previous = previousItemRef.current;\n    if (previous.id === item.id) return;\n    previousItemRef.current = item;\n    if (isEditingNoteRef.current) {\n      // Leave the editor rather than carry the draft onto another item.\n      setIsEditingNote(false);\n      setIsFocusMode(false);\n    }\n\n    const activeFlight = flightRef.current;\n    if (activeFlight?.kind === \"close\") return;\n    if (activeFlight?.kind === \"open\") {\n      // Retarget the in-progress open from its current visual state.\n      const dialog = dialogRef.current;\n      if (!dialog) return;\n      cancelPendingOpenRef.current = false;\n      beginOpenFlight(rectFrom(dialog.getBoundingClientRect()));\n      return;\n    }\n\n    // Settled: close into the old card, then open the new selection.\n    cancelPendingOpenRef.current = false;\n    beginCloseFlight(previous, queryCardRects(previous.id)?.card ?? null, /* thenOpen */ true);\n  }, [item, beginOpenFlight, beginCloseFlight]);\n\n  // When a sequential switch's closing leg lands, open the newly selected\n  // item from its own card.\n  useLayoutEffect(() => {\n    if (!pendingOpen || flight) return;\n    setPendingOpen(false);\n    if (cancelPendingOpenRef.current) {\n      cancelPendingOpenRef.current = false;\n      actionsRef.current.onClose();\n      return;\n    }\n    const rects = queryCardRects(itemRef.current.id);\n    if (!rects) {\n      actionsRef.current.onClose();\n      return;\n    }\n    beginOpenFlight(rects.card);\n  }, [pendingOpen, flight, beginOpenFlight]);\n\n  // On close, hand focus back to the source card while it is still mounted.\n  // Skipping the restore when focus already moved elsewhere (nav, search)\n  // avoids yanking it back out of whatever the user clicked.\n  useEffect(\n    () => () => {\n      const focusOwner = document.activeElement;\n      const overlayHasFocus =\n        focusOwner instanceof HTMLElement && (dialogRef.current?.contains(focusOwner) ?? false);\n      if (!overlayHasFocus && focusOwner !== document.body) return;\n      const card = document.querySelector<HTMLElement>(\n        `.library-card[data-library-item-id=\"${CSS.escape(String(itemIdRef.current))}\"]`,\n      );\n      card?.focus({ preventScroll: true });\n    },\n    [],\n  );\n\n  // Move focus to the close control when the view finishes opening.\n  useLayoutEffect(() => {\n    if (flight || !destination || hasSettledOnceRef.current) return;\n    hasSettledOnceRef.current = true;\n    closeButtonRef.current?.focus({ preventScroll: true });\n  }, [flight, destination]);\n\n  actionsRef.current = actions;\n\n  const handleOverlayClose = () => {\n    if (isFocusModeRef.current) {\n      setIsFocusMode(false);\n      return;\n    }\n    if (isEditingNoteRef.current) {\n      setIsEditingNote(false);\n      return;\n    }\n    requestClose();\n  };\n\n  useEffect(() => {\n    const onKeyDown = (event: KeyboardEvent) => {\n      if (event.key !== \"Escape\") return;\n      // A field inside the view owns its own Escape: the new-tag input and\n      // the editor's link URL field each cancel just themselves. This listener\n      // runs in the capture phase, before their handlers get a chance to.\n      if (event.target instanceof HTMLInputElement) return;\n      event.stopPropagation();\n      if (isFocusModeRef.current) {\n        setIsFocusMode(false);\n        return;\n      }\n      if (isEditingNoteRef.current) {\n        setIsEditingNote(false);\n        return;\n      }\n      requestClose();\n    };\n    window.addEventListener(\"keydown\", onKeyDown, true);\n    return () => window.removeEventListener(\"keydown\", onKeyDown, true);\n  }, [requestClose]);\n\n  // Presses outside the view (the sidebar, the search bar) close it, except\n  // the edge tab, which only folds the sidebar away. While a note is being\n  // written every outside press is absorbed instead, so it cannot silently\n  // throw away what was just typed. The close button, Escape and Save are the\n  // ways out.\n  useEffect(() => {\n    const isOutside = (target: EventTarget | null) => {\n      if (!(target instanceof Node)) return false;\n      if (dialogRef.current?.contains(target)) return false;\n      return !(target instanceof Element && target.closest(\".edge-tab\"));\n    };\n\n    const onPointerDown = (event: PointerEvent) => {\n      if (!isOutside(event.target)) return;\n      if (!isEditingNoteRef.current) {\n        requestClose();\n        return;\n      }\n      event.preventDefault();\n      event.stopPropagation();\n    };\n\n    // A control behind the view can answer the press, the release, or the\n    // click, and those are separate events, so the press alone is not enough to\n    // absorb the interaction.\n    const absorbHandledPress = (event: Event) => {\n      if (!isEditingNoteRef.current || !isOutside(event.target)) return;\n      event.preventDefault();\n      event.stopPropagation();\n    };\n\n    document.addEventListener(\"pointerdown\", onPointerDown, true);\n    document.addEventListener(\"mousedown\", absorbHandledPress, true);\n    document.addEventListener(\"pointerup\", absorbHandledPress, true);\n    document.addEventListener(\"mouseup\", absorbHandledPress, true);\n    document.addEventListener(\"click\", absorbHandledPress, true);\n    return () => {\n      document.removeEventListener(\"pointerdown\", onPointerDown, true);\n      document.removeEventListener(\"mousedown\", absorbHandledPress, true);\n      document.removeEventListener(\"pointerup\", absorbHandledPress, true);\n      document.removeEventListener(\"mouseup\", absorbHandledPress, true);\n      document.removeEventListener(\"click\", absorbHandledPress, true);\n    };\n  }, [requestClose]);\n\n  const [isAddingTag, setIsAddingTag] = useState(false);\n  const [tagDraft, setTagDraft] = useState(\"\");\n  useLayoutEffect(() => {\n    if (isAddingTag) tagInputRef.current?.focus();\n  }, [isAddingTag]);\n\n  // Selection changes reset this local editor state even though the selected ID\n  // is only a trigger and is not read by the reset itself.\n  // biome-ignore lint/correctness/useExhaustiveDependencies: The shown item ID intentionally triggers a reset.\n  useEffect(() => {\n    setIsAddingTag(false);\n    setTagDraft(\"\");\n    setIsSpaceMenuOpen(false);\n  }, [shownItem.id]);\n\n  const allTags = shownItem.tags;\n\n  function submitTag() {\n    const clean = tagDraft.trim().replace(/^#+/u, \"\").toLowerCase();\n    if (clean && !allTags.some((tag) => tag.toLowerCase() === clean)) {\n      void actions.onAddTag?.(shownItem, clean);\n    }\n    setTagDraft(\"\");\n    setIsAddingTag(false);\n  }\n\n  const isFlying = flight !== null;\n  const placedStyle: CSSProperties | undefined =\n    destination && !isFlying\n      ? {\n          left: destination.left,\n          top: destination.top,\n          width: destination.width,\n          height: destination.height,\n        }\n      : undefined;\n\n  const isEditingNoteView = isEditingNote && shownItem.kind === \"Note\";\n  const isFocusModeView = isFocusMode && isEditingNoteView;\n  const isPinned = shownItem.favorite === true;\n  const sourceHost = hostnameForUrl(shownItem.sourceUrl);\n  const memberSpaces = spaces?.filter((space) => space.member) ?? [];\n  const content = contentActions(shownItem, actions);\n  const savedDate = shownItem.date.replace(/^saved\\s+/iu, \"\");\n  const size =\n    shownItem.mediaWidth && shownItem.mediaHeight\n      ? `${shownItem.mediaWidth} × ${shownItem.mediaHeight}`\n      : null;\n\n  return (\n    <div\n      className={`expanded-overlay-layer ${isFocusModeView ? \"is-focus-mode\" : \"\"}`}\n      ref={layerRef}\n    >\n      <section\n        ref={dialogRef}\n        className={`expanded-overlay ${destination ? \"is-placed\" : \"\"} ${isFlying ? \"is-flying\" : \"\"} ${isEditingNoteView ? \"is-editing-note\" : \"\"} ${isFocusModeView ? \"is-focus-mode\" : \"\"}`}\n        role=\"dialog\"\n        aria-modal={false}\n        aria-label={detailTitleFor(shownItem)}\n        style={isFocusModeView ? undefined : placedStyle}\n      >\n        <div className=\"item-stage\">\n          <div className=\"item-stage-title glass\">{detailTitleFor(shownItem)}</div>\n          <OverlayMedia item={shownItem} />\n        </div>\n\n        <aside className=\"item-inspector\">\n          <header className=\"item-inspector-header\">\n            <button\n              type=\"button\"\n              ref={closeButtonRef}\n              className=\"item-close\"\n              onClick={handleOverlayClose}\n              aria-label={\n                isFocusModeView\n                  ? \"Exit focus mode\"\n                  : isEditingNoteView\n                    ? \"Close editor\"\n                    : \"Close details\"\n              }\n            >\n              {isFocusModeView ? \"Exit focus\" : \"Close\"}\n              <kbd>esc</kbd>\n            </button>\n          </header>\n\n          <div className=\"item-inspector-body\">\n            {isEditingNoteView ? (\n              <Suspense\n                fallback={\n                  <p className=\"item-note\" role=\"status\">\n                    Loading editor…\n                  </p>\n                }\n              >\n                <RichNoteEditor\n                  key={`edit-${shownItem.id}`}\n                  embedded\n                  body={shownItem.noteBody}\n                  title={shownItem.title}\n                  onSave={(body) => actions.onUpdateNote(shownItem, body)}\n                  onEditingChange={(editing) => {\n                    setIsEditingNote(editing);\n                    if (!editing) setIsFocusMode(false);\n                  }}\n                  focusMode={isFocusModeView}\n                  onFocusModeChange={setIsFocusMode}\n                />\n              </Suspense>\n            ) : (\n              <>\n                {shownItem.kind === \"Quote\" ? (\n                  <>\n                    <blockquote className=\"detail-quote\">“{shownItem.title}”</blockquote>\n                    {shownItem.description && (\n                      <p className=\"detail-attribution\">\n                        — {shownItem.description.replace(/^—\\s*/u, \"\")}\n                      </p>\n                    )}\n                  </>\n                ) : (\n                  <>\n                    <h2 className=\"item-title\">{detailTitleFor(shownItem)}</h2>\n                    {shownItem.kind !== \"Note\" && shownItem.description && (\n                      <p className=\"item-note\">{shownItem.description}</p>\n                    )}\n                  </>\n                )}\n\n                {shownItem.processing?.active && (\n                  <div className=\"detail-processing\" role=\"status\">\n                    <HugeiconsIcon icon={Loading01Icon} size={14} />\n                    <span>{shownItem.processing.message ?? \"Processing\"}</span>\n                    {shownItem.processing.progressTotal != null && (\n                      <span>\n                        {shownItem.processing.progressCurrent}/{shownItem.processing.progressTotal}\n                      </span>\n                    )}\n                  </div>\n                )}\n                {shownItem.processing?.failedJob && (\n                  <div className=\"detail-processing failed\" role=\"alert\">\n                    <HugeiconsIcon icon={AlertCircleIcon} size={14} />\n                    <span>\n                      {shownItem.processing.failedJob.errorMessage ?? \"Processing failed\"}\n                    </span>\n                    <button\n                      type=\"button\"\n                      className=\"retry-button\"\n                      onClick={() =>\n                        void actions.onRetryJob(shownItem.processing?.failedJob?.id ?? \"\")\n                      }\n                    >\n                      <HugeiconsIcon icon={RotateCwIcon} size={12} /> Try again\n                    </button>\n                  </div>\n                )}\n\n                <div className=\"item-tags\">\n                  {memberSpaces.map((space) => (\n                    <span key={space.id} className=\"item-space-chip\">\n                      <span className={`detail-space-dot ${space.color}`} aria-hidden=\"true\" />\n                      {space.name}\n                    </span>\n                  ))}\n                  {allTags.map((tag) => (\n                    <span key={tag} className=\"item-tag\">\n                      #{tag}\n                    </span>\n                  ))}\n                  {isAddingTag ? (\n                    <input\n                      ref={tagInputRef}\n                      className=\"detail-tag-input\"\n                      value={tagDraft}\n                      placeholder=\"tag name\"\n                      aria-label=\"New tag name\"\n                      onChange={(event) => setTagDraft(event.target.value)}\n                      onKeyDown={(event) => {\n                        if (event.key === \"Enter\") {\n                          event.preventDefault();\n                          submitTag();\n                        } else if (event.key === \"Escape\") {\n                          setTagDraft(\"\");\n                          setIsAddingTag(false);\n                        }\n                      }}\n                      onBlur={submitTag}\n                    />\n                  ) : (\n                    <button\n                      type=\"button\"\n                      className=\"item-tag-add\"\n                      onClick={() => setIsAddingTag(true)}\n                      aria-label=\"Add a tag\"\n                    >\n                      <HugeiconsIcon icon={PlusSignIcon} size={11} />\n                    </button>\n                  )}\n                </div>\n\n                <dl className=\"item-details\">\n                  <dt className=\"item-details-label\">Details</dt>\n                  <div>\n                    <dt>Saved</dt>\n                    <dd>{savedDate}</dd>\n                  </div>\n                  {(sourceHost || shownItem.source) && (\n                    <div>\n                      <dt>From</dt>\n                      <dd>{sourceHost ?? shownItem.source}</dd>\n                    </div>\n                  )}\n                  <div>\n                    <dt>Type</dt>\n                    <dd>{fileTypeFor(shownItem)}</dd>\n                  </div>\n                  {size && (\n                    <div>\n                      <dt>Size</dt>\n                      <dd className=\"is-mono\">{size}</dd>\n                    </div>\n                  )}\n                </dl>\n\n                {(content.length > 0 || shownItem.kind === \"Note\") && (\n                  <div className=\"item-actions\">\n                    {shownItem.kind === \"Note\" && (\n                      <button\n                        type=\"button\"\n                        onClick={() => {\n                          setIsFocusMode(false);\n                          setIsEditingNote(true);\n                        }}\n                      >\n                        Edit note\n                      </button>\n                    )}\n                    {content.map((action) => (\n                      <button\n                        type=\"button\"\n                        key={action.key}\n                        onClick={action.onClick}\n                        disabled={action.disabled}\n                        title={action.title}\n                      >\n                        {action.icon} {action.label}\n                      </button>\n                    ))}\n                  </div>\n                )}\n              </>\n            )}\n          </div>\n\n          {!isEditingNoteView && (\n            <footer className=\"item-action-bar\">\n              {isSpaceMenuOpen && spaces && spaces.length > 0 && (\n                <fieldset className=\"item-space-menu\">\n                  <legend className=\"visually-hidden\">Regular Spaces</legend>\n                  {spaces.map((space) => (\n                    <button\n                      key={space.id}\n                      type=\"button\"\n                      className={`detail-space ${space.member ? \"is-member\" : \"\"}`}\n                      aria-pressed={space.member}\n                      title={space.member ? `Remove from ${space.name}` : `Add to ${space.name}`}\n                      onClick={() => void actions.onToggleSpace?.(shownItem, space.id)}\n                    >\n                      <span className={`detail-space-dot ${space.color}`} aria-hidden=\"true\" />\n                      <span className=\"detail-space-name\">{space.name}</span>\n                    </button>\n                  ))}\n                </fieldset>\n              )}\n              <button\n                type=\"button\"\n                className=\"item-bar-button\"\n                onClick={() => void actions.onTogglePin(shownItem)}\n                aria-label={isPinned ? \"Unstar\" : \"Star to Top of mind\"}\n                aria-pressed={isPinned}\n                title={isPinned ? \"Unstar\" : \"Star to Top of mind\"}\n              >\n                <HugeiconsIcon icon={StarIcon} size={15} />\n              </button>\n              {spaces && spaces.length > 0 && (\n                <button\n                  type=\"button\"\n                  className=\"item-bar-button\"\n                  onClick={() => setIsSpaceMenuOpen((open) => !open)}\n                  aria-label=\"Move to Space\"\n                  aria-expanded={isSpaceMenuOpen}\n                  title=\"Move to Space\"\n                >\n                  <HugeiconsIcon icon={FolderAddIcon} size={15} />\n                </button>\n              )}\n              {shownItem.sourceUrl && (\n                <button\n                  type=\"button\"\n                  className=\"item-bar-button\"\n                  onClick={() =>\n                    window.open(shownItem.sourceUrl, \"_blank\", \"noopener,noreferrer\")\n                  }\n                  aria-label={`Open ${sourceHost ?? \"original\"}`}\n                  title={`Open ${sourceHost ?? \"original\"}`}\n                >\n                  <HugeiconsIcon icon={ArrowUpRight01Icon} size={15} />\n                </button>\n              )}\n              <button\n                type=\"button\"\n                className=\"item-bar-button\"\n                onClick={() => void actions.onForget(shownItem)}\n                aria-label=\"Archive\"\n                title=\"Archive\"\n              >\n                <HugeiconsIcon icon={Archive01Icon} size={15} />\n              </button>\n            </footer>\n          )}\n        </aside>\n      </section>\n    </div>\n  );\n}\n"}},"apiBlockIndex":2,"requestId":"req_011CgBwf3vbEkuBTLqKSoh1f","requestRef":"ad4ffb52-cd60-4c9b-87ca-cbc6dc1d17d5","requestedModel":"claude-opus-5-5","type":"assistant","uuid":"f47aa428-2e04-4898-b935-f0bf3fc6025f","timestamp":"2026-10-19T16:53:55.491Z","advisorModel":"claude-opus-5-5","effort":"low","perTurnEffort":"low","userType":"external","entrypoint":"sdk-ts","cwd":"C:\\Users\\chris\\.t3\\worktrees\\inkling\\t3-47ff5304","sessionId":"fad76192-bf94-45bb-9f1a-d29cda113db7","version":"2.1.303","gitBranch":"feat/glass-surface","slug":"purrfect-munching-gadget"}
{"parentUuid":"f47aa428-2e04-4898-b935-f0bf3fc6025f","isSidechain":false,"promptId":"6f28c0dc-c66c-4abb-8f60-5b5bebef6251","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KMhroKxLx6i2KeRqqWH1D2","type":"tool_result","content":"The file C:\\Users\\chris\\.t3\\worktrees\\inkling\\t3-47ff5304\\src\\components\\ExpandedItemOverlay.tsx has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"uuid":"2c64301f-17ec-4b9a-bb3f-5c2cb0526ef9","timestamp":"2026-10-19T16:53:55.810Z","toolUseResult":{"type":"update","filePath":"C:\\Users\\chris\\.t3\\worktrees\\inkling\\t3-47ff5304\\src\\components\\ExpandedItemOverlay.tsx","content":"import {\n  lazy,\n  Suspense,\n  useCallback,\n  useEffect,\n  useLayoutEffect,\n  useRef,\n  useState,\n  type CSSProperties,\n  type ReactNode,\n  type RefObject,\n} from \"react\";\nimport { gsap } from \"gsap\";\nimport { HugeiconsIcon } from \"@hugeicons/react\";\nimport {\n  AlertCircleIcon,\n  Archive01Icon,\n  ArrowUpRight01Icon,\n  BookOpen01Icon,\n  FileTextIcon,\n  FolderAddIcon,\n  Loading01Icon,\n  PlusSignIcon,\n  RotateCwIcon,\n  SparklesIcon,\n  StarIcon,\n} from \"@hugeicons/core-free-icons\";\nimport type { LibraryItem } from \"../lib/types\";\nimport { isElectronRuntime } from \"../lib/libraryApi\";\nimport type { ReaderOrigin } from \"../ReaderView\";\nimport {\n  KindIcon,\n  NoteArtwork,\n  PdfArtwork,\n  PostArtwork,\n  XPostEmbed,\n  DetailVideoMedia,\n  pdfPreviewTitle,\n} from \"./ItemMedia\";\nimport {\n  OVERLAY_EASE,\n  OVERLAY_FLIGHT_MS,\n  prefersReducedMotion,\n  queryCardRects,\n  rectFrom,\n  type FlightRect,\n  type SourceRects,\n} from \"./overlayMotion\";\n\nconst RichNoteEditor = lazy(() =>\n  import(\"./RichNoteEditor\").then((module) => ({ default: module.RichNoteEditor })),\n);\n\nexport type ExpandedOverlayActions = {\n  onClose: () => void;\n  onOpenPdf: (item: LibraryItem) => void;\n  onOpenReader: (item: LibraryItem, origin: ReaderOrigin) => void;\n  onFindSimilar: (item: LibraryItem) => void;\n  onForget: (item: LibraryItem) => void | Promise<void>;\n  onTogglePin: (item: LibraryItem) => void | Promise<void>;\n  onRetryJob: (jobId: string) => void | Promise<void>;\n  onAddTag?: (item: LibraryItem, tag: string) => void | Promise<void>;\n  onUpdateNote: (item: LibraryItem, body: string) => void | Promise<void>;\n  onToggleSpace?: (item: LibraryItem, spaceId: string) => void | Promise<void>;\n  isFindingSimilar: boolean;\n};\n\n/** A Regular Space chip: filing an item in and taking it back out happen in the\n *  same place, so one toggle carries both directions. */\nexport type OverlaySpaceChip = {\n  id: string;\n  name: string;\n  color: string;\n  member: boolean;\n};\n\ntype OverlayAction = {\n  key: string;\n  label: string;\n  icon: ReactNode;\n  onClick: (event: React.MouseEvent<HTMLButtonElement>) => void;\n  disabled?: boolean;\n  title?: string;\n};\n\ntype Flight =\n  | { kind: \"open\"; id: number; from: FlightRect; to: FlightRect }\n  | {\n      kind: \"close\";\n      id: number;\n      fromItem: LibraryItem;\n      from: FlightRect;\n      to: FlightRect | null;\n      thenOpen: boolean;\n    };\n\n// The settled view's corners match the library frame it covers.\nconst FRAME_RADIUS = \"16px 0px 0px 16px\";\n\nfunction clickOrigin(event: React.MouseEvent<HTMLElement>): ReaderOrigin {\n  const rect = event.currentTarget.getBoundingClientRect();\n  return { x: rect.left + rect.width / 2, y: rect.top + rect.height / 2 };\n}\n\nfunction hostnameForUrl(url: string | undefined): string | null {\n  if (!url) return null;\n  try {\n    return new URL(url).hostname.replace(/^www\\./u, \"\");\n  } catch {\n    return null;\n  }\n}\n\nfunction fileTypeFor(item: LibraryItem): string {\n  if (item.kind === \"Image\") {\n    const match = item.image?.split(\"?\")[0].match(/\\.([a-z0-9]{2,5})$/iu);\n    if (match) {\n      const extension = match[1].toLowerCase();\n      return extension === \"jpeg\" ? \"JPG\" : extension.toUpperCase();\n    }\n    return \"JPG\";\n  }\n  switch (item.kind) {\n    case \"PDF\":\n      return \"PDF\";\n    case \"Video\":\n      return \"Video\";\n    case \"Article\":\n      return \"Link\";\n    case \"Post\":\n      return \"Post\";\n    case \"Note\":\n      return \"Note\";\n    case \"Quote\":\n      return \"Quote\";\n    default:\n      return \"File\";\n  }\n}\n\n// Content actions sit under the details: read, open the PDF, find similar.\n// Item housekeeping (star, Spaces, open original, archive) lives in the\n// action bar at the bottom of the inspector instead.\nfunction contentActions(item: LibraryItem, actions: ExpandedOverlayActions): OverlayAction[] {\n  const list: OverlayAction[] = [];\n  const hasReaderContent = Boolean(item.articleHtml || item.hasArticleContent);\n  if (item.kind === \"PDF\" && item.fileUrl) {\n    list.push({\n      key: \"open-pdf\",\n      label: \"Open PDF\",\n      icon: <HugeiconsIcon icon={FileTextIcon} size={14} />,\n      onClick: () => actions.onOpenPdf(item),\n    });\n  }\n  if (item.kind === \"Article\" && hasReaderContent) {\n    list.push({\n      key: \"read\",\n      label: \"Read\",\n      icon: <HugeiconsIcon icon={BookOpen01Icon} size={14} />,\n      onClick: (event) => actions.onOpenReader(item, clickOrigin(event)),\n    });\n  }\n  if (isElectronRuntime() && [\"Image\", \"Article\", \"Note\", \"Quote\"].includes(item.kind)) {\n    list.push({\n      key: \"find-similar\",\n      label: actions.isFindingSimilar ? \"Finding similar…\" : \"Find similar\",\n      icon: <HugeiconsIcon icon={SparklesIcon} size={14} />,\n      onClick: () => actions.onFindSimilar(item),\n      disabled: actions.isFindingSimilar,\n    });\n  }\n  return list;\n}\n\nfunction OverlayMedia({ item }: { item: LibraryItem }) {\n  if (item.kind === \"Note\" && !item.image) {\n    return (\n      <div className=\"item-stage-art note-detail-media\">\n        <NoteArtwork item={item} />\n      </div>\n    );\n  }\n\n  if (item.social?.provider === \"x\") {\n    return (\n      <div className=\"item-stage-art detail-x-post\">\n        <XPostEmbed\n          key={item.social.postUrl}\n          social={item.social}\n          fallback={\n            item.post ? (\n              <PostArtwork post={item.post} />\n            ) : (\n              <div className=\"detail-art ink\">Post preview unavailable.</div>\n            )\n          }\n        />\n      </div>\n    );\n  }\n\n  if (item.kind === \"Video\") {\n    return (\n      <div className=\"item-stage-art\">\n        <DetailVideoMedia item={item} />\n      </div>\n    );\n  }\n\n  if (item.kind === \"PDF\") {\n    return (\n      <div className=\"item-stage-art\">\n        <PdfArtwork item={item} />\n      </div>\n    );\n  }\n\n  if (item.image) {\n    return <img src={item.image} alt={item.imageAlt ?? item.title} className=\"item-stage-image\" />;\n  }\n\n  if (item.kind === \"Quote\") {\n    return (\n      <div className=\"item-stage-art\">\n        <div className=\"detail-art detail-quote-art paper-yellow\">\n          <span className=\"detail-quote-mark\">“</span>\n          <span>{item.kind}</span>\n        </div>\n      </div>\n    );\n  }\n\n  if (item.kind === \"Post\" && item.post) {\n    return (\n      <div className=\"item-stage-art\">\n        <PostArtwork post={item.post} />\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"item-stage-art\">\n      <div className={`detail-art ${item.accent ?? \"ink\"}`}>\n        <KindIcon kind={item.kind} />\n        <span>{item.kind}</span>\n      </div>\n    </div>\n  );\n}\n\nfunction detailTitleFor(item: LibraryItem): string {\n  return item.kind === \"PDF\" ? pdfPreviewTitle(item.title) || item.title : item.title;\n}\n\ntype ExpandedItemOverlayProps = {\n  item: LibraryItem;\n  actions: ExpandedOverlayActions;\n  /** Regular Spaces available to file this item in. Empty hides the Space control. */\n  spaces?: OverlaySpaceChip[];\n  originRectsRef: RefObject<SourceRects | null>;\n  /** The library frame the item view covers once it settles. */\n  frameRef: RefObject<HTMLElement | null>;\n};\n\nexport function ExpandedItemOverlay({\n  item,\n  actions,\n  spaces,\n  originRectsRef,\n  frameRef,\n}: ExpandedItemOverlayProps) {\n  const layerRef = useRef<HTMLDivElement>(null);\n  const dialogRef = useRef<HTMLElement>(null);\n  const closeButtonRef = useRef<HTMLButtonElement>(null);\n  const tagInputRef = useRef<HTMLInputElement>(null);\n  const itemIdRef = useRef(item.id);\n  const itemRef = useRef(item);\n  const previousItemRef = useRef(item);\n  const flightIdRef = useRef(0);\n  const flightRef = useRef<Flight | null>(null);\n  const cancelPendingOpenRef = useRef(false);\n  const hasSettledOnceRef = useRef(false);\n  const actionsRef = useRef(actions);\n  const [destination, setDestination] = useState<FlightRect | null>(null);\n  const [flight, setFlight] = useState<Flight | null>(null);\n  const [pendingOpen, setPendingOpen] = useState(false);\n  const [isEditingNote, setIsEditingNote] = useState(false);\n  const [isFocusMode, setIsFocusMode] = useState(false);\n  const [isSpaceMenuOpen, setIsSpaceMenuOpen] = useState(false);\n  const isEditingNoteRef = useRef(false);\n  const isFocusModeRef = useRef(false);\n\n  // Mirror props into refs inside an effect, never during render, so a\n  // concurrent render cannot publish a half-updated set. This runs before\n  // the flight effects below, which read these refs.\n  useLayoutEffect(() => {\n    itemIdRef.current = item.id;\n    itemRef.current = item;\n    flightRef.current = flight;\n  }, [item, flight]);\n\n  useLayoutEffect(() => {\n    isEditingNoteRef.current = isEditingNote;\n    isFocusModeRef.current = isFocusMode;\n  }, [isEditingNote, isFocusMode]);\n\n  // The item whose content the view shows. During a closing flight that was\n  // triggered by switching items, the view flies back displaying the item it\n  // was showing, while React's item prop already points at the next one.\n  const shownItem = flight?.kind === \"close\" ? flight.fromItem : item;\n\n  const frameRect = useCallback((): FlightRect => {\n    const rect = frameRef.current?.getBoundingClientRect();\n    if (rect) return rectFrom(rect);\n    return { left: 0, top: 0, width: window.innerWidth, height: window.innerHeight };\n  }, [frameRef]);\n\n  // Grows the view from a card-sized rectangle into the library frame.\n  const beginOpenFlight = useCallback(\n    (from: FlightRect) => {\n      const to = frameRect();\n      setDestination(to);\n      flightIdRef.current += 1;\n      setFlight({ kind: \"open\", id: flightIdRef.current, from, to });\n    },\n    [frameRect],\n  );\n\n  const beginCloseFlight = useCallback(\n    (closingItem: LibraryItem, to: FlightRect | null, thenOpen: boolean) => {\n      const dialog = dialogRef.current;\n      if (!dialog) {\n        actionsRef.current.onClose();\n        return;\n      }\n      flightIdRef.current += 1;\n      setFlight({\n        kind: \"close\",\n        id: flightIdRef.current,\n        fromItem: closingItem,\n        from: rectFrom(dialog.getBoundingClientRect()),\n        to,\n        thenOpen,\n      });\n    },\n    [],\n  );\n\n  const requestClose = useCallback(() => {\n    const activeFlight = flightRef.current;\n    if (activeFlight?.kind === \"close\") {\n      if (activeFlight.thenOpen) cancelPendingOpenRef.current = true;\n      return;\n    }\n    const rects = queryCardRects(itemIdRef.current);\n    if (prefersReducedMotion() || !rects || !dialogRef.current) {\n      if (flightRef.current) setFlight(null);\n      gsap.to(layerRef.current, {\n        opacity: 0,\n        duration: 0.15,\n        onComplete: actionsRef.current.onClose,\n      });\n      return;\n    }\n    cancelPendingOpenRef.current = false;\n    beginCloseFlight(itemRef.current, rects.card, false);\n  }, [beginCloseFlight]);\n\n  // The origin rectangle is a one-time snapshot supplied through a mutable ref.\n  // Reading it again after opening would retarget the flight to a stale card.\n  // biome-ignore lint/correctness/useExhaustiveDependencies: This effect consumes the source-rectangle snapshot once on mount.\n  useLayoutEffect(() => {\n    const originRects = originRectsRef.current;\n    if (!originRects || prefersReducedMotion()) {\n      setDestination(frameRect());\n      gsap.fromTo(\n        layerRef.current,\n        { opacity: 0 },\n        { opacity: 1, duration: 0.18, ease: \"power1.out\" },\n      );\n      return;\n    }\n    beginOpenFlight(originRects.card);\n  }, [beginOpenFlight]);\n\n  // Runs every flight. GSAP owns only the view's outer rectangle. While it\n  // flies, the stage fills the whole rectangle and the inspector is hidden, so\n  // the card reads as its own image growing into the frame; the inspector and\n  // the stage's margins ease in by CSS once it lands.\n  useLayoutEffect(() => {\n    if (!flight) return;\n    const dialog = dialogRef.current;\n    if (!dialog) {\n      if (flight.kind === \"close\") actionsRef.current.onClose();\n      return;\n    }\n    const cardRadius = `${getComputedStyle(dialog).getPropertyValue(\"--sidebar-radius\").trim() || \"14px\"}`;\n    const cardCorners = `${cardRadius} ${cardRadius} ${cardRadius} ${cardRadius}`;\n    const duration = OVERLAY_FLIGHT_MS / 1000;\n\n    if (flight.kind === \"open\") {\n      const timeline = gsap.timeline({\n        onComplete: () => {\n          setFlight(null);\n          closeButtonRef.current?.focus({ preventScroll: true });\n        },\n      });\n      timeline\n        .fromTo(\n          dialog,\n          { ...flight.from, borderRadius: cardCorners },\n          { ...flight.to, borderRadius: FRAME_RADIUS, duration, ease: OVERLAY_EASE, autoRound: false },\n          0,\n        )\n        .fromTo(dialog, { opacity: 0 }, { opacity: 1, duration: 0.12, ease: \"power1.out\" }, 0);\n      return () => {\n        timeline.kill();\n      };\n    }\n\n    // Closing: the view returns to its source card and dissolves into it, or —\n    // when the source card is no longer mounted — fades out in place.\n    const timeline = gsap.timeline({\n      onComplete: () => {\n        if (flight.thenOpen && !cancelPendingOpenRef.current) {\n          setFlight(null);\n          setPendingOpen(true);\n        } else {\n          actionsRef.current.onClose();\n        }\n      },\n    });\n    if (flight.to) {\n      timeline\n        .fromTo(\n          dialog,\n          { ...flight.from },\n          { ...flight.to, borderRadius: cardCorners, duration, ease: OVERLAY_EASE, autoRound: false },\n          0,\n        )\n        .to(dialog, { opacity: 0, duration: 0.18, ease: \"power1.in\" }, duration - 0.18);\n    } else {\n      timeline.to(dialog, { opacity: 0, duration: 0.25, ease: \"power1.in\" });\n    }\n    return () => {\n      timeline.kill();\n    };\n  }, [flight]);\n\n  // Follows the frame when the window resizes or the sidebar opens or closes.\n  useEffect(() => {\n    const frame = frameRef.current;\n    if (!frame) return;\n    const observer = new ResizeObserver(() => {\n      if (flightRef.current) return;\n      setDestination(frameRect());\n    });\n    observer.observe(frame);\n    return () => observer.disconnect();\n  }, [frameRef, frameRect]);\n\n  // Switching items while the view is open runs sequentially: the open view\n  // first flies back into the card it was showing, and only after it lands\n  // does the newly selected item open from its own card. Rapid selections\n  // during the closing leg are absorbed — the flight completes once and then\n  // opens the most recently selected item.\n  useLayoutEffect(() => {\n    const previous = previousItemRef.current;\n    if (previous.id === item.id) return;\n    previousItemRef.current = item;\n    if (isEditingNoteRef.current) {\n      // Leave the editor rather than carry the draft onto another item.\n      setIsEditingNote(false);\n      setIsFocusMode(false);\n    }\n\n    const activeFlight = flightRef.current;\n    if (activeFlight?.kind === \"close\") return;\n    if (activeFlight?.kind === \"open\") {\n      // Retarget the in-progress open from its current visual state.\n      const dialog = dialogRef.current;\n      if (!dialog) return;\n      cancelPendingOpenRef.current = false;\n      beginOpenFlight(rectFrom(dialog.getBoundingClientRect()));\n      return;\n    }\n\n    // Settled: close into the old card, then open the new selection.\n    cancelPendingOpenRef.current = false;\n    beginCloseFlight(previous, queryCardRects(previous.id)?.card ?? null, /* thenOpen */ true);\n  }, [item, beginOpenFlight, beginCloseFlight]);\n\n  // When a sequential switch's closing leg lands, open the newly selected\n  // item from its own card.\n  useLayoutEffect(() => {\n    if (!pendingOpen || flight) return;\n    setPendingOpen(false);\n    if (cancelPendingOpenRef.current) {\n      cancelPendingOpenRef.current = false;\n      actionsRef.current.onClose();\n      return;\n    }\n    const rects = queryCardRects(itemRef.current.id);\n    if (!rects) {\n      actionsRef.current.onClose();\n      return;\n    }\n    beginOpenFlight(rects.card);\n  }, [pendingOpen, flight, beginOpenFlight]);\n\n  // On close, hand focus back to the source card while it is still mounted.\n  // Skipping the restore when focus already moved elsewhere (nav, search)\n  // avoids yanking it back out of whatever the user clicked.\n  useEffect(\n    () => () => {\n      const focusOwner = document.activeElement;\n      const overlayHasFocus =\n        focusOwner instanceof HTMLElement && (dialogRef.current?.contains(focusOwner) ?? false);\n      if (!overlayHasFocus && focusOwner !== document.body) return;\n      const card = document.querySelector<HTMLElement>(\n        `.library-card[data-library-item-id=\"${CSS.escape(String(itemIdRef.current))}\"]`,\n      );\n      card?.focus({ preventScroll: true });\n    },\n    [],\n  );\n\n  // Move focus to the close control when the view finishes opening.\n  useLayoutEffect(() => {\n    if (flight || !destination || hasSettledOnceRef.current) return;\n    hasSettledOnceRef.current = true;\n    closeButtonRef.current?.focus({ preventScroll: true });\n  }, [flight, destination]);\n\n  actionsRef.current = actions;\n\n  const handleOverlayClose = () => {\n    if (isFocusModeRef.current) {\n      setIsFocusMode(false);\n      return;\n    }\n    if (isEditingNoteRef.current) {\n      setIsEditingNote(false);\n      return;\n    }\n    requestClose();\n  };\n\n  useEffect(() => {\n    const onKeyDown = (event: KeyboardEvent) => {\n      if (event.key !== \"Escape\") return;\n      // A field inside the view owns its own Escape: the new-tag input and\n      // the editor's link URL field each cancel just themselves. This listener\n      // runs in the capture phase, before their handlers get a chance to.\n      if (event.target instanceof HTMLInputElement) return;\n      event.stopPropagation();\n      if (isFocusModeRef.current) {\n        setIsFocusMode(false);\n        return;\n      }\n      if (isEditingNoteRef.current) {\n        setIsEditingNote(false);\n        return;\n      }\n      requestClose();\n    };\n    window.addEventListener(\"keydown\", onKeyDown, true);\n    return () => window.removeEventListener(\"keydown\", onKeyDown, true);\n  }, [requestClose]);\n\n  // Presses outside the view (the sidebar, the search bar) close it, except\n  // the edge tab, which only folds the sidebar away. While a note is being\n  // written every outside press is absorbed instead, so it cannot silently\n  // throw away what was just typed. The close button, Escape and Save are the\n  // ways out.\n  useEffect(() => {\n    const isOutside = (target: EventTarget | null) => {\n      if (!(target instanceof Node)) return false;\n      if (dialogRef.current?.contains(target)) return false;\n      return !(target instanceof Element && target.closest(\".edge-tab\"));\n    };\n\n    const onPointerDown = (event: PointerEvent) => {\n      if (!isOutside(event.target)) return;\n      if (!isEditingNoteRef.current) {\n        requestClose();\n        return;\n      }\n      event.preventDefault();\n      event.stopPropagation();\n    };\n\n    // A control behind the view can answer the press, the release, or the\n    // click, and those are separate events, so the press alone is not enough to\n    // absorb the interaction.\n    const absorbHandledPress = (event: Event) => {\n      if (!isEditingNoteRef.current || !isOutside(event.target)) return;\n      event.preventDefault();\n      event.stopPropagation();\n    };\n\n    document.addEventListener(\"pointerdown\", onPointerDown, true);\n    document.addEventListener(\"mousedown\", absorbHandledPress, true);\n    document.addEventListener(\"pointerup\", absorbHandledPress, true);\n    document.addEventListener(\"mouseup\", absorbHandledPress, true);\n    document.addEventListener(\"click\", absorbHandledPress, true);\n    return () => {\n      document.removeEventListener(\"pointerdown\", onPointerDown, true);\n      document.removeEventListener(\"mousedown\", absorbHandledPress, true);\n      document.removeEventListener(\"pointerup\", absorbHandledPress, true);\n      document.removeEventListener(\"mouseup\", absorbHandledPress, true);\n      document.removeEventListener(\"click\", absorbHandledPress, true);\n    };\n  }, [requestClose]);\n\n  const [isAddingTag, setIsAddingTag] = useState(false);\n  const [tagDraft, setTagDraft] = useState(\"\");\n  useLayoutEffect(() => {\n    if (isAddingTag) tagInputRef.current?.focus();\n  }, [isAddingTag]);\n\n  // Selection changes reset this local editor state even though the selected ID\n  // is only a trigger and is not read by the reset itself.\n  // biome-ignore lint/correctness/useExhaustiveDependencies: The shown item ID intentionally triggers a reset.\n  useEffect(() => {\n    setIsAddingTag(false);\n    setTagDraft(\"\");\n    setIsSpaceMenuOpen(false);\n  }, [shownItem.id]);\n\n  const allTags = shownItem.tags;\n\n  function submitTag() {\n    const clean = tagDraft.trim().replace(/^#+/u, \"\").toLowerCase();\n    if (clean && !allTags.some((tag) => tag.toLowerCase() === clean)) {\n      void actions.onAddTag?.(shownItem, clean);\n    }\n    setTagDraft(\"\");\n    setIsAddingTag(false);\n  }\n\n  const isFlying = flight !== null;\n  const placedStyle: CSSProperties | undefined =\n    destination && !isFlying\n      ? {\n          left: destination.left,\n          top: destination.top,\n          width: destination.width,\n          height: destination.height,\n        }\n      : undefined;\n\n  const isEditingNoteView = isEditingNote && shownItem.kind === \"Note\";\n  const isFocusModeView = isFocusMode && isEditingNoteView;\n  const isPinned = shownItem.favorite === true;\n  const sourceHost = hostnameForUrl(shownItem.sourceUrl);\n  const memberSpaces = spaces?.filter((space) => space.member) ?? [];\n  const content = contentActions(shownItem, actions);\n  const savedDate = shownItem.date.replace(/^saved\\s+/iu, \"\");\n  const size =\n    shownItem.mediaWidth && shownItem.mediaHeight\n      ? `${shownItem.mediaWidth} × ${shownItem.mediaHeight}`\n      : null;\n\n  return (\n    <div\n      className={`expanded-overlay-layer ${isFocusModeView ? \"is-focus-mode\" : \"\"}`}\n      ref={layerRef}\n    >\n      <section\n        ref={dialogRef}\n        className={`expanded-overlay ${destination ? \"is-placed\" : \"\"} ${isFlying ? \"is-flying\" : \"\"} ${isEditingNoteView ? \"is-editing-note\" : \"\"} ${isFocusModeView ? \"is-focus-mode\" : \"\"}`}\n        role=\"dialog\"\n        aria-modal={false}\n        aria-label={detailTitleFor(shownItem)}\n        style={isFocusModeView ? undefined : placedStyle}\n      >\n        <div className=\"item-stage\">\n          <div className=\"item-stage-title glass\">{detailTitleFor(shownItem)}</div>\n          <OverlayMedia item={shownItem} />\n        </div>\n\n        <aside className=\"item-inspector\">\n          <header className=\"item-inspector-header\">\n            <button\n              type=\"button\"\n              ref={closeButtonRef}\n              className=\"item-close\"\n              onClick={handleOverlayClose}\n              aria-label={\n                isFocusModeView\n                  ? \"Exit focus mode\"\n                  : isEditingNoteView\n                    ? \"Close editor\"\n                    : \"Close details\"\n              }\n            >\n              {isFocusModeView ? \"Exit focus\" : \"Close\"}\n              <kbd>esc</kbd>\n            </button>\n          </header>\n\n          <div className=\"item-inspector-body\">\n            {isEditingNoteView ? (\n              <Suspense\n                fallback={\n                  <p className=\"item-note\" role=\"status\">\n                    Loading editor…\n                  </p>\n                }\n              >\n                <RichNoteEditor\n                  key={`edit-${shownItem.id}`}\n                  embedded\n                  body={shownItem.noteBody}\n                  title={shownItem.title}\n                  onSave={(body) => actions.onUpdateNote(shownItem, body)}\n                  onEditingChange={(editing) => {\n                    setIsEditingNote(editing);\n                    if (!editing) setIsFocusMode(false);\n                  }}\n                  focusMode={isFocusModeView}\n                  onFocusModeChange={setIsFocusMode}\n                />\n              </Suspense>\n            ) : (\n              <>\n                {shownItem.kind === \"Quote\" ? (\n                  <>\n                    <blockquote className=\"detail-quote\">“{shownItem.title}”</blockquote>\n                    {shownItem.description && (\n                      <p className=\"detail-attribution\">\n                        — {shownItem.description.replace(/^—\\s*/u, \"\")}\n                      </p>\n                    )}\n                  </>\n                ) : (\n                  <>\n                    <h2 className=\"item-title\">{detailTitleFor(shownItem)}</h2>\n                    {shownItem.kind !== \"Note\" && shownItem.description && (\n                      <p className=\"item-note\">{shownItem.description}</p>\n                    )}\n                  </>\n                )}\n\n                {shownItem.processing?.active && (\n                  <div className=\"detail-processing\" role=\"status\">\n                    <HugeiconsIcon icon={Loading01Icon} size={14} />\n                    <span>{shownItem.processing.message ?? \"Processing\"}</span>\n                    {shownItem.processing.progressTotal != null && (\n                      <span>\n                        {shownItem.processing.progressCurrent}/{shownItem.processing.progressTotal}\n                      </span>\n                    )}\n                  </div>\n                )}\n                {shownItem.processing?.failedJob && (\n                  <div className=\"detail-processing failed\" role=\"alert\">\n                    <HugeiconsIcon icon={AlertCircleIcon} size={14} />\n                    <span>\n                      {shownItem.processing.failedJob.errorMessage ?? \"Processing failed\"}\n                    </span>\n                    <button\n                      type=\"button\"\n                      className=\"retry-button\"\n                      onClick={() =>\n                        void actions.onRetryJob(shownItem.processing?.failedJob?.id ?? \"\")\n                      }\n                    >\n                      <HugeiconsIcon icon={RotateCwIcon} size={12} /> Try again\n                    </button>\n                  </div>\n                )}\n\n                <div className=\"item-tags\">\n                  {memberSpaces.map((space) => (\n                    <span key={space.id} className=\"item-space-chip\">\n                      <span className={`detail-space-dot ${space.color}`} aria-hidden=\"true\" />\n                      {space.name}\n                    </span>\n                  ))}\n                  {allTags.map((tag) => (\n                    <span key={tag} className=\"item-tag\">\n                      #{tag}\n                    </span>\n                  ))}\n                  {isAddingTag ? (\n                    <input\n                      ref={tagInputRef}\n                      className=\"detail-tag-input\"\n                      value={tagDraft}\n                      placeholder=\"tag name\"\n                      aria-label=\"New tag name\"\n                      onChange={(event) => setTagDraft(event.target.value)}\n                      onKeyDown={(event) => {\n                        if (event.key === \"Enter\") {\n                          event.preventDefault();\n                          submitTag();\n                        } else if (event.key === \"Escape\") {\n                          setTagDraft(\"\");\n                          setIsAddingTag(false);\n                        }\n                      }}\n                      onBlur={submitTag}\n                    />\n                  ) : (\n                    <button\n                      type=\"button\"\n                      className=\"item-tag-add\"\n                      onClick={() => setIsAddingTag(true)}\n                      aria-label=\"Add a tag\"\n                    >\n                      <HugeiconsIcon icon={PlusSignIcon} size={11} />\n                    </button>\n                  )}\n                </div>\n\n                <dl className=\"item-details\">\n                  <dt className=\"item-details-label\">Details</dt>\n                  <div>\n                    <dt>Saved</dt>\n                    <dd>{savedDate}</dd>\n                  </div>\n                  {(sourceHost || shownItem.source) && (\n                    <div>\n                      <dt>From</dt>\n                      <dd>{sourceHost ?? shownItem.source}</dd>\n                    </div>\n                  )}\n                  <div>\n                    <dt>Type</dt>\n                    <dd>{fileTypeFor(shownItem)}</dd>\n                  </div>\n                  {size && (\n                    <div>\n                      <dt>Size</dt>\n                      <dd className=\"is-mono\">{size}</dd>\n                    </div>\n                  )}\n                </dl>\n\n                {(content.length > 0 || shownItem.kind === \"Note\") && (\n                  <div className=\"item-actions\">\n                    {shownItem.kind === \"Note\" && (\n                      <button\n                        type=\"button\"\n                        onClick={() => {\n                          setIsFocusMode(false);\n                          setIsEditingNote(true);\n                        }}\n                      >\n                        Edit note\n                      </button>\n                    )}\n                    {content.map((action) => (\n                      <button\n                        type=\"button\"\n                        key={action.key}\n                        onClick={action.onClick}\n                        disabled={action.disabled}\n                        title={action.title}\n                      >\n                        {action.icon} {action.label}\n                      </button>\n                    ))}\n                  </div>\n                )}\n              </>\n            )}\n          </div>\n\n          {!isEditingNoteView && (\n            <footer className=\"item-action-bar\">\n              {isSpaceMenuOpen && spaces && spaces.length > 0 && (\n                <fieldset className=\"item-space-menu\">\n                  <legend className=\"visually-hidden\">Regular Spaces</legend>\n                  {spaces.map((space) => (\n                    <button\n                      key={space.id}\n                      type=\"button\"\n                      className={`detail-space ${space.member ? \"is-member\" : \"\"}`}\n                      aria-pressed={space.member}\n                      title={space.member ? `Remove from ${space.name}` : `Add to ${space.name}`}\n                      onClick={() => void actions.onToggleSpace?.(shownItem, space.id)}\n                    >\n                      <span className={`detail-space-dot ${space.color}`} aria-hidden=\"true\" />\n                      <span className=\"detail-space-name\">{space.name}</span>\n                    </button>\n                  ))}\n                </fieldset>\n              )}\n              <button\n                type=\"button\"\n                className=\"item-bar-button\"\n                onClick={() => void actions.onTogglePin(shownItem)}\n                aria-label={isPinned ? \"Unstar\" : \"Star to Top of mind\"}\n                aria-pressed={isPinned}\n                title={isPinned ? \"Unstar\" : \"Star to Top of mind\"}\n              >\n                <HugeiconsIcon icon={StarIcon} size={15} />\n              </button>\n              {spaces && spaces.length > 0 && (\n                <button\n                  type=\"button\"\n                  className=\"item-bar-button\"\n                  onClick={() => setIsSpaceMenuOpen((open) => !open)}\n                  aria-label=\"Move to Space\"\n                  aria-expanded={isSpaceMenuOpen}\n                  title=\"Move to Space\"\n                >\n                  <HugeiconsIcon icon={FolderAddIcon} size={15} />\n                </button>\n              )}\n              {shownItem.sourceUrl && (\n                <button\n                  type=\"button\"\n                  className=\"item-bar-button\"\n                  onClick={() =>\n                    window.open(shownItem.sourceUrl, \"_blank\", \"noopener,noreferrer\")\n                  }\n                  aria-label={`Open ${sourceHost ?? \"original\"}`}\n                  title={`Open ${sourceHost ?? \"original\"}`}\