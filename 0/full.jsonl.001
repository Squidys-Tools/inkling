{"type":"api-request","sessionId":"fad76192-bf94-45bb-9f1a-d29cda113db7","id":"f8357f93-8c48-41cf-8b18-1db2216e3eaf","timestamp":"2026-10-19T13:16:25.102Z","version":"2.1.303","querySource":"sdk","shapeHash":"bcd5e62b1c5bf69cec77484e91712120ae2329531adb56e5595b8f37b64e884f","params":{"model":"claude-opus-5-5","betas":["claude-code-20250219","oauth-2025-04-20","interleaved-thinking-2025-05-14","thinking-token-count-2026-05-13","context-management-2025-06-27","prompt-caching-scope-2026-01-05","per-turn-control-2026-07-01","mid-conversation-tool-changes-2026-07-01","inline-tools-2026-09-15","advisor-tool-2026-03-01","advanced-tool-use-2025-11-20","mid-conversation-system-clear-at-2026-08-21","effort-2025-11-24","thinking-binding-controls-2026-08-01","extended-cache-ttl-2025-04-11","cache-diagnosis-2026-04-07","message-threads-2026-08-12"],"max_tokens":128000,"thinking":{"type":"adaptive","display":"summarized"},"context_management":{"edits":[{"type":"clear_thinking_20251015","keep":"all"}]},"output_config":{"effort":"low"}},"base":"68ef2fd6-80ea-42f0-95db-01046b4f7b90","keep":314,"tail":["e8086b38d1bf9ac767028d0fe1664be5cd6575bc0c4d539030109e16b3a9321c","2679fdd4ae893d9d96bd401d07af4a1776742f42367698d11b3ebf14c0f65cde","479a827319d44f9b952f56069fe7b001c64019225801c96088aa57adb1cfd724"],"cacheControl":[{"path":["system",1],"value":{"type":"ephemeral","ttl":"1h","scope":"global"}},{"path":["system",2],"value":{"type":"ephemeral","ttl":"1h"}},{"path":["messages",316,"content",0],"value":{"type":"ephemeral","ttl":"1h"}}],"requestDigest":"22f66db4991b9f7e14229cdd7aec0536ce6ebb991011a66522b3c4ed0cffda6e"}
{"parentUuid":"022eaa45-0e63-48cd-979f-8aed4d727d0b","isSidechain":false,"message":{"model":"claude-opus-5-5","id":"msg_011CgBfB4tVgTxe9FdtiUwu3","type":"message","role":"assistant","content":[{"type":"text","text":"Updated the mockup the way you described:\n\n- **At rest:** just the \"Everything\" title inside a glass pill, with no mascot. The pill fits the title's width, so it's the same size as the other pills.\n- **Search icon:** I kept a faint magnifying glass beside the title as a hint that clicking it searches. Without it, the pill reads as a plain label, but I can take it out if you'd rather keep it to just the word.\n- **When opened:** the pill grows into the search bar you already have in 1.2: the mascot's eyes, what you type, and \"esc to close\". The title fades out as the pill widens, and the search bar's contents fade in just after.\n- **Inside a Space:** the pill would show that Space's name, for example \"Japan trip\"."}],"container":null,"stop_reason":"end_turn","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3945,"cache_read_input_tokens":259428,"output_tokens":242,"output_tokens_details":{"thinking_tokens":0},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":3945,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":242,"cache_read_input_tokens":259428,"cache_creation_input_tokens":3945,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3945},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"apiBlockIndex":0,"requestId":"req_011CgBfB4VvezpWqoGgAfJD6","requestRef":"f8357f93-8c48-41cf-8b18-1db2216e3eaf","requestedModel":"claude-opus-5-5","attributionMcpServer":"t3-code","attributionMcpTool":"html_render","type":"assistant","uuid":"f380fcdb-ac3c-44cd-945d-0