ius: 4px;\n  background: var(--color-canvas);\n  color: #c9d8c3;\n  font: 11px var(--font-body);\n}\n.note-editor-content pre {\n  overflow-x: auto;\n  margin: 10px 0;\n  padding: 10px;\n  border: 1px solid var(--color-border);\n  border-radius: 7px;\n  background: var(--color-canvas);\n}\n.note-editor-content pre code {\n  padding: 0;\n}\n.note-editor-content p.is-editor-empty:first-child::before {\n  float: left;\n  height: 0;\n  color: #65736a;\n  content: attr(data-placeholder);\n  pointer-events: none;\n}\n.note-editor-error {\n  margin: 8px 0 0;\n  color: #d07055;\n  font-size: 11px;\n  line-height: 1.45;\n}\n.note-editor-actions {\n  display: flex;\n  align-items: center;\n  justify-content: flex-end;\n  gap: 7px;\n  margin-top: 9px;\n}\n.note-editor-status {\n  margin-right: auto;\n  color: var(--color-muted);\n  font: 10px var(--font-body);\n}\n.note-editor-cancel,\n.note-editor-save {\n  border-radius: 7px;\n  cursor: pointer;\n  font-size: 11px;\n  padding: 7px 10px;\n}\n.note-editor-cancel {\n  border: 1px solid var(--color-border);\n  background: transparent;\n  color: var(--color-muted);\n}\n.note-editor-cancel:hover {\n  border-color: #5a5750;\n  color: var(--color-ink);\n}\n.note-editor-save {\n  border: 1px solid #4a6a58;\n  background: var(--color-green-soft);\n  color: #b5d0bd;\n}\n.note-editor-save:hover:not(:disabled) {\n  border-color: var(--color-green);\n  background: #2b382f;\n}\n.note-editor-save:disabled {\n  cursor: wait;\n  opacity: 0.55;\n}\n\n.note-embedded-editor {\n  flex: 1 1 auto;\n  min-height: 0;\n  display: flex;\n  flex-direction: column;\n  margin: 0;\n}\n.note-embedded-orientation {\n  flex: 0 0 auto;\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  min-width: 0;\n  padding: 12px 20px;\n  border-bottom: 1px solid #1f1d1b;\n}\n.note-embedded-kicker {\n  flex: 0 0 auto;\n  color: #6f6a62;\n  font: 10px var(--font-body);\n  letter-spacing: 0.16em;\n  text-transform: uppercase;\n}\n.note-embedded-divider {\n  flex: 0 0 auto;\n  width: 1px;\n  height: 11px;\n  background: #332f2c;\n}\n.note-embedded-name {\n  min-width: 0;\n  overflow: hidden;\n  color: #c8c0b5;\n  font:\n    400 14px / 1.3 \"Libre Baskerville\",\n    Georgia,\n    serif;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.note-embedded-editor-surface {\n  flex: 1 1 auto;\n  min-height: 0;\n  overflow: auto;\n  background: #141312;\n}\n.note-focus-editor {\n  width: min(100%, 760px);\n  min-height: 0;\n  align-self: center;\n  margin: auto;\n  padding-top: clamp(76px, 12vh, 126px);\n}\n.note-focus-editor .note-embedded-editor-surface {\n  overflow: auto;\n  background: transparent;\n}\n.note-focus-editor .note-embedded-editor-surface::-webkit-scrollbar {\n  display: none;\n}\n.note-focus-editor.note-embedded-editor .note-editor-content {\n  padding: 20px clamp(24px, 6vw, 76px) 80px;\n  color: #e9e1d6;\n  font:\n    400 18px / 1.85 \"Source Serif 4\",\n    Georgia,\n    serif;\n}\n.note-focus-editor.note-embedded-editor .note-editor-content > p {\n  margin-bottom: 1.25em;\n}\n.note-focus-editor.note-embedded-editor .note-editor-content h1,\n.note-focus-editor.note-embedded-editor .note-editor-content h2,\n.note-focus-editor.note-embedded-editor .note-editor-content h3 {\n  margin-top: 1.7em;\n  color: #e9e1d6;\n  font:\n    400 1.45em / 1.3 \"Libre Baskerville\",\n    Georgia,\n    serif;\n}\n.note-focus-editor.note-embedded-editor .note-editor-content blockquote {\n  border-color: #9a684c;\n  color: #b6a999;\n}\n.note-focus-editor.note-embedded-editor .note-editor-actions {\n  position: fixed;\n  right: 0;\n  bottom: 0;\n  left: 0;\n  justify-content: center;\n  gap: clamp(8px, 2vw, 18px);\n  min-height: 66px;\n  padding: 10px 20px;\n  border-top: 1px solid rgba(229, 221, 210, 0.08);\n  background: rgba(16, 15, 14, 0.88);\n  backdrop-filter: blur(18px);\n}\n.note-focus-editor.note-embedded-editor .note-editor-toolbar {\n  gap: 3px;\n}\n.note-focus-editor.note-embedded-editor .note-editor-save-cluster {\n  marg