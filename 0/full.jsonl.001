n-connector-dot {\n    transition: none;\n  }\n}\n.settings-data-link {\n  align-self: flex-start;\n  border: 0;\n  padding: 0;\n  background: transparent;\n  color: var(--library-muted);\n  font: inherit;\n  font-size: 13px;\n  text-decoration: underline;\n  text-underline-offset: 3px;\n  cursor: pointer;\n}\n.settings-data-link:hover,\n.settings-data-link:focus-visible {\n  color: var(--library-text);\n}\n\n/* Search: a glass pill naming the current view at rest, growing into the\n   search bar on focus or while a query is pinned. */\n.capture-bar {","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"sourceToolAssistantUUID":"a395f025-1ec9-414d-b147-05784052ef16","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"sdk-ts","cwd":"C:\\Users\\chris\\.t3\\worktrees\\inkling\\t3-47ff5304","sessionId":"fad76192-bf94-45bb-9f1a-d29cda113db7","version":"2.1.303","gitBranch":"feat/glass-surface","slug":"purrfect-munching-gadget"}
