 => {\nsrc/lib/notes.test.ts:129:  test(\"leaves a lone underscore alone for want of a closing delimiter\", () => {\nsrc/lib/notes.test.ts:134:  test(\"still strips genuine underscore emphasis\", () => {\nsrc/lib/notes.test.ts:142:  test(\"keeps markup and entities inside a code span verbatim\", () => {\nsrc/lib/notes.test.ts:147:describe(\"noteBodyForPreview\", () => {\nsrc/lib/notes.test.ts:148:  test(\"does not repeat a leading heading that matches the item title\", () => {\nsrc/lib/notes.test.ts:152:  test(\"keeps a distinct leading heading\", () => {\nsrc/lib/notes.test.ts:156:  test(\"keeps the leading heading when the item has no title to match it against\", () => {\nsrc/lib/notes.test.ts:161:  test(\"reads a body that is nothing but the title heading as empty\", () => {\nsrc/lib/notes.test.ts:166:describe(\"noteBodyForEditor\", () => {\nsrc/lib/notes.test.ts:167:  test(\"removes the duplicated title before editing\", () => {\nsrc/lib/notes.test.ts:171:  test(\"is empty while the body has not loaded\", () => {\nsrc/lib/notes.test.ts:176:describe(\"noteBodyForStorage\", () => {\nsrc/lib/notes.test.ts:177:  test(\"restores the original title heading after editing\", () => {\nsrc/lib/notes.test.ts:183:  test(\"does not add a title heading when the source did not have one\", () => {\nsrc/lib/notes.test.ts:187:  test(\"does not add a title heading when the item has no title to match it against\", () => {\nsrc/lib/notes.test.ts:194:  test(\"has nothing to save when the user emptied a note\", () => {\nsrc/lib/notes.test.ts:202:describe(\"normalizeNoteBody\", () => {\nsrc/lib/notes.test.ts:203:  test(\"normalizes line endings and trims the source\", () => {\nsrc/lib/notes.test.ts:208:describe(\"isSafeNoteLink\", () => {\nsrc/lib/notes.test.ts:209:  test(\"accepts web URLs\", () => {\nsrc/lib/notes.test.ts:214:  test(\"refuses schemes that would run or embed on open\", () => {\nsrc/lib/notes.test.ts:221:  test(\"refuses anything that is not a URL\", () => {\nsrc/lib/d