: 92px;\n  padding: 0 12px;\n  border-color: #38332e;\n  border-radius: 999px;\n  background: var(--library-surface-raised);\n  color: #c8c0b5;\n  font: 11px var(--font-ui);\n}\n.expanded-overlay-layer.is-focus-mode .expanded-overlay-close::after {\n  content: \"Exit focus\";\n  margin-left: 7px;\n}\n.expanded-overlay-layer.is-focus-mode .expanded-overlay-close:hover {\n  border-color: #6b5748;\n  background: #25211e;\n}\n.expanded-overlay-layer.is-focus-mode .expanded-overlay-close svg {\n  width: 13px;\n  height: 13px;\n}\n.expanded-overlay.is-editing-note .expanded-overlay-media {\n  display: none;\n}\n.expanded-overlay.is-editing-note .expanded-overlay-body {\n  display: flex;\n  flex-direction: column;\n  flex: 1 1 auto;\n  min-height: 0;\n  padding: 0;\n  overflow: hidden;\n}\n.expanded-overlay.is-editing-note .detail-processing,\n.expanded-overlay.is-editing-note .detail-meta,\n.expanded-overlay.is-editing-note .expanded-overlay-actions,\n.expanded-overlay.is-editing-note .expanded-overlay-toolbar {\n  display: none;\n}\n.note-embedded-editor {\n  flex: 1 1 auto;\n  min-height: 0;\n  display: flex;\n  flex-direction: column;\n  margin: 0;\n}\n.note-embedded-orientation {\n  flex: 0 0 auto;","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"sourceToolAssistantUUID":"ebfb6aa2-2c60-436e-87cf-c7267c13126b","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"sdk-ts","cwd":"C:\\Users\\chris\\.t3\\worktrees\\inkling\\t3-47ff5304","sessionId":"fad76192-bf94-45bb-9f1a-d29cda113db7","version":"2.1.303","gitBranch":"feat/glass-surface","slug":"purrfect-munching-gadget"}
