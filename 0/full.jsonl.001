\\t3-a1f541e8","sessionId":"bf5ac5c7-e575-44db-b623-8a1386058030","version":"2.1.310","gitBranch":"squidlee/squ-132-stack-77-onboarding-reader-cleanup-delete-appcss","slug":"starry-painting-spark"}
{"parentUuid":"46a9d29d-0b61-4ede-9fdf-3912c8456dec","isSidechain":false,"promptId":"cda62929-1bba-4a09-ba3d-cc680eb61184","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WMT2YFhsKtixvNEpu4dPMp","type":"tool_result","content":"57:test(\"completed onboarding persists across library reopen\", () => {\n133:test(\"demo-seed search, Smart Space, Regular Space, CRUD, and semantic ranking match goldens\", () => {\n198:test(\"list rows keep card fields while full content stays available by item id\", () => {\n285:test(\"URL enrichment preserves a title and tags edited while extraction is queued\", () => {\n327:test(\"URL capture commits the fallback item with a pending enrichment job\", () => {\n352:test(\"URL capture rolls back the item when its enrichment job cannot be queued\", () => {\n365:test(\"free-text search hybrid-ranks lexical and Nomic semantic matches\", () => {\n396:test(\"free-text search keeps lexical matches and drops weak semantic matches\", () => {\n421:test(\"Smart Spaces apply saved filters to hybrid text-search candidates\", () => {\n442:test(\"Smart Space predicates are applied before the result limit\", () => {\n462:test(\"LIKE fallback treats percent and underscore as literal search characters\", () => {\n476:test(\"v7 libraries migrate note bodies, Space kind, jobs, and FTS to schema 8\", () => {\n517:test(\"job leases are owner-bound, renew for five minutes, and recover only after expiry\", () => {\n579:test(\"exclusive startup resumes interrupted URL work without stealing other live jobs\", () => {\n616:test(\"manual retry restores the full retry budget\", () => {\n639:test(\"file capture persists its item and asset before queued processing becomes visible\", async () => {\n661:test(\"file bytes arrive as a typed array view or an ArrayBuffer, never a number array\", async () => {\n684:test(\"image capture saves the item and header-read size without resizing\", async () => {\n721:test(\"image capture refuses what inspection rejects before it stores anything\", async () => {\n740:test(\"image thumbnails publish once, record the decoded size, and tell the renderer\", async () => {\n770:test(\"export snapshots and hashes assets; restore rejects tampering and imports the verified copy\", async () => {\n818:test(\"export counts and copies assets from the database snapshot\", async () => {\n843:test(\"successful export details persist across reopening the library\", async () => {\n861:test(\"restore rejects item ids that could escape the managed asset directory\", async () => {\n881:test(\"restore preserves Space kinds, ordering, and Regular Space membership\", async () => {\n912:test(\"restore rejects unsupported Smart Space query fields\", async () => {\n931:test(\"restore keeps stored pins and accepts an older pin filter\", async () => {\n954:test(\"restore removes staged assets when the active library rejects its transaction\", async () => {\n976:test(\"data directory keeps portable precedence and the product app-data identity\", () => {\n999:test(\"the Electron worker leaves unregistered processors queued instead of blocking capture\", async () => {\n1013:test(\"stopping the Electron worker waits for its active job and leaves later work queued\", async () => {\n1060:test(\"silent thumbnail jobs never appear in summaries, counts, or lifecycle events\", () => {\n1098:test(\"the worker admits idle work only when nothing processable is pending and drains it without polling\", async () => {\n1127:test(\"PDF thumbnails publish once, touch only thumbnail_path, and survive export and restore\", async () => {\n1178:test(\"PDF thumbnail candidates walk the kind index by rowid without sorting and skip failed or assetless PDFs\", () => {\n1218:test(\"item job lookups return the latest job of each kind, for any number of items\", () => {\n1238:test(\"the change count holds still on reads and moves on every write\", () => {","is_error":false}]},"uuid":"b0164e20-4286-45e0-a3d8-104432d829d7","timest