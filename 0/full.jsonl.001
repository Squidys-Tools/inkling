{"parentUuid":"f1f54453-1e25-4da8-a067-55dbca065e46","isSidechain":false,"promptId":"6f28c0dc-c66c-4abb-8f60-5b5bebef6251","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012mGgKBFPfyhfXWejmvsHw8","type":"tool_result","content":"1\timport {\n2\t  lazy,\n3\t  Suspense,\n4\t  useCallback,\n5\t  useEffect,\n6\t  useLayoutEffect,\n7\t  useRef,\n8\t  useState,\n9\t  type CSSProperties,\n10\t  type ReactNode,\n11\t  type RefObject,\n12\t} from \"react\";\n13\timport { gsap } from \"gsap\";\n14\timport { HugeiconsIcon } from \"@hugeicons/react\";\n15\timport {\n16\t  AlertCircleIcon,\n17\t  Archive01Icon,\n18\t  ArrowUpRight01Icon,\n19\t  BookOpen01Icon,\n20\t  CheckmarkCircle01Icon,\n21\t  Copy01Icon,\n22\t  FileTextIcon,\n23\t  Globe02Icon,\n24\t  Loading01Icon,\n25\t  PinIcon,\n26\t  PlusSignIcon,\n27\t  RotateCwIcon,\n28\t  SparklesIcon,\n29\t  Cancel01Icon,\n30\t} from \"@hugeicons/core-free-icons\";\n31\timport type { LibraryItem } from \"../lib/types\";\n32\timport { isElectronRuntime } from \"../lib/libraryApi\";\n33\timport type { ReaderOrigin } from \"../ReaderView\";\n34\timport {\n35\t  KindIcon,\n36\t  NoteArtwork,\n37\t  PdfArtwork,\n38\t  PostArtwork,\n39\t  XPostEmbed,\n40\t  DetailVideoMedia,\n41\t  pdfPreviewTitle,\n42\t} from \"./ItemMedia\";\n43\timport {\n44\t  OVERLAY_EASE,\n45\t  OVERLAY_FLIGHT_MS,\n46\t  isCardTooFarOffscreen,\n47\t  overlayMediaHeight,\n48\t  overlayPosition,\n49\t  overlayWidth,\n50\t  prefersReducedMotion,\n51\t  queryCardRects,\n52\t  rectFrom,\n53\t  scrollViewport,\n54\t  type FlightRect,\n55\t  type SourceRects,\n56\t} from \"./overlayMotion\";\n57\t\n58\tconst RichNoteEditor = lazy(() =>\n59\t  import(\"./RichNoteEditor\").then((module) => ({ default: module.RichNoteEditor })),\n60\t);\n61\t\n62\texport type ExpandedOverlayActions = {\n63\t  onClose: () => void;\n64\t  onOpenPdf: (item: LibraryItem) => void;\n65\t  onOpenReader: (item: LibraryItem, origin: ReaderOrigin) => void;\n66\t  onFindSimilar: (item: LibraryItem) => void;\n67\t  onForget: (item: LibraryItem) => void | Promise<void>;\n68\t  onTogglePin: (item: LibraryItem) => void | Promise<void>;\n69\t  onRetryJob: (jobId: string) => void | Promise<void>;\n70\t  onAddTag?: (item: LibraryItem, tag: string) => void | Promise<void>;\n71\t  onUpdateNote: (item: LibraryItem, body: string) => void | Promise<void>;\n72\t  onToggleSpace?: (item: LibraryItem, spaceId: string) => void | Promise<void>;\n73\t  isFindingSimilar: boolean;\n74\t};\n75\t\n76\t/** A Regular Space chip: filing an item in and taking it back out happen in the\n77\t *  same place, so one toggle carries both directions. */\n78\texport type OverlaySpaceChip = {\n79\t  id: string;\n80\t  name: string;\n81\t  color: string;\n82\t  member: boolean;\n83\t};\n84\t\n85\ttype OverlayAction = {\n86\t  key: string;\n87\t  label: string;\n88\t  icon: ReactNode;\n89\t  onClick: (event: React.MouseEvent<HTMLButtonElement>) => void;\n90\t  disabled?: boolean;\n91\t  title?: string;\n92\t};\n93\t\n94\ttype OverlayDestination = { frame: FlightRect; mediaHeight: number };\n95\t\n96\ttype Flight =\n97\t  | {\n98\t      kind: \"open\";\n99\t      id: number;\n100\t      originCard: FlightRect;\n101\t      originMediaHeight: number;\n102\t      destination: OverlayDestination;\n103\t    }\n104\t  | {\n105\t      kind: \"close\";\n106\t      id: number;\n107\t      fromItem: LibraryItem;\n108\t      fromCard: FlightRect;\n109\t      fromMediaHeight: number;\n110\t      toRects: SourceRects | null;\n111\t      thenOpen: boolean;\n112\t    };\n113\t\n114\tconst OVERLAY_RADIUS = 18;\n115\t\n116\tfunction clickOrigin(event: React.MouseEvent<HTMLElement>): ReaderOrigin {\n117\t  const rect = event.currentTarget.getBoundingClientRect();\n118\t  return { x: rect.left + rect.width / 2, y: rect.top + rect.height / 2 };\n119\t}\n120\t\n121\t// Variant A (provenance row) derives its quiet metadata line from the item\n122\t// itself: the file/media type comes from the pipeline (image extension or\n123\t// kind), and the saved date is the item's own date. Tags render from the\n124\t// item's tag list with an inline + Add affordance.\n125\tfunction hostnameForUrl(url: string | undefined): string | null {\n126\t  if (!url) return null;\n127\t  try {\n128\t    return new URL(url).hostname.replace(/^www\\./u, \"\");\n129\t  } catch {\n130\t    return null;\n131\t  }\n132\t}\n133\t\n134\tfunction fileTypeFor(item: LibraryItem): string {\n135\t  if (item.kind === \"Image\") {\n136\t    const match = item.image?.split(\"?\")[0].match(/\\.([a-z0-9]{2,5})$/iu);\n137\t    if (match) {\n138\t      const extension = match[1].toLowerCase();\n139\t      return extension === \"jpeg\" ? \"JPG\" : extension.toUpperCase();\n140\t    }\n141\t    return \"JPG\";\n142\t  }\n143\t  switch (item.kind) {\n144\t    case \"PDF\":\n145\t      return \"PDF\";\n146\t    case \"Video\":\n147\t      return \"VIDEO\";\n148\t    case \"Article\":\n149\t      return \"LINK\";\n150\t    case \"Post\":\n151\t      return \"POST\";\n152\t    case \"Note\":\n153\t      return \"NOTE\";\n154\t    case \"Quote\":\n155\t      return \"QUOTE\";\n156\t    default:\n157\t      return \"FILE\";\n158\t  }\n159\t}\n160\t\n161\tfunction savedLabelFor(date: string): string {\n162\t  return `SAVED ${date.replace(/^saved\\s+/iu, \"\").toUpperCase()}`;\n163\t}\n164\t\n165\t// The overlay keeps two triage actions in view: a primary (read / play / open)\n166\t// and secondary (open original / find similar). Everything after the first\n167\t// entry renders in the secondary slot.\n168\tfunction triageActions(item: LibraryItem, actions: ExpandedOverlayActions): OverlayAction[] {\n169\t  const list: OverlayAction[] = [];\n170\t  const sourceHost = hostnameForUrl(item.sourceUrl);\n171\t  const hasReaderContent = Boolean(item.articleHtml || item.hasArticleContent);\n172\t  const openOriginal: OverlayAction = {\n173\t    key: \"open-original\",\n174\t    label: sourceHost ?? item.source ?? \"Open original\",\n175\t    icon: sourceHost ? (\n176\t      <HugeiconsIcon icon={Globe02Icon} size={15} />\n177\t    ) : (\n178\t      <HugeiconsIcon icon={ArrowUpRight01Icon} size={15} />\n179\t    ),\n180\t    onClick: () => item.sourceUrl && window.open(item.sourceUrl, \"_blank\", \"noopener,noreferrer\"),\n181\t    disabled: !item.sourceUrl,\n182\t  };\n183\t\n184\t  if (item.kind === \"PDF\" && item.fileUrl) {\n185\t    list.push({\n186\t      key: \"open-pdf\",\n187\t      label: \"Open PDF\",\n188\t      icon: <HugeiconsIcon icon={FileTextIcon} size={15} />,\n189\t      onClick: () => actions.onOpenPdf(item),\n190\t    });\n191\t  }\n192\t  if (item.kind === \"Article\" && hasReaderContent) {\n193\t    list.push({\n194\t      key: \"read\",\n195\t      label: \"Read\",\n196\t      icon: <HugeiconsIcon icon={BookOpen01Icon} size={15} />,\n197\t      onClick: (event) => actions.onOpenReader(item, clickOrigin(event)),\n198\t    });\n199\t  }\n200\t  if (item.sourceUrl) list.push(openOriginal);\n201\t  if (isElectronRuntime() && [\"Image\", \"Article\", \"Note\", \"Quote\"].includes(item.kind)) {\n202\t    list.push({\n203\t      key: \"find-similar\",\n204\t      label: actions.isFindingSimilar ? \"Finding similar…\" : \"Find similar\",\n205\t      icon: <HugeiconsIcon icon={SparklesIcon} size={15} />,\n206\t      onClick: () => actions.onFindSimilar(item),\n207\t      disabled: actions.isFindingSimilar,\n208\t    });\n209\t  }\n210\t  if (item.kind === \"Article\" && !hasReaderContent && item.sourceUrl) {\n211\t    list.push({\n212\t      key: \"read-unavailable\",\n213\t      label: \"Read\",\n214\t      icon: <HugeiconsIcon icon={BookOpen01Icon} size={15} />,\n215\t      onClick: () => {},\n216\t      disabled: true,\n217\t      title: \"No saved article text\",\n218\t    });\n219\t  }\n220\t  return list;\n221\t}\n222\t\n223\tfunction OverlayMedia({ item }: { item: LibraryItem }) {\n224\t  if (item.kind === \"Note\" && !item.image) {\n225\t    return (\n226\t      <div className=\"expanded-overlay-media note-detail-media\">\n227\t        <NoteArtwork item={item} />\n228\t      </div>\n229\t    );\n230\t  }\n231\t\n232\t  if (item.social?.provider === \"x\") {\n233\t    return (\n234\t      <div className=\"expanded-overlay-media detail-x-post\">\n235\t        <XPostEmbed\n236\t          key={item.social.postUrl}\n237\t          social={item.social}\n238\t          fallback={\n239\t            item.post ? (\n240\t              <PostArtwork post={item.post} />\n241\t            ) : (\n242\t              <div className=\"detail-art ink\">Post preview unavailable.</div>\n243\t            )\n244\t          }\n245\t        />\n246\t      </div>\n247\t    );\n248\t  }\n249\t\n250\t  if (item.kind === \"Video\") {\n251\t    return (\n252\t      <div className=\"expanded-overlay-media\">\n253\t        <DetailVideoMedia item={item} />\n254\t      </div>\n255\t    );\n256\t  }\n257\t\n258\t  if (item.kind === \"PDF\") {\n259\t    return (\n260\t      <div className=\"expanded-overlay-media\">\n261\t        <PdfArtwork item={item} />\n262\t      </div>\n263\t    );\n264\t  }\n265\t\n266\t  if (item.image) {\n267\t    return (\n268\t      <div className=\"expanded-overlay-media\">\n269\t        <img src={item.image} alt={item.imageAlt ?? item.title} className=\"detail-image\" />\n270\t      </div>\n271\t    );\n272\t  }\n273\t\n274\t  if (item.kind === \"Quote\") {\n275\t    return (\n276\t      <div className=\"expanded-overlay-media\">\n277\t        <div className=\"detail-art detail-quote-art paper-yellow\">\n278\t          <span className=\"detail-quote-mark\">“</span>\n279\t          <span>{item.kind}</span>\n280\t        </div>\n281\t      </div>\n282\t    );\n283\t  }\n284\t\n285\t  if (item.kind === \"Post\" && item.post) {\n286\t    return (\n287\t      <div className=\"expanded-overlay-media\">\n288\t        <PostArtwork post={item.post} />\n289\t      </div>\n290\t    );\n291\t  }\n292\t\n293\t  return (\n294\t    <div className=\"expanded-overlay-media\">\n295\t      <div className={`detail-art ${item.accent ?? \"ink\"}`}>\n296\t        <KindIcon kind={item.kind} />\n297\t        <span>{item.kind}</span>\n298\t      </div>\n299\t    </div>\n300\t  );\n301\t}\n302\t\n303\tfunction detailTitleFor(item: LibraryItem): string {\n304\t  return item.kind === \"PDF\" ? pdfPreviewTitle(item.title) || item.title : item.title;\n305\t}\n306\t\n307\ttype ExpandedItemOverlayProps = {\n308\t  item: LibraryItem;\n309\t  actions: ExpandedOverlayActions;\n310\t  /** Regular Spaces available to file this item in. Empty hides the row. */\n311\t  spaces?: OverlaySpaceChip[];\n312\t  originRectsRef: RefObject<SourceRects | null>;\n313\t  contentAreaRef: RefObject<HTMLElement | null>;\n314\t  selectionScrollRef: RefObject<boolean>;\n315\t};\n316\t\n317\texport function ExpandedItemOverlay({\n318\t  item,\n319\t  actions,\n320\t  spaces,\n321\t  originRectsRef,\n322\t  contentAreaRef,\n323\t  selectionScrollRef,\n324\t}: ExpandedItemOverlayProps) {\n325\t  const layerRef = useRef<HTMLDivElement>(null);\n326\t  const dialogRef = useRef<HTMLElement>(null);\n327\t  const mediaRef = useRef<HTMLDivElement>(null);\n328\t  const bodyRef = useRef<HTMLDivElement>(null);\n329\t  const closeButtonRef = useRef<HTMLButtonElement>(null);\n330\t  const tagInputRef = useRef<HTMLInputElement>(null);\n331\t  const itemIdRef = useRef(item.id);\n332\t  const itemRef = useRef(item);\n333\t  const previousItemRef = useRef(item);\n334\t  const copyTimerRef = useRef<number | null>(null);\n335\t  const flightIdRef = useRef(0);\n336\t  const flightRef = useRef<Flight | null>(null);\n337\t  const destinationRef = useRef<OverlayDestination | null>(null);\n338\t  const cancelPendingOpenRef = useRef(false);\n339\t  const hasSettledOnceRef = useRef(false);\n340\t  const actionsRef = useRef(actions);\n341\t  const [destination, setDestination] = useState<OverlayDestination | null>(null);\n342\t  const [flight, setFlight] = useState<Flight | null>(null);\n343\t  const [pendingOpen, setPendingOpen] = useState(false);\n344\t  const [linkCopied, setLinkCopied] = useState(false);\n345\t  const [linkCopyFailed, setLinkCopyFailed] = useState(false);\n346\t  const [isEditingNote, setIsEditingNote] = useState(false);\n347\t  const [isFocusMode, setIsFocusMode] = useState(false);\n348\t  const isEditingNoteRef = useRef(false);\n349\t  const isFocusModeRef = useRef(false);\n350\t\n351\t  // Mirror props into refs inside an effect, never during render, so a\n352\t  // concurrent render cannot publish a half-updated set. This runs before\n353\t  // the flight effects below, which read these refs.\n354\t  useLayoutEffect(() => {\n355\t    itemIdRef.current = item.id;\n356\t    itemRef.current = item;\n357\t    flightRef.current = flight;\n358\t  }, [item, flight]);\n359\t\n360\t  useLayoutEffect(() => {\n361\t    isEditingNoteRef.current = isEditingNote;\n362\t    isFocusModeRef.current = isFocusMode;\n363\t  }, [isEditingNote, isFocusMode]);\n364\t\n365\t  // The item whose content the dialog shows. During a closing flight that was\n366\t  // triggered by switching items, the dialog flies back displaying the item it\n367\t  // was showing, while React's item prop already points at the next one.\n368\t  const shownItem = flight?.kind === \"close\" ? flight.fromItem : item;\n369\t\n370\t  const contentAreaRect = useCallback((): FlightRect => {\n371\t    const rect = contentAreaRef.current?.getBoundingClientRect();\n372\t    if (rect) return rectFrom(rect);\n373\t    return { left: 0, top: 0, width: window.innerWidth, height: window.innerHeight };\n374\t  }, [contentAreaRef]);\n375\t\n376\t  // Lays the dialog out at the destination width, measures its natural\n377\t  // content height, and picks a frame centered on the parent card.\n378\t  const beginOpenFlight = useCallback(\n379\t    (origin: SourceRects) => {\n380\t      const dialog = dialogRef.current;\n381\t      if (!dialog) return;\n382\t      const content = contentAreaRect();\n383\t      const width = overlayWidth(content);\n384\t      const mediaHeight = overlayMediaHeight(itemRef.current, width, window.innerHeight);\n385\t\n386\t      dialog.style.width = `${width}px`;\n387\t      dialog.style.height = \"auto\";\n388\t      if (mediaRef.current) mediaRef.current.style.height = `${mediaHeight}px`;\n389\t      const contentHeight = dialog.offsetHeight;\n390\t      const availHeight = Math.max(content.height - 24 * 2, 240);\n391\t      const height = Math.min(Math.max(contentHeight, 320), availHeight);\n392\t      const position = overlayPosition(origin.card, content, width, height);\n393\t\n394\t      const destination: OverlayDestination = {\n395\t        frame: { left: position.left, top: position.top, width, height },\n396\t        mediaHeight,\n397\t      };\n398\t      destinationRef.current = destination;\n399\t      setDestination(destination);\n400\t      flightIdRef.current += 1;\n401\t      setFlight({\n402\t        kind: \"open\",\n403\t        id: flightIdRef.current,\n404\t        originCard: origin.card,\n405\t        originMediaHeight: origin.media.height,\n406\t        destination,\n407\t      });\n408\t    },\n409\t    [contentAreaRect],\n410\t  );\n411\t\n412\t  const beginCloseFlight = useCallback(\n413\t    (closingItem: LibraryItem, toRects: SourceRects | null, thenOpen: boolean) => {\n414\t      const dialog = dialogRef.current;\n415\t      const media = mediaRef.current;\n416\t      if (!dialog) {\n417\t        actionsRef.current.onClose();\n418\t        return;\n419\t      }\n420\t      const fromCard = rectFrom(dialog.getBoundingClientRect());\n421\t      const fromMediaHeight = media ? media.getBoundingClientRect().height : 0;\n422\t      flightIdRef.current += 1;\n423\t      setFlight({\n424\t        kind: \"close\",\n425\t        id: flightIdRef.current,\n426\t        fromItem: closingItem,\n427\t        fromCard,\n428\t        fromMediaHeight,\n429\t        toRects,\n430\t        thenOpen,\n431\t      });\n432\t    },\n433\t    [],\n434\t  );\n435\t\n436\t  const beginOpenFlightFrom = useCallback(\n437\t    (fromMediaHeight: number, origin: SourceRects) => {\n438\t      const dialog = dialogRef.current;\n439\t      if (!dialog) return;\n440\t      const content = contentAreaRect();\n441\t      const width = overlayWidth(content);\n442\t      const mediaHeight = overlayMediaHeight(itemRef.current, width, window.innerHeight);\n443\t\n444\t      const measuredBefore = dialog.getBoundingClientRect();\n445\t      dialog.style.width = `${width}px`;\n446\t      dialog.style.height = \"auto\";\n447\t      if (mediaRef.current) mediaRef.current.style.height = `${mediaHeight}px`;\n448\t      const contentHeight = dialog.offsetHeight;\n449\t      const availHeight = Math.max(content.height - 24 * 2, 240);\n450\t      const height = Math.min(Math.max(contentHeight, 320), availHeight);\n451\t      const position = overlayPosition(origin.card, content, width, height);\n452\t\n453\t      const destination: OverlayDestination = {\n454\t        frame: { left: position.left, top: position.top, width, height },\n455\t        mediaHeight,\n456\t      };\n457\t      destinationRef.current = destination;\n458\t      setDestination(destination);\n459\t      flightIdRef.current += 1;\n460\t      setFlight({\n461\t        kind: \"open\",\n462\t        id: flightIdRef.current,\n463\t        originCard: measuredBefore,\n464\t        originMediaHeight: fromMediaHeight,\n465\t        destination,\n466\t      });\n467\t    },\n468\t    [contentAreaRect],\n469\t  );\n470\t\n471\t  const requestClose = useCallback(() => {\n472\t    const activeFlight = flightRef.current;\n473\t    if (activeFlight?.kind === \"close\") {\n474\t      if (activeFlight.thenOpen) cancelPendingOpenRef.current = true;\n475\t      return;\n476\t    }\n477\t    const rects = queryCardRects(itemIdRef.current);\n478\t    if (prefersReducedMotion() || !rects || !dialogRef.current) {\n479\t      if (flightRef.current) setFlight(null);\n480\t      gsap.to(layerRef.current, {\n481\t        opacity: 0,\n482\t        duration: 0.15,\n483\t        onComplete: actionsRef.current.onClose,\n484\t      });\n485\t      return;\n486\t    }\n487\t    cancelPendingOpenRef.current = false;\n488\t    beginCloseFlight(itemRef.current, rects, false);\n489\t  }, [beginCloseFlight]);\n490\t\n491\t  // Picks the overlay's frame before the opening animation starts. Openings\n492\t  // always run over the general area of the item's parent card.\n493\t  // The origin rectangle is a one-time snapshot supplied through a mutable ref.\n494\t  // Reading it again after opening would retarget the flight to a stale card.\n495\t  // biome-ignore lint/correctness/useExhaustiveDependencies: This effect consumes the source-rectangle snapshot once on mount.\n496\t  useLayoutEffect(() => {\n497\t    const originRects = originRectsRef.current;\n498\t    if (!originRects || prefersReducedMotion()) {\n499\t      gsap.fromTo(\n500\t        layerRef.current,\n501\t        { opacity: 0 },\n502\t        { opacity: 1, duration: 0.18, ease: \"power1.out\" },\n503\t      );\n504\t      return;\n505\t    }\n506\t    beginOpenFlight(originRects);\n507\t  }, [beginOpenFlight]);\n508\t\n509\t  // Runs every flight. GSAP owns the overlay's rectangle geometry. The real\n510\t  // content stays mounted and laid out at the destination width for the whole\n511\t  // flight — the frame is all that moves — so text never re-wraps and\n512\t  // nothing unmounts or flashes mid-animation.\n513\t  useLayoutEffect(() => {\n514\t    if (!flight) return;\n515\t    const media = mediaRef.current;\n516\t    const dialog = dialogRef.current;\n517\t\n518\t    if (flight.kind === \"open\") {\n519\t      if (!dialog || !media) return;\n520\t      const cardRadius = Number.parseFloat(\n521\t        getComputedStyle(dialog).getPropertyValue(\"--sidebar-radius\"),\n522\t      );\n523\t      const duration = OVERLAY_FLIGHT_MS / 1000;\n524\t      const hasEmbed =\n525\t        itemRef.current.social?.provider === \"x\" ||\n526\t        (itemRef.current.kind === \"Video\" && !!itemRef.current.video);\n527\t      const timeline = gsap.timeline({\n528\t        onComplete: () => {\n529\t          setFlight(null);\n530\t          closeButtonRef.current?.focus({ preventScroll: true });\n531\t        },\n532\t      });\n533\t      timeline\n534\t        .fromTo(\n535\t          dialog,\n536\t          {\n537\t            left: flight.originCard.left,\n538\t            top: flight.originCard.top,\n539\t            width: flight.originCard.width,\n540\t            height: flight.originCard.height,\n541\t            borderRadius: cardRadius,\n542\t          },\n543\t          {\n544\t            left: flight.destination.frame.left,\n545\t            top: flight.destination.frame.top,\n546\t            width: flight.destination.frame.width,\n547\t            height: flight.destination.frame.height,\n548\t            borderRadius: OVERLAY_RADIUS,\n549\t            duration,\n550\t            ease: OVERLAY_EASE,\n551\t            autoRound: false,\n552\t          },\n553\t          0,\n554\t        )\n555\t        .fromTo(dialog, { opacity: 0 }, { opacity: 1, duration: 0.12, ease: \"power1.out\" }, 0);\n556\t      if (hasEmbed) {\n557\t        // Third-party embeds keep a stable frame for the whole flight.\n558\t        gsap.set(media, { height: flight.destination.mediaHeight });\n559\t      } else {\n560\t        timeline.fromTo(\n561\t          media,\n562\t          { height: flight.originMediaHeight },\n563\t          {\n564\t            height: flight.destination.mediaHeight,\n565\t            duration,\n566\t            ease: OVERLAY_EASE,\n567\t            autoRound: false,\n568\t          },\n569\t          0,\n570\t        );\n571\t      }\n572\t      return () => {\n573\t        timeline.kill();\n574\t      };\n575\t    }\n576\t\n577\t    // Closing: the dialog returns to its source card and dissolves into it,\n578\t    // or — when the source card is no longer mounted — fades out in place.\n579\t    if (!dialog || !media) {\n580\t      actionsRef.current.onClose();\n581\t      return;\n582\t    }\n583\t    const cardRadius = Number.parseFloat(\n584\t      getComputedStyle(dialog).getPropertyValue(\"--sidebar-radius\"),\n585\t    );\n586\t    const duration = OVERLAY_FLIGHT_MS / 1000;\n587\t    const hasEmbed =\n588\t      flight.fromItem.social?.provider === \"x\" ||\n589\t      (flight.fromItem.kind === \"Video\" && !!flight.fromItem.video);\n590\t    const timeline = gsap.timeline({\n591\t      onComplete: () => {\n592\t        if (flight.thenOpen && !cancelPendingOpenRef.current) {\n593\t          setFlight(null);\n594\t          setPendingOpen(true);\n595\t        } else {\n596\t          actionsRef.current.onClose();\n597\t        }\n598\t      },\n599\t    });\n600\t    if (flight.toRects) {\n601\t      timeline\n602\t        .fromTo(\n603\t          dialog,\n604\t          {\n605\t            left: flight.fromCard.left,\n606\t            top: flight.fromCard.top,\n607\t            width: flight.fromCard.width,\n608\t            height: flight.fromCard.height,\n609\t          },\n610\t          {\n611\t            left: flight.toRects.card.left,\n612\t            top: flight.toRects.card.top,\n613\t            width: flight.toRects.card.width,\n614\t            height: flight.toRects.card.height,\n615\t            borderRadius: cardRadius,\n616\t            duration,\n617\t            ease: OVERLAY_EASE,\n618\t            autoRound: false,\n619\t          },\n620\t          0,\n621\t        )\n622\t        .to(dialog, { opacity: 0, duration: 0.18, ease: \"power1.in\" }, duration - 0.18);\n623\t      if (hasEmbed) {\n624\t        gsap.set(media, { height: flight.fromMediaHeight });\n625\t      } else {\n626\t        timeline.fromTo(\n627\t          media,\n628\t          { height: flight.fromMediaHeight },\n629\t          { height: flight.toRects.media.height, duration, ease: OVERLAY_EASE, autoRound: false },\n630\t          0,\n631\t        );\n632\t      }\n633\t    } else {\n634\t      timeline.to(dialog, { opacity: 0, duration: 0.25, ease: \"power1.in\" });\n635\t    }\n636\t    return () => {\n637\t      timeline.kill();\n638\t    };\n639\t  }, [flight]);\n640\t\n641\t  // Re-clamps and re-measures the settled overlay when the window resizes.\n642\t  useEffect(() => {\n643\t    const onResize = () => {\n644\t      const dialog = dialogRef.current;\n645\t      if (!dialog || !destinationRef.current) return;\n646\t      const content = contentAreaRect();\n647\t      const width = overlayWidth(content);\n648\t      const mediaHeight = overlayMediaHeight(itemRef.current, width, window.innerHeight);\n649\t      dialog.style.width = `${width}px`;\n650\t      if (mediaRef.current) mediaRef.current.style.height = `${mediaHeight}px`;\n651\t      const contentHeight = dialog.offsetHeight;\n652\t      const availHeight = Math.max(content.height - 24 * 2, 240);\n653\t      const height = Math.min(Math.max(contentHeight, 320), availHeight);\n654\t      const cardCenterX =\n655\t        destinationRef.current.frame.left + destinationRef.current.frame.width / 2;\n656\t      const cardCenterY =\n657\t        destinationRef.current.frame.top + destinationRef.current.frame.height / 2;\n658\t      const position = overlayPosition(\n659\t        { left: cardCenterX - width / 2, top: cardCenterY - height / 2, width, height },\n660\t        content,\n661\t        width,\n662\t        height,\n663\t      );\n664\t      const next: OverlayDestination = {\n665\t        frame: { left: position.left, top: position.top, width, height },\n666\t        mediaHeight,\n667\t      };\n668\t      destinationRef.current = next;\n669\t      setDestination(next);\n670\t    };\n671\t    window.addEventListener(\"resize\", onResize);\n672\t    return () => window.removeEventListener(\"resize\", onResize);\n673\t  }, [contentAreaRect]);\n674\t\n675\t  // Switching items while the overlay is open runs sequentially: the open\n676\t  // overlay first animates closed into the card it was showing, and only\n677\t  // after it lands does the newly selected item animate open from its own\n678\t  // card. Rapid clicks during the closing leg are absorbed — the flight\n679\t  // completes once and then opens the most recently selected item.\n680\t  useLayoutEffect(() => {\n681\t    const previous = previousItemRef.current;\n682\t    if (previous.id === item.id) return;\n683\t    previousItemRef.current = item;\n684\t    if (isEditingNoteRef.current) {\n685\t      // Card presses are absorbed while a note is being written, so this only\n686\t      // catches a switch that arrived another way (Enter on a focused card).\n687\t      // Leave the editor rather than carry the draft onto another item.\n688\t      setIsEditingNote(false);\n689\t      setIsFocusMode(false);\n690\t    }\n691\t\n692\t    const activeFlight = flightRef.current;\n693\t    if (activeFlight?.kind === \"close\") return;\n694\t    if (activeFlight?.kind === \"open\") {\n695\t      // Retarget the in-progress open from its current visual state.\n696\t      const dialog = dialogRef.current;\n697\t      const media = mediaRef.current;\n698\t      const rects = queryCardRects(item.id);\n699\t      if (!dialog || !media || !rects) return;\n700\t      const fromMediaHeight = media.getBoundingClientRect().height;\n701\t      cancelPendingOpenRef.current = false;\n702\t      beginOpenFlightFrom(fromMediaHeight, rects);\n703\t      return;\n704\t    }\n705\t\n706\t    // Settled: close into the old card, then open the new selection.\n707\t    cancelPendingOpenRef.current = false;\n708\t    const previousRects = queryCardRects(previous.id);\n709\t    beginCloseFlight(previous, previousRects, /* thenOpen */ true);\n710\t  }, [item, beginOpenFlightFrom, beginCloseFlight]);\n711\t\n712\t  // When a sequential switch's closing leg lands, open the newly selected\n713\t  // item from its own card. The dialog is measured at the destination width\n714\t  // so the frame height fits its content with no leftover whitespace.\n715\t  useLayoutEffect(() => {\n716\t    if (!pendingOpen || flight) return;\n717\t    setPendingOpen(false);\n718\t    if (cancelPendingOpenRef.current) {\n719\t      cancelPendingOpenRef.current = false;\n720\t      actionsRef.current.onClose();\n721\t      return;\n722\t    }\n723\t    const rects = queryCardRects(itemRef.current.id);\n724\t    if (!rects) {\n725\t      actionsRef.current.onClose();\n726\t      return;\n727\t    }\n728\t    beginOpenFlight(rects);\n729\t  }, [pendingOpen, flight, beginOpenFlight]);\n730\t\n731\t  // On close, hand focus back to the source card while it is still mounted.\n732\t  // Skipping the restore when focus already moved elsewhere (nav, search)\n733\t  // avoids yanking it back out of whatever the user clicked.\n734\t  useEffect(\n735\t    () => () => {\n736\t      const focusOwner = document.activeElement;\n737\t      const overlayHasFocus =\n738\t        focusOwner instanceof HTMLElement && (dialogRef.current?.contains(focusOwner) ?? false);\n739\t      if (!overlayHasFocus && focusOwner !== document.body) return;\n740\t      const card = document.querySelector<HTMLElement>(\n741\t        `.library-card[data-library-item-id=\"${CSS.escape(String(itemIdRef.current))}\"]`,\n742\t      );\n743\t      card?.focus({ preventScroll: true });\n744\t    },\n745\t    [],\n746\t  );\n747\t\n748\t  // Move focus to the close control when the overlay finishes opening.\n749\t  useLayoutEffect(() => {\n750\t    if (flight || !destination || hasSettledOnceRef.current) return;\n751\t    hasSettledOnceRef.current = true;\n752\t    closeButtonRef.current?.focus({ preventScroll: true });\n753\t  }, [flight, destination]);\n754\t\n755\t  actionsRef.current = actions;\n756\t\n757\t  const handleOverlayClose = () => {\n758\t    if (isFocusModeRef.current) {\n759\t      setIsFocusMode(false);\n760\t      return;\n761\t    }\n762\t    if (isEditingNoteRef.current) {\n763\t      setIsEditingNote(false);\n764\t      return;\n765\t    }\n766\t    requestClose();\n767\t  };\n768\t\n769\t  // The content-area ref is read afresh for each scroll or resize event.\n770\t  // biome-ignore lint/correctness/useExhaustiveDependencies: Mutable ref contents are intentionally read at event time.\n771\t  useEffect(() => {\n772\t    const checkSourceVisibility = () => {\n773\t      if (selectionScrollRef.current) return;\n774\t      // While a note is being written the source card is irrelevant: closing on\n775\t      // scroll or resize would throw away the draft without a word.\n776\t      if (isEditingNoteRef.current) return;\n777\t      const contentArea = contentAreaRef.current;\n778\t      const viewport = scrollViewport(contentArea);\n779\t      const rects = queryCardRects(itemIdRef.current);\n780\t      if (\n781\t        !viewport ||\n782\t        !rects ||\n783\t        isCardTooFarOffscreen(rects.card, rectFrom(viewport.getBoundingClientRect()))\n784\t      ) {\n785\t        requestClose();\n786\t      }\n787\t    };\n788\t\n789\t    document.addEventListener(\"scroll\", checkSourceVisibility, true);\n790\t    window.addEventListener(\"resize\", checkSourceVisibility);\n791\t    return () => {\n792\t      document.removeEventListener(\"scroll\", checkSourceVisibility, true);\n793\t      window.removeEventListener(\"resize\", checkSourceVisibility);\n794\t    };\n795\t  }, [selectionScrollRef, requestClose]);\n796\t\n797\t  useEffect(() => {\n798\t    const onKeyDown = (event: KeyboardEvent) => {\n799\t      if (event.key !== \"Escape\") return;\n800\t      // A field inside the dialog owns its own Escape: the new-tag input and\n801\t      // the editor's link URL field each cancel just themselves. This listener\n802\t      // runs in the capture phase, before their handlers get a chance to.\n803\t      if (event.target instanceof HTMLInputElement) return;\n804\t      event.stopPropagation();\n805\t      if (isFocusModeRef.current) {\n806\t        setIsFocusMode(false);\n807\t        return;\n808\t      }\n809\t      if (isEditingNoteRef.current) {\n810\t        setIsEditingNote(false);\n811\t        return;\n812\t      }\n813\t      requestClose();\n814\t    };\n815\t    window.addEventListener(\"keydown\", onKeyDown, true);\n816\t    return () => window.removeEventListener(\"keydown\", onKeyDown, true);\n817\t  }, [requestClose]);\n818\t\n819\t  // Modeless close: presses on empty library space dismiss the overlay, while\n820\t  // presses on cards fall through to the card's own handler, which switches the\n821\t  // overlay to that item. While a note is being written every press outside the\n822\t  // dialog is absorbed, cards included, so it cannot silently cancel what was\n823\t  // just typed, carry the panel to another item, or reach a control behind it.\n824\t  // The close button, Escape and Save are the ways out.\n825\t  useEffect(() => {\n826\t    // True for presses the panel answers itself: anything outside the dialog,\n827\t    // plus the cards too while a note is being written, so a stray press cannot\n828\t    // navigate the overlay off an unsaved draft.\n829\t    const shouldHandlePress = (target: EventTarget | null) => {\n830\t      if (!(target instanceof Node)) return false;\n831\t      if (dialogRef.current?.contains(target)) return false;\n832\t      const onCard = target instanceof Element && target.closest(\".library-card\") !== null;\n833\t      return !onCard || isEditingNoteRef.current;\n834\t    };\n835\t\n836\t    const onPointerDown = (event: PointerEvent) => {\n837\t      if (!shouldHandlePress(event.target)) return;\n838\t      if (!isEditingNoteRef.current) {\n839\t        requestClose();\n840\t        return;\n841\t      }\n842\t      event.preventDefault();\n843\t      event.stopPropagation();\n844\t    };\n845\t\n846\t    // A control behind the panel can answer the press, the release, or the\n847\t    // click, and those are separate events, so the press alone is not enough to\n848\t    // absorb the interaction. mousedown is included rather than relying on the\n849\t    // pointerdown cancel to suppress it.\n850\t    const absorbHandledPress = (event: Event) => {\n851\t      if (!isEditingNoteRef.current || !shouldHandlePress(event.target)) return;\n852\t      event.preventDefault();\n853\t      event.stopPropagation();\n854\t    };\n855\t\n856\t    document.addEventListener(\"pointerdown\", onPointerDown, true);\n857\t    document.addEventListener(\"mousedown\", absorbHandledPress, true);\n858\t    document.addEventListener(\"pointerup\", absorbHandledPress, true);\n859\t    document.addEventListener(\"mouseup\", absorbHandledPress, true);\n860\t    document.addEventListener(\"click\", absorbHandledPress, true);\n861\t    return () => {\n862\t      document.removeEventListener(\"pointerdown\", onPointerDown, true);\n863\t      document.removeEventListener(\"mousedown\", absorbHandledPress, true);\n864\t      document.removeEventListener(\"pointerup\", absorbHandledPress, true);\n865\t      document.removeEventListener(\"mouseup\", absorbHandledPress, true);\n866\t      document.removeEventListener(\"click\", absorbHandledPress, true);\n867\t    };\n868\t  }, [requestClose]);\n869\t\n870\t  useEffect(\n871\t    () => () => {\n872\t      if (copyTimerRef.current !== null) window.clearTimeout(copyTimerRef.current);\n873\t    },\n874\t    [],\n875\t  );\n876\t\n877\t  const dialogFlying = flight?.kind === \"open\" || flight?.kind === \"close\";\n878\t  const placedStyle: CSSProperties | undefined = destination\n879\t    ? {\n880\t        left: destination.frame.left,\n881\t        top: destination.frame.top,\n882\t        width: destination.frame.width,\n883\t        height: destination.frame.height,\n884\t      }\n885\t    : undefined;\n886\t\n887\t  function copySourceLink() {\n888\t    if (!shownItem.sourceUrl) return;\n889\t    const resetCopyFeedback = () => {\n890\t      setLinkCopied(false);\n891\t      setLinkCopyFailed(false);\n892\t    };\n893\t    void navigator.clipboard\n894\t      .writeText(shownItem.sourceUrl)\n895\t      .then(() => {\n896\t        setLinkCopied(true);\n897\t        setLinkCopyFailed(false);\n898\t        if (copyTimerRef.current !== null) window.clearTimeout(copyTimerRef.current);\n899\t        copyTimerRef.current = window.setTimeout(resetCopyFeedback, 2000);\n900\t      })\n901\t      .catch(() => {\n902\t        setLinkCopied(false);\n903\t        setLinkCopyFailed(true);\n904\t        if (copyTimerRef.current !== null) window.clearTimeout(copyTimerRef.current);\n905\t        copyTimerRef.current = window.setTimeout(resetCopyFeedback, 2000);\n906\t      });\n907\t  }\n908\t\n909\t  const triage = triageActions(shownItem, actions);\n910\t  const sourceAction = triage.find((action) => action.key === \"open-original\");\n911\t  const otherActions = triage.filter((action) => action.key !== \"open-original\");\n912\t  // Layout G (Paper): any item with readable content merges into a single\n913\t  // row — Read/Open PDF + domain share the row, copy + forget are bare icons.\n914\t  // Readable = whatever currently renders a Read button in the overlay.\n915\t  const readAction = triage.find(\n916\t    (action) =>\n917\t      action.key === \"read\" || action.key === \"open-pdf\" || action.key === \"read-unavailable\",\n918\t  );\n919\t  const isReadRow = Boolean(readAction);\n920\t  const isPinned = shownItem.favorite === true;\n921\t\n922\t  // Copy, pin and forget sit at the end of both toolbar layouts, so they are\n923\t  // built once here rather than pasted into each row.\n924\t  const itemControls = (\n925\t    <>\n926\t      {shownItem.sourceUrl && (\n927\t        <button\n928\t          type=\"button\"\n929\t          className=\"toolbar-icon\"\n930\t          onClick={copySourceLink}\n931\t          aria-label=\"Copy link to original\"\n932\t          title={linkCopied ? \"Copied\" : linkCopyFailed ? \"Copy failed\" : \"Copy link\"}\n933\t        >\n934\t          {linkCopied ? (\n935\t            <HugeiconsIcon icon={CheckmarkCircle01Icon} size={14} />\n936\t          ) : (\n937\t            <HugeiconsIcon icon={Copy01Icon} size={14} />\n938\t          )}\n939\t        </button>\n940\t      )}\n941\t      <button\n942\t        type=\"button\"\n943\t        className=\"toolbar-icon\"\n944\t        onClick={() => void actions.onTogglePin(shownItem)}\n945\t        aria-label={isPinned ? \"Unpin from Top of mind\" : \"Pin to Top of mind\"}\n946\t        aria-pressed={isPinned}\n947\t        title={isPinned ? \"Unpin\" : \"Pin to Top of mind\"}\n948\t      >\n949\t        <HugeiconsIcon icon={PinIcon} size={14} />\n950\t      </button>\n951\t      <button\n952\t        type=\"button\"\n953\t        className=\"toolbar-icon toolbar-icon-muted\"\n954\t        onClick={() => void actions.onForget(shownItem)}\n955\t        aria-label=\"Forget this item\"\n956\t        title=\"Forget\"\n957\t      >\n958\t        <HugeiconsIcon icon={Archive01Icon} size={14} />\n959\t      </button>\n960\t    </>\n961\t  );\n962\t\n963\t  const [isAddingTag, setIsAddingTag] = useState(false);\n964\t  const [tagDraft, setTagDraft] = useState(\"\");\n965\t  useLayoutEffect(() => {\n966\t    if (isAddingTag) tagInputRef.current?.focus();\n967\t  }, [isAddingTag]);\n968\t\n969\t  // Selection changes reset this local editor state even though the selected ID\n970\t  // is only a trigger and is not read by the reset itself.\n971\t  // biome-ignore lint/correctness/useExhaustiveDependencies: The shown item ID intentionally triggers a tag-editor reset.\n972\t  useEffect(() => {\n973\t    setIsAddingTag(false);\n974\t    setTagDraft(\"\");\n975\t  }, [shownItem.id]);\n976\t\n977\t  const allTags = shownItem.tags;\n978\t\n979\t  function submitTag() {\n980\t    const clean = tagDraft.trim().replace(/^#+/u, \"\").toLowerCase();\n981\t    if (clean && !allTags.some((tag) => tag.toLowerCase() === clean)) {\n982\t      void actions.onAddTag?.(shownItem, clean);\n983\t    }\n984\t    setTagDraft(\"\");\n985\t    setIsAddingTag(false);\n986\t  }\n987\t\n988\t  const isEditingNoteView = isEditingNote && shownItem.kind === \"Note\";\n989\t  const isFocusModeView = isFocusMode && isEditingNoteView;\n990\t\n991\t  return (\n992\t    <div\n993\t      className={`expanded-overlay-layer ${isFocusModeView ? \"is-focus-mode\" : \"\"}`}\n994\t      ref={layerRef}\n995\t    >\n996\t      <section\n997\t        ref={dialogRef}\n998\t        className={`expanded-overlay ${destination ? \"is-placed\" : \"\"} ${dialogFlying ? \"is-flying\" : \"\"} ${isEditingNoteView ? \"is-editing-note\" : \"\"} ${isFocusModeView ? \"is-focus-mode\" : \"\"}`}\n999\t        role=\"dialog\"\n1000\t        aria-modal={false}\n1001\t        aria-label={detailTitleFor(shownItem)}\n1002\t        style={\n1003\t          isFocusModeView\n1004\t            ? {\n1005\t                position: \"relative\",\n1006\t                left: \"auto\",\n1007\t                top: \"auto\",\n1008\t                width: \"min(100%, 1060px)\",\n1009\t                height: \"100%\",\n1010\t              }\n1011\t            : dialogFlying\n1012\t              ? undefined\n1013\t              : placedStyle\n1014\t        }\n1015\t      >\n1016\t        <button\n1017\t          type=\"button\"\n1018\t          ref={closeButtonRef}\n1019\t          className=\"expanded-overlay-close\"\n1020\t          onClick={handleOverlayClose}\n1021\t          aria-label={\n1022\t            isFocusModeView\n1023\t              ? \"Exit focus mode\"\n1024\t              : isEditingNoteView\n1025\t                ? \"Close editor\"\n1026\t                : \"Close details\"\n1027\t          }\n1028\t        >\n1029\t          <HugeiconsIcon icon={Cancel01Icon} size={16} />\n1030\t        </button>\n1031\t\n1032\t        <div\n1033\t          className={`expanded-overlay-media ${shownItem.kind === \"Note\" && !shownItem.image ? \"note-detail-media-band\" : \"\"}`}\n1034\t          ref={mediaRef}\n1035\t          style={\n1036\t            dialogFlying\n1037\t              ? undefined\n1038\t              : ({\n1039\t                  height: destination\n1040\t                    ? overlayMediaHeight(shownItem, destination.frame.width, window.innerHeight)\n1041\t                    : undefined,\n1042\t                } as CSSProperties)\n1043\t          }\n1044\t        >\n1045\t          <OverlayMedia item={shownItem} />\n1046\t        </div>\n1047\t\n1048\t        <div\n1049\t          className=\"expanded-overlay-body\"\n1050\t          ref={bodyRef}\n1051\t          style={dialogFlying && destination ? { width: destination.frame.width } : undefined}\n1052\t        >\n1053\t          {isEditingNoteView ? (\n1054\t            <Suspense\n1055\t              fallback={\n1056\t                <p className=\"expanded-overlay-description\" role=\"status\">\n1057\t                  Loading editor…\n1058\t                </p>\n1059\t              }\n1060\t            >\n1061\t              <RichNoteEditor\n1062\t                key={`edit-${shownItem.id}`}\n1063\t                embedded\n1064\t                body={shownItem.noteBody}\n1065\t                title={shownItem.title}\n1066\t                onSave={(body) => actions.onUpdateNote(shownItem, body)}\n1067\t                onEditingChange={(editing) => {\n1068\t                  setIsEditingNote(editing);\n1069\t                  if (!editing) setIsFocusMode(false);\n1070\t                }}\n1071\t                focusMode={isFocusModeView}\n1072\t                onFocusModeChange={setIsFocusMode}\n1073\t              />\n1074\t            </Suspense>\n1075\t          ) : shownItem.kind === \"Quote\" ? (\n1076\t            <>\n1077\t              <blockquote className=\"detail-quote\">“{shownItem.title}”</blockquote>\n1078\t              {shownItem.description && (\n1079\t                <p className=\"detail-attribution\">\n1080\t                  — {shownItem.description.replace(/^—\\s*/u, \"\")}\n1081\t                </p>\n1082\t              )}\n1083\t            </>\n1084\t          ) : shownItem.kind === \"Note\" ? (\n1085\t            <h2 className=\"expanded-overlay-title\">{detailTitleFor(shownItem)}</h2>\n1086\t          ) : (\n1087\t            <>\n1088\t              <h2 className=\"expanded-overlay-title\">{detailTitleFor(shownItem)}</h2>\n1089\t              {shownItem.description && (\n1090\t                <p className=\"expanded-overlay-description\">{shownItem.description}</p>\n1091\t              )}\n1092\t            </>\n1093\t          )}\n1094\t          {!isEditingNoteView && shownItem.processing?.active && (\n1095\t            <div className=\"detail-processing\" role=\"status\">\n1096\t              <HugeiconsIcon icon={Loading01Icon} size={14} />\n1097\t              <span>{shownItem.processing.message ?? \"Processing\"}</span>\n1098\t              {shownItem.processing.progressTotal != null && (\n1099\t                <span>\n1100\t                  {shownItem.processing.progressCurrent}/{shownItem.processing.progressTotal}\n1101\t                </span>\n1102\t              )}\n1103\t            </div>\n1104\t          )}\n1105\t          {!isEditingNoteView && shownItem.processing?.failedJob && (\n1106\t            <div className=\"detail-processing failed\" role=\"alert\">\n1107\t              <HugeiconsIcon icon={AlertCircleIcon} size={14} />\n1108\t              <span>{shownItem.processing.failedJob.errorMessage ?? \"Processing failed\"}</span>\n1109\t              <button\n1110\t                type=\"button\"\n1111\t                className=\"retry-button\"\n1112\t                onClick={() => void actions.onRetryJob(shownItem.processing?.failedJob?.id ?? \"\")}\n1113\t              >\n1114\t                <HugeiconsIcon icon={RotateCwIcon} size={12} /> Try again\n1115\t              </button>\n1116\t            </div>\n1117\t          )}\n1118\t          {!isEditingNoteView && (\n1119\t            <div className=\"detail-meta\">\n1120\t              <div className=\"detail-filemeta\">\n1121\t                <span className=\"filemeta-type\">{fileTypeFor(shownItem)}</span>\n1122\t                <span className=\"filemeta-dot\" aria-hidden=\"true\" />\n1123\t                <span className=\"filemeta-saved\">{savedLabelFor(shownItem.date)}</span>\n1124\t              </div>\n1125\t              <div className=\"detail-tags\">\n1126\t                {allTags.map((tag) => (\n1127\t                  <span key={tag} className=\"detail-tag\">\n1128\t                    #{tag}\n1129\t                  </span>\n1130\t                ))}\n1131\t                {isAddingTag ? (\n1132\t                  <input\n1133\t                    ref={tagInputRef}\n1134\t                    className=\"detail-tag-input\"\n1135\t                    value={tagDraft}\n1136\t                    placeholder=\"tag name\"\n1137\t                    aria-label=\"New tag name\"\n1138\t                    onChange={(event) => setTagDraft(event.target.value)}\n1139\t                    onKeyDown={(event) => {\n1140\t                      if (event.key === \"Enter\") {\n1141\t                        event.preventDefault();\n1142\t                        submitTag();\n1143\t                      } else if (event.key === \"Escape\") {\n1144\t                        setTagDraft(\"\");\n1145\t                        setIsAddingTag(false);\n1146\t                      }\n1147\t                    }}\n1148\t                    onBlur={submitTag}\n1149\t                  />\n1150\t                ) : (\n1151\t                  <button\n1152\t                    type=\"button\"\n1153\t                    className=\"detail-tag-add\"\n1154\t                    onClick={() => setIsAddingTag(true)}\n1155\t                  >\n1156\t                    <HugeiconsIcon icon={PlusSignIcon} size={11} /> Add\n1157\t                  </button>\n1158\t                )}\n1159\t              </div>\n1160\t              {spaces && spaces.length > 0 && (\n1161\t                <fieldset className=\"detail-spaces\">\n1162\t                  <legend className=\"visually-hidden\">Regular Spaces</legend>\n1163\t                  {spaces.map((space) => (\n1164\t                    <button\n1165\t                      key={space.id}\n1166\t                      type=\"button\"\n1167\t                      className={`detail-space ${space.member ? \"is-member\" : \"\"}`}\n1168\t                      aria-pressed={space.member}\n1169\t                      title={space.member ? `Remove from ${space.name}` : `Add to ${space.name}`}\n1170\t                      onClick={() => void actions.onToggleSpace?.(shownItem, space.id)}\n1171\t                    >\n1172\t                      <span className={`detail-space-dot ${space.color}`} aria-hidden=\"true\" />\n1173\t                      <span className=\"detail-space-name\">{space.name}</span>\n1174\t                    </button>\n1175\t                  ))}\n1176\t                </fieldset>\n1177\t              )}\n1178\t            </div>\n1179\t          )}\n1180\t\n1181\t          {isReadRow && otherActions.some((action) => action.key === \"find-similar\") && (\n1182\t            <div className=\"expanded-overlay-actions\">\n1183\t              {otherActions\n1184\t                .filter((action) => action.key === \"find-similar\")\n1185\t                .map((action) => (\n1186\t                  <button\n1187\t                    type=\"button\"\n1188\t                    key={action.key}\n1189\t                    className=\"overlay-action-secondary\"\n1190\t                    onClick={action.onClick}\n1191\t                    disabled={action.disabled}\n1192\t                  >\n1193\t                    {action.icon} {action.label}\n1194\t                  </button>\n1195\t                ))}\n1196\t            </div>\n1197\t          )}\n1198\t\n1199\t          {isReadRow && readAction ? (\n1200\t            <div className=\"expanded-overlay-toolbar is-read-row\">\n1201\t              <button\n1202\t                type=\"button\"\n1203\t                className=\"toolbar-primary toolbar-reading\"\n1204\t                onClick={readAction.onClick}\n1205\t                disabled={readAction.disabled}\n1206\t                title={\n1207\t                  readAction.title ??\n1208\t                  (readAction.disabled ? \"No saved content to read\" : readAction.label)\n1209\t                }\n1210\t              >\n1211\t                {readAction.icon} {readAction.label}\n1212\t              </button>\n1213\t              {sourceAction && (\n1214\t                <button\n1215\t                  type=\"button\"\n1216\t                  className=\"toolbar-primary\"\n1217\t                  onClick={sourceAction.onClick}\n1218\t                  disabled={sourceAction.disabled}\n1219\t                  title={\n1220\t                    sourceAction.disabled ? \"No source link saved\" : `Open ${sourceAction.label}`\n1221\t                  }\n1222\t                >\n1223\t                  {sourceAction.icon} {sourceAction.label}{\" \"}\n1224\t                  <HugeiconsIcon icon={ArrowUpRight01Icon} size={13} />\n1225\t                </button>\n1226\t              )}\n1227\t              {itemControls}\n1228\t            </div>\n1229\t          ) : (\n1230\t            <>\n1231\t              {otherActions.length > 0 && (\n1232\t                <div className=\"expanded-overlay-actions\">\n1233\t                  {otherActions.map((action, index) => (\n1234\t                    <button\n1235\t                      type=\"button\"\n1236\t                      key={action.key}\n1237\t                      className={\n1238\t                        index === 0 ? \"overlay-action-primary\" : \"overlay-action-secondary\"\n1239\t                      }\n1240\t                      onClick={action.onClick}\n1241\t                      disabled={action.disabled}\n1242\t                      title={action.title}\n1243\t                    >\n1244\t                      {action.icon} {action.label}\n1245\t                    </button>\n1246\t                  ))}\n1247\t                </div>\n1248\t              )}\n1249\t\n1250\t              <div className=\"expanded-overlay-toolbar\">\n1251\t                {shownItem.kind === \"Note\" && (\n1252\t                  <button\n1253\t                    type=\"button\"\n1254\t                    className=\"toolbar-primary\"\n1255\t                    onClick={() => {\n1256\t                      setIsFocusMode(false);\n1257\t                      setIsEditingNote(true);\n1258\t                    }}\n1259\t                    aria-label=\"Edit note\"\n1260\t                  >\n1261\t                    Edit note\n1262\t                  </button>\n1263\t                )}\n1264\t                {sourceAction && (\n1265\t                  <button\n1266\t                    type=\"button\"\n1267\t                    className=\"toolbar-primary\"\n1268\t                    onClick={sourceAction.onClick}\n1269\t                    disabled={sourceAction.disabled}\n1270\t                    title={\n1271\t                      sourceAction.disabled ? \"No source link saved\" : `Open ${sourceAction.label}`\n1272\t                    }\n1273\t                  >\n1274\t                    {sourceAction.icon} {sourceAction.label}{\" \"}\n1275\t                    <HugeiconsIcon icon={ArrowUpRight01Icon} size={13} />\n1276\t                  </button>\n1277\t                )}\n1278\t                {itemControls}\n1279\t              </div>\n1280\t            </>\n1281\t          )}\n1282\t\n1283\t          {/* Insertion point for related items (overlay PR 3); renders nothing until then. */}\n1284\t          <div className=\"expanded-overlay-related\" hidden />\n1285\t        </div>\n1286\t      </section>\n1287\t    </div>\n1288\t  );\n1289\t}\n1290\t"}]},"uuid":"01342f56-2cab-493c-93e9-e456acd2eac0","timestamp":"2026-10-19T16:49:10.534Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\chris\\.t3\\worktrees\\inkling\\t3-47ff5304\\src\\components\\ExpandedItemOverlay.tsx","content":"import {\n  lazy,\n  Suspense,\n  useCallback,\n  useEffect,\n  useLayoutEffect,\n  useRef,\n  useState,\n  type CSSProperties,\n  type ReactNode,\n  type RefObject,\n} from \"react\";\nimport { gsap } from \"gsap\";\nimport { HugeiconsIcon } from \"@hugeicons/react\";\nimport {\n  AlertCircleIcon,\n  Archive01Icon,\n  ArrowUpRight01Icon,\n  BookOpen01Icon,\n  CheckmarkCircle01Icon,\n  Copy01Icon,\n  FileTextIcon,\n  Globe02Icon,\n  Loading01Icon,\n  PinIcon,\n  PlusSignIcon,\n  RotateCwIcon,\n  SparklesIcon,\n  Cancel01Icon,\n} from \"@hugeicons/core-free-icons\";\nimport type { LibraryItem } from \"../lib/types\";\nimport { isElectronRuntime } from \"../lib/libraryApi\";\nimport type { ReaderOrigin } from \"../ReaderView\";\nimport {\n  KindIcon,\n  NoteArtwork,\n  PdfArtwork,\n  PostArtwork,\n  XPostEmbed,\n  DetailVideoMedia,\n  pdfPreviewTitle,\n} from \"./ItemMedia\";\nimport {\n  OVERLAY_EASE,\n  OVERLAY_FLIGHT_MS,\n  isCardTooFarOffscreen,\n  overlayMediaHeight,\n  overlayPosition,\n  overlayWidth,\n  prefersReducedMotion,\n  queryCardRects,\n  rectFrom,\n  scrollViewport,\n  type FlightRect,\n  type SourceRects,\n} from \"./overlayMotion\";\n\nconst RichNoteEditor = lazy(() =>\n  import(\"./RichNoteEditor\").then((module) => ({ default: module.RichNoteEditor })),\n);\n\nexport type ExpandedOverlayActions = {\n  onClose: () => void;\n  onOpenPdf: (item: LibraryItem) => void;\n  onOpenReader: (item: LibraryItem, origin: ReaderOrigin) => void;\n  onFindSimilar: (item: LibraryItem) => void;\n  onForget: (item: LibraryItem) => void | Promise<void>;\n  onTogglePin: (item: LibraryItem) => void | Promise<void>;\n  onRetryJob: (jobId: string) => void | Promise<void>;\n  onAddTag?: (item: LibraryItem, tag: string) => void | Promise<void>;\n  onUpdateNote: (item: LibraryItem, body: string) => void | Promise<void>;\n  onToggleSpace?: (item: LibraryItem, spaceId: string) => void | Promise<void>;\n  isFindingSimilar: boolean;\n};\n\n/** A Regular Space chip: filing an item in and taking it back out happen in the\n *  same place, so one toggle carries both directions. */\nexport type OverlaySpaceChip = {\n  id: string;\n  name: string;\n  color: string;\n  member: boolean;\n};\n\ntype OverlayAction = {\n  key: string;\n  label: string;\n  icon: ReactNode;\n  onClick: (event: React.MouseEvent<HTMLButtonElement>) => void;\n  disabled?: boolean;\n  title?: string;\n};\n\ntype OverlayDestination = { frame: FlightRect; mediaHeight: number };\n\ntype Flight =\n  | {\n      kind: \"open\";\n      id: number;\n      originCard: FlightRect;\n      originMediaHeight: number;\n      destination: OverlayDestination;\n    }\n  | {\n      kind: \"close\";\n      id: number;\n      fromItem: LibraryItem;\n      fromCard: FlightRect;\n      fromMediaHeight: number;\n      toRects: SourceRects | null;\n      thenOpen: boolean;\n    };\n\nconst OVERLAY_RADIUS = 18;\n\nfunction clickOrigin(event: React.MouseEvent<HTMLElement>): ReaderOrigin {\n  const rect = event.currentTarget.getBoundingClientRect();\n  return { x: rect.left + rect.width / 2, y: rect.top + rect.height / 2 };\n}\n\n// Variant A (provenance row) derives its quiet metadata line from the item\n// itself: the file/media type comes from the pipeline (image extension or\n// kind), and the saved date is the item's own date. Tags render from the\n// item's tag list with an inline + Add affordance.\nfunction hostnameForUrl(url: string | undefined): string | null {\n  if (!url) return null;\n  try {\n    return new URL(url).hostname.replace(/^www\\./u, \"\");\n  } catch {\n    return null;\n  }\n}\n\nfunction fileTypeFor(item: LibraryItem): string {\n  if (item.kind === \"Image\") {\n    const match = item.image?.split(\"?\")[0].match(/\\.([a-z0-9]{2,5})$/iu);\n    if (match) {\n      const extension = match[1].toLowerCase();\n      return extension === \"jpeg\" ? \"JPG\" : extension.toUpperCase();\n    }\n    return \"JPG\";\n  }\n  switch (item.kind) {\n    case \"PDF\":\n      return \"PDF\";\n    case \"Video\":\n      return \"VIDEO\";\n    case \"Article\":\n      return \"LINK\";\n    case \"Post\":\n      return \"POST\";\n    case \"Note\":\n      return \"NOTE\";\n    case \"Quote\":\n      return \"QUOTE\";\n    default:\n      return \"FILE\";\n  }\n}\n\nfunction savedLabelFor(date: string): string {\n  return `SAVED ${date.replace(/^saved\\s+/iu, \"\").toUpperCase()}`;\n}\n\n// The overlay keeps two triage actions in view: a primary (read / play / open)\n// and secondary (open original / find similar). Everything after the first\n// entry renders in the secondary slot.\nfunction triageActions(item: LibraryItem, actions: ExpandedOverlayActions): OverlayAction[] {\n  const list: OverlayAction[] = [];\n  const sourceHost = hostnameForUrl(item.sourceUrl);\n  const hasReaderContent = Boolean(item.articleHtml || item.hasArticleContent);\n  const openOriginal: OverlayAction = {\n    key: \"open-original\",\n    label: sourceHost ?? item.source ?? \"Open original\",\n    icon: sourceHost ? (\n      <HugeiconsIcon icon={Globe02Icon} size={15} />\n    ) : (\n      <HugeiconsIcon icon={ArrowUpRight01Icon} size={15} />\n    ),\n    onClick: () => item.sourceUrl && window.open(item.sourceUrl, \"_blank\", \"noopener,noreferrer\"),\n    disabled: !item.sourceUrl,\n  };\n\n  if (item.kind === \"PDF\" && item.fileUrl) {\n    list.push({\n      key: \"open-pdf\",\n      label: \"Open PDF\",\n      icon: <HugeiconsIcon icon={FileTextIcon} size={15} />,\n      onClick: () => actions.onOpenPdf(item),\n    });\n  }\n  if (item.kind === \"Article\" && hasReaderContent) {\n    list.push({\n      key: \"read\",\n      label: \"Read\",\n      icon: <HugeiconsIcon icon={BookOpen01Icon} size={15} />,\n      onClick: (event) => actions.onOpenReader(item, clickOrigin(event)),\n    });\n  }\n  if (item.sourceUrl) list.push(openOriginal);\n  if (isElectronRuntime() && [\"Image\", \"Article\", \"Note\", \"Quote\"].includes(item.kind)) {\n    list.push({\n      key: \"find-similar\",\n      label: actions.isFindingSimilar ? \"Finding similar…\" : \"Find similar\",\n      icon: <HugeiconsIcon icon={SparklesIcon} size={15} />,\n      onClick: () => actions.onFindSimilar(item),\n      disabled: actions.isFindingSimilar,\n    });\n  }\n  if (item.kind === \"Article\" && !hasReaderContent && item.sourceUrl) {\n    list.push({\n      key: \"read-unavailable\",\n      label: \"Read\",\n      icon: <HugeiconsIcon icon={BookOpen01Icon} size={15} />,\n      onClick: () => {},\n      disabled: true,\n      title: \"No saved article text\",\n    });\n  }\n  return list;\n}\n\nfunction OverlayMedia({ item }: { item: LibraryItem }) {\n  if (item.kind === \"Note\" && !item.image) {\n    return (\n      <div className=\"expanded-overlay-media note-detail-media\">\n        <NoteArtwork item={item} />\n      </div>\n    );\n  }\n\n  if (item.social?.provider === \"x\") {\n    return (\n      <div className=\"expanded-overlay-media detail-x-post\">\n        <XPostEmbed\n          key={item.social.postUrl}\n          social={item.social}\n          fallback={\n            item.post ? (\n              <PostArtwork post={item.post} />\n            ) : (\n              <div className=\"detail-art ink\">Post preview unavailable.</div>\n            )\n          }\n        />\n      </div>\n    );\n  }\n\n  if (item.kind === \"Video\") {\n    return (\n      <div className=\"expanded-overlay-media\">\n        <DetailVideoMedia item={item} />\n      </div>\n    );\n  }\n\n  if (item.kind === \"PDF\") {\n    return (\n      <div className=\"expanded-overlay-media\">\n        <PdfArtwork item={item} />\n      </div>\n    );\n  }\n\n  if (item.image) {\n    return (\n      <div className=\"expanded-overlay-media\">\n        <img src={item.image} alt={item.imageAlt ?? item.title} className=\"detail-image\" />\n      </div>\n    );\n  }\n\n  if (item.kind === \"Quote\") {\n    return (\n      <div className=\"expanded-overlay-media\">\n        <div className=\"detail-art detail-quote-art paper-yellow\">\n          <span className=\"detail-quote-mark\">“</span>\n          <span>{item.kind}</span>\n        </div>\n      </div>\n    );\n  }\n\n  if (item.kind === \"Post\" && item.post) {\n    return (\n      <div className=\"expanded-overlay-media\">\n        <PostArtwork post={item.post} />\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"expanded-overlay-media\">\n      <div className={`detail-art ${item.accent ?? \"ink\"}`}>\n        <KindIcon kind={item.kind} />\n        <span>{item.kind}</span>\n      </div>\n    </div>\n  );\n}\n\nfunction detailTitleFor(item: LibraryItem): string {\n  return item.kind === \"PDF\" ? pdfPreviewTitle(item.title) || item.title : item.title;\n}\n\ntype ExpandedItemOverlayProps = {\n  item: LibraryItem;\n  actions: ExpandedOverlayActions;\n  /** Regular Spaces available to file this item in. Empty hides the row. */\n  spaces?: OverlaySpaceChip[];\n  originRectsRef: RefObject<SourceRects | null>;\n  contentAreaRef: RefObject<HTMLElement | null>;\n  selectionScrollRef: RefObject<boolean>;\n};\n\nexport function ExpandedItemOverlay({\n  item,\n  actions,\n  spaces,\n  originRectsRef,\n  contentAreaRef,\n  selectionScrollRef,\n}: ExpandedItemOverlayProps) {\n  const layerRef = useRef<HTMLDivElement>(null);\n  const dialogRef = useRef<HTMLElement>(null);\n  const mediaRef = useRef<HTMLDivElement>(null);\n  const bodyRef = useRef<HTMLDivElement>(null);\n  const closeButtonRef = useRef<HTMLButtonElement>(null);\n  const tagInputRef = useRef<HTMLInputElement>(null);\n  const itemIdRef = useRef(item.id);\n  const itemRef = useRef(item);\n  const previousItemRef = useRef(item);\n  const copyTimerRef = useRef<number | null>(null);\n  const flightIdRef = useRef(0);\n  const flightRef = useRef<Flight | null>(null);\n  const destinationRef = useRef<OverlayDestination | null>(null);\n  const cancelPendingOpenRef = useRef(false);\n  const hasSettledOnceRef = useRef(false);\n  const actionsRef = useRef(actions);\n  const [destination, setDestination] = useState<OverlayDestination | null>(null);\n  const [flight, setFlight] = useState<Flight | null>(null);\n  const [pendingOpen, setPendingOpen] = useState(false);\n  const [linkCopied, setLinkCopied] = useState(false);\n  const [linkCopyFailed, setLinkCopyFailed] = useState(false);\n  const [isEditingNote, setIsEditingNote] = useState(false);\n  const [isFocusMode, setIsFocusMode] = useState(false);\n  const isEditingNoteRef = useRef(false);\n  const isFocusModeRef = useRef(false);\n\n  // Mirror props into refs inside an effect, never during render, so a\n  // concurrent render cannot publish a half-updated set. This runs before\n  // the flight effects below, which read these refs.\n  useLayoutEffect(() => {\n    itemIdRef.current = item.id;\n    itemRef.current = item;\n    flightRef.current = flight;\n  }, [item, flight]);\n\n  useLayoutEffect(() => {\n    isEditingNoteRef.current = isEditingNote;\n    isFocusModeRef.current = isFocusMode;\n  }, [isEditingNote, isFocusMode]);\n\n  // The item whose content the dialog shows. During a closing flight that was\n  // triggered by switching items, the dialog flies back displaying the item it\n  // was showing, while React's item prop already points at the next one.\n  const shownItem = flight?.kind === \"close\" ? flight.fromItem : item;\n\n  const contentAreaRect = useCallback((): FlightRect => {\n    const rect = contentAreaRef.current?.getBoundingClientRect();\n    if (rect) return rectFrom(rect);\n    return { left: 0, top: 0, width: window.innerWidth, height: window.innerHeight };\n  }, [contentAreaRef]);\n\n  // Lays the dialog out at the destination width, measures its natural\n  // content height, and picks a frame centered on the parent card.\n  const beginOpenFlight = useCallback(\n    (origin: SourceRects) => {\n      const dialog = dialogRef.current;\n      if (!dialog) return;\n      const content = contentAreaRect();\n      const width = overlayWidth(content);\n      const mediaHeight = overlayMediaHeight(itemRef.current, width, window.innerHeight);\n\n      dialog.style.width = `${width}px`;\n      dialog.style.height = \"auto\";\n      if (mediaRef.current) mediaRef.current.style.height = `${mediaHeight}px`;\n      const contentHeight = dialog.offsetHeight;\n      const availHeight = Math.max(content.height - 24 * 2, 240);\n      const height = Math.min(Math.max(contentHeight, 320), availHeight);\n      const position = overlayPosition(origin.card, content, width, height);\n\n      const destination: OverlayDestination = {\n        frame: { left: position.left, top: position.top, width, height },\n        mediaHeight,\n      };\n      destinationRef.current = destination;\n      setDestination(destination);\n      flightIdRef.current += 1;\n      setFlight({\n        kind: \"open\",\n        id: flightIdRef.current,\n        originCard: origin.card,\n        originMediaHeight: origin.media.height,\n        destination,\n      });\n    },\n    [contentAreaRect],\n  );\n\n  const beginCloseFlight = useCallback(\n    (closingItem: LibraryItem, toRects: SourceRects | null, thenOpen: boolean) => {\n      const dialog = dialogRef.current;\n      const media = mediaRef.current;\n      if (!dialog) {\n        actionsRef.current.onClose();\n        return;\n      }\n      const fromCard = rectFrom(dialog.getBoundingClientRect());\n      const fromMediaHeight = media ? media.getBoundingClientRect().height : 0;\n      flightIdRef.current += 1;\n      setFlight({\n        kind: \"close\",\n        id: flightIdRef.current,\n        fromItem: closingItem,\n        fromCard,\n        fromMediaHeight,\n        toRects,\n        thenOpen,\n      });\n    },\n    [],\n  );\n\n  const beginOpenFlightFrom = useCallback(\n    (fromMediaHeight: number, origin: SourceRects) => {\n      const dialog = dialogRef.current;\n      if (!dialog) return;\n      const content = contentAreaRect();\n      const width = overlayWidth(content);\n      const mediaHeight = overlayMediaHeight(itemRef.current, width, window.innerHeight);\n\n      const measuredBefore = dialog.getBoundingClientRect();\n      dialog.style.width = `${width}px`;\n      dialog.style.height = \"auto\";\n      if (mediaRef.current) mediaRef.current.style.height = `${mediaHeight}px`;\n      const contentHeight = dialog.offsetHeight;\n      const availHeight = Math.max(content.height - 24 * 2, 240);\n      const height = Math.min(Math.max(contentHeight, 320), availHeight);\n      const position = overlayPosition(origin.card, content, width, height);\n\n      const destination: OverlayDestination = {\n        frame: { left: position.left, top: position.top, width, height },\n        mediaHeight,\n      };\n      destinationRef.current = destination;\n      setDestination(destination);\n      flightIdRef.current += 1;\n      setFlight({\n        kind: \"open\",\n        id: flightIdRef.current,\n        originCard: measuredBefore,\n        originMediaHeight: fromMediaHeight,\n        destination,\n      });\n    },\n    [contentAreaRect],\n  );\n\n  const requestClose = useCallback(() => {\n    const activeFlight = flightRef.current;\n    if (activeFlight?.kind === \"close\") {\n      if (activeFlight.thenOpen) cancelPendingOpenRef.current = true;\n      return;\n    }\n    const rects = queryCardRects(itemIdRef.current);\n    if (prefersReducedMotion() || !rects || !dialogRef.current) {\n      if (flightRef.current) setFlight(null);\n      gsap.to(layerRef.current, {\n        opacity: 0,\n        duration: 0.15,\n        onComplete: actionsRef.current.onClose,\n      });\n      return;\n    }\n    cancelPendingOpenRef.current = false;\n    beginCloseFlight(itemRef.current, rects, false);\n  }, [beginCloseFlight]);\n\n  // Picks the overlay's frame before the opening animation starts. Openings\n  // always run over the general area of the item's parent card.\n  // The origin rectangle is a one-time snapshot supplied through a mutable ref.\n  // Reading it again after opening would retarget the flight to a stale card.\n  // biome-ignore lint/correctness/useExhaustiveDependencies: This effect consumes the source-rectangle snapshot once on mount.\n  useLayoutEffect(() => {\n    const originRects = originRectsRef.current;\n    if (!originRects || prefersReducedMotion()) {\n      gsap.fromTo(\n        layerRef.current,\n        { opacity: 0 },\n        { opacity: 1, duration: 0.18, ease: \"power1.out\" },\n      );\n      return;\n    }\n    beginOpenFlight(originRects);\n  }, [beginOpenFlight]);\n\n  // Runs every flight. GSAP owns the overlay's rectangle geometry. The real\n  // content stays mounted and laid out at the destination width for the whole\n  // flight — the frame is all that moves — so text never re-wraps and\n  // nothing unmounts or flashes mid-animation.\n  useLayoutEffect(() => {\n    if (!flight) return;\n    const media = mediaRef.current;\n    const dialog = dialogRef.current;\n\n    if (flight.kind === \"open\") {\n      if (!dialog || !media) return;\n      const cardRadius = Number.parseFloat(\n        getComputedStyle(dialog).getPropertyValue(\"--sidebar-radius\"),\n      );\n      const duration = OVERLAY_FLIGHT_MS / 1000;\n      const hasEmbed =\n        itemRef.current.social?.provider === \"x\" ||\n        (itemRef.current.kind === \"Video\" && !!itemRef.current.video);\n      const timeline = gsap.timeline({\n        onComplete: () => {\n          setFlight(null);\n          closeButtonRef.current?.focus({ preventScroll: true });\n        },\n      });\n      timeline\n        .fromTo(\n          dialog,\n          {\n            left: flight.originCard.left,\n            top: flight.originCard.top,\n            width: flight.originCard.width,\n            height: flight.originCard.height,\n            borderRadius: cardRadius,\n          },\n          {\n            left: flight.destination.frame.left,\n            top: flight.destination.frame.top,\n            width: flight.destination.frame.width,\n            height: flight.destination.frame.height,\n            borderRadius: OVERLAY_RADIUS,\n            duration,\n            ease: OVERLAY_EASE,\n            autoRound: false,\n          },\n          0,\n        )\n        .fromTo(dialog, { opacity: 0 }, { opacity: 1, duration: 0.12, ease: \"power1.out\" }, 0);\n      if (hasEmbed) {\n        // Third-party embeds keep a stable frame for the whole flight.\n        gsap.set(media, { height: flight.destination.mediaHeight });\n      } else {\n        timeline.fromTo(\n          media,\n          { height: flight.originMediaHeight },\n          {\n            height: flight.destination.mediaHeight,\n            duration,\n            ease: OVERLAY_EASE,\n            autoRound: false,\n          },\n          0,\n        );\n      }\n      return () => {\n        timeline.kill();\n      };\n    }\n\n    // Closing: the dialog returns to its source card and dissolves into it,\n    // or — when the source card is no longer mounted — fades out in place.\n    if (!dialog || !media) {\n      actionsRef.current.onClose();\n      return;\n    }\n    const cardRadius = Number.parseFloat(\n      getComputedStyle(dialog).getPropertyValue(\"--sidebar-radius\"),\n    );\n    const duration = OVERLAY_FLIGHT_MS / 1000;\n    const hasEmbed =\n      flight.fromItem.social?.provider === \"x\" ||\n      (flight.fromItem.kind === \"Video\" && !!flight.fromItem.video);\n    const timeline = gsap.timeline({\n      onComplete: () => {\n        if (flight.thenOpen && !cancelPendingOpenRef.current) {\n          setFlight(null);\n          setPendingOpen(true);\n        } else {\n          actionsRef.current.onClose();\n        }\n      },\n    });\n    if (flight.toRects) {\n      timeline\n        .fromTo(\n          dialog,\n          {\n            left: flight.fromCard.left,\n            top: flight.fromCard.top,\n            width: flight.fromCard.width,\n            height: flight.fromCard.height,\n          },\n          {\n            left: flight.toRects.card.left,\n            top: flight.toRects.card.top,\n            width: flight.toRects.card.width,\n            height: flight.toRects.card.height,\n            borderRadius: cardRadius,\n            duration,\n            ease: OVERLAY_EASE,\n            autoRound: false,\n          },\n          0,\n        )\n        .to(dialog, { opacity: 0, duration: 0.18, ease: \"power1.in\" }, duration - 0.18);\n      if (hasEmbed) {\n        gsap.set(media, { height: flight.fromMediaHeight });\n      } else {\n        timeline.fromTo(\n          media,\n          { height: flight.fromMediaHeight },\n          { height: flight.toRects.media.height, duration, ease: OVERLAY_EASE, autoRound: false },\n          0,\n        );\n      }\n    } else {\n      timeline.to(dialog, { opacity: 0, duration: 0.25, ease: \"power1.in\" });\n    }\n    return () => {\n      timeline.kill();\n    };\n  }, [flight]);\n\n  // Re-clamps and re-measures the settled overlay when the window resizes.\n  useEffect(() => {\n    const onResize = () => {\n      const dialog = dialogRef.current;\n      if (!dialog || !destinationRef.current) return;\n      const content = contentAreaRect();\n      const width = overlayWidth(content);\n      const mediaHeight = overlayMediaHeight(itemRef.current, width, window.innerHeight);\n      dialog.style.width = `${width}px`;\n      if (mediaRef.current) mediaRef.current.style.height = `${mediaHeight}px`;\n      const contentHeight = dialog.offsetHeight;\n      const availHeight = Math.max(content.height - 24 * 2, 240);\n      const height = Math.min(Math.max(contentHeight, 320), availHeight);\n      const cardCenterX =\n        destinationRef.current.frame.left + destinationRef.current.frame.width / 2;\n      const cardCenterY =\n        destinationRef.current.frame.top + destinationRef.current.frame.height / 2;\n      const position = overlayPosition(\n        { left: cardCenterX - width / 2, top: cardCenterY - height / 2, width, height },\n        content,\n        width,\n        height,\n      );\n      const next: OverlayDestination = {\n        frame: { left: position.left, top: position.top, width, height },\n        mediaHeight,\n      };\n      destinationRef.current = next;\n      setDestination(next);\n    };\n    window.addEventListener(\"resize\", onResize);\n    return () => window.removeEventListener(\"resize\", onResize);\n  }, [contentAreaRect]);\n\n  // Switching items while the overlay is open runs sequentially: the open\n  // overlay first animates closed into the card it was showing, and only\n  // after it lands does the newly selected item animate open from its own\n  // card. Rapid clicks during the closing leg are absorbed — the flight\n  // completes once and then opens the most recently selected item.\n  useLayoutEffect(() => {\n    const previous = previousItemRef.current;\n    if (previous.id === item.id) return;\n    previousItemRef.current = item;\n    if (isEditingNoteRef.current) {\n      // Card presses are absorbed while a note is being written, so this only\n      // catches a switch that arrived another way (Enter on a focused card).\n      // Leave the editor rather than carry the draft onto another item.\n      setIsEditingNote(false);\n      setIsFocusMode(false);\n    }\n\n    const activeFlight = flightRef.current;\n    if (activeFlight?.kind === \"close\") return;\n    if (activeFlight?.kind === \"open\") {\n      // Retarget the in-progress open from its current visual state.\n      const dialog = dialogRef.current;\n      const media = mediaRef.current;\n      const rects = queryCardRects(item.id);\n      if (!dialog || !media || !rects) return;\n      c