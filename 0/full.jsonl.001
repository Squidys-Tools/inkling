{"parentUuid":"54f0f53e-dc81-4941-8b57-fd13f7b835a0","isSidechain":false,"promptId":"c5c82701-87f1-44de-a798-b12d146b22cb","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MWyq2eTofjW6QZE1AT4yvn","type":"tool_result","content":"{\n  \"$schema\": \"https://t3.codes/schema/t3.json\",\n  \"scripts\": [\n    {\n      \"name\": \"Install dependencies\",\n      \"command\": \"bun install --frozen-lockfile --ignore-scripts\",\n      \"icon\": \"configure\",\n      \"runOnWorktreeCreate\": true\n    },\n    {\n      \"name\": \"Run desktop app\",\n      \"command\": \"bun run dev:app\",\n      \"icon\": \"play\",\n      \"runOnWorktreeCreate\": false\n    },\n    {\n      \"name\": \"Run web preview\",\n      \"command\": \"bun run dev\",\n      \"icon\": \"play\",\n      \"runOnWorktreeCreate\": false\n    },\n    {\n      \"name\": \"UI smoke\",\n      \"command\": \"bun run ui:smoke\",\n      \"icon\": \"test\",\n      \"runOnWorktreeCreate\": false\n    },\n    {\n      \"name\": \"Check everything\",\n      \"command\": \"bun run check\",\n      \"icon\": \"test\",\n      \"runOnWorktreeCreate\": false\n    },\n    {\n      \"name\": \"Lint frontend\",\n      \"command\": \"bun run lint\",\n      \"icon\": \"test\",\n      \"runOnWorktreeCreate\": false\n    },\n    {\n      \"name\": \"Fix frontend lint and format\",\n      \"command\": \"bun run lint:fix\",\n      \"icon\": \"configure\",\n      \"runOnWorktreeCreate\": false\n    },\n    {\n      \"name\": \"Check Bun version\",\n      \"command\": \"bun run check:bun-version\",\n      \"icon\": \"debug\",\n      \"runOnWorktreeCreate\": false\n    },\n    {\n      \"name\": \"Clean project JS dependencies\",\n      \"command\": \"bun -e \\\"import { rmSync } from 'node:fs'; for (const path of ['node_modules', 'extension/node_modules']) rmSync(path, { recursive: true, force: true })\\\"\",\n      \"icon\": \"debug\",\n      \"runOnWorktreeCreate\": false\n    }\n  ]\n}\n{\n \"dev\": \"vite\"