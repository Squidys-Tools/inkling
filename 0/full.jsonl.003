 backdrop, so the toolbar glass"," // refracts the blur rather than being blurred itself. Values are the React Bits"," // \"Subtle\" preset as tuned on reactbits.dev; the tint is #120f17 at its 0.3","-// tint amount.","+// tint amount. 5 layers instead of 8: it looks the same, and each layer is","+// another backdrop blur on every scrolled frame."," const EDGE_BLUR: GradualBlurProps = {","   height: \"4rem\",","   strength: 1,"]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"sourceToolAssistantUUID":"9d6e6028-42ae-4a70-96e4-56cedc1ea96f","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"sdk-ts","cwd":"C:\\Users\\chris\\.t3\\worktrees\\inkling\\t3-47ff5304","sessionId":"fad76192-bf94-45bb-9f1a-d29cda113db7","version":"2.1.306","gitBranch":"feat/glass-surface","slug":"purrfect-munching-gadget"}
