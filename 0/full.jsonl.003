th, band.height);\n        this.renderBand(layers, width, band.height, target);''','''      for (const band of bands) {\n        const target = this.bandTarget(width, band.height);\n        this.renderBand(band.top, width, band.height, target);''')\nrep('''  private setBand(top: number) {\n    this.bandTop = top;\n    this.container.y = -top / this.dpr;\n  }\n\n  private renderBand(\n    layers: ReturnType<WebGpuDomContentSource[\"sync\"]>,\n    width: number,\n    height: number,\n    outputTexture: GPUTexture,\n  ) {\n    this.core.render({\n      layers,''','''  // Layers carry transforms baked when they are listed, so each band hands\n  // liquid-dom the scene and gets the glass shifted by its own offset.\n  private renderBand(top: number, width: number, height: number, outputTexture: GPUTexture) {\n    this.bandTop = top;\n    this.container.y = -top / this.dpr;\n    this.core.render({\n      scene: this.scene,''')\nrep('''import type {\n  Container,''','''import type {\n  Container,\n  Scene,''')\nopen(p,\"w\",encoding=\"utf-8\",newline=\"\").write(s)\nEOF\ngrep -n \"Scene\\b\" node_modules/@liquid-dom/core/dist/index.d.ts | head -3; bunx biome check --write src/components/LiquidGlass.tsx | tail -2; timeout 300 bunx tsc-rs --noEmit 2>&1 | head","description":"Render each band from the scene","timeout":320000},"caller":{"type":"direct"}}]}}
