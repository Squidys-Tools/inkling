nlayout.js\nlayout.js.map\n18:type SceneHtmlEntry = {\n42:type WebGpuGlassContentSource = {\n45:    getSceneHtmlEntry?: (html: Html) => SceneHtmlEntry | null;\n65:    contentSource?: WebGpuGlassContentSource | null;\n74:    private contentSource;\n145:declare class WebGpuDomContentSource implements WebGpuGlassContentSource {\n161:    getSceneHtmlEntry(html: Html): SceneHtmlEntry | null;\n168:export { BackdropMetrics, Container, Glass, Html, Scene, SpecularWidth, WebGpuDomContentSource, type WebGpuDomContentSourceInit, type WebGpuGlassContentSource, WebGpuGlassCore, type WebGpuGlassCoreInit, type WebGpuGlassCoreRenderOptions, resolveSpecularWidthPx };\n5264:.capture-status .capture-error {\n5265-  pointer-events: auto;\n5266-}\n5267:.query-chip {\n5268-  display: flex;\n5269-  flex: 0 1 auto;\n5270-  align-items: center;\n5271-  gap: 7px;\n5272-  min-width: 0;\n5273-  height: 30px;\n5274-  padding: 0 8px 0 10px;\n5275-  border-radius: 999px;\n--\n5314:.capture-error {\n5315-  align-self: flex-start;\n5316-  margin: 8px 0 0;\n5317-  padding: 6px 12px;\n5318-  border-radius: 999px;\n5319-  color: #d07055;\n5320-  font-size: 12px;\n5321-  white-space: nowrap;\n5322-}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"sourceToolAssistantUUID":"e2a73809-4937-42f6-9b1b-3b7787d22ee6","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"sdk-ts","cwd":"C:\\Users\\chris\\.t3\\worktrees\\inkling\\t3-47ff5304","sessionId":"fad76192-bf94-45bb-9f1a-d29cda113db7","version":"2.1.305","gitBranch":"feat/glass-surface","slug":"purrfect-munching-gadget"}
