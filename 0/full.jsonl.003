Fade() {\r","-  return (\r","-    <>\r","-      <GradualBlur {...EDGE_BLUR} position=\"top\" />\r","-      <GradualBlur {...EDGE_BLUR} position=\"bottom\" />\r","-    </>\r","-  );\r","-}\r","+import GradualBlur, { type GradualBlurProps } from \"./GradualBlur/GradualBlur\";","+","+// The grid scrolls almost to the frame's edges; these blur it out there instead","+// of a hard clip. They render in the liquid glass backdrop, so the toolbar glass","+// refracts the blur rather than being blurred itself. Values are the React Bits","+// \"Peek\" preset as tuned on reactbits.dev; the tint is #120f17 at its 0.15 tint","+// amount. Hover intensity 0 clears a band while the pointer is over it.","+const EDGE_BLUR: GradualBlurProps = {","+  height: \"6rem\",","+  strength: 1,","+  layers: 5,","+  curve: \"ease-in\",","+  exponential: true,","+  opacity: 1,","+  saturation: 1,","+  tint: \"rgba(18, 15, 23, 0.15)\",","+  hoverIntensity: 0,","+  autoHide: false,","+  zIndex: 1,","+  className: \"library-edge-blur\",","+};","+","+export function LibraryEdgeFade() {","+  return (","+    <>","+      <GradualBlur {...EDGE_BLUR} position=\"top\" />","+      <GradualBlur {...EDGE_BLUR} position=\"bottom\" />","+    </>","+  );","+}"]}]}],"moreFiles":0,"changedFiles":["C:\\Users\\chris\\.t3\\worktrees\\inkling\\t3-47ff5304\\src\\components\\LibraryEdgeFade.tsx"]}},"sourceToolAssistantUUID":"45870d4a-4fb6-4468-91b6-651710cac9d9","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"sdk-ts","cwd":"C:\\Users\\chris\\.t3\\worktrees\\inkling\\t3-47ff5304","sessionId":"fad76192-bf94-45bb-9f1a-d29cda113db7","version":"2.1.306","gitBranch":"feat/glass-surface","slug":"purrfect-munching-gadget"}
