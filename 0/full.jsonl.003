er.current, blurredBackdrop, displacementField, composer.next)\n      composer.submitAndSwap()\n\n      if (metricsState && scheduledMetricsReadback) {\n        this.backdropMetrics.scheduleReadback(metricsState)\n      }\n    }\n\n    this.backdropMetrics.markSceneMembership(seenContainers)\n    this.blitTexture(composer.encoder, composer.current, outputTexture)\n    composer.submit()\n  }\n}\n49:export function drawFullscreenPass(\n50-  encoder: GPUCommandEncoder,\n51-  { pipeline, bindGroup, target, clearValue = OPAQUE_BLACK }: FullscreenPassOptions,\n52-) {\n53-  const pass = encoder.beginRenderPass({\n54-    colorAttachments: [\n55-      {\n56-        clearValue,\n57-        loadOp: 'clear',\n58-        storeOp: 'store',\n59-        view: target.createView(),\n60-      },\n61-    ],\n62-  })\n63-  pass.setPipeline(pipeline)\n64-  pass.setBindGroup(0, bindGroup)\n65-  pass.draw(3)\n66-  pass.end()\n67-}\n68-\n69-/** Manages two scene targets and a command encoder for incremental composition. */\n70-export class PingPongComposer {\n71-  /** Active encoder for the current composition step. */\n72-  encoder: GPUCommandEncoder\n73-  private currentTexture: GPUTexture\n74-  private nextTexture: GPUTexture\n75-\n76-  /** Starts a composition sequence with sceneA cleared as the current texture. */\n77-  constructor(private readonly device: GPUDevice, targets: SceneTargets) {\n78-    this.encoder = device.createCommandEncoder()\n79-    this.currentTexture = targets.sceneA\n78:/** Creates pipelines and uniforms for adaptive blur over one texture format. */\n96:/** Destroys GPU buffers owned by one adaptive blur resource set. */","stderr":"\nShell cwd was reset to C:\\Users\\chris\\.t3\\worktrees\\inkling\\t3-47ff5304","interrupted":false,"isImage":false,"noOutputExpected":false},"sourceToolAssistantUUID":"7449aeb5-6ab9-4e9a-a1b0-25b12de2bb61","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"sdk-ts","cwd"