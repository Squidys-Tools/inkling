\n  z-index: 4;\n  width: 44px;\n  height: 44px;\n  pointer-events: none;\n  will-change: transform;\n}\n/* The body mounts at zero size, so the frame it is created in shows nothing and\n   the store can place it before it ever becomes visible. Only the squash\n   transitions; the position is written every frame and transitioning it as well\n   would leave the rendering a frame behind the steering. */\n.mascot-roam-body {\n  width: 100%;\n  height: 100%;\n  transform: scale(0);\n  transform-origin: center;\n  transition: transform 460ms cubic-bezier(0.18, 1.28, 0.36, 1);\n  will-change: transform;\n}\n.mascot-roam svg {\n  display: block;\n  width: 100%;\n  height: 100%;\n}\n/* Sidebar (Paper 1.1): the blot, three nav rows, Spaces, Settings at the foot.\n   Rows are 32px on --row-radius with a 10px inset. Active is a colour and weight\n   change on the label and icon, never a fill. */\n.sidebar {\n  top: 0;\n  z-index: 30;\n  width: var(--sidebar-width);\n  height: 100vh;\n  min-height: 0;\n  /* The mascot row may sit in the Electron titlebar strip: it takes no clicks. */\n  padding: 26px 10px 6px;\n  border-right: 1px solid var(--rule);\n  display: flex;\n  flex-direction: column;\n  gap: 22px;\n  flex-shrink: 0;\n  overflow: hidden;\n  background: var(--library-canvas);\n  transition:\n    width 0.3s cubic-bezier(0.4, 0, 0.2, 1),\n    min-width 0.3s cubic-bezier(0.4, 0, 0.2, 1),\n    padding 0.3s cubic-bezier(0.4, 0, 0.2, 1),\n    border-color 0.3s ease,\n    opacity 0.2s ease;\n}\n.sidebar:not(.is-open) {\n  width: 0;\n  min-width: 0;\n  padding-left: 0;\n  padding-right: 0;\n  border-right-color: transparent;\n  opacity: 0;\n}\n.brand-lockup {\n  display: flex;\n  align-items: center;\n  height: 44px;\n  margin-bottom: -8px;\n  padding: 0 4px 0 6px;\n}\n.brand-name {\n  margin-left: 8px;\n  color: var(--ink);\n  font:\n    400 20px / 1 \"Libre Baskerville\",\n    Georgia,\n    serif;\n  letter-spacing: -0.04em;\n  white-space: nowrap;\n  user-select: none;\n}\n/* The docked mascot is drawn at MASCOT_SIZE, the same body the roam uses, so the\n   roam anchor measures this box's centre. */\n.brand-mark {\n  width: 44px;\n  height: 44px;\n  flex: 0 0 auto;\n  overflow: hidden;\n  transition:\n    width 0.35s cubic-bezier(0.2, 0.8, 0.2, 1),\n    opacity 0.3s ease;\n  transform-origin: center;\n}\n.brand-mark.is-away {\n  width: 0;\n  opacity: 0;\n}\n.brand-mark svg {\n  display: block;\n  width: 100%;\n  height: 100%;\n}\n.primary-nav {\n  display: grid;\n  gap: 2px;\n}\n.nav-item,\n.space-item {\n  min-width: 0;\n  height: 32px;\n  border: 0;\n  border-radius: var(--row-radius);\n  background: transparent;\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 0 10px;\n  color: var(--library-text-soft);\n  font-size: 14px;\n  line-height: 18px;\n  cursor: pointer;\n  text-align: left;\n  transition:\n    color 0.18s ease,\n    background 0.18s ease,\n    transform 0.18s ease;\n}\n.nav-item:hover,\n.space-item:hover {\n  background: rgba(255, 255, 255, 0.06);\n  color: var(--ink);\n}\n.nav-item:active,\n.space-item:active {\n  transform: translateY(1px);\n}\n.nav-item.active,\n.space-item.selected {\n  color: var(--nav-label-active);\n  font-weight: 600;\n}\n.nav-icon {\n  width: 16px;\n  flex: 0 0 auto;\n  display: grid;\n  place-items: center;\n  color: var(--library-muted);\n}\n.nav-item.active .nav-icon {\n  color: var(--library-accent);\n}\n.nav-label {\n  flex: 1;\n  min-width: 0;\n}\n.nav-count,\n.space-count {\n  flex: 0 0 40px;\n  width: 40px;\n  text-align: right;\n  color: var(--library-muted);\n  font: 400 12px / 16px var(--font-mono);\n}\n.sidebar-section {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n}\n.sidebar-heading {\n  height: 28px;\n  padding: 0 10px;\n  display: flex;","numLines":225,"startLine":90,"totalLines":6004}},"sourceToolAssistantUUID":"18602fb8-c9a6-438d-aeb9-2a3d57701576","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"extern