urrentTarget) setIsSettingsOpen(false);\n5234\t              }}\n5235\t            >\n5236\t              <motion.section\n5237\t                ref={settingsDialogRef}\n5238\t                id=\"settings-modal\"\n5239\t                className=\"settings-modal\"\n5240\t                role=\"dialog\"\n5241\t                aria-modal=\"true\"\n5242\t                aria-labelledby=\"settings-modal-title\"\n5243\t                tabIndex={-1}\n5244\t                initial={{ opacity: 0, transform: \"translateY(10px) scale(0.98)\" }}\n5245\t                animate={{ opacity: 1, transform: \"translateY(0) scale(1)\" }}\n5246\t                exit={{ opacity: 0, transform: \"translateY(8px) scale(0.98)\" }}\n5247\t                transition={{ duration: 0.24, ease: [0.23, 1, 0.32, 1] }}\n5248\t              >\n5249\t                <aside className=\"settings-modal-sidebar\" aria-label=\"Settings sections\">\n5250\t                  <header className=\"settings-sidebar-header\">\n5251\t                    <h2>Settings</h2>\n5252\t                  </header>\n5253\t                  <div className=\"settings-sidebar-content\">\n5254\t                    <button\n5255\t                      type=\"button\"\n5256\t                      className={`settings-tab ${settingsTab === \"general\" ? \"active\" : \"\"}`}\n5257\t                      aria-current={settingsTab === \"general\" ? \"page\" : undefined}\n5258\t                      onClick={() => setSettingsTab(\"general\")}\n5259\t                    >\n5260\t                      <HugeiconsIcon icon={Settings01Icon} size={15} />\n5261\t                      <span>General</span>\n5262\t                    </button>\n5263\t                    <button\n5264\t                      type=\"button\"\n5265\t                      className={`settings-tab ${settingsTab === \"data\" ? \"active\" : \"\"}`}\n5266\t                      aria-current={settingsTab === \"data\" ? \"page\" : undefined}\n5267\t                      