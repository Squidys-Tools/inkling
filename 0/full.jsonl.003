s.toggleMaximize()}\n      >\n        <span aria-hidden=\"true\">□</span>\n      </button>\n      <button\n        type=\"button\"\n        className=\"electron-window-close\"\n        aria-label=\"Close window\"\n        onClick={() => void controls.close()}\n      >\n        <span aria-hidden=\"true\">×</span>\n      </button>\n    </div>\n  );\n}\n","numLines":29,"startLine":1,"totalLines":29}},"sourceToolAssistantUUID":"f2a25ff1-efe3-4bf7-8611-46dfede7b3e1","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"sdk-ts","cwd":"C:\\Users\\chris\\.t3\\worktrees\\inkling\\t3-47ff5304","sessionId":"fad76192-bf94-45bb-9f1a-d29cda113db7","version":"2.1.306","gitBranch":"feat/glass-surface","slug":"purrfect-munching-gadget"}
