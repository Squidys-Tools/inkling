 => `<span class=\"ic${on ? \" on\" : \"\"}\">${svg[k]}</span>`;\nconst toggle = `<span class=\"pill glass\" style=\"POS\">${ic(\"grid\", true)}${ic(\"list\")}</span>`;\nconst search = `<span class=\"pill glass search\" style=\"POS\">${svg.search}Everything</span>`;\nconst at = (html, pos) => html.replace(\"POS\", pos);\nfunction sidebar(extra = \"\") {\n  return `<div class=\"side\">\n    <div class=\"brand\"><span class=\"blot\"></span>inkling</div>${extra}\n    <div class=\"nav on\"><i></i>Everything</div><div class=\"nav\"><i></i>Top of mind</div><div class=\"nav\"><i></i>Serendipity</div>\n    <div class=\"hd\">Spaces</div>\n    <div class=\"nav\"><span class=\"dot\" style=\"background:#c47a55\"></span>Design references</div>\n    <div class=\"nav\"><span class=\"dot\" style=\"background:#6f9a86\"></span>Read later</div>\n    <div class=\"nav\"><span class=\"dot\" style=\"background:#7d86c4\"></span>Top picks</div>\n  </div>`;\n}\nfunction grid(y) {\n  return `<div class=\"grid\" style=\"top:${y}px\">${imgs.map((n) => `<img src=\"${n}\">`).join(\"\")}</div>`;\n}\nconst wc = `<div class=\"wc\"><span>&#8212;</span><span>&#9633;</span><span>&#10005;</span></div>`;\nfunction win({ side = \"\", frame }) {\n  return `<div class=\"win\">${sidebar(side)}<div class=\"frame\">${grid(-40)}<div class=\"fade-top\"></div><div class=\"fade-bot\"></div>${frame}</div>${wc}</div>`;\n}\nconst footer = (add) => `<div style=\"position:absolute;left:8px;right:8px;bottom:12px\">${add}<div class=\"nav\"><i></i>Settings</div></div>`;\nconst libraryTop = at(toggle, \"left:8px;top:22px\") + at(search, \"left:50%;transform:translateX(-50%);top:22px\");\nconst options = [\n  { title: \"1. Add as a pill at the foot of the sidebar\",\n    text: \"Grid/list takes the old back/forward spot, search stays put, and the top right is empty. Add sits at the bottom of the sidebar, above Settings.\",\n    html: win({ frame: libraryTop, side: footer(`<div class=\"add\" style=\"display:flex;align-items: