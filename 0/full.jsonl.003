es only the menu, not the whole item view.","+  useEffect(() => {","+    if (!isSpaceMenuOpen) return;","+    const onPointerDown = (event: PointerEvent) => {","+      const target = event.target as Node;","+      if (spaceMenuRef.current?.contains(target)) return;","+      if (spaceMenuButtonRef.current?.contains(target)) return;","+      setIsSpaceMenuOpen(false);","+    };","+    const onKeyDown = (event: KeyboardEvent) => {","+      if (event.key !== \"Escape\") return;","+      event.stopPropagation();","+      setIsSpaceMenuOpen(false);","+    };","+    window.addEventListener(\"pointerdown\", onPointerDown);","+    window.addEventListener(\"keydown\", onKeyDown, true);","+    return () => {","+      window.removeEventListener(\"pointerdown\", onPointerDown);","+      window.removeEventListener(\"keydown\", onKeyDown, true);","+    };","+  }, [isSpaceMenuOpen]);","   const [inspectorTab, setInspectorTab] = useState<InspectorTab>(\"info\");","   // The similar items for one item. Tied to its id so a stale list never shows for another item.","   const [similar, setSimilar] = useState<{ itemId: string; items: LibraryItem[] } | null>(null);"]},{"oldStart":1328,"oldLines":22,"newStart":1352,"newLines":43,"lines":["           {!isEditingNoteView && (","             <footer className=\"item-action-bar\">","               {isSpaceMenuOpen && spaces && spaces.length > 0 && (","-                <fieldset className=\"item-space-menu\">","-                  <legend className=\"visually-hidden\">Regular Spaces</legend>","+                <div","+                  ref={spaceMenuRef}","+                  className=\"item-space-menu\"","+                  role=\"group\"","+                  aria-labelledby=\"item-space-menu-title\"","+                >","+                  <p id=\"item-space-menu-title\" className=\"item-space-menu-title\">","+                    Keep in a Space","+                  </p>","                   {spaces.map((space) => (","                     <bu