   const source = this.source;\n    // The backdrop as seen from the band: the same texture, sampled bandTop\n    // device rows lower.\n    this.bandSource = {\n      get atlasTexture() {\n        return source.atlasTexture;\n      },\n      get contentEntriesBindingResource() {\n        return source.contentEntriesBindingResource;\n      },\n      getGlassContentRange: (glass) => source.getGlassContentRange(glass),\n      getSceneHtmlEntry: (html) => {\n        const entry = source.getSceneHtmlEntry(html);\n        const inverse = entry?.inverseTransform;\n        if (!entry || !inverse) return entry;\n        return {\n          ...entry,\n          inverseTransform: {\n            ...inverse,\n            e: inverse.e + inverse.c * this.bandTop,\n            f: inverse.f + inverse.d * this.bandTop,\n          },\n        };\n      },\n    };\n    this.core = new lib.WebGpuGlassCore({ device, format });''')\nrep('''    this.source.destroy();\n    this.core.destroy();\n    this.context.unconfigure();''','''    this.source.destroy();\n    this.core.destroy();\n    this.bandTexture?.destroy();\n    this.context.unconfigure();''')\nrep('''  // Draws only on paint events: when the backdrop DOM changes (scroll, hover,\n  // new cards) or after requestPaint. Nothing redraws while the page is idle.\n  private readonly draw = () => {\n    const layers = this.source.sync();\n    this.core.render({\n      layers,\n      width: this.canvas.width,\n      height: this.canvas.height,\n      dpr: this.dpr,\n      outputTexture: this.context.getCurrentTexture(),\n      contentSource: this.source,\n    });\n    if (this.source.getSceneHtmlEntry(this.backdrop)?.copiedDeviceWidth) this.onFirstFrame();\n  };''','''  private bandTarget(width: number, height: number) {\n    if (this.bandTexture?.width !== width || this.bandTexture.height !== height) {\n      this.bandTexture?.destroy();\n      this.bandTexture = this.gpu.device.createTexture({\n        size: { width, height },\n        format: this.gpu.format,\n        usage: GPUTextureUsage.RENDER_ATTACHMENT | GPUTextureUsage.COPY_SRC,\n      });\n    }\n    return this.bandTexture;\n  }\n\n  // Draws only on paint events: when the backdrop DOM changes (scroll, hover,\n  // new cards) or after requestPaint. Nothing redraws while the page is idle.\n  // Glass sits in a band of rows (the toolbar), so liquid-dom renders just that\n  // band and the rest of the frame is a copy of the content texture.\n  private readonly draw = () => {\n    const { width, height } = this.canvas;\n    const band = glassBand(this.glasses.values(), this.dpr, height);\n    const whole = band.top === 0 && band.height === height;\n    this.bandTop = band.top;\n    this.container.y = -band.top / this.dpr;\n    const layers = this.source.sync();\n    const output = this.context.getCurrentTexture();\n    if (band.height > 0) {\n      this.core.render({\n        layers,\n        width,\n        height: band.height,\n        dpr: this.dpr,\n        outputTexture: whole ? output : this.bandTarget(width, band.height),\n        contentSource: this.bandSource,\n      });\n    }\n    const content = this.source.getSceneHtmlEntry(this.backdrop);\n    if (!whole) {\n      const encoder = this.gpu.device.createCommandEncoder();\n      if (content?.texture && content.copiedDeviceWidth > 0) {\n        encoder.copyTextureToTexture(\n          { texture: content.texture },\n          { texture: output },\n          {\n            width: Math.min(content.copiedDeviceWidth, width),\n            height: Math.min(content.copiedDeviceHeight, height),\n          },\n        );\n      }\n      if (band.height > 0 && this.bandTexture) {\n        encoder.copyTextureToTexture(\n          { texture: this.bandTexture },\n          { texture: output, origin: { x: 0, y: band.top } },\n          { width, height: band.height },\n        );\n      }\n      this.gpu.device.queue.submit([encoder.finish()]);\n    }\n    if (content?.copiedDeviceWidth) this.onFirstFrame();\n  };''')\nopen(p,'w',encoding='utf-8',newline='').write(s)\nEOF\ntimeout 120 bunx tsc-rs --noEmit -p . 2>&1 | grep -i \"LiquidGlass\\|liquidGlassShape\\|ExpandedItemOverlay\\|ItemMedia\\|App.tsx\" | head -20; echo \"tsc done\"","description":"Render glass only in a band, copy the rest","timeout":150000},"caller":{"type":"direct"}}]}}
