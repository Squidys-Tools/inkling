ops } from \"./GradualBlur/GradualBlur\";\r","-\r","-// The grid scrolls almost to the frame's edges; these blur it out there instead\r","-// of a hard clip. No tint, so the cards soften without darkening. They render in\r","-// the liquid glass backdrop, so the toolbar glass refracts the blur rather than\r","-// being blurred itself.\r","-const EDGE_BLUR: GradualBlurProps = {\r","-  strength: 1.4,\r","-  layers: 5,\r","-  curve: \"bezier\",\r","-  exponential: true,\r","-  opacity: 1,\r","-  zIndex: 1,\r","-};\r","-const TOP_HEIGHT = 112;\r","-const BOTTOM_HEIGHT = 96;\r","-\r","-export function LibraryEdgeFade() {\r","-  return (\r","-    <>\r","-      <GradualBlur {...EDGE_BLUR} position=\"top\" height={TOP_HEIGHT} />\r","-      <GradualBlur {...EDGE_BLUR} position=\"bottom\" height={BOTTOM_HEIGHT} />\r","-    </>\r","-  );\r","-}\r","+import GradualBlur, { type GradualBlurProps } from \"./GradualBlur/GradualBlur\";","+","+// The grid scrolls almost to the frame's edges; these blur it out there instead","+// of a hard clip. No tint, so the cards soften without darkening. They render in","+// the liquid glass backdrop, so the toolbar glass refracts the blur rather than","+// being blurred itself.","+const EDGE_BLUR: GradualBlurProps = {","+  strength: 1.4,","+  layers: 5,","+  curve: \"bezier\",","+  exponential: true,","+  opacity: 1,","+  zIndex: 1,","+};","+const TOP_HEIGHT = 112;","+const BOTTOM_HEIGHT = 96;","+","+export function LibraryEdgeFade() {","+  return (","+    <>","+      <GradualBlur {...EDGE_BLUR} position=\"top\" height={TOP_HEIGHT} />","+      <GradualBlur {...EDGE_BLUR} position=\"bottom\" height={BOTTOM_HEIGHT} />","+    </>","+  );","+}"]}]}],"moreFiles":1,"changedFiles":["C:\\Users\\chris\\.t3\\worktrees\\inkling\\t3-47ff5304\\electron\\main.mjs","C:\\Users\\chris\\.t3\\worktrees\\inkling\\t3-47ff5304\\src\\App.tsx","C:\\Users\\chris\\.t3\\worktrees\\inkling\\t3-47ff5304\\src\\components\\LibraryEdgeFade.tsx"]}},"sourceToolAssistantUUID":"75