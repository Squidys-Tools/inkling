ps where the image edge meets the frame\", () => {\n  const shown = { width: 400, height: 100 };\n  const frame = { width: 200, height: 200 };\n  expect(clampPan({ x: 500, y: 50 }, shown, frame)).toEqual({ x: 100, y: 0 });\n});\n","structuredPatch":[],"originalFile":null,"userModified":false},"sourceToolAssistantUUID":"24eb6e84-445f-4a86-afae-390a0851089e","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"sdk-ts","cwd":"C:\\Users\\chris\\.t3\\worktrees\\inkling\\t3-47ff5304","sessionId":"fad76192-bf94-45bb-9f1a-d29cda113db7","version":"2.1.305","gitBranch":"feat/glass-surface","slug":"purrfect-munching-gadget"}
