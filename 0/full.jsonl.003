0ms cubic-bezier(0.4, 0, 1, 1) forwards;\n767\t  }\n768\t  .edge-tab.flip-in {\n769\t    animation: edge-tab-in 280ms cubic-bezier(0.2, 0.8, 0.2, 1);\n770\t  }\n771\t}\n772\t@keyframes edge-tab-out {\n773\t  from {\n774\t    transform: perspective(300px) rotateY(0deg);\n775\t  }\n776\t  to {\n777\t    transform: perspective(300px) rotateY(var(--flip));\n778\t  }\n779\t}\n780\t@keyframes edge-tab-in {\n781\t  from {\n782\t    transform: perspective(300px) rotateY(var(--flip));\n783\t  }\n784\t  to {\n785\t    transform: perspective(300px) rotateY(0deg);\n786\t  }\n787\t}\n788\t@media (prefers-reduced-motion: reduce) {\n789\t  /* Still fire animationend so the tab settles on its new side. */\n790\t  .edge-tab.flip-out,\n791\t  .edge-tab.flip-in {\n792\t    animation-duration: 1ms;\n793\t  }\n794\t}\n795\t.capture-modal-backdrop {\n796\t  position: fixed;\n797\t  inset: 0;\n798\t  z-index: 100;"},{"tool_use_id":"toolu_01MWVyPw4T1rjuL53w3i5zpN","type":"tool_result","content":"2150\t    opacity: 1;\n2151\t    transform: translateY(0);\n2152\t  }\n2153\t}\n2154\t@media (max-width: 1120px) {\n2155\t  :root {\n2156\t    --sidebar-width: 220px;\n2157\t  }\n2158\t  .main-content {\n2159\t    width: calc(100vw - var(--sidebar-width));\n2160\t  }\n2161\t  .sidebar-toggle {\n2162\t    left: -30px;\n2163\t  }\n2164\t}\n2165\t@media (max-width: 780px) {\n2166\t  .sidebar {\n2167\t    position: fixed;\n2168\t    inset: 0 auto 0 0;\n2169\t    width: min(248px, calc(100vw - 42px));\n2170\t    height: 100vh;\n2171\t    min-height: 0;\n2172\t    padding: 24px 10px 10px;\n2173\t    border-right: 1px solid var(--rule);\n2174\t    opacity: 1;\n2175\t    transform: translateX(-102%);\n2176\t    box-shadow: var(--small-component) 0 40px rgba(0, 0, 0, 0.45);\n2177\t    transition: transform 0.24s cubic-bezier(0.2, 0.8, 0.2, 1);\n2178\t  }\n2179\t  .sidebar.is-open {\n2180\t    transform: translateX(0);\n2181\t  }\n2182\t  .sidebar-scrim {\n2183\t    position: fixed;\n2184\t    inset: 0;\n2185\t    z-index: 25;\n2186\t    display: block;\n2187\t    width: 100%;\n2188\t    height: 100%;\n2189\t    border: 0;\n2190\t    background: rgba(10, 10, 9, 0.48);\n2191\t    cursor: pointer;\n2192\t  }\n2193\t  .sidebar-close {\n2194\t    position: absolute;\n2195\t    top: var(--small-component);\n2196\t    right: 12px;\n2197\t    z-index: 1;\n2198\t    display: inline-flex;\n2199\t    align-items: center;\n2200\t    justify-content: center;\n2201\t    width: 40px;\n2202\t    height: 40px;\n2203\t    margin-left: 0;\n2204\t    border: 1px solid transparent;\n2205\t    border-radius: 8px;\n2206\t    background: transparent;\n2207\t    color: var(--library-muted);\n2208\t    cursor: pointer;\n2209\t    opacity: 1;\n2210\t  }\n2211\t  .sidebar-close:hover {\n2212\t    border-color: #4a4842;\n2213\t    background: var(--library-surface);\n2214\t    color: var(--ink);\n2215\t  }\n2216\t  .main-content {\n2217\t    --main-pad-top: 12px;\n2218\t    --main-pad-x: 18px;\n2219\t    --main-pad-bottom: 24px;\n2220\t    /* Below the 30px library-header padding. */\n2221\t    --library-top: 42px;\n2222\t    width: 100%;\n2223\t    transition: none;\n2224\t  }\n2225\t  .library-header {\n2226\t    display: block;\n2227\t    padding-top: 30px;\n2228\t  }\n2229\t  .sidebar-toggle {"}]}}
