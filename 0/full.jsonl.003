{"parentUuid":"a588170b-d13d-4acf-b9c4-70ba8db33c93","isSidechain":false,"attachment":{"type":"file","filename":"C:\\Users\\chris\\.t3\\worktrees\\inkling\\t3-47ff5304\\src\\components\\LibraryEdgeFade.tsx","content":{"type":"text","file":{"filePath":"C:\\Users\\chris\\.t3\\worktrees\\inkling\\t3-47ff5304\\src\\components\\LibraryEdgeFade.tsx","content":"import GradualBlur, { type GradualBlurProps } from \"./GradualBlur/GradualBlur\";\n\n// The grid scrolls almost to the frame's edges; these blur it out there instead\n// of a hard clip. They render in the liquid glass backdrop, so the toolbar glass\n// refracts the blur rather than being blurred itself. Values are the React Bits\n// \"Peek\" preset as tuned on reactbits.dev; the tint is #120f17 at its 0.15 tint\n// amount. Hover intensity 0 clears a band while the pointer is over it.\nconst EDGE_BLUR: GradualBlurProps = {\n  height: \"6rem\",\n  strength: 1,\n  layers: 5,\n  curve: \"ease-in\",\n  exponential: true,\n  opacity: 1,\n  saturation: 1,\n  tint: \"rgba(18, 15, 23, 0.15)\",\n  hoverIntensity: 0,\n  autoHide: false,\n  zIndex: 1,\n  className: \"library-edge-blur\",\n};\n\nexport function LibraryEdgeFade() {\n  return (\n    <>\n      <GradualBlur {...EDGE_BLUR} position=\"top\" />\n      <GradualBlur {...EDGE_BLUR} position=\"bottom\" />\n    </>\n  );\n}\n","numLines":31,"startLine":1,"totalLines":31}},"displayPath":"src\\components\\LibraryEdgeFade.tsx"},"type":"attachment","uuid":"a89b4063-bf27-4941-8255-f938ac1bcbfc","timestamp":"2026-10-21T15:48:32.613Z","rendered":[{"content":"<system-reminder>\nCalled the Read tool with the following input: {\"file_path\":\"C:\\\\Users\\\\chris\\\\.t3\\\\worktrees\\\\inkling\\\\t3-47ff5304\\\\src\\\\components\\\\LibraryEdgeFade.tsx\"}\n</system-reminder>"},{"content":"<system-reminder>\nResult of calling the Read tool:\n1\timport GradualBlur, { type GradualBlurProps } from \"./GradualBlur/GradualBlur\";\n2\t\n3\t// The grid scrolls almost to the frame's edges; these blur it out there instead\n4\t// of a hard clip. They render in the liquid glass backdrop, so the toolbar glass\n5\t// refracts the blur rather than being blurred itself. Values are the React Bits\n6\t// \"Peek\" preset as tuned on reactbits.dev; the tint is #120f17 at its 0.15 tint\n7\t// amount. Hover intensity 0 clears a band while the pointer is over it.\n8\tconst EDGE_BLUR: GradualBlurProps = {\n9\t  height: \"6rem\",\n10\t  strength: 1,\n11\t  layers: 5,\n12\t  curve: \"ease-in\",\n13\t  exponential: true,\n14\t  opacity: 1,\n15\t  saturation: 1,\n16\t  tint: \"rgba(18, 15, 23, 0.15)\",\n17\t  hoverIntensity: 0,\n18\t  autoHide: false,\n19\t  zIndex: 1,\n20\t  className: \"library-edge-blur\",\n21\t};\n22\t\n23\texport function LibraryEdgeFade() {\n24\t  return (\n25\t    <>\n26\t      <GradualBlur {...EDGE_BLUR} position=\"top\" />\n27\t      <GradualBlur {...EDGE_BLUR} position=\"bottom\" />\n28\t    </>\n29\t  );\n30\t}\n31\t\n</system-reminder>"}],"renderedRole":"system","userType":"external","entrypoint":"sdk-ts","cwd":"C:\\Users\\chris\\.t3\\worktrees\\inkling\\t3-47ff5304","sessionId":"fad76192-bf94-45bb-9f1a-d29cda113db7","version":"2.1.306","gitBranch":"feat/glass-surface","slug":"purrfect-munching-gadget"}
