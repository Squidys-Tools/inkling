, Settings, a card) is absorbed rather","+  // than navigating away and dropping it. Save, Close and Escape are the ways","+  // out. Press, release and click are separate events a control can answer.","+  useEffect(() => {","+    if (!isEditingNote) return;","+    const absorb = (event: Event) => {","+      if (!(event.target instanceof Node) || dialogRef.current?.contains(event.target)) return;","+      event.preventDefault();","+      event.stopPropagation();","+    };","+    const events = [\"pointerdown\", \"mousedown\", \"pointerup\", \"mouseup\", \"click\"];","+    for (const type of events) document.addEventListener(type, absorb, true);","+    return () => {","+      for (const type of events) document.removeEventListener(type, absorb, true);","+    };","+  }, [isEditingNote]);","+","   // The item whose content the view shows. During a closing flight that was","   // triggered by switching items, the view flies back displaying the item it","   // was showing, while React's item prop already points at the next one."]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"sourceToolAssistantUUID":"f166d089-86ef-48fd-a1c5-fe9aafe072ed","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"sdk-ts","cwd":"C:\\Users\\chris\\.t3\\worktrees\\inkling\\t3-47ff5304","sessionId":"fad76192-bf94-45bb-9f1a-d29cda113db7","version":"2.1.307","gitBranch":"feat/glass-surface","slug":"purrfect-munching-gadget"}
