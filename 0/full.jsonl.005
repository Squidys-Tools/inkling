," });"," ","-test(\"image palette job reads the thumbnail and persists five dominant colors\", async () => {","-  const { root, library } = temporaryLibrary();","-  const image = await library.saveFile({","-    fileName: \"palette.png\",","+const imageFixture = () => readFileSync(\"benchmarks/corpus/images/image-columns-01.png\");","+","+function saveImage(library: ReturnType<typeof openLibraryStorage>, fileName = \"photo.png\") {","+  return library.saveFile({","+    fileName,","     mimeType: \"image/png\",","     kind: \"image\",","-    bytes: [...readFileSync(\"benchmarks/corpus/images/image-columns-01.png\")],","+    bytes: imageFixture(),","+  });","+}","+","+function thumbnailLane(","+  library: ReturnType<typeof openLibraryStorage>,","+  ai: ReturnType<typeof createProcessors>,","+  options: Omit<NonNullable<ConstructorParameters<typeof JobWorker>[1]>, \"processors\"> = {},","+) {","+  return createWorker(library, { processors: ai.thumbnailProcessors, ...options });","+}","+","+test(\"image capture stays instant and the thumbnail job publishes the card image\", async () => {","+  const events: string[] = [];","+  let thumbnailCalls = 0;","+  const { root, library } = temporaryLibrary({","+    jobQueue: { onUpdated: (id: string) => events.push(id) },","+    createThumbnail: async (bytes: Buffer) => {","+      thumbnailCalls += 1;","+      return createImageThumbnail(bytes);","+    },","   });","+  const image = await saveImage(library);","+  const source = await sharp(imageFixture()).metadata();","+","+  expect(thumbnailCalls).toBe(0);","+  expect(image.thumbnailPath).toBeNull();","+  expect(image.metadata).toMatchObject({ mediaWidth: source.width, mediaHeight: source.height });","+  const itemDirectory = join(root, \"assets\", \"items\", image.id);","+  expect(readdirSync(itemDirectory)).toEqual([\"photo.png\"]);","+  events.length = 0;","+","+  const ai = createAiJobProcessors({ modelCacheDirectory: join(root, \"models\"), ...unusedModels });","+  await thumbnailLane(library, ai, { workerId: \"thumbnail-test\" }).pump();","+","+  expect(thumbnailCalls).toBe(1);","+  expect(library.getItem(image.id)?.thumbnailPath).toBe(`assets/items/${image.id}/thumbnail.webp`);","+  const thumbnail = await sharp(readFileSync(join(itemDirectory, \"thumbnail.webp\"))).metadata();","+  expect(thumbnail).toMatchObject({ format: \"webp\" });","+  expect(Math.max(thumbnail.width ?? 0, thumbnail.height ?? 0)).toBeLessThanOrEqual(512);","+  // The renderer hears about it through the same event as every other item update.","+  expect(events).toEqual([image.id]);","+  expect(library.jobs.getForItem(image.id).map((job) => job.kind)).not.toContain(","+    IMAGE_THUMBNAIL_JOB,","+  );","+  await closeProcessors(ai);","+});","+","+test(\"the image palette job waits for the thumbnail job, then persists five dominant colors\", async () => {","+  const { root, library } = temporaryLibrary();","+  const image = await saveImage(library, \"palette.png\");","   const ai = createAiJobProcessors({ modelCacheDirectory: join(root, \"models\"), ...unusedModels });","+  const paletteJobs = () =>","+    library.db.prepare(\"SELECT status FROM jobs WHERE kind = ?\").all(IMAGE_PALETTE_JOB);","+  expect(paletteJobs()).toEqual([]);","+","+  await thumbnailLane(library, ai).pump();","+  expect(paletteJobs()).toEqual([{ status: \"pending\" }]);","   await ai.processors[IMAGE_PALETTE_JOB]({ itemId: image.id }, library);","+","   expect(library.getItem(image.id)?.palette).toHaveLength(5);","   expect(library.getItem(image.id)?.palette?.every((color) => /^#[0-9a-f]{6}$/i.test(color))).toBe(","     true,"]},{"oldStart":389,"oldLines":13,"newStart":448,"newLines":117,"lines":["   await closeProcessors(ai);"," });"," ","+test(\"a failed thumbnail keeps the item and the OCR and embedding work, with nothing to retry on screen\", async () => {","+  const { root, library } = temporaryLibrary({","+    createThumbnail: async () => {","+      throw new Error(\"image processing error: unable to decode image\");","+    },","+  });","+  const image = await saveImage(library, \"corrupt.png\");","+  const ai = createAiJobProcessors({ modelCacheDirectory: join(root, \"models\"), ...unusedModels });","+  const worker = createWorker(library, { processors: ai.processors, workerId: \"main-lane\" });","+","+  await thumbnailLane(library, ai).pump();","+  await worker.pump();","+  await stopWorker(worker);","+","+  expect(library.getItem(image.id)).toMatchObject({ id: image.id, kind: \"image\" });","+  expect(library.getItem(image.id)?.thumbnailPath).toBeNull();","+  expect(","+    library.db","+      .prepare(\"SELECT status, retry_count FROM jobs WHERE kind = ?\")","+      .get(IMAGE_THUMBNAIL_JOB),","+  ).toEqual({ status: \"failed\", retry_count: 3 });","+  expect(","+    library.db.prepare(\"SELECT 1 FROM jobs WHERE kind = ?\").get(IMAGE_PALETTE_JOB),","+  ).toBeUndefined();","+  expect(library.jobs.getForItem(image.id).map((job) => job.status)).toEqual([","+    \"completed\",","+    \"completed\",","+  ]);","+  expect(library.jobs.countActive()).toBe(0);","+  await closeProcessors(ai);","+});","+","+test(\"the thumbnail lane finishes while the main worker is held inside a long job\", async () => {","+  const { root, library } = temporaryLibrary();","+  const image = await saveImage(library);","+  let ocrStarted!: () => void;","+  const started = new Promise<void>((resolve) => {","+    ocrStarted = resolve;","+  });","+  let finishOcr!: (text: string) => void;","+  const ai = createAiJobProcessors({","+    modelCacheDirectory: join(root, \"models\"),","+    ...unusedModels,","+    ocr: {","+      recognize: () =>","+        new Promise<string>((resolve) => {","+          finishOcr = resolve;","+          ocrStarted();","+        }),","+    },","+  });","+  const main = createWorker(library, { processors: ai.processors, workerId: \"main-lane\" });","+  const mainRun = main.pump();","+  await started;","+","+  await thumbnailLane(library, ai).pump();","+  expect(library.getItem(image.id)?.thumbnailPath).toBe(`assets/items/${image.id}/thumbnail.webp`);","+","+  finishOcr(\"\");","+  await mainRun;","+  await stopWorker(main);","+  await closeProcessors(ai);","+});","+","+test(\"a pending thumbnail job survives closing and reopening the library\", async () => {","+  const { root, library } = temporaryLibrary();","+  const image = await saveImage(library);","+  library.db.close();","+  libraries.splice(libraries.indexOf(library), 1);","+","+  const reopened = openLibraryStorage(join(root, \"library.sqlite3\"), {","+    createThumbnail: createImageThumbnail,","+  });","+  libraries.push(reopened);","+  expect(reopened.getItem(image.id)?.thumbnailPath).toBeNull();","+  const ai = createAiJobProcessors({ modelCacheDirectory: join(root, \"models\"), ...unusedModels });","+  await thumbnailLane(reopened, ai).start().stop();","+","+  expect(reopened.getItem(image.id)?.thumbnailPath).toBe(`assets/items/${image.id}/thumbnail.webp`);","+  await closeProcessors(ai);","+});","+","+test(\"a thumbnail job whose worker died resumes after its lease expires\", async () => {","+  let clock = 1_000_000;","+  const { root, library } = temporaryLibrary({ jobQueue: { now: () => clock } });","+  const image = await saveImage(library);","+  const job = library.db.prepare(\"SELECT id FROM jobs WHERE kind = ?\").get(IMAGE_THUMBNAIL_JOB);","+  expect(library.jobs.claimNext(\"crashed-worker\", [IMAGE_THUMBNAIL_JOB])?.id).toBe(job.id);","+  const ai = createAiJobProcessors({ modelCacheDirectory: join(root, \"models\"), ...unusedModels });","+","+  // Still leased: a restart inside the lease must not run it twice.","+  await thumbnailLane(library, ai).start().stop();","+  expect(library.getItem(image.id)?.thumbnailPath).toBeNull();","+","+  clock += JOB_LEASE_MILLIS + 1;","+  await thumbnailLane(library, ai).start().stop();","+","+  expect(library.getItem(image.id)?.thumbnailPath).toBe(`assets/items/${image.id}/thumbnail.webp`);","+  expect(","+    library.db.prepare(\"SELECT status FROM jobs WHERE kind = ?\").all(IMAGE_THUMBNAIL_JOB),","+  ).toEqual([{ status: \"completed\" }]);","+  await closeProcessors(ai);","+});","+"," test(\"backfill drains one missing PDF thumbnail at a time, hides the work, and skips a broken PDF\", async () => {","   const events: string[] = [];","   const { root, library } = temporaryLibrary({","     jobQueue: { onUpdated: (id: string) => events.push(id) },","   });","   const first = await savePdf(library, \"native.pdf\", pdfFixture(\"pdf-native-text-01\"));","-  const broken = await savePdf(library, \"broken.pdf\", [...Buffer.from(\"not a pdf\")]);","+  const broken = await savePdf(library, \"broken.pdf\", Buffer.from(\"not a pdf\"));","   const second = await savePdf(library, \"tables.pdf\", pdfFixture(\"pdf-tables-01\"));","   library.db.prepare(\"DELETE FROM jobs\").run();","   events.length = 0;"]}]},{"filePath":"C:\\Users\\chris\\.t3\\worktrees\\inkling\\t3-47ff5304\\electron\\asset-response.mjs","hunks":[{"oldStart":0,"oldLines":0,"newStart":1,"newLines":90,"lines":["+import { createReadStream } from \"node:fs\";","+import { realpath, stat } from \"node:fs/promises\";","+import { extname, isAbsolute, relative, resolve } from \"node:path\";","+import { Readable } from \"node:stream\";","+","+// Returns the byte window to serve, \"unsatisfiable\", or null when the header has to be ignored.","+// Multiple ranges, other units and malformed specs are ignored: RFC 9110 lets a server answer","+// those with the whole file, and a multipart body is not worth it for local media.","+function parseRange(header, size) {","+  const match = /^bytes=(\\d*)-(\\d*)$/i.exec(header.trim());","+  if (!match) return null;","+  const [, first, last] = match;","+  if (!first && !last) return null;","+  if (!first) {","+    const suffixLength = Number(last);","+    if (suffixLength === 0 || size === 0) return \"unsatisfiable\";","+    return { start: Math.max(0, size - suffixLength), end: size - 1 };","+  }","+  const start = Number(first);","+  if (last && Number(last) < start) return null;","+  if (start >= size) return \"unsatisfiable\";","+  return { start, end: Math.min(last ? Number(last) : size - 1, size - 1) };","+}","+","+// Serves a file under `root` without reading it into memory, so a large video or PDF starts","+// playing before it is loaded and seeks through Range requests.","+export async function serveAssetFile(request, { root, path, contentTypes, headers }) {","+  if (request.method !== \"GET\" && request.method !== \"HEAD\") {","+    return new Response(null, { status: 405, headers: { Allow: \"GET, HEAD\" } });","+  }","+","+  const filePath = resolve(root, `.${path}`);","+  const pathFromRoot = relative(root, filePath);","+  if (pathFromRoot.startsWith(\"..\") || isAbsolute(pathFromRoot)) {","+    return new Response(null, { status: 403 });","+  }","+","+  try {","+    const [realRoot, realFile, fileStat] = await Promise.all([","+      realpath(root),","+      realpath(filePath),","+      stat(filePath),","+    ]);","+    const realRelativePath = relative(realRoot, realFile);","+    if (!fileStat.isFile() || realRelativePath.startsWith(\"..\") || isAbsolute(realRelativePath)) {","+      return new Response(null, { status: 403 });","+    }","+","+    const { size } = fileStat;","+    // Asset URLs are not versioned (thumbnail.webp is rewritten in place), so these are","+    // validators only. Cache-Control stays unset: nothing here may be called immutable.","+    const etag = `\"${Math.floor(fileStat.mtimeMs).toString(16)}-${size.toString(16)}\"`;","+    const lastModified = fileStat.mtime.toUTCString();","+","+    const rangeHeader = request.headers.get(\"Range\");","+    const ifRange = request.headers.get(\"If-Range\");","+    // A stale If-Range means the file changed since the client's earlier bytes: send it all.","+    const range =","+      rangeHeader && (!ifRange || ifRange === etag || ifRange === lastModified)","+        ? parseRange(rangeHeader, size)","+        : null;","+    if (range === \"unsatisfiable\") {","+      return new Response(null, {","+        status: 416,","+        headers: { \"Accept-Ranges\": \"bytes\", \"Content-Range\": `bytes */${size}` },","+      });","+    }","+","+    const start = range?.start ?? 0;","+    const end = range?.end ?? size - 1;","+    const length = end - start + 1;","+    const responseHeaders = {","+      ...headers,","+      \"Accept-Ranges\": \"bytes\",","+      \"Content-Length\": String(length),","+      \"Content-Type\": contentTypes[extname(realFile).toLowerCase()] ?? \"application/octet-stream\",","+      ETag: etag,","+      \"Last-Modified\": lastModified,","+      \"X-Content-Type-Options\": \"nosniff\",","+      ...(range ? { \"Content-Range\": `bytes ${start}-${end}/${size}` } : {}),","+    };","+    const body =","+      request.method === \"HEAD\" || length === 0","+        ? null","+        : Readable.toWeb(createReadStream(realFile, { start, end }));","+    return new Response(body, { status: range ? 206 : 200, headers: responseHeaders });","+  } catch {","+    return new Response(null, { status: 404 });","+  }","+}"]}],"created":true},{"filePath":"C:\\Users\\chris\\.t3\\worktrees\\inkling\\t3-47ff5304\\electron\\asset-response.test.ts","hunks":[{"oldStart":0,"oldLines":0,"newStart":1,"newLines":174,"lines":["+import { afterEach, beforeEach, expect, test } from \"bun:test\";","+import { mkdir, mkdtemp, rm, symlink, writeFile } from \"node:fs/promises\";","+import { tmpdir } from \"node:os\";","+import { join } from \"node:path\";","+import { serveAssetFile } from \"./asset-response.mjs\";","+","+const contentTypes = { \".mp4\": \"video/mp4\", \".webp\": \"image/webp\" };","+const bytes = Buffer.from(Array.from({ length: 1000 }, (_, index) => index % 251));","+","+let sandbox: string;","+let root: string;","+","+beforeEach(async () => {","+  sandbox = await mkdtemp(join(tmpdir(), \"inkling-asset-\"));","+  root = join(sandbox, \"assets\");","+  await mkdir(join(root, \"items\", \"a\"), { recursive: true });","+  await writeFile(join(root, \"items\", \"a\", \"clip.mp4\"), bytes);","+  await writeFile(join(root, \"items\", \"a\", \"empty.webp\"), \"\");","+  await writeFile(join(root, \"items\", \"a\", \"notes.xyz\"), \"plain\");","+  await writeFile(join(sandbox, \"secret.txt\"), \"outside\");","+});","+","+afterEach(async () => {","+  await rm(sandbox, { recursive: true, force: true });","+});","+","+function serve(path: string, init: RequestInit = {}) {","+  return serveAssetFile(new Request(\"app://local/library-assets/clip\", init), {","+    root,","+    path,","+    contentTypes,","+    headers: { \"Content-Security-Policy\": \"default-src 'self'\" },","+  });","+}","+","+const clip = \"/items/a/clip.mp4\";","+","+async function body(response: Response) {","+  return Buffer.from(await response.arrayBuffer());","+}","+","+test(\"a full GET streams the file with its headers\", async () => {","+  const response = await serve(clip);","+  expect(response.status).toBe(200);","+  expect(response.headers.get(\"Content-Length\")).toBe(\"1000\");","+  expect(response.headers.get(\"Content-Type\")).toBe(\"video/mp4\");","+  expect(response.headers.get(\"Accept-Ranges\")).toBe(\"bytes\");","+  expect(response.headers.get(\"X-Content-Type-Options\")).toBe(\"nosniff\");","+  expect(response.headers.get(\"Content-Security-Policy\")).toBe(\"default-src 'self'\");","+  expect(response.headers.get(\"ETag\")).toMatch(/^\"[0-9a-f]+-3e8\"$/);","+  expect(response.headers.get(\"Last-Modified\")).toBeTruthy();","+  expect(response.headers.get(\"Cache-Control\")).toBeNull();","+  expect(await body(response)).toEqual(bytes);","+});","+","+test(\"a large file arrives in chunks instead of one read\", async () => {","+  const large = Buffer.alloc(8 * 1024 * 1024, 7);","+  await writeFile(join(root, \"items\", \"a\", \"large.mp4\"), large);","+  const response = await serve(\"/items/a/large.mp4\");","+  const reader = (response.body as ReadableStream<Uint8Array>).getReader();","+  const first = await reader.read();","+  await reader.cancel();","+  expect(first.value?.length).toBeGreaterThan(0);","+  expect(first.value?.length).toBeLessThan(large.length);","+});","+","+test(\"HEAD answers with the headers and no body\", async () => {","+  const response = await serve(clip, { method: \"HEAD\" });","+  expect(response.status).toBe(200);","+  expect(response.headers.get(\"Content-Length\")).toBe(\"1000\");","+  expect(response.headers.get(\"Content-Type\")).toBe(\"video/mp4\");","+  expect(response.body).toBeNull();","+});","+","+test(\"a byte range answers 206 with just those bytes\", async () => {","+  const response = await serve(clip, { headers: { Range: \"bytes=100-199\" } });","+  expect(response.status).toBe(206);","+  expect(response.headers.get(\"Content-Range\")).toBe(\"bytes 100-199/1000\");","+  expect(response.headers.get(\"Content-Length\")).toBe(\"100\");","+  expect(await body(response)).toEqual(bytes.subarray(100, 200));","+});","+","+test(\"open-ended, suffix and overlong ranges are clamped to the file\", async () => {","+  const openEnded = await serve(clip, { headers: { Range: \"bytes=900-\" } });","+  expect(openEnded.status).toBe(206);","+  expect(openEnded.headers.get(\"Content-Range\")).toBe(\"bytes 900-999/1000\");","+  expect(await body(openEnded)).toEqual(bytes.subarray(900));","+","+  const suffix = await serve(clip, { headers: { Range: \"bytes=-100\" } });","+  expect(suffix.status).toBe(206);","+  expect(suffix.headers.get(\"Content-Range\")).toBe(\"bytes 900-999/1000\");","+  expect(await body(suffix)).toEqual(bytes.subarray(900));","+","+  const pastEnd = await serve(clip, { headers: { Range: \"bytes=990-5000\" } });","+  expect(pastEnd.headers.get(\"Content-Range\")).toBe(\"bytes 990-999/1000\");","+  expect(await body(pastEnd)).toEqual(bytes.subarray(990));","+","+  const longSuffix = await serve(clip, { headers: { Range: \"bytes=-5000\" } });","+  expect(longSuffix.status).toBe(206);","+  expect(longSuffix.headers.get(\"Content-Range\")).toBe(\"bytes 0-999/1000\");","+});","+","+test(\"HEAD with a range reports the slice without a body\", async () => {","+  const response = await serve(clip, { method: \"HEAD\", headers: { Range: \"bytes=10-19\" } });","+  expect(response.status).toBe(206);","+  expect(response.headers.get(\"Content-Range\")).toBe(\"bytes 10-19/1000\");","+  expect(response.headers.get(\"Content-Length\")).toBe(\"10\");","+  expect(response.body).toBeNull();","+});","+","+test(\"a range past the end answers 416 with the file size\", async () => {","+  for (const range of [\"bytes=1000-\", \"bytes=2000-3000\", \"bytes=-0\"]) {","+    const response = await serve(clip, { headers: { Range: range } });","+    expect(response.status).toBe(416);","+    expect(response.headers.get(\"Content-Range\")).toBe(\"bytes */1000\");","+    expect(response.body).toBeNull();","+  }","+  const empty = await serve(\"/items/a/empty.webp\", { headers: { Range: \"bytes=0-\" } });","+  expect(empty.status).toBe(416);","+  expect(empty.headers.get(\"Content-Range\")).toBe(\"bytes */0\");","+});","+","+test(\"a malformed or unsupported range is ignored and the whole file is sent\", async () => {","+  for (const range of [\"bytes=abc\", \"bytes=5-2\", \"bytes=0-1,5-6\", \"items=0-1\", \"bytes=-\", \"0-10\"]) {","+    const response = await serve(clip, { headers: { Range: range } });","+    expect(response.status).toBe(200);","+    expect(response.headers.get(\"Content-Range\")).toBeNull();","+    expect(await body(response)).toEqual(bytes);","+  }","+});","+","+test(\"an empty file is a 200 with no body\", async () => {","+  const response = await serve(\"/items/a/empty.webp\");","+  expect(response.status).toBe(200);","+  expect(response.headers.get(\"Content-Length\")).toBe(\"0\");","+  expect(response.headers.get(\"Content-Type\")).toBe(\"image/webp\");","+  expect((await body(response)).length).toBe(0);","+});","+","+test(\"If-Range only honors the range while the file is unchanged\", async () => {","+  const etag = (await serve(clip, { method: \"HEAD\" })).headers.get(\"ETag\") ?? \"\";","+  const fresh = await serve(clip, { headers: { Range: \"bytes=0-9\", \"If-Range\": etag } });","+  expect(fresh.status).toBe(206);","+  const stale = await serve(clip, { headers: { Range: \"bytes=0-9\", \"If-Range\": '\"stale\"' } });","+  expect(stale.status).toBe(200);","+  expect(await body(stale)).toEqual(bytes);","+});","+","+test(\"unknown extensions fall back to a binary content type\", async () => {","+  const response = await serve(\"/items/a/notes.xyz\");","+  expect(response.headers.get(\"Content-Type\")).toBe(\"application/octet-stream\");","+});","+","+test(\"only GET and HEAD are served\", async () => {","+  const response = await serve(clip, { method: \"POST\", body: \"x\" });","+  expect(response.status).toBe(405);","+  expect(response.headers.get(\"Allow\")).toBe(\"GET, HEAD\");","+});","+","+test(\"paths that leave the assets directory are rejected\", async () => {","+  expect((await serve(\"/../secret.txt\")).status).toBe(403);","+  expect((await serve(\"/items/a/../../../secret.txt\")).status).toBe(403);","+});","+","+test(\"a link that resolves outside the assets directory is rejected\", async () => {","+  // A junction needs no privileges on Windows; elsewhere it is a plain symlink.","+  await symlink(sandbox, join(root, \"items\", \"escape\"), \"junction\");","+  expect((await serve(\"/items/escape/secret.txt\")).status).toBe(403);","+});","+","+test(\"directories and missing files are not served\", async () => {","+  expect((await serve(\"/items/a\")).status).toBe(403);","+  expect((await serve(\"/items/a/missing.mp4\")).status).toBe(404);","+});"]}],"created":true},{"filePath":"C:\\Users\\chris\\.t3\\worktrees\\inkling\\t3-47ff5304\\electron\\main.mjs","hunks":[{"oldStart":1,"oldLines":9,"newStart":1,"newLines":10,"lines":[" import { app, BrowserWindow, dial