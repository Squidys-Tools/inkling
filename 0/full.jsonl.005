vent\", { type, key: k, code: k, windowsVirtualKeyCode: code }); };\nconst out = await new Function(\"ev\", \"click\", \"move\", \"key\", \"sleep\", `return (async () => { ${body} })()`)(ev, click, move, key, sleep);\nconsole.log(JSON.stringify(out, null, 1));\nif (shotName !== \"-\") { const s = await send(\"Page.captureScreenshot\", { format: \"png\" }); await Bun.write(`C:/Users/chris/AppData/Local/Temp/agents/chat-images/sidebar/${shotName}.png`, Buffer.from(s.result.data, \"base64\")); }\nws.close();\n1.1-search-pill.jpg\n2.3-zoomed.jpg\na-library.png\na.jpg\na2.jpg\nb-search-drop.png\nb.jpg\nb2.jpg\nc-query-pinned.png\nc.jpg\nc2.jpg\nd-item-inspector.png\nd.jpg\nd1.jpg\nd11.png\nd13.png\nd2.jpg\nd23.png\nfinal21.jpg\nfinal22.jpg\nflight-sheet.jpg\nglass51.jpg\nglass51d.jpg\nglass52.jpg\nglass52d.jpg\nglass53.jpg\nglass53d.jpg\nhistory-item-full.png\nhistory-item-open.png\nhistory-offscreen-open.png\nhistory-search.png\nhistory-start.png\nink-css-mid.jpg\nink-css-thumb-mid.jpg\nink-css-thumb-top.jpg\nink-css-top.jpg\nink-glass-demand-mid.jpg\nink-glass-demand-noimg-mid.jpg\nink-glass-demand-noimg-top.jpg\nink-glass-demand-predecode-mid.jpg\nink-glass-demand-predecode-top.jpg\nink-glass-demand-thumb-mid.jpg\nink-glass-demand-thumb-top.jpg\nink-glass-demand-top.jpg\nink-glass-mid.jpg\nink-glass-thumb-mid.jpg\nink-glass-thumb-top.jpg\nink-glass-top.jpg\nitem-view-flight.mp4\nitem-view.png\nlantern-stage.jpg\nld-0.jpg\nld-1.jpg\nld-2.jpg\nld-3.jpg\nld-4.jpg\nld-5.jpg\nld-6.jpg\nld-7.jpg\nld-8.jpg\nld-9.jpg\npixel-zoom.png\npr-after-item.png\npr-after-library.png\npr-after-search.png\npr-after-settings.png\npr-before-item.png\npr-before-library.png\npr-before-search.png\npr-before-settings.png\nqa-1-1-library-app.png\nqa-1-1-library-paper.png\nqa-1-2-search-drops-in-app.png\nqa-1-2-search-drops-in-paper.png\nqa-1-3-query-pinned-app.png\nqa-1-3-query-pinned-paper.png\nqa-1.1-paper.png\nqa-2-1-item-inspector-app.png\nqa-2-1-item-inspector-paper.png\nqa-2-2-similar-tab