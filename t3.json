{
  "$schema": "https://t3.codes/schema/t3.json",
  "scripts": [
    {
      "name": "Install dependencies",
      "command": "bun install --frozen-lockfile --ignore-scripts",
      "icon": "configure",
      "runOnWorktreeCreate": true
    },
    {
      "name": "Run desktop app",
      "command": "bun run dev:app",
      "icon": "play",
      "runOnWorktreeCreate": false
    },
    {
      "name": "Run web preview",
      "command": "bun run dev",
      "icon": "play",
      "runOnWorktreeCreate": false
    },
    {
      "name": "Run marketing site",
      "command": "bun run dev:site",
      "icon": "play",
      "runOnWorktreeCreate": false
    },
    {
      "name": "Build desktop app (unpacked)",
      "command": "bun run build:dir",
      "icon": "configure",
      "runOnWorktreeCreate": false
    },
    {
      "name": "Build web preview",
      "command": "bun run build:web",
      "icon": "configure",
      "runOnWorktreeCreate": false
    },
    {
      "name": "Build marketing site",
      "command": "bun run build:site",
      "icon": "configure",
      "runOnWorktreeCreate": false
    },
    {
      "name": "Build Linux packages (.deb and AppImage)",
      "command": "bun run build:linux",
      "icon": "configure",
      "runOnWorktreeCreate": false
    },
    {
      "name": "Build macOS disk image",
      "command": "bun run build:mac",
      "icon": "configure",
      "runOnWorktreeCreate": false
    },
    {
      "name": "Build Windows installer",
      "command": "bun run build:win",
      "icon": "configure",
      "runOnWorktreeCreate": false
    },
    {
      "name": "Check everything",
      "command": "bun run check",
      "icon": "test",
      "runOnWorktreeCreate": false
    },
    {
      "name": "Check changed files",
      "command": "bun run check:changed",
      "icon": "test",
      "runOnWorktreeCreate": false
    },
    {
      "name": "Typecheck",
      "command": "bun run typecheck",
      "icon": "test",
      "runOnWorktreeCreate": false
    },
    {
      "name": "Run tests",
      "command": "bun run test",
      "icon": "test",
      "runOnWorktreeCreate": false
    },
    {
      "name": "Find unused code",
      "command": "bun run knip",
      "icon": "test",
      "runOnWorktreeCreate": false
    },
    {
      "name": "Ingestion smoke",
      "command": "bun run ingest:smoke",
      "icon": "test",
      "runOnWorktreeCreate": false
    },
    {
      "name": "Run frame benchmark",
      "command": "bun run bench",
      "icon": "debug",
      "runOnWorktreeCreate": false
    },
    {
      "name": "Generate benchmark library",
      "command": "bun run bench:library",
      "icon": "debug",
      "runOnWorktreeCreate": false
    },
    {
      "name": "Score extraction and OCR",
      "command": "bun run bench:quality",
      "icon": "debug",
      "runOnWorktreeCreate": false
    },
    {
      "name": "Lint frontend",
      "command": "bun run lint",
      "icon": "test",
      "runOnWorktreeCreate": false
    },
    {
      "name": "Fix frontend lint and format",
      "command": "bun run lint:fix",
      "icon": "configure",
      "runOnWorktreeCreate": false
    },
    {
      "name": "Check Bun version",
      "command": "bun run check:bun-version",
      "icon": "debug",
      "runOnWorktreeCreate": false
    },
    {
      "name": "Clean project JS dependencies",
      "command": "bun -e \"import { readdirSync, rmSync } from 'node:fs'; for (const dir of ['.', 'extension', ...['apps', 'packages', 'tools'].flatMap((root) => readdirSync(root).map((name) => root + '/' + name))]) rmSync(dir + '/node_modules', { recursive: true, force: true })\"",
      "icon": "debug",
      "runOnWorktreeCreate": false
    }
  ]
}
