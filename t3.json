{
  "$schema": "https://t3.codes/schema/t3.json",
  "scripts": [
    {
      "name": "Install dependencies",
      "command": "bun install --frozen-lockfile --ignore-scripts",
      "icon": "configure",
      "runOnWorktreeCreate": true
    },
    {
      "name": "Run desktop app dev",
      "command": "bun run electron:dev",
      "icon": "play",
      "runOnWorktreeCreate": false
    },
    {
      "name": "Run web preview",
      "command": "bun run dev",
      "icon": "play",
      "runOnWorktreeCreate": false
    },
    {
      "name": "Fast local checks",
      "command": "bun run check",
      "icon": "test",
      "runOnWorktreeCreate": false
    },
    {
      "name": "Lint frontend",
      "command": "bun run lint",
      "icon": "test",
      "runOnWorktreeCreate": false
    },
    {
      "name": "Fix frontend lint and format",
      "command": "bun run lint:fix",
      "icon": "configure",
      "runOnWorktreeCreate": false
    },
    {
      "name": "Check Bun version",
      "command": "bun run check:bun-version",
      "icon": "debug",
      "runOnWorktreeCreate": false
    },
    {
      "name": "Clean project JS dependencies",
      "command": "bun -e \"import { rmSync } from 'node:fs'; for (const path of ['node_modules', 'extension/node_modules']) rmSync(path, { recursive: true, force: true })\"",
      "icon": "debug",
      "runOnWorktreeCreate": false
    }
  ]
}
