{
  "name": "mymind-library",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "dev": "vite",
    "build": "tsc -p benchmarks/harness/tsconfig.json && tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "ingest:smoke": "bun src/lib/ingestion/ingestion.smoke.ts",
    "test:pdf": "bun benchmarks/harness/pdf.smoke.ts",
    "bench": "bun benchmarks/harness/index.ts",
    "typecheck:benchmarks": "tsc -p benchmarks/harness/tsconfig.json",
    "test:windows:pdfs": "cargo test --manifest-path src-tauri/Cargo.toml --locked windows_benchmark_tests -- --nocapture",
    "fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "fmt:check": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "defuddle": "^0.19.2",
    "linkedom": "^0.18.13",
    "lucide-react": "^1.31.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "regenerator-runtime": "^0.14.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/bun": "^1.4.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.5",
    "lefthook": "^2.1.10",
    "tesseract.js": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
