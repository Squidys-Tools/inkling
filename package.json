{
  "name": "inkling",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.mjs",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "extension",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "dev:app": "vite build --mode electron-preview && electron . --preview",
    "build": "tsc -p benchmarks/harness/tsconfig.json && tsc && vite build",
    "build:app": "tsc -p benchmarks/harness/tsconfig.json && tsc && vite build --mode app && bun scripts/assert-no-demo-seed.ts",
    "build:dir": "bun run build:app && bun scripts/prepare-electron-models.mjs && electron-builder --publish never --dir",
    "build:installer": "bun run build:app && bun scripts/prepare-electron-models.mjs && electron-builder --publish never --win nsis",
    "preview": "vite preview",
    "check": "bun run check:bun-version && bun install --frozen-lockfile --ignore-scripts && bun run typecheck && bun run --cwd extension typecheck && bun run --cwd packages/ingestion-shared typecheck && bun test && bun run knip && bun run lint && bun run build && bun run build:app && bun run ingest:smoke && bun run --cwd extension build",
    "check:bun-version": "bun -e \"const pkg = await Bun.file('package.json').json(); const fileVersion = (await Bun.file('.bun-version').text()).trim(); const expected = pkg.packageManager.replace('bun@', ''); if (fileVersion !== expected || Bun.version !== expected) { console.error('Expected Bun ' + expected + ', found ' + Bun.version); process.exit(1); }\"",
    "typecheck": "tsc --noEmit && tsc -p benchmarks/harness/tsconfig.json --noEmit",
    "typecheck:rs": "tsc-rs --noEmit && tsc-rs -p benchmarks/harness/tsconfig.json --noEmit",
    "test": "bun test",
    "test:pdf": "bun benchmarks/harness/pdf.smoke.ts",
    "knip": "knip --no-progress",
    "lint": "biome check --colors=off",
    "lint:fix": "biome check --write",
    "ingest:smoke": "bun src/lib/ingestion/ingestion.smoke.ts",
    "bench": "bun benchmarks/harness/index.ts"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@huggingface/tokenizers": "0.2.0",
    "@inkling/ingestion-shared": "workspace:*",
    "@napi-rs/canvas": "1.0.11",
    "@tesseract.js-data/eng": "1.0.0",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-list": "3.31.4",
    "@tiptap/markdown": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@virtuoso.dev/masonry": "^1.4.3",
    "defuddle": "^0.19.5",
    "electron-updater": "6.8.9",
    "gsap": "^3.15.0",
    "linkedom": "^0.18.13",
    "motion": "^14.1.0",
    "onnxruntime-node": "1.24.2",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "bun-types": "1.4.3",
    "knip": "^6.41.0",
    "tsc-rs": "0.7.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "electron": "44.7.2",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.inkling.library",
    "productName": "inkling",
    "directories": {
      "buildResources": "build",
      "output": ".artifacts/electron"
    },
    "extraResources": [
      {
        "from": ".artifacts/electron-resources/models",
        "to": "models",
        "filter": [
          "**/*"
        ]
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src/lib/deepLinkCore.mjs",
      "package.json"
    ],
    "asarUnpack": [
      "**/tesseract.js/**/*",
      "**/tesseract.js-core/**/*",
      "**/@tesseract.js-data/eng/**/*",
      "**/onnxruntime-node/bin/**/*",
      "**/@img/sharp-*/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/squidys-tools/inkling/releases/latest/download/"
      }
    ],
    "protocols": [
      {
        "name": "Inkling capture link",
        "schemes": [
          "inkling"
        ]
      }
    ]
  }
}
