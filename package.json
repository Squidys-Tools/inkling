{
  "name": "inkling",
  "version": "0.1.0",
  "private": true,
  "description": "A private local library for everything worth keeping",
  "homepage": "https://github.com/Squidys-Tools/inkling",
  "license": "MIT",
  "author": "exodus712",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*",
    "extension"
  ],
  "type": "module",
  "main": "dist/desktop/main.mjs",
  "scripts": {
    "dev": "vite --config apps/renderer/vite.config.ts",
    "dev:app": "bun run build:app && bun tools/dev/dev-app.ts",
    "dev:site": "bun run --cwd apps/site dev",
    "dev:site:tunnel": "INKLING_TUNNEL=1 bun run --cwd apps/site dev",
    "build:app": "vite build --config apps/renderer/vite.config.ts && bun apps/desktop/build.ts && bun tools/repo/assert-no-demo-seed.ts",
    "build:web": "vite build --config apps/renderer/vite.config.ts --mode preview",
    "build:site": "bun run --cwd apps/site build",
    "build:extension": "bun run --cwd extension build",
    "dist": "bun run build:app && bun tools/models/prepare.ts && bun tools/repo/dist.ts",
    "test": "bun test --timeout 5000",
    "typecheck": "tsc-rs -p apps/renderer --noEmit && tsc-rs -p apps/desktop --noEmit && tsc-rs -p apps/site --noEmit && tsc-rs -p packages/library --noEmit && tsc-rs -p packages/jobs --noEmit && tsc-rs -p packages/ingestion --noEmit && tsc-rs -p tools --noEmit && tsc-rs -p extension --noEmit && tsc-rs -p benchmarks --noEmit",
    "lint": "oxlint --report-unused-disable-directives && oxfmt --check",
    "lint:fix": "oxlint --report-unused-disable-directives --fix && oxfmt",
    "knip": "knip --no-progress",
    "check": "bun tools/repo/check-bun-version.ts && bun run typecheck && bun tools/repo/command-refs.ts && bun run lint && bun run test && bun run knip && bun run build:app && bun run build:web && bun run build:site && bun run build:extension",
    "check:changed": "bun tools/repo/check-changed.ts",
    "bench": "bun tools/bench/index.ts"
  },
  "dependencies": {
    "@effect/sql-sqlite-node": "4.1.2",
    "@huggingface/tokenizers": "0.2.0",
    "@img/sharp-wasm32": "0.35.5",
    "@napi-rs/canvas": "1.1.0",
    "@tesseract.js-data/eng": "1.0.0",
    "builder-util-runtime": "9.7.0",
    "defuddle": "0.19.6",
    "dompurify": "3.4.17",
    "effect": "4.1.2",
    "electron-updater": "6.8.11",
    "entities": "9.0.0",
    "ipaddr.js": "2.5.0",
    "linkedom": "0.18.15",
    "onnxruntime-node": "1.31.1",
    "pdfjs-dist": "6.5.438",
    "semver": "7.8.6",
    "sharp": "0.35.5",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@base-ui/react": "1.9.0",
    "@effect/platform-browser": "4.1.2",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource/arimo": "5.3.0",
    "@fontsource/bitter": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/crimson-pro": "5.3.0",
    "@fontsource/dm-mono": "5.3.0",
    "@fontsource/eb-garamond": "5.3.0",
    "@fontsource/fraunces": "5.3.0",
    "@fontsource/gelasio": "5.3.0",
    "@fontsource/ibm-plex-serif": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/libre-baskerville": "5.3.0",
    "@fontsource/literata": "5.3.0",
    "@fontsource/lora": "5.3.0",
    "@fontsource/newsreader": "5.3.0",
    "@fontsource/noto-sans": "5.3.0",
    "@fontsource/nunito-sans": "5.3.0",
    "@fontsource/playfair-display": "5.3.0",
    "@fontsource/pt-sans": "5.3.0",
    "@fontsource/pt-serif": "5.3.0",
    "@fontsource/roboto": "5.3.0",
    "@fontsource/source-sans-3": "5.3.1",
    "@fontsource/source-serif-4": "5.3.1",
    "@fontsource/space-grotesk": "5.3.0",
    "@fontsource/spectral": "5.3.0",
    "@fontsource/vollkorn": "5.3.0",
    "@fontsource/zilla-slab": "5.3.0",
    "@hugeicons/core-free-icons": "4.4.0",
    "@hugeicons/react": "1.1.10",
    "@inkling/contracts": "workspace:*",
    "@inkling/ingestion": "workspace:*",
    "@inkling/jobs": "workspace:*",
    "@inkling/library": "workspace:*",
    "@inkling/rpc-electron": "workspace:*",
    "@inkling/ui": "workspace:*",
    "@oxlint/plugins": "1.93.0",
    "@stylexjs/stylex": "0.19.1",
    "@stylexjs/unplugin": "0.19.1",
    "@tanstack/react-hotkeys": "0.22.2",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.5",
    "@tanstack/react-store": "0.11.2",
    "@tanstack/react-virtual": "3.14.26",
    "@tiptap/core": "3.33.0",
    "@tiptap/extension-list": "3.33.0",
    "@tiptap/markdown": "3.33.0",
    "@tiptap/pm": "3.33.0",
    "@tiptap/react": "3.33.0",
    "@tiptap/starter-kit": "3.33.0",
    "@types/bun": "1.4.4",
    "@types/jsdom": "30.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/semver": "7.8.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "jsdom": "31.0.0",
    "knip": "6.44.2",
    "oxc-transform-react": "0.156.0",
    "oxfmt": "0.78.0",
    "oxlint": "1.92.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsc-rs": "0.8.0",
    "vite": "8.3.7",
    "vite-imagetools": "12.0.1"
  },
  "overrides": {
    "isbinaryfile": "6.0.0"
  },
  "build": {
    "appId": "com.inkling.library",
    "productName": "inkling",
    "directories": {
      "buildResources": "build",
      "output": ".artifacts/electron"
    },
    "files": [
      "dist/desktop/**/*",
      "dist/renderer/**/*",
      "package.json",
      "!**/node_modules/**/*.{map,ts,mts,cts}",
      "!**/node_modules/onnxruntime-node/bin/napi-v6/!(${platform})/**",
      "!**/node_modules/onnxruntime-node/bin/napi-v6/*/!(${arch})/**",
      "!**/node_modules/@napi-rs/canvas-linux-*-musl/**",
      "!**/node_modules/tesseract.js-core/*.wasm.js",
      "!**/node_modules/@img/sharp-{linux,linuxmusl,libvips-linux,libvips-linuxmusl}-*/**"
    ],
    "asarUnpack": [
      "**/tesseract.js/**/*",
      "**/tesseract.js-core/**/*",
      "**/node_modules/regenerator-runtime/**/*",
      "**/node_modules/is-url/**/*",
      "**/node_modules/bmp-js/**/*",
      "**/node_modules/wasm-feature-detect/**/*",
      "**/node_modules/node-fetch/**/*",
      "**/node_modules/whatwg-url/**/*",
      "**/node_modules/tr46/**/*",
      "**/node_modules/webidl-conversions/**/*",
      "**/@tesseract.js-data/eng/**/*",
      "**/onnxruntime-node/bin/**/*",
      "**/@img/sharp-*/**/*"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "apps/desktop/src/updates/update-helper.py",
        "to": "update-helper.py"
      },
      {
        "from": ".artifacts/electron-resources/models",
        "to": "models",
        "filter": [
          "**/*"
        ]
      }
    ],
    "afterPack": "apps/desktop/after-pack.ts",
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "${name}-${version}-win-${arch}.${ext}"
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "${name}-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "syncDesktopName": true,
      "category": "Utility",
      "target": [
        "deb",
        "AppImage"
      ],
      "artifactName": "${name}-${version}-linux-${arch}.${ext}",
      "desktop": {
        "entry": {
          "StartupWMClass": "inkling",
          "MimeType": "x-scheme-handler/inkling;"
        }
      }
    },
    "deb": {
      "maintainer": "inkling contributors",
      "fpm": [
        "--depends",
        "pkexec | policykit-1",
        "--depends",
        "python3",
        "--depends",
        "ffmpeg (>= 4.4)"
      ]
    },
    "protocols": [
      {
        "name": "Inkling capture link",
        "schemes": [
          "inkling"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Squidys-Tools",
        "repo": "inkling",
        "releaseType": "release"
      }
    ]
  },
  "desktopName": "inkling.desktop",
  "patchedDependencies": {
    "sharp@0.35.5": "patches/sharp@0.35.5.patch"
  }
}
