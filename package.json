{
  "name": "inkling",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "extension",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -p benchmarks/harness/tsconfig.json && tsc && vite build",
    "build:app": "tsc -p benchmarks/harness/tsconfig.json && tsc && vite build --mode app && bun scripts/assert-no-demo-seed.ts",
    "check:bun-version": "bun -e \"const pkg = await Bun.file('package.json').json(); const fileVersion = (await Bun.file('.bun-version').text()).trim(); const expected = pkg.packageManager.replace('bun@', ''); if (fileVersion !== expected || Bun.version !== expected) { console.error('Expected Bun ' + expected + ', found ' + Bun.version); process.exit(1); }\"",
    "check": "bun run typecheck && bun test",
    "typecheck": "tsc --noEmit && tsc -p benchmarks/harness/tsconfig.json --noEmit",
    "knip:check": "knip --no-progress",
    "check:frontend": "bun run check:bun-version && bun install --frozen-lockfile --ignore-scripts && bun run test && bun run knip:check && bun run lint && bun run build && bun run build:app && bun run ingest:smoke",
    "lint": "biome check --colors=off",
    "lint:fix": "biome check --write",
    "preview": "vite preview",
    "preview:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-native-preview.ps1",
    "provision:ort": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/provision-onnxruntime.ps1",
    "tauri": "tauri",
    "ingest:smoke": "bun src/lib/ingestion/ingestion.smoke.ts",
    "test": "bun test",
    "test:pdf": "bun benchmarks/harness/pdf.smoke.ts",
    "bench": "bun benchmarks/harness/index.ts",
    "typecheck:benchmarks": "tsc -p benchmarks/harness/tsconfig.json",
    "test:windows:pdfs": "cargo test --manifest-path src-tauri/Cargo.toml --locked windows_benchmark_tests -- --nocapture",
    "fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "fmt:check": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@tauri-apps/api": "^2.12.3",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-list": "3.31.4",
    "@tiptap/markdown": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@tauri-apps/plugin-dialog": "^2.8.2",
    "@virtuoso.dev/masonry": "^1.4.3",
    "defuddle": "^0.19.5",
    "gsap": "^3.15.0",
    "linkedom": "^0.18.13",
    "motion": "^14.1.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@tauri-apps/cli": "^2.12.2",
    "@types/bun": "1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "bun-types": "1.4.3",
    "knip": "^6.41.0",
    "tesseract.js": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
