{
  "name": "inkling",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "extension",
    "packages/*"
  ],
  "type": "module",
  "main": "dist/electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "dev:app": "vite build --mode electron-preview && bun run build:electron && electron . --preview",
    "ui:smoke": "bun scripts/ui-smoke.mjs",
    "build": "tsc-rs -p benchmarks/harness/tsconfig.json && tsc-rs && vite build",
    "build:app": "tsc-rs -p benchmarks/harness/tsconfig.json && tsc-rs && vite build --mode app && bun run build:electron && bun scripts/assert-no-demo-seed.ts",
    "build:electron": "bun scripts/build-electron.ts",
    "build:dir": "bun run build:app && bun scripts/prepare-electron-models.mjs && electron-builder --publish never --dir",
    "build:installer": "bun run build:app && bun scripts/prepare-electron-models.mjs && electron-builder --publish never --win nsis",
    "preview": "vite preview",
    "check": "bun run check:bun-version && bun install --frozen-lockfile --ignore-scripts && bun run typecheck && bun run --cwd extension typecheck && bun run --cwd packages/ingestion-shared typecheck && bun run --cwd packages/contracts typecheck && bun run check:refs && bun run test && bun run knip && bun run lint && bun run build && bun run build:app && bun run ingest:smoke && bun run --cwd extension build",
    "check:bun-version": "bun -e \"const expected = (await Bun.file('.bun-version').text()).trim(); if (Bun.version !== expected) { console.error('Expected Bun ' + expected + ', found ' + Bun.version); process.exit(1); }\"",
    "check:refs": "bun scripts/assert-command-refs.ts",
    "typecheck": "tsc-rs --noEmit && tsc-rs -p benchmarks/harness/tsconfig.json --noEmit && tsc-rs -p electron/tsconfig.json --noEmit",
    "typecheck:tsc": "tsc --noEmit && tsc -p benchmarks/harness/tsconfig.json --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "test": "bun test --timeout 30000",
    "test:pdf": "bun benchmarks/harness/pdf.smoke.ts",
    "knip": "knip --no-progress",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt",
    "ingest:smoke": "bun src/lib/ingestion/ingestion.smoke.ts",
    "bench": "bun benchmarks/harness/index.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@effect/sql-sqlite-node": "4.0.6",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/arimo": "^5.3.0",
    "@fontsource/bitter": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/crimson-pro": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/gelasio": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/libre-baskerville": "^5.3.0",
    "@fontsource/literata": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/nunito-sans": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/pt-sans": "^5.3.0",
    "@fontsource/pt-serif": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "@fontsource/source-serif-4": "^5.3.1",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/spectral": "^5.3.0",
    "@fontsource/vollkorn": "^5.3.0",
    "@fontsource/zilla-slab": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@huggingface/tokenizers": "0.2.0",
    "@inkling/ingestion-shared": "workspace:*",
    "@liquid-dom/core": "0.1.1",
    "@napi-rs/canvas": "1.0.13",
    "@tesseract.js-data/eng": "1.0.0",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-list": "3.32.0",
    "@tiptap/markdown": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@virtuoso.dev/masonry": "^1.4.3",
    "defuddle": "^0.19.5",
    "effect": "4.0.6",
    "electron-updater": "6.8.11",
    "gsap": "^3.15.0",
    "linkedom": "0.18.13",
    "motion": "^14.6.0",
    "onnxruntime-node": "1.30.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@inkling/contracts": "workspace:*",
    "@oxlint/plugins": "^1.89.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "bun-types": "1.4.4",
    "electron": "45.0.0",
    "electron-builder": "^26.18.0",
    "knip": "^6.43.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "tailwindcss": "^4.3.3",
    "tsc-rs": "0.8.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "com.inkling.library",
    "productName": "inkling",
    "directories": {
      "buildResources": "build",
      "output": ".artifacts/electron"
    },
    "extraResources": [
      {
        "from": ".artifacts/electron-resources/models",
        "to": "models",
        "filter": [
          "**/*"
        ]
      }
    ],
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/tesseract.js/**/*",
      "**/tesseract.js-core/**/*",
      "**/node_modules/regenerator-runtime/**/*",
      "**/node_modules/is-url/**/*",
      "**/node_modules/bmp-js/**/*",
      "**/node_modules/wasm-feature-detect/**/*",
      "**/node_modules/node-fetch/**/*",
      "**/node_modules/whatwg-url/**/*",
      "**/node_modules/tr46/**/*",
      "**/node_modules/webidl-conversions/**/*",
      "**/@tesseract.js-data/eng/**/*",
      "**/onnxruntime-node/bin/**/*",
      "**/@img/sharp-*/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/squidys-tools/inkling/releases/latest/download/"
      }
    ],
    "protocols": [
      {
        "name": "Inkling capture link",
        "schemes": [
          "inkling"
        ]
      }
    ]
  },
  "patchedDependencies": {
    "@liquid-dom/core@0.1.1": "patches/@liquid-dom%2Fcore@0.1.1.patch"
  }
}
