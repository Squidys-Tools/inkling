{
  "expo": {
    "name": "inkling",
    "slug": "inkling-mobile",
    "scheme": "inkling-mobile",
    "version": "0.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "app.inkling.mobile.dev",
      "supportsTablet": true,
      "entitlements": {
        "com.apple.security.application-groups": ["group.app.inkling.mobile.dev"]
      },
      "infoPlist": {
        "EXDevMenuShowFloatingActionButton": false
      },
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png"
      }
    },
    "plugins": [
      "expo-dev-client",
      "@bacons/apple-targets",
      "expo-secure-store",
      "expo-image",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0c0c0b",
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#0c0c0b",
            "image": "./assets/splash-icon.png"
          }
        }
      ]
    ]
  }
}
