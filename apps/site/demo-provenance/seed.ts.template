import type { LibraryCard, Space } from '@inkling/contracts';
// Site-only fixtures: no personal collection, profile, SQLite or desktop IPC.
// Photographs are freshly downloaded from Lorem Picsum/Unsplash; provenance is retained by the host site.
const files=import.meta.glob<string>('./safe-media/*',{eager:true,query:'?url',import:'default'});
const photo=(id:number)=>files[`./safe-media/animal-${id}.jpg`];
const base=1793577600000,day=86400000;
const card=(index:number,fields:Partial<LibraryCard>,tags:string[]=[]):LibraryCard=>({id:`keeper-${index}`,kind:'note',title:null,description:null,sourceUrl:null,sourceLabel:null,localAssetPath:null,thumbnailPath:null,ocrText:'',createdAt:base-index*day,updatedAt:base-index*day,archived:false,hasArticleContent:false,...fields,metadata:{tags,...fields.metadata}});
const animals=[
 [237,'A black dog, taking a break','A curious black Labrador looking up from a wooden deck.',['dog','black','wood','animals']],
 [1069,'A jellyfish in deep blue','An orange jellyfish moving through blue water.',['jellyfish','blue','orange','ocean']],
 [1020,'A bear by the water','A brown bear beside a quiet lake, mountains behind it.',['bear','lake','nature','mountains']],
 [1025,'The blanket belongs to the pug','A small pug wrapped up on a woodland walk.',['dog','pug','blanket','animals']],
 [1074,'Lion, up close','A lion looking straight at the camera.',['lion','wildlife','portrait']],
 [1084,'A slow afternoon','Walruses resting together on a quiet beach.',['walrus','beach','wildlife','ocean']],
] as const;
const imageCards=animals.map(([id,title,description,tags],index)=>card(index*2,{kind:'image',title,description,sourceLabel:'Photo collection',thumbnailPath:photo(id),localAssetPath:photo(id),metadata:{mediaWidth:720,mediaHeight:960}},[...tags]));
const notes=[
 ['Tiny things worth keeping','The sound of rain. A good paragraph. The long way home.',['notes','life']],
 ['A weekend by the water','Bring a notebook, a camera and a warm layer. Leave room for the unplanned.',['travel','lake']],
 ['Design thoughts','Let one thing lead. Make room for the words. Give the details a reason to exist.',['design','reference']],
 ['A recipe for a slow morning','Coffee, toast, a book. No hurry.',['recipe','morning']],
 ['Books for a quiet evening','The Secret Garden\nThe Wind in the Willows\nA notebook of your own',['books','reading']],
 ['Good ideas turn up anywhere','Keep them somewhere you can find them again.',['ideas','notes']],
];
const noteCards=notes.map(([title,description,tags],index)=>card(index*2+1,{title:title as string,description:description as string},tags as string[]));
export const seedCards:LibraryCard[]=[...imageCards,...noteCards,
 card(13,{id:'reading-garden',kind:'article',title:'A little garden journal',description:'What grows when you give it time.',sourceLabel:'Garden journal',thumbnailPath:photo(1020),hasArticleContent:true},['garden','reading']),
 card(14,{id:'keeper-quote',kind:'quote',title:'Keep a little room for a good surprise.',description:'A note to ourselves.'},['life','quote']),
].sort((a,b)=>b.createdAt-a.createdAt);
export const seedArchived:LibraryCard[]=[card(30,{id:'archive-note',title:'Last month’s reading list',description:'Finished, but worth remembering.',archived:true},['books'])];
export const seedBodies:Record<string,string>=Object.fromEntries(noteCards.map(c=>[c.id,`# ${c.title}\n\n${c.description}`]));
export const seedArticles:Record<string,string>={'reading-garden':'<h1>A little garden journal</h1><p>A quiet place to keep track of what is growing. Watch the light, leave room for new leaves, and write down the small changes.</p><h2>Start small</h2><p>A pot on the windowsill counts. So does a few minutes of attention.</p>'};
export const seedSpaces:Space[]=[{id:'nature',name:'Out in nature',color:'green',query:{tag:'nature'},kind:'smart',position:1,createdAt:base,updatedAt:base},{id:'reading',name:'Read later',color:'blue',query:{tag:'reading'},kind:'smart',position:2,createdAt:base,updatedAt:base},{id:'favourites',name:'Little favourites',color:'pink',query:{},kind:'regular',position:3,createdAt:base,updatedAt:base}];
export const seedMembership:Record<string,string[]>={favourites:['keeper-0','keeper-1','keeper-quote']};
export const seedJobs={processing:'not-present',failed:'not-present-either'};
