{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "curl -fsSL https://bun.sh/install | bash -s \"bun-v$(cat ../../.bun-version)\" && ~/.bun/bin/bun install --frozen-lockfile --ignore-scripts",
  "buildCommand": "~/.bun/bin/bun run build",
  "outputDirectory": "dist/client",
  "cleanUrls": true,
  "git": { "deploymentEnabled": { "main": false } },
  "ignoreCommand": "git diff --quiet \"${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}\" HEAD -- ../../apps/site ../../apps/renderer ../../packages ../../package.json ../../bun.lock ../../bunfig.toml ../../tsconfig.base.json ../../patches ../../.bun-version"
}
