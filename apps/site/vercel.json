{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "curl -fsSL https://bun.sh/install | bash -s \"bun-v$(cat ../../.bun-version)\" && ~/.bun/bin/bun install --frozen-lockfile --ignore-scripts",
  "buildCommand": "~/.bun/bin/bun run build",
  "outputDirectory": "dist/client",
  "cleanUrls": true,
  "git": { "deploymentEnabled": { "main": false } },
  "ignoreCommand": "node vercel-ignore.mjs"
}
