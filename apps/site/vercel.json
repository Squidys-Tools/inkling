{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "curl -fsSL https://bun.sh/install | bash -s \"bun-v$(cat ../../.bun-version)\" && ~/.bun/bin/bun install --frozen-lockfile --ignore-scripts",
  "buildCommand": "~/.bun/bin/bun run build",
  "outputDirectory": "dist/client",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/assets/:file([^/]+-[A-Za-z0-9_-]{8}\\.[a-z0-9]+)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/demo/assets/:file([^/]+-[A-Za-z0-9_-]{8}\\.[a-z0-9]+)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "redirects": [
    { "source": "/media/stories/credits.html", "destination": "/credits", "permanent": true },
    { "source": "/media/stories/credits", "destination": "/credits", "permanent": true }
  ],
  "git": { "deploymentEnabled": false }
}
