{
  "name": "inkling",
  "version": "0.1.0",
  "private": true,
  "description": "A private local library for everything worth keeping",
  "license": "MIT",
  "author": "exodus712",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "type": "module",
  "main": "dist/desktop/main.mjs",
  "scripts": {
    "dev": "vite --config apps/renderer/vite.config.ts",
    "dev:app": "bun run build:app && electron . --dev",
    "build:renderer": "vite build --config apps/renderer/vite.config.ts",
    "build:processes": "bun apps/desktop/build.ts",
    "build:app": "bun run build:renderer && bun run build:processes",
    "build:dir": "bun run build:app && electron-builder --publish never --dir",
    "build:win": "bun run build:app && electron-builder --publish never --win nsis",
    "build:linux": "bun run build:app && electron-builder --publish never --linux deb AppImage",
    "build:mac": "bun run build:app && electron-builder --publish never --mac dmg",
    "typecheck": "tsc-rs -p apps/renderer --noEmit && tsc-rs -p apps/desktop --noEmit && tsc-rs -p packages/library --noEmit",
    "test": "bun test",
    "lint": "oxlint --report-unused-disable-directives && oxfmt --check",
    "lint:fix": "oxlint --report-unused-disable-directives --fix && oxfmt",
    "check": "bun run typecheck && bun run lint && bun test && bun run build:app",
    "bench": "bun tools/bench/run.ts"
  },
  "dependencies": {
    "@effect/sql-sqlite-node": "4.0.6",
    "@huggingface/tokenizers": "0.2.0",
    "@img/sharp-wasm32": "0.35.5",
    "@napi-rs/canvas": "1.0.13",
    "@tesseract.js-data/eng": "1.0.0",
    "builder-util-runtime": "9.7.0",
    "defuddle": "^0.19.5",
    "dompurify": "^3.4.17",
    "effect": "4.0.6",
    "electron-updater": "6.8.11",
    "entities": "^7.0.1",
    "linkedom": "0.18.13",
    "onnxruntime-node": "1.30.0",
    "pdfjs-dist": "^6.4.299",
    "semver": "7.7.3",
    "sharp": "0.35.5",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@base-ui/react": "^1.9.0",
    "@effect/platform-browser": "4.0.6",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/libre-baskerville": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@inkling/contracts": "workspace:*",
    "@inkling/library": "workspace:*",
    "@inkling/rpc-electron": "workspace:*",
    "@inkling/ui": "workspace:*",
    "@oxlint/plugins": "^1.89.0",
    "@rolldown/plugin-babel": "^0.3.0",
    "@stylexjs/stylex": "0.19.1",
    "@stylexjs/unplugin": "0.19.1",
    "@tanstack/react-router": "^1.140.0",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-list": "3.32.0",
    "@tiptap/markdown": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@types/bun": "1.4.4",
    "@types/jsdom": "^30.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "7.7.1",
    "@virtuoso.dev/masonry": "^1.4.3",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "electron": "45.0.0",
    "electron-builder": "^26.18.0",
    "jsdom": "^30.1.3",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsc-rs": "0.8.0",
    "vite": "^8.3.5"
  },
  "overrides": {
    "isbinaryfile": "5.0.7"
  },
  "build": {
    "appId": "com.inkling.library",
    "productName": "inkling",
    "directories": {
      "buildResources": "build",
      "output": ".artifacts/electron"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!**/node_modules/**/*.{map,ts,mts,cts}"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ],
      "files": [
        "!**/node_modules/onnxruntime-node/bin/napi-v6/!(win32)/**"
      ]
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "${name}-${version}-mac-${arch}.${ext}",
      "files": [
        "!**/node_modules/onnxruntime-node/bin/napi-v6/!(darwin)/**"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Utility",
      "target": [
        "deb",
        "AppImage"
      ],
      "artifactName": "${name}-${version}-linux-${arch}.${ext}",
      "files": [
        "!**/node_modules/onnxruntime-node/bin/napi-v6/!(linux)/**"
      ],
      "desktop": {
        "entry": {
          "StartupWMClass": "inkling",
          "MimeType": "x-scheme-handler/inkling;"
        }
      }
    },
    "protocols": [
      {
        "name": "Inkling capture link",
        "schemes": [
          "inkling"
        ]
      }
    ]
  },
  "patchedDependencies": {
    "sharp@0.35.5": "patches/sharp@0.35.5.patch"
  }
}
