{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "oxc", "react", "unicorn", "typescript", "jsx-a11y"],
  "jsPlugins": ["./oxlint-plugin-inkling/index.ts"],
  "categories": {
    "correctness": "warn",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "oxc/no-accumulating-spread": "error",
    "eslint/no-control-regex": "off",
    "typescript/no-this-alias": "off",
    "unicorn/prefer-add-event-listener": "off",
    "unicorn/prefer-string-starts-ends-with": "off",
    "unicorn/prefer-set-has": "off",
    "unicorn/prefer-array-find": "off",
    "unicorn/no-new-array": "off",
    "unicorn/no-array-reverse": "off",
    "unicorn/no-array-sort": "off",
    "unicorn/consistent-function-scoping": "off",
    "react/no-object-type-as-default-prop": "off",
    "react/jsx-no-constructed-context-values": "off",
    "react/react-in-jsx-scope": "off",
    "react/no-array-index-key": "error",
    "react/no-unstable-nested-components": "error",
    "react-hooks/exhaustive-deps": "warn",
    "react-hooks/rules-of-hooks": "error",
    "typescript/no-explicit-any": "warn",
    "typescript/no-extraneous-class": "error",
    "eslint/no-empty-pattern": "error",
    "eslint/no-new": "error",
    "eslint/no-eval": "error",
    "eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    "eslint/no-unsafe-optional-chaining": "error",
    "eslint/no-unneeded-ternary": "error",
    "unicorn/no-useless-spread": "error",
    "unicorn/no-useless-fallback-in-spread": "error",
    "oxc/no-map-spread": "off",
    "eslint/no-shadow": "off",
    "eslint/no-await-in-loop": "off",
    "eslint/no-underscore-dangle": "off",
    "react/refs": "error",
    "react/set-state-in-effect": "error",
    "react/exhaustive-effect-dependencies": "error",
    "react/immutability": "error",
    "react/purity": "error",
    "jsx-a11y/prefer-tag-over-role": "off",
    "jsx-a11y/interactive-supports-focus": "off",
    "jsx-a11y/control-has-associated-label": "off",
    "jsx-a11y/label-has-associated-control": [
      "error",
      {
        "controlComponents": ["Input"]
      }
    ],
    "inkling/no-low-value-comments": "error",
    "inkling/require-suppression-reason": "error"
  },
  "ignorePatterns": [
    "dist",
    ".artifacts",
    "public/seed-demo",
    "**/*.d.ts",
    "benchmarks/corpus",
    "docs/assets",
    "extension/icons"
  ],
  "options": {
    "reportUnusedDisableDirectives": "error"
  },
  "overrides": [
    {
      "files": ["electron/**"],
      "rules": {
        "unicorn/require-post-message-target-origin": "off",
        "react-hooks/rules-of-hooks": "off"
      }
    },
    {
      "files": ["src/components/mascot/bot/**"],
      "rules": {
        "inkling/no-low-value-comments": "off"
      }
    }
  ]
}
